//! member: false
//! POSIX.1-2024 expr synopsis and option specifications consulted.
//! expr — token grammar, lazy Boolean operators and anchored BRE captures.
//! References consulted: GNU coreutils 9.11 --help and binary probes;
//! clean-room scent BRE engine at b6f63a4 plus our capture adapter.
//! Integers outside 64-bit magnitude range are refused explicitly, including
//! arithmetic results (wolf-std#100: no general bigint surface at this pin).

use bore
use re
use numcli

struct Parser { args: List[str], at: int, status: int, message: str }

fn fail(mut p: Parser, message: str) { if p.status == 0 { p.status = 2; p.message = message } }

fn gap(mut p: Parser) {
    fail(mut p, "unsupported integer: outside the 64-bit magnitude range (wolf-std#100)")
}

fn spelling(bs: List[byte]) -> str { str_from_utf8(bs) else "<non-UTF-8>" }

fn numeric(bs: List[byte]) -> bool {
    var k = 0
    if bs.len > 0 && bs[0] == 45 as byte { k = 1 }
    if k == bs.len { return false }
    while k < bs.len { if bs[k] < 48 as byte || bs[k] > 57 as byte { return false }; k += 1 }
    true
}

fn truth(bs: List[byte]) -> bool {
    if bs.len == 0 { return false }
    var k = 0
    if bs[0] == 45 as byte { k = 1 }
    if k == bs.len { return true }
    while k < bs.len { if bs[k] != 48 as byte { return true }; k += 1 }
    false
}

fn bounded(mut p: Parser, bs: List[byte]) -> bool {
    let text = spelling(bs)
    let _ = numcli.unsigned(if text.starts_with("-") then text[1..] else text) else |_| { gap(mut p); return false }
    true
}

fn precedence(op: str) -> int {
    if op == "|" { return 1 }
    if op == "&" { return 2 }
    if op == "=" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { return 3 }
    if op == "+" || op == "-" { return 4 }
    if op == "*" || op == "/" || op == "%" { return 5 }
    if op == ":" { return 6 }
    0
}

fn regex(mut p: Parser, text: List[byte], pattern: List[byte], eval: bool) -> List[byte] {
    if !eval || p.status != 0 { return List[byte]() }
    var d = re.diagnostics_new()
    let m = re.match_prefix(pattern, text, mut d) else |_| {
        for item in d.items {
            if !item.warning { fail(mut p, spelling(item.text)); return List[byte]() }
        }
        fail(mut p, "Invalid regular expression")
        return List[byte]()
    }
    if m.group { return copy m.text }
    "{m.length}".bytes()
}

fn primary(mut p: Parser, eval: bool) -> List[byte] {
    if p.at >= p.args.len {
        if p.at > 0 {
            fail(
                mut p,
                "syntax error: missing argument after {bore.quote_always(p.args[p.at - 1])}",
            )
        } else {
            fail(mut p, "missing operand")
        }
        return List[byte]()
    }
    let token = p.args[p.at]
    p.at += 1
    if token == ")" { fail(mut p, "syntax error: unexpected ')'"); return List[byte]() }
    if token == "(" {
        let result = expression(mut p, 1, eval)
        if p.status != 0 { return List[byte]() }
        if p.at >= p.args.len || p.args[p.at] != ")" {
            fail(mut p, "syntax error: expecting ')' after {bore.quote_always(p.args[p.at - 1])}")
            return List[byte]()
        }
        p.at += 1
        return result
    }
    if token == "+" {
        if p.at >= p.args.len {
            fail(mut p, "syntax error: missing argument after '+'")
            return List[byte]()
        }
        let value = p.args[p.at].bytes()
        p.at += 1
        return value
    }
    if token == "length" { let value = primary(mut p, eval); return "{value.len}".bytes() }
    if token == "index" {
        let text = primary(mut p, eval), chars = primary(mut p, eval)
        var result = 0
        for k in 0..text.len {
            for c in chars { if text[k] == c { result = k + 1; break } }
            if result > 0 { break }
        }
        return "{result}".bytes()
    }
    if token == "substr" {
        let text = primary(mut p, eval),
            position = primary(mut p, eval),
            count = primary(mut p, eval)
        var result = List[byte]()
        if !eval || !numeric(position) || !numeric(count) { return result }
        let first = number(position), length = number(count)
        if first.neg ||
            length.neg ||
            first.mag == 0 ||
            length.mag == 0 ||
            first.mag > text.len as wrapping[u64] {
            return result
        }
        let a = first.mag as int
        let amount = if length.mag < (text.len - a + 1) as wrapping[u64] {
            length.mag as int
        } else {
            text.len - a + 1
        }
        for k in a - 1..a - 1 + amount { (mut result).push(text[k]) }
        return result
    }
    if token == "match" {
        let text = primary(mut p, eval), pattern = primary(mut p, eval)
        return regex(mut p, text, pattern, eval)
    }
    token.bytes()
}

fn compare(a: List[byte], b: List[byte]) -> int {
    var k = 0
    while k < a.len && k < b.len {
        if a[k] < b[k] { return -1 }
        if a[k] > b[k] { return 1 }
        k += 1
    }
    if a.len < b.len { return -1 }
    if a.len > b.len { return 1 }
    0
}

fn integer_compare(a: List[byte], b: List[byte]) -> int {
    var i = if a[0] == 45 as byte then 1 else 0, j = if b[0] == 45 as byte then 1 else 0
    while i < a.len && a[i] == 48 as byte { i += 1 }
    while j < b.len && b[j] == 48 as byte { j += 1 }
    let negative_a = a[0] == 45 as byte && i < a.len, negative_b = b[0] == 45 as byte && j < b.len
    if negative_a != negative_b { return if negative_a then -1 else 1 }
    var result = 0
    if a.len - i != b.len - j { result = if a.len - i < b.len - j then -1 else 1 } else {
        while i < a.len { if a[i] != b[j] { result = if a[i] < b[j] then -1 else 1; break }; i += 1; j += 1 }
    }
    if negative_a then -result else result
}
fn binary(mut p: Parser, left: List[byte], op: str, right: List[byte], eval: bool) -> List[byte] {
    if !eval || p.status != 0 { return List[byte]() }
    if op == "|" {
        return if truth(left) then copy left else if truth(right) then copy right else "0".bytes()
    }
    if op == "&" { return if truth(left) && truth(right) then copy left else "0".bytes() }
    if op == ":" { return regex(mut p, left, right, true) }
    let nums = numeric(left) && numeric(right)
    if precedence(op) == 3 {
        var c = 0
        if nums { c = integer_compare(left, right) } else { c = compare(left, right) }
        let yes = if op == "=" {
            c == 0
        } else if op == "!=" {
            c != 0
        } else if op == "<" {
            c < 0
        } else if op == "<=" {
            c <= 0
        } else if op == ">" {
            c > 0
        } else {
            c >= 0
        }
        return (if yes then "1" else "0").bytes()
    }
    if !nums { fail(mut p, "non-integer argument"); return List[byte]() }
    if !bounded(mut p, left) || !bounded(mut p, right) { return List[byte]() }
    let a = number(left)
    var b = number(right)
    let maximum: wrapping[u64] = 18446744073709551615
    var result = Number { mag: 0, neg: false }
    if op == "-" { b.neg = !b.neg && b.mag != 0 }
    if op == "+" || op == "-" {
        if a.neg == b.neg {
            if a.mag > maximum - b.mag { gap(mut p); return List[byte]() }
            result.mag = a.mag + b.mag
            result.neg = a.neg
        } else if a.mag >= b.mag {
            result.mag = a.mag - b.mag
            result.neg = a.neg
        } else {
            result.mag = b.mag - a.mag
            result.neg = b.neg
        }
    } else if op == "*" {
        if b.mag != 0 && a.mag > maximum / b.mag { gap(mut p); return List[byte]() }
        result.mag = a.mag * b.mag
        result.neg = a.neg != b.neg
    } else {
        if b.mag == 0 { fail(mut p, "division by zero"); return List[byte]() }
        result.mag = if op == "/" then a.mag / b.mag else a.mag % b.mag
        result.neg = if op == "/" then a.neg != b.neg else a.neg
    }
    let digits = bore.u64_text(result.mag)
    (if result.neg && result.mag != 0 then "-" + digits else digits).bytes()
}

struct Number { mag: wrapping[u64], neg: bool }

fn number(bytes: List[byte]) -> Number {
    let text = spelling(bytes), neg = text.starts_with("-")
    let mag = numcli.unsigned(if neg then text[1..] else text) else |e| match e { overflow => { 18446744073709551615 as wrapping[u64] }, parse => { 0 as wrapping[u64] } }
    Number { mag: mag, neg: neg && mag != 0 }
}

fn expression(mut p: Parser, least: int, eval: bool) -> List[byte] {
    var left = primary(mut p, eval)
    while p.status == 0 && p.at < p.args.len {
        let op = p.args[p.at], power = precedence(op)
        if power < least { break }
        p.at += 1
        let evaluate = eval && !(op == "|" && truth(left) || op == "&" && !truth(left))
        let right = expression(mut p, power + 1, evaluate)
        left = binary(mut p, left, op, right, eval)
    }
    left
}

fn finish(mut out: bore.Out, status: int) -> int {
    bore.flush(mut out) else |_| { bore.write_error(out, "expr", "write error"); return 3 }
    status
}

fn main() -> int {
    var args = env_args(), out = bore.stdout()
    if args.len == 1 && (args[0] == "--help" || args[0] == "--version") {
        bore.put(
            mut out,
            if args[0] == "--version" {
                bore.version_text("expr")
            } else {
                "Usage: expr EXPRESSION\nEvaluate arithmetic, strings, Boolean expressions and anchored BRE matches.\nIntegers outside the 64-bit magnitude range require wolf-std#100.\n"
            },
        ) else |_| { bore.write_error(out, "expr", "write error"); return 3 }
        return finish(mut out, 0)
    }
    if args.len > 0 && args[0] == "--" {
        var rest = List[str]()
        for k in 1..args.len { (mut rest).push(args[k]) }
        args = rest
    }
    if args.len == 0 { let _ = bore.usage_error("expr", "missing operand"); return 2 }
    var p = Parser { args: args, at: 0, status: 0, message: "" }
    let result = expression(mut p, 1, true)
    if p.status == 0 && p.at < p.args.len {
        fail(mut p, "syntax error: unexpected argument {bore.quote_always(p.args[p.at])}")
    }
    if p.status != 0 { bore.warn("expr", p.message); return p.status }
    bore.write_all(mut out, result) else |_| {
        bore.write_error(out, "expr", "write error")
        return 3
    }
    bore.put(mut out, "\n") else |_| { bore.write_error(out, "expr", "write error"); return 3 }
    finish(mut out, if truth(result) then 0 else 1)
}
