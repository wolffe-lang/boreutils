//! Published standard vectors, not answers computed by the implementation.
use checksum

fn vector(kind: int, bits: int, text: str, want: str) {
    var d = checksum.digest_new(kind, bits)
    checksum.digest_feed(mut d, text.bytes())
    let got = checksum.hex_bytes(checksum.digest_end(mut d))
    assert(got == want, "digest {kind}/{bits}: {got}, want {want}")
}

fn main() {
    // RFC 1321 A.5.
    vector(4, 128, "", "d41d8cd98f00b204e9800998ecf8427e")
    vector(4, 128, "a", "0cc175b9c0f1b6a831c399e269772661")
    vector(4, 128, "abc", "900150983cd24fb0d6963f7d28e17f72")
    vector(4, 128, "message digest", "f96b697d7cb7938d525a2f31aaf161d0")
    vector(4, 128, "abcdefghijklmnopqrstuvwxyz", "c3fcd3d76192e4007dfb496cca67e13b")
    vector(4, 128, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789", "d174ab98d277d9f5a5611c2c9f419d9f")
    vector(4, 128, "12345678901234567890123456789012345678901234567890123456789012345678901234567890", "57edf4a22be3c955ac49da2e2107b67a")
    // FIPS 180-4 / NIST SHS example abc; RFC 3174 and RFC 6234.
    vector(5, 160, "abc", "a9993e364706816aba3e25717850c26c9cd0d89d")
    vector(6, 224, "abc", "23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7")
    vector(7, 256, "abc", "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    vector(8, 384, "abc", "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    vector(9, 512, "abc", "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    // RFC 7693 Appendix A, BLAKE2b-512(abc).
    vector(10, 512, "abc", "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923")
    // POSIX polynomial-derived regressions; Ethernet CRC check value.
    vector(0, 32, "", "ffffffff")
    vector(0, 32, "123456789", "377a6011")
    vector(1, 32, "123456789", "cbf43926")
    // BSD rotation and SysV additive definitions, hand-derived for abc.
    vector(2, 16, "abc", "00000126")
    vector(3, 16, "abc", "000040ac")
}
