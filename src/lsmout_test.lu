//! Synthetic byte fixtures, not claims about the host's LSM label.

use lsmout

fn rendered(text: str) -> str {
    str_from_utf8(lsmout.line(text.bytes())) else "invalid"
}

fn main() {
    assert(rendered("docker-default (enforce)") == "docker-default (enforce)\n", "one appended LF")
    assert(rendered("docker-default (enforce)\n") == "docker-default (enforce)\n\n", "preserve existing LF")
    assert(rendered("label\n\n") == "label\n\n\n", "no trimming")
    let raw = [255 as byte]
    let output = lsmout.line(raw)
    assert(output.len == 2 && output[0] as int == 255 && output[1] as int == 10, "raw context bytes")
}
