//! member: false
//!
//! sleep — pause for the sum of the given intervals.
//!
//! References consulted: POSIX.1-2024 `sleep`; GNU coreutils 9.11
//! `sleep --help`, the info manual's `sleep invocation` node, and
//! black-box runs of the GNU binary on linux x86-64 (Arch) and macOS
//! arm64 (Homebrew `gsleep`), under `LC_ALL=C`; C's `strtod` grammar
//! (C17 7.22.1.3) for what a NUMBER is. Never GNU source.
//!
//! GNU's rules, each measured against 9.11 on both hosts:
//!
//! - An operand is a DURATION (`bore/duration.lu`, shared with `timeout`
//!   since bu27): a `strtod` number — leading white space, a sign,
//!   decimal digits with an optional point and exponent, a `0x` hex
//!   float with an optional `p` exponent, or `inf`/`infinity` in any
//!   case — followed by at most ONE of `s`, `m`, `h`, `d`, lower case
//!   only. Anything left over, a NaN, an upper-case unit, a comma and
//!   a negative value are `invalid time interval 'X'`. `-0` is not
//!   negative. In a hex number `d` is a digit, so `0x1d` is 29
//!   seconds and a day needs a `p` exponent first (`0x1p0d`).
//! - Every invalid operand is reported, in order, and ONE `Try` line
//!   follows them all; the status is 1 and nothing is slept.
//! - Options permute (`sleep 0 --help` is help) unless
//!   `POSIXLY_CORRECT` is set, when the first operand ends them. A word
//!   like `-1` is therefore an OPTION, `invalid option -- '1'`, and a
//!   negative interval can only be written after `--`.
//! - No operand is `missing operand`, status 1 — but `sleep --`, which
//!   has no operand either, sleeps for nothing and exits 0. That is
//!   GNU's answer and it is kept.
//! - The intervals are summed; an infinite or overflowing sum sleeps
//!   until the process is killed.
//!
//! **The resolution is a millisecond, not a nanosecond.** wolf 0.2.26
//! sleeps through `time_sleep_ms(int)`, so the sum is rounded UP to the
//! next whole millisecond: `sleep 1e-9` sleeps 1 ms where GNU sleeps
//! one nanosecond. Never shorter than asked, and no differential case
//! can see the difference; the bench measures it.

use bore

fn main() -> int {
    let p = bore.parse(options(), env_args(), bore.permute())
    var out = bore.stdout()
    var i = 0
    while i < p.keys.len {
        if p.keys[i] == "help" {
            bore.put(mut out, help()) else |_| {}
            return bore.finish(mut out, "sleep", 0)
        }
        if p.keys[i] == "version" {
            bore.put(mut out, bore.version_text("sleep")) else |_| {}
            return bore.finish(mut out, "sleep", 0)
        }
        i += 1
    }
    if !bore.ok(p) {
        return bore.usage_error("sleep", p.error)
    }
    if p.operands.len == 0 {
        if env_args().len > 0 {
            // `sleep --`: GNU sleeps for nothing and succeeds.
            return 0
        }
        return bore.usage_error("sleep", "missing operand")
    }
    var total: f64 = 0.0
    var bad = false
    for a in p.operands {
        let d = bore.duration_of(a) else |_| {
            bore.warn("sleep", "invalid time interval {bore.quote(a)}")
            bad = true
            continue
        }
        total = total + d.secs
    }
    if bad {
        eprint("Try 'sleep --help' for more information.")
        return 1
    }
    pause(total)
    0
}

fn options() -> List[bore.Opt] {
    var s = List[bore.Opt]()
    (mut s).push(bore.flag("", "help"))
    (mut s).push(bore.flag("", "version"))
    s
}

/// Sleep `secs` seconds, rounded up to a whole millisecond. A sum past
/// what an `int` of milliseconds holds — about 292 million years — is
/// forever, and so is `inf`.
fn pause(secs: f64) {
    let ms = secs * 1000.0
    if ms <= 0.0 {
        return
    }
    if ms > 9000000000000000000.0 {
        loop {
            time_sleep_ms(1000000000)
        }
    }
    var whole = ms as int
    if whole as f64 < ms {
        whole += 1
    }
    time_sleep_ms(whole)
}

fn help() -> str {
    """
    Usage: sleep NUMBER[SUFFIX]...
      or:  sleep OPTION
    Wait for NUMBER seconds, or for the sum of every NUMBER given.
    NUMBER may be a whole or a fractional number, in decimal or in C's
    hexadecimal float form, or 'inf'. SUFFIX is one of:

      s   seconds (the default)
      m   minutes
      h   hours
      d   days

          --help     print this help and exit
          --version  print the version and exit

    boreutils: https://github.com/wolffe-lang/boreutils
    """
}
