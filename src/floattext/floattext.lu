//! Exact dyadic-to-decimal formatting shared by the number tools.
//! Reuses boreutils' own clean-room printf implementation at e690513,
//! src/printf.lu's 24-bit naturals, decimal lexer and %g converter.
//! IEEE 754 encodings are decoded here from the published bit layouts;
//! GNU coreutils 9.11 binaries are the oracle, never implementation source.

struct Host { mant: int, emin_lsb: int, emax: int }
fn push_str(mut b: List[byte], s: str) { for c in s.bytes() { (mut b).push(c) } }
fn hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    -1
}

/// C's `isspace` in the C locale.
fn is_space(c: int) -> bool {
    c == 32 || c >= 9 && c <= 13
}

// -------------------------------------------------------- big naturals

// A natural number as little-endian limbs of 24 bits, with no zero
// limb on top; zero is the empty list. 24 bits so that a limb times a
// limb, plus a carry, stays far inside an `int`.

fn limb() -> int {
    16777216
}

fn mask() -> int {
    16777215
}

/// `a` without zero limbs on top.
fn bn_norm(a: List[int]) -> List[int] {
    var n = a.len
    while n > 0 && a[n - 1] == 0 {
        n -= 1
    }
    var r = List[int]()
    var i = 0
    while i < n {
        (mut r).push(a[i])
        i += 1
    }
    r
}

fn bn_of(n: int) -> List[int] {
    var a = List[int]()
    var v = n
    while v > 0 {
        (mut a).push(v % limb())
        v = v / limb()
    }
    a
}

fn bn_bitlen(a: List[int]) -> int {
    if a.len == 0 {
        return 0
    }
    var top = a[a.len - 1]
    var bits = 0
    while top > 0 {
        bits += 1
        top = top / 2
    }
    bits + 24 * (a.len - 1)
}

fn bn_cmp(a: List[int], b: List[int]) -> int {
    if a.len != b.len {
        return if a.len < b.len then -1 else 1
    }
    var i = a.len - 1
    while i >= 0 {
        if a[i] != b[i] {
            return if a[i] < b[i] then -1 else 1
        }
        i -= 1
    }
    0
}

fn bn_add(a: List[int], b: List[int]) -> List[int] {
    var r = List[int]()
    var carry = 0
    var i = 0
    while i < a.len || i < b.len || carry > 0 {
        var s = carry
        if i < a.len {
            s += a[i]
        }
        if i < b.len {
            s += b[i]
        }
        (mut r).push(s % limb())
        carry = s / limb()
        i += 1
    }
    r
}

/// `a - b`, for `a >= b`.
fn bn_sub(a: List[int], b: List[int]) -> List[int] {
    var r = List[int]()
    var owe = 0
    var i = 0
    while i < a.len {
        var s = a[i] - owe
        if i < b.len {
            s -= b[i]
        }
        if s < 0 {
            s += limb()
            owe = 1
        } else {
            owe = 0
        }
        (mut r).push(s)
        i += 1
    }
    bn_norm(r)
}

/// `a * k` for `0 <= k <= 2^31`.
fn bn_mul_small(a: List[int], k: int) -> List[int] {
    var r = List[int]()
    if k == 0 {
        return r
    }
    var carry: int = 0
    for x in a {
        let p = x * k + carry
        (mut r).push(p % limb())
        carry = p / limb()
    }
    while carry > 0 {
        (mut r).push(carry % limb())
        carry = carry / limb()
    }
    r
}

fn bn_add_small(a: List[int], k: int) -> List[int] {
    bn_add(a, bn_of(k))
}

fn bn_mul(a: List[int], b: List[int]) -> List[int] {
    if a.len == 0 || b.len == 0 {
        return List[int]()
    }
    var r = List[int]()
    var n = 0
    while n < a.len + b.len {
        (mut r).push(0)
        n += 1
    }
    var i = 0
    while i < a.len {
        var carry: int = 0
        var j = 0
        while j < b.len {
            let cur = r[i + j] + a[i] * b[j] + carry
            r[i + j] = cur % limb()
            carry = cur / limb()
            j += 1
        }
        var k = i + b.len
        while carry > 0 {
            let cur = r[k] + carry
            r[k] = cur % limb()
            carry = cur / limb()
            k += 1
        }
        i += 1
    }
    bn_norm(r)
}

fn bn_shl(a: List[int], s: int) -> List[int] {
    if a.len == 0 {
        return List[int]()
    }
    var r = List[int]()
    var w = s / 24
    let bits = s % 24
    while w > 0 {
        (mut r).push(0)
        w -= 1
    }
    var mult = 1
    var k = 0
    while k < bits {
        mult = mult * 2
        k += 1
    }
    var carry = 0
    for x in a {
        let p = x * mult + carry
        (mut r).push(p % limb())
        carry = p / limb()
    }
    if carry > 0 {
        (mut r).push(carry)
    }
    r
}

fn bn_shr(a: List[int], s: int) -> List[int] {
    let w = s / 24
    let bits = s % 24
    var div = 1
    var k = 0
    while k < bits {
        div = div * 2
        k += 1
    }
    var r = List[int]()
    var i = w
    while i < a.len {
        var v = a[i] / div
        if i + 1 < a.len {
            v += a[i + 1] % div * (limb() / div)
        }
        (mut r).push(v)
        i += 1
    }
    bn_norm(r)
}

/// Bit `i` of `a`.
fn bn_bit(a: List[int], i: int) -> int {
    let w = i / 24
    if w >= a.len {
        return 0
    }
    var v = a[w]
    var k = i % 24
    while k > 0 {
        v = v / 2
        k -= 1
    }
    v % 2
}

/// Whether any of the low `s` bits of `a` is set.
fn bn_low_nonzero(a: List[int], s: int) -> bool {
    let w = s / 24
    var i = 0
    while i < w && i < a.len {
        if a[i] != 0 {
            return true
        }
        i += 1
    }
    if w < a.len {
        var div = 1
        var k = 0
        while k < s % 24 {
            div = div * 2
            k += 1
        }
        if a[w] % div != 0 {
            return true
        }
    }
    false
}

struct DivSmall {
    q: List[int],
    r: int,
}

/// `a / k` and `a % k`, for `0 < k <= 2^24`.
fn bn_divmod_small(a: List[int], k: int) -> DivSmall {
    var q = List[int]()
    var n = 0
    while n < a.len {
        (mut q).push(0)
        n += 1
    }
    var r: int = 0
    var i = a.len - 1
    while i >= 0 {
        let cur = r * limb() + a[i]
        q[i] = cur / k
        r = cur % k
        i -= 1
    }
    DivSmall { q: bn_norm(q), r: r }
}

struct DivBig {
    q: List[int],
    r: List[int],
}

/// `a / b` and `a % b` by binary long division; the callers keep the
/// quotient to a few hundred bits at most.
fn bn_divmod(a: List[int], b: List[int]) -> DivBig {
    if bn_cmp(a, b) < 0 {
        return DivBig { q: List[int](), r: copy a }
    }
    let shift = bn_bitlen(a) - bn_bitlen(b)
    var r = copy a
    var q = List[int]()
    var d = bn_shl(b, shift)
    var i = shift
    while i >= 0 {
        if bn_cmp(r, d) >= 0 {
            r = bn_sub(r, d)
            q = bn_add(q, bn_shl(bn_of(1), i))
        }
        d = bn_shr(d, 1)
        i -= 1
    }
    DivBig { q: q, r: r }
}

/// `base ^ n`, for a small base.
fn bn_pow(base: int, n: int) -> List[int] {
    var r = bn_of(1)
    var step = 1
    var chunk = 0
    while chunk < 10 && step * base <= 16777216 {
        step = step * base
        chunk += 1
    }
    var left = n
    while left >= chunk && chunk > 0 {
        r = bn_mul_small(r, step)
        left -= chunk
    }
    while left > 0 {
        r = bn_mul_small(r, base)
        left -= 1
    }
    r
}

/// `a` in decimal.
fn bn_dec(a: List[int]) -> List[byte] {
    var out = List[byte]()
    if a.len == 0 {
        (mut out).push(48 as byte)
        return out
    }
    var groups = List[int]()
    var v = copy a
    while v.len > 0 {
        let d = bn_divmod_small(v, 1000000)
        (mut groups).push(d.r)
        v = d.q
    }
    var g = groups.len - 1
    var first = true
    while g >= 0 {
        let text = "{groups[g]}"
        if !first {
            var pad = 6 - text.len
            while pad > 0 {
                (mut out).push(48 as byte)
                pad -= 1
            }
        }
        push_str(mut out, text)
        first = false
        g -= 1
    }
    out
}

/// A natural from decimal digit values, most significant first.
fn bn_from_digits(ds: List[int]) -> List[int] {
    var r = List[int]()
    var i = 0
    while i < ds.len {
        var chunk = 0
        var mult = 1
        var k = 0
        while k < 6 && i < ds.len {
            chunk = chunk * 10 + ds[i]
            mult = mult * 10
            i += 1
            k += 1
        }
        r = bn_add_small(bn_mul_small(r, mult), chunk)
    }
    r
}

/// `num / den`, rounded to nearest with ties to even, and whether
/// anything was rounded away.
struct Rounded {
    q: List[int],
    inexact: bool,
}

fn bn_div_round(num: List[int], den: List[int]) -> Rounded {
    let p = pow2_index(den)
    if p >= 0 {
        return bn_shr_round(num, p)
    }
    if den.len == 1 {
        // A one-limb divisor — 5^k for k <= 10, which is every decimal
        // argument with ten or fewer digits after its point — divides in
        // one pass instead of bit by bit.
        let d = bn_divmod_small(num, den[0])
        if d.r == 0 {
            return Rounded { q: d.q, inexact: false }
        }
        let twice = 2 * d.r
        if twice > den[0] || twice == den[0] && bn_bit(d.q, 0) == 1 {
            return Rounded { q: bn_add_small(d.q, 1), inexact: true }
        }
        return Rounded { q: d.q, inexact: true }
    }
    let d = bn_divmod(num, den)
    if d.r.len == 0 {
        return Rounded { q: d.q, inexact: false }
    }
    let c = bn_cmp(bn_shl(d.r, 1), den)
    if c > 0 || c == 0 && bn_bit(d.q, 0) == 1 {
        return Rounded { q: bn_add_small(d.q, 1), inexact: true }
    }
    Rounded { q: d.q, inexact: true }
}

/// `num / 2^s`, rounded half to even.
fn bn_shr_round(num: List[int], s: int) -> Rounded {
    if s <= 0 {
        return Rounded { q: bn_shl(num, 0 - s), inexact: false }
    }
    let q = bn_shr(num, s)
    let half = bn_bit(num, s - 1) == 1
    let sticky = bn_low_nonzero(num, s - 1)
    if half && (sticky || bn_bit(q, 0) == 1) {
        return Rounded { q: bn_add_small(q, 1), inexact: true }
    }
    Rounded { q: q, inexact: half || sticky }
}

/// `k` when `a` is exactly 2^k, else -1.
fn pow2_index(a: List[int]) -> int {
    if a.len == 0 {
        return -1
    }
    var i = 0
    while i < a.len - 1 {
        if a[i] != 0 {
            return -1
        }
        i += 1
    }
    var top = a[a.len - 1]
    var k = 0
    while top % 2 == 0 {
        top = top / 2
        k += 1
    }
    if top != 1 {
        return -1
    }
    k + 24 * (a.len - 1)
}

// ------------------------------------------------------------ floating

/// A value in the host's `long double`: finite (`m * 2^e`, `m` at most
/// `mant` bits), infinite or NaN, with a sign either way.
struct Flt {
    kind: int,
    neg: bool,
    m: List[int],
    e: int,
}

/// What `strtold` read: the kind, the sign, and an exact finite value,
/// `m * 10^e` (decimal) or `m * 2^e` (hex), with `ndig` significant
/// decimal digits; `end` is where it stopped, `start` where the number
/// itself began (after blanks and a sign).
struct Lex {
    kind: int,
    neg: bool,
    m: List[int],
    e: int,
    hex: bool,
    ndig: int,
    start: int,
    end: int,
}

fn lex_float(b: List[byte]) -> Lex {
    var i = 0
    while i < b.len && is_space(b[i] as int) {
        i += 1
    }
    var neg = false
    if i < b.len && (b[i] as int == 43 || b[i] as int == 45) {
        neg = b[i] as int == 45
        i += 1
    }
    let start = i
    var lx = Lex {
        kind: 0,
        neg: neg,
        m: List[int](),
        e: 0,
        hex: false,
        ndig: 0,
        start: start,
        end: start,
    }
    if word_at(b, i, "infinity") {
        lx.kind = 1
        lx.end = i + 8
        return lx
    }
    if word_at(b, i, "inf") {
        lx.kind = 1
        lx.end = i + 3
        return lx
    }
    if word_at(b, i, "nan") {
        lx.kind = 2
        lx.end = i + 3
        var j = i + 3
        if j < b.len && b[j] as int == 40 {
            j += 1
            while j < b.len && is_nchar(b[j] as int) {
                j += 1
            }
            if j < b.len && b[j] as int == 41 {
                lx.end = j + 1
            }
        }
        return lx
    }
    if i + 1 < b.len && b[i] as int == 48 && (b[i + 1] as int == 120 || b[i + 1] as int == 88) {
        if lex_hex(b, i + 2, mut lx) {
            return lx
        }
    }
    lex_dec(b, i, mut lx)
    lx
}

fn is_nchar(c: int) -> bool {
    c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95
}

/// Whether `w` (lower case) is at `b[i]`, in any case.
fn word_at(b: List[byte], i: int, w: str) -> bool {
    let wb = w.bytes()
    if i + wb.len > b.len {
        return false
    }
    var k = 0
    while k < wb.len {
        var c = b[i + k] as int
        if c >= 65 && c <= 90 {
            c += 32
        }
        if c != wb[k] as int {
            return false
        }
        k += 1
    }
    true
}

/// A decimal number at `b[i]`; with no digit at all, nothing is read.
fn lex_dec(b: List[byte], start: int, mut lx: Lex) {
    var i = start
    var ds = List[int]()
    var frac = 0
    var seen = false
    while i < b.len && b[i] as int >= 48 && b[i] as int <= 57 {
        seen = true
        if ds.len > 0 || b[i] as int != 48 {
            (mut ds).push(b[i] as int - 48)
        }
        i += 1
    }
    if i < b.len && b[i] as int == 46 {
        var j = i + 1
        var fseen = false
        while j < b.len && b[j] as int >= 48 && b[j] as int <= 57 {
            fseen = true
            if ds.len > 0 || b[j] as int != 48 {
                (mut ds).push(b[j] as int - 48)
            }
            frac += 1
            j += 1
        }
        if seen || fseen {
            seen = true
            i = j
        }
    }
    if !seen {
        return
    }
    var e = exp_part(b, i, 101, 69)
    if e.len > 0 {
        i += e.len
    }
    lx.m = bn_from_digits(ds)
    lx.ndig = ds.len
    lx.e = clamp(e.value - frac)
    lx.end = i
}

/// A hex float after its `0x` at `b[i]`; answers false (reading
/// nothing) when no hex digit follows, so `0x` is a `0` and an `x`.
fn lex_hex(b: List[byte], start: int, mut lx: Lex) -> bool {
    var i = start
    var m = List[int]()
    var e = 0
    var seen = false
    var leading = true
    while i < b.len && hex_digit(b[i] as int) >= 0 {
        seen = true
        let d = hex_digit(b[i] as int)
        if !(leading && d == 0) {
            leading = false
            m = bn_add_small(bn_mul_small(m, 16), d)
        }
        i += 1
    }
    if i < b.len && b[i] as int == 46 {
        var j = i + 1
        var fseen = false
        while j < b.len && hex_digit(b[j] as int) >= 0 {
            fseen = true
            let d = hex_digit(b[j] as int)
            if !(leading && d == 0) {
                leading = false
                m = bn_add_small(bn_mul_small(m, 16), d)
            }
            e -= 4
            j += 1
        }
        if seen || fseen {
            seen = true
            i = j
        }
    }
    if !seen {
        return false
    }
    let p = exp_part(b, i, 112, 80)
    if p.len > 0 {
        i += p.len
    }
    lx.m = m
    lx.e = clamp(e + p.value)
    lx.hex = true
    lx.end = i
    true
}

/// An exponent: the marker, an optional sign, at least one digit. A
/// length of 0 when there is none, so `1e` is a `1` and an `e`.
struct ExpPart {
    value: int,
    len: int,
}

fn exp_part(b: List[byte], i: int, lower: int, upper: int) -> ExpPart {
    if i >= b.len || b[i] as int != lower && b[i] as int != upper {
        return ExpPart { value: 0, len: 0 }
    }
    var j = i + 1
    var neg = false
    if j < b.len && (b[j] as int == 43 || b[j] as int == 45) {
        neg = b[j] as int == 45
        j += 1
    }
    if j >= b.len || b[j] as int < 48 || b[j] as int > 57 {
        return ExpPart { value: 0, len: 0 }
    }
    var v: int = 0
    while j < b.len && b[j] as int >= 48 && b[j] as int <= 57 {
        if v < 1000000000 {
            v = v * 10 + (b[j] as int - 48)
        }
        j += 1
    }
    if neg {
        v = 0 - v
    }
    ExpPart { value: v, len: j - i }
}

fn clamp(v: int) -> int {
    if v > 1000000000 {
        return 1000000000
    }
    if v < -1000000000 {
        return -1000000000
    }
    v
}

/// The value `lx` names, rounded to the host's `long double`, and
/// whether `strtold` would set ERANGE: an overflow, or a result that is
/// subnormal (or zero) and inexact.
struct Conv {
    v: Flt,
    erange: bool,
}

fn to_host(lx: Lex, h: Host) -> Conv {
    if lx.kind != 0 {
        return Conv { v: Flt { kind: lx.kind, neg: lx.neg, m: List[int](), e: 0 }, erange: false }
    }
    let zero = Flt { kind: 0, neg: lx.neg, m: List[int](), e: 0 }
    let inf = Flt { kind: 1, neg: lx.neg, m: List[int](), e: 0 }
    if lx.m.len == 0 {
        return Conv { v: zero, erange: false }
    }
    // Far outside the range: no need to compute anything.
    var lg = 0
    if lx.hex {
        lg = bn_bitlen(lx.m) - 1 + lx.e
        if lg > h.emax + 1 {
            return Conv { v: inf, erange: true }
        }
        if lg < h.emin_lsb - 2 {
            return Conv { v: zero, erange: true }
        }
    } else {
        let top10 = lx.ndig + lx.e
        if top10 - 1 > h.emax * 30103 / 100000 + 2 {
            return Conv { v: inf, erange: true }
        }
        if top10 < floor_div(h.emin_lsb * 30103, 100000) - 2 {
            return Conv { v: zero, erange: true }
        }
        lg = bn_bitlen(lx.m) - 1 + floor_div(lx.e * 332192809, 100000000)
    }
    var p5 = List[int]()
    if !lx.hex {
        if lx.e >= 0 {
            p5 = bn_pow(5, lx.e)
        } else {
            p5 = bn_pow(5, 0 - lx.e)
        }
    }
    var e2 = lg - (h.mant - 1)
    if e2 < h.emin_lsb {
        e2 = h.emin_lsb
    }
    var r = scaled(lx, p5, e2)
    var tries = 0
    while tries < 12 {
        let bl = bn_bitlen(r.q)
        if bl > h.mant {
            e2 += bl - h.mant
        } else if bl < h.mant && e2 > h.emin_lsb {
            var ne = e2 - (h.mant - bl)
            if ne < h.emin_lsb {
                ne = h.emin_lsb
            }
            e2 = ne
        } else {
            break
        }
        r = scaled(lx, p5, e2)
        tries += 1
    }
    if r.q.len == 0 {
        return Conv { v: zero, erange: true }
    }
    let bl = bn_bitlen(r.q)
    if bl - 1 + e2 > h.emax {
        return Conv { v: inf, erange: true }
    }
    let v = Flt { kind: 0, neg: lx.neg, m: r.q, e: e2 }
    Conv { v: v, erange: r.inexact && bl < h.mant }
}

fn floor_div(a: int, b: int) -> int {
    let q = a / b
    if a % b != 0 && (a < 0) != (b < 0) {
        return q - 1
    }
    q
}

/// The lexed value divided by 2^e2, rounded half to even. `p5` is
/// 5^|e| for a decimal value.
fn scaled(lx: Lex, p5: List[int], e2: int) -> Rounded {
    var num = copy lx.m
    var den = bn_of(1)
    if !lx.hex {
        if lx.e >= 0 {
            num = bn_mul(num, p5)
        } else {
            den = copy p5
        }
    }
    let s = lx.e - e2
    if s >= 0 {
        num = bn_shl(num, s)
    } else {
        den = bn_shl(den, 0 - s)
    }
    bn_div_round(num, den)
}

/// `%f`: the value rounded to `p` decimals, half to even on the exact
/// binary value.
fn fmt_f(v: Flt, p: int, alt: bool) -> List[byte] {
    var num = bn_mul(v.m, bn_pow(10, p))
    var x = List[int]()
    if v.e >= 0 {
        x = bn_shl(num, v.e)
    } else {
        x = bn_shr_round(num, 0 - v.e).q
    }
    let ds = bn_dec(x)
    var all = List[byte]()
    var pad = p + 1 - ds.len
    while pad > 0 {
        (mut all).push(48 as byte)
        pad -= 1
    }
    for d in ds {
        (mut all).push(d)
    }
    var r = List[byte]()
    let cut = all.len - p
    var i = 0
    while i < cut {
        (mut r).push(all[i])
        i += 1
    }
    if p > 0 || alt {
        (mut r).push(46 as byte)
    }
    while i < all.len {
        (mut r).push(all[i])
        i += 1
    }
    r
}

/// The `p + 1` significant digits of `v` rounded half to even, and its
/// decimal exponent after the rounding.
struct Sci {
    ds: List[byte],
    x10: int,
}

fn sci(v: Flt, p: int) -> Sci {
    if v.m.len == 0 {
        var z = List[byte]()
        var k = 0
        while k <= p {
            (mut z).push(48 as byte)
            k += 1
        }
        return Sci { ds: z, x10: 0 }
    }
    let lo = bn_pow(10, p)
    let hi = bn_pow(10, p + 1)
    var x10 = floor_div((bn_bitlen(v.m) - 1 + v.e) * 30102999566, 100000000000)
    var d = scaled_dec(v, p - x10)
    var tries = 0
    while tries < 8 {
        if bn_cmp(d, hi) >= 0 {
            x10 += 1
        } else if bn_cmp(d, lo) < 0 {
            x10 -= 1
        } else {
            break
        }
        d = scaled_dec(v, p - x10)
        tries += 1
    }
    Sci { ds: bn_dec(d), x10: x10 }
}

/// `v * 10^k`, rounded half to even.
fn scaled_dec(v: Flt, k: int) -> List[int] {
    var num = copy v.m
    var den = bn_of(1)
    if k >= 0 {
        num = bn_mul(num, bn_pow(10, k))
    } else {
        den = bn_pow(10, 0 - k)
    }
    if v.e >= 0 {
        num = bn_shl(num, v.e)
    } else {
        den = bn_shl(den, 0 - v.e)
    }
    bn_div_round(num, den).q
}

fn exp_text(x10: int, upper: bool) -> str {
    let e = if upper then "E" else "e"
    var n = x10
    var sign = "+"
    if n < 0 {
        sign = "-"
        n = 0 - n
    }
    if n < 10 {
        return "{e}{sign}0{n}"
    }
    "{e}{sign}{n}"
}

fn fmt_e(v: Flt, p: int, alt: bool, upper: bool) -> List[byte] {
    let s = sci(v, p)
    var r = List[byte]()
    (mut r).push(s.ds[0])
    if p > 0 || alt {
        (mut r).push(46 as byte)
    }
    var i = 1
    while i < s.ds.len {
        (mut r).push(s.ds[i])
        i += 1
    }
    push_str(mut r, exp_text(s.x10, upper))
    r
}

fn fmt_g(v: Flt, prec: int, alt: bool, upper: bool) -> List[byte] {
    var p = prec
    if p < 0 {
        p = 6
    }
    if p == 0 {
        p = 1
    }
    var x10 = 0
    if v.m.len > 0 {
        x10 = sci(v, p - 1).x10
    }
    var r = List[byte]()
    var tail = List[byte]()
    if x10 < p && x10 >= -4 {
        r = fmt_f(v, p - 1 - x10, alt)
    } else {
        let s = sci(v, p - 1)
        (mut r).push(s.ds[0])
        if p - 1 > 0 || alt {
            (mut r).push(46 as byte)
        }
        var i = 1
        while i < s.ds.len {
            (mut r).push(s.ds[i])
            i += 1
        }
        push_str(mut tail, exp_text(s.x10, upper))
    }
    if !alt {
        var has_point = false
        for d in r {
            if d as int == 46 {
                has_point = true
            }
        }
        if has_point {
            var n = r.len
            while n > 0 && r[n - 1] as int == 48 {
                n -= 1
            }
            if n > 0 && r[n - 1] as int == 46 {
                n -= 1
            }
            var cut = List[byte]()
            var i = 0
            while i < n {
                (mut cut).push(r[i])
                i += 1
            }
            r = cut
        }
    }
    for d in tail {
        (mut r).push(d)
    }
    r
}


fn mantissa(n: wrapping[u64]) -> List[int] {
    var result = List[int](), v = n
    while v != 0 { (mut result).push((v & 16777215) as int); v = v >> 24 }
    result
}
fn same(a: Flt, b: Flt) -> bool { a.kind == b.kind && a.neg == b.neg && (a.kind != 0 || a.m.len == 0 && b.m.len == 0 || a.e == b.e && bn_cmp(a.m, b.m) == 0) }

/// Render an IEEE binary16/bfloat16/binary32/binary64/x87 value using
/// the smallest %g precision that reads back to its value. GNU formats
/// both 16-bit formats via binary32, rather than 16-bit round trips.
/// kind is 2 (binary16), 3 (bfloat16), 4, 8 or 16 (x87 storage).
pub fn shortest(raw: List[byte], kind: int, big: bool) -> str {
    var data = List[byte]()
    for k in 0..raw.len { (mut data).push(raw[if big then raw.len - k - 1 else k]) }
    var bits: wrapping[u64] = 0
    let count = if data.len < 8 then data.len else 8
    for k in 0..count { bits |= (data[k] as wrapping[u64]) << (8 * k) as wrapping[u64] }
    var h = Host { mant: 24, emin_lsb: -149, emax: 127 }
    var negative = false, exponent = 0, fraction: wrapping[u64] = 0, special = 0, shift = 0
    if kind == 16 {
        h = Host { mant: 64, emin_lsb: -16445, emax: 16383 }
        let tag = data[8] as int + 256 * data[9] as int
        negative = tag >= 32768
        exponent = tag % 32768
        fraction = bits
        let integer = bits >> 63 != 0
        if exponent == 32767 { special = if bits == 9223372036854775808 then 1 else 2 } else if exponent > 0 && !integer { special = 2 }
        shift = (if exponent == 0 then 1 else exponent) - 16383 - 63
    } else {
        var fracbits = 23, expbits = 8, bias = 127
        if kind == 8 { fracbits = 52; expbits = 11; bias = 1023; h = Host { mant: 53, emin_lsb: -1074, emax: 1023 } }
        if kind == 2 { fracbits = 10; expbits = 5; bias = 15 }
        if kind == 3 { fracbits = 7 }
        let expmask = (1 << expbits) - 1
        negative = bits >> (fracbits + expbits) as wrapping[u64] != 0
        exponent = ((bits >> fracbits as wrapping[u64]) & expmask as wrapping[u64]) as int
        fraction = bits & ((1 as wrapping[u64] << fracbits as wrapping[u64]) - 1)
        if exponent == expmask { special = if fraction == 0 then 1 else 2 } else if exponent > 0 { fraction |= 1 as wrapping[u64] << fracbits as wrapping[u64] }
        shift = (if exponent == 0 then 1 else exponent) - bias - fracbits
    }
    if special == 2 { return if negative then "-nan" else "nan" }
    if special == 1 { return if negative then "-inf" else "inf" }
    let exact = Lex { kind: 0, neg: negative, m: mantissa(fraction), e: shift, hex: true, ndig: 0, start: 0, end: 0 }
    let v = to_host(exact, h).v
    let maxdigits = if kind == 16 then 21 else if kind == 8 then 17 else 9
    for p in 1..maxdigits + 1 {
        var candidate = fmt_g(v, p, false, false)
        if negative { var signed = "-".bytes(); for b in candidate { (mut signed).push(b) }; candidate = signed }
        let converted = to_host(lex_float(candidate), h).v
        if same(v, converted) { return str_from_utf8(candidate) else "?" }
    }
    "?"
}
