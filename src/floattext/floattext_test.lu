//! Exact dyadic controls, independent of GNU output expectations.
fn test_exact_rounding_modes() {
    let x = parse_number("1.25") else { assert(false, "decimal parse"); return }
    assert(fixed(x, 1, 0) == "1.3", "away from zero")
    assert(fixed(x, 1, 1) == "1.2", "towards zero")
    assert(fixed(x, 1, 4) == "1.3", "nearest away tie")
    assert(fixed(x, 1, 5) == "1.2", "nearest even tie")
    assert(fixed(product(x, integer(100)), 0, 0) == "125", "exact product")
    assert(fixed(quotient(x, integer(2)), 3, 0) == "0.625", "exact quotient")
    let zero = parse_number("-0.0") else { assert(false, "negative zero parse"); return }
    assert(fixed(zero, 2, 0) == "0.00", "numfmt clears a rounded zero sign")
}
fn test_ieee_float_spelling() {
    let single: List[byte] = [0, 0, 128, 63]
    let negative_zero: List[byte] = [0, 0, 0, 128]
    let subnormal: List[byte] = [1, 0, 0, 0]
    assert(shortest(single, 4, false) == "1", "binary32 one")
    assert(shortest(negative_zero, 4, false) == "-0", "od preserves zero sign")
    assert(shortest(subnormal, 4, false) == "1e-45", "shortest subnormal")
}
