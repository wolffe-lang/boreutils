//! Expr's anchored first-submatch adapter to scent b6f63a4.
//! Original engine files remain unmodified (apart from the origin notice).
//! This adapter retains SAVE instructions even without a backreference,
//! and exposes capture 1. POSIX BRE semantics; GNU 9.11 expr is the oracle.

struct PrefixCapture { end: int, caps: Captures }

/// Result of a BRE anchored at byte zero, including an empty match.
pub struct PrefixMatch { matched: bool, length: int, group: bool, text: List[byte] }

fn capture_prefix_at(
    re: Regex,
    mut ws: Workspace,
    root: int,
    bytes: List[byte],
    lo: int,
    hi: int,
    origin: int,
    nonempty: bool,
    any_match: bool,
) -> PrefixCapture {
    ws.depth = 0
    branch_push(mut ws, root, origin, captures_new())
    var best = -1, winning = captures_new()
    while ws.depth > 0 {
        let top = ws.depth - 1
        let pc = ws.branches[top].pc
        let pos = ws.branches[top].pos
        let inst = copy re.prog[pc]
        let stage = ws.branches[top].stage
        if stage > 0 {
            if inst.op == SPLIT && stage == 1 {
                ws.branches[top].stage = 2
                let caps = copy ws.branches[top].caps
                branch_push(mut ws, inst.y, pos, caps)
            } else {
                ws.depth -= 1
            }
            continue
        }
        var ancestor = top
        var cycle = false
        while ancestor > 0 {
            ancestor -= 1
            if ws.branches[ancestor].pos != pos { break }
            if ws.branches[ancestor].pc == pc &&
                captures_equal(ws.branches[ancestor].caps, ws.branches[top].caps) {
                cycle = true
                break
            }
        }
        if cycle { ws.depth -= 1; continue }
        ws.branches[top].stage = 1
        var caps = copy ws.branches[top].caps
        if inst.op == ACCEPT {
            if (!nonempty || pos > origin) &&
                (!re.options.whole || pos == hi) &&
                (!re.options.word || re.options.whole || pos == hi || !is_word(bytes[pos] as int)) {
                if pos > best ||
                    pos == best &&
                        (
                            capture_get(caps, 2) >= 0 &&
                                (
                                    capture_get(winning, 2) < 0 ||
                                        capture_get(caps, 2) < capture_get(winning, 2) ||
                                        capture_get(caps, 2) == capture_get(winning, 2) &&
                                            capture_get(caps, 3) > capture_get(winning, 3)
                                )
                        ) {
                    best = pos
                    winning = copy caps
                }
            }
        } else if inst.op == SPLIT || inst.op == JUMP {
            branch_push(mut ws, inst.x, pos, caps)
        } else if inst.op == SAVE {
            capture_set(mut caps, inst.arg, pos)
            branch_push(mut ws, inst.x, pos, caps)
        } else if inst.op == REF {
            let end = reference_end(re, inst, caps, bytes, pos, hi)
            if end >= 0 { branch_push(mut ws, inst.x, end, caps) }
        } else if inst.op >= BOL && inst.op <= WORD_END {
            if assertion(inst.op, bytes, lo, hi, pos) { branch_push(mut ws, inst.x, pos, caps) }
        } else if pos < hi && consumes(re, inst, bytes[pos]) {
            branch_push(mut ws, inst.x, pos + 1, caps)
        }
    }
    PrefixCapture { end: best, caps: winning }
}

/// Compile one BRE with capture retention and match at byte zero.
pub fn match_prefix(
    pattern: List[byte],
    bytes: List[byte],
    mut diagnostics: Diagnostics,
) -> PrefixMatch ! {invalid} {
    let options = Options {
        extended: false,
        icase: false,
        word: false,
        whole: false,
        terminator: 0 as byte,
    }
    var parsed = parse(pattern, options, mut diagnostics, 0)
    if parsed.failed { return invalid }
    let groups = parsed.group
    parsed.has_ref = true
    var re = Regex {
        options: options,
        prog: List[Inst](),
        classes: copy parsed.classes,
        starts: List[int](),
        span_starts: List[int](),
        backrefs: List[bool](),
        verify: List[bool](),
    }
    let end = emit(mut re.prog, ACCEPT, 0, 0, 0)
    let root = compile_tree(mut re.prog, parsed, 0, end)
    var ws = workspace_new(re)
    let found = capture_prefix_at(re, mut ws, root, bytes, 0, bytes.len, 0, false, false)
    var text = List[byte]()
    let start = capture_get(found.caps, 2), stop = capture_get(found.caps, 3)
    if found.end >= 0 && start >= 0 && stop >= start {
        for k in start..stop { (mut text).push(bytes[k]) }
    }
    PrefixMatch {
        matched: found.end >= 0,
        length: if found.end >= 0 then found.end else 0,
        group: groups > 0,
        text: text,
    }
}
