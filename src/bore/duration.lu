//! A DURATION as GNU's `sleep` and `timeout` read one (bu27, moved here
//! from `sleep.lu`, where bu-lanes measured it against GNU 9.11 on both
//! hosts; `timeout` reads the same grammar, measured again by bu27).
//!
//! References consulted: C's `strtod` grammar (C17 7.22.1.3) for what a
//! NUMBER is; GNU coreutils 9.11 `sleep --help` and `timeout --help`, and
//! black-box runs of the GNU binaries. Never GNU source.
//!
//! - A `strtod` number — leading white space, a sign, decimal digits with
//!   an optional point and exponent, a `0x` hex float with an optional `p`
//!   exponent, or `inf`/`infinity` in any case — followed by at most ONE
//!   of `s`, `m`, `h`, `d`, lower case only. Anything left over, a NaN, an
//!   upper-case unit, a comma and a negative value are invalid. `-0` is
//!   not negative. In a hex number `d` is a digit, so `0x1d` is 29 seconds.
//! - A number too small for a double (`1e-400`) reads as 0, and `tiny`
//!   says that its digits were not all zero: GNU `timeout` takes such a
//!   duration as the shortest there is, never as 0 ("no timeout").

/// What a DURATION operand says: `secs` seconds (`duration_forever()` or
/// more for `inf` and for a sum too large to finish), and whether it is a
/// non-zero number too small for a double (`tiny`).
pub struct Duration {
    secs: f64,
    tiny: bool,
}

/// The stand-in for an infinite interval: any sum at or past it sleeps
/// until the process is killed. A finite `f64` on purpose, so no sum of
/// a few of them can overflow, and no infinity or NaN is ever computed.
pub fn duration_forever() -> f64 {
    1.0e300
}

/// The DURATION the operand `a` names, or `invalid`.
pub fn duration_of(a: str) -> Duration ! {invalid} {
    let b = a.bytes()
    var i = 0
    while i < b.len && is_space(b[i] as int) {
        i += 1
    }
    var neg = false
    if i < b.len && (b[i] as int == 43 || b[i] as int == 45) {
        neg = b[i] as int == 45
        i += 1
    }
    var value: f64 = 0.0
    var nonzero = false
    let inf = word_at(b, i)
    if inf > 0 {
        i += inf
        value = duration_forever()
        nonzero = true
    } else if is_hex_start(b, i) {
        let h = hex_number(b, i + 2)
        if h.end < 0 {
            return invalid
        }
        value = h.value
        nonzero = h.nonzero
        i = h.end
    } else {
        let d = dec_number(b, i)
        if d.end < 0 {
            return invalid
        }
        value = d.value
        nonzero = d.nonzero
        i = d.end
    }
    var scale: f64 = 1.0
    if i < b.len {
        let u = b[i] as int
        if u == 115 {
            scale = 1.0
        } else if u == 109 {
            scale = 60.0
        } else if u == 104 {
            scale = 3600.0
        } else if u == 100 {
            scale = 86400.0
        } else {
            return invalid
        }
        i += 1
    }
    if i != b.len {
        return invalid
    }
    if neg && value > 0.0 {
        return invalid
    }
    Duration { secs: value * scale, tiny: value == 0.0 && nonzero && !neg }
}

/// C's `isspace` in the C locale: space and `\t` through `\r`.
fn is_space(c: int) -> bool {
    c == 32 || c >= 9 && c <= 13
}

/// The length of `infinity` or `inf` at `b[i]`, in any case, or 0.
/// `nan` is not here on purpose: a NaN is never a time interval.
fn word_at(b: List[byte], i: int) -> int {
    if matches(b, i, "infinity") {
        return 8
    }
    if matches(b, i, "inf") {
        return 3
    }
    0
}

fn matches(b: List[byte], i: int, w: str) -> bool {
    let wb = w.bytes()
    if i + wb.len > b.len {
        return false
    }
    var k = 0
    while k < wb.len {
        var c = b[i + k] as int
        if c >= 65 && c <= 90 {
            c += 32
        }
        if c != wb[k] as int {
            return false
        }
        k += 1
    }
    true
}

/// Whether `0x` or `0X` followed by a hex digit or a point and a hex
/// digit starts at `b[i]`. Without one, `strtod` reads only the `0`.
fn is_hex_start(b: List[byte], i: int) -> bool {
    if i + 2 >= b.len || b[i] as int != 48 {
        return false
    }
    let x = b[i + 1] as int
    if x != 120 && x != 88 {
        return false
    }
    if hex_digit(b[i + 2] as int) >= 0 {
        return true
    }
    b[i + 2] as int == 46 && i + 3 < b.len && hex_digit(b[i + 3] as int) >= 0
}

/// A number, where it ends, and whether any of its digits was not 0;
/// `end` is -1 when nothing was read.
struct Num {
    value: f64,
    end: int,
    nonzero: bool,
}

fn dec_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    -1
}

fn hex_digit(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    -1
}

/// A decimal `strtod` number at `b[i]`: digits, an optional point and
/// digits (at least one digit in all), and an optional exponent that is
/// taken only when a digit follows its sign.
fn dec_number(b: List[byte], start: int) -> Num {
    var i = start
    var value: f64 = 0.0
    var digits = 0
    var exp10 = 0
    var nonzero = false
    while i < b.len && dec_digit(b[i] as int) >= 0 {
        value = value * 10.0 + dec_digit(b[i] as int) as f64
        nonzero = nonzero || dec_digit(b[i] as int) > 0
        digits += 1
        i += 1
    }
    if i < b.len && b[i] as int == 46 {
        i += 1
        while i < b.len && dec_digit(b[i] as int) >= 0 {
            value = value * 10.0 + dec_digit(b[i] as int) as f64
            nonzero = nonzero || dec_digit(b[i] as int) > 0
            exp10 -= 1
            digits += 1
            i += 1
        }
    }
    if digits == 0 {
        return Num { value: 0.0, end: -1, nonzero: false }
    }
    let e = exponent(b, i, 101, 69)
    if e.end > i {
        exp10 = clamp_add(exp10, e.exp)
        i = e.end
    }
    Num { value: ten_to(value, exp10), end: i, nonzero: nonzero }
}

/// A hex float at `b[i]`, after its `0x`: hex digits, an optional point
/// and hex digits, and an optional `p` binary exponent.
fn hex_number(b: List[byte], start: int) -> Num {
    var i = start
    var value: f64 = 0.0
    var exp2 = 0
    var digits = 0
    var nonzero = false
    while i < b.len && hex_digit(b[i] as int) >= 0 {
        value = value * 16.0 + hex_digit(b[i] as int) as f64
        nonzero = nonzero || hex_digit(b[i] as int) > 0
        digits += 1
        i += 1
    }
    if i < b.len && b[i] as int == 46 {
        i += 1
        while i < b.len && hex_digit(b[i] as int) >= 0 {
            value = value * 16.0 + hex_digit(b[i] as int) as f64
            nonzero = nonzero || hex_digit(b[i] as int) > 0
            exp2 -= 4
            digits += 1
            i += 1
        }
    }
    if digits == 0 {
        return Num { value: 0.0, end: -1, nonzero: false }
    }
    let e = exponent(b, i, 112, 80)
    if e.end > i {
        exp2 = clamp_add(exp2, e.exp)
        i = e.end
    }
    var v = value
    while exp2 > 0 && v < 1.0e300 {
        v = v * 2.0
        exp2 -= 1
    }
    if exp2 > 0 && v > 0.0 {
        v = duration_forever()
    }
    while exp2 < 0 && v > 0.0 {
        v = v / 2.0
        exp2 += 1
    }
    Num { value: v, end: i, nonzero: nonzero }
}

/// An exponent part: the marker (`lower` or `upper`), a sign, and at
/// least one decimal digit. `end` is `i` itself when there is none.
struct Exp {
    exp: int,
    end: int,
}

fn exponent(b: List[byte], i: int, lower: int, upper: int) -> Exp {
    if i >= b.len || b[i] as int != lower && b[i] as int != upper {
        return Exp { exp: 0, end: i }
    }
    var j = i + 1
    var neg = false
    if j < b.len && (b[j] as int == 43 || b[j] as int == 45) {
        neg = b[j] as int == 45
        j += 1
    }
    if j >= b.len || dec_digit(b[j] as int) < 0 {
        return Exp { exp: 0, end: i }
    }
    var e = 0
    while j < b.len && dec_digit(b[j] as int) >= 0 {
        if e < 100000000 {
            e = e * 10 + dec_digit(b[j] as int)
        }
        j += 1
    }
    if neg {
        e = -e
    }
    Exp { exp: e, end: j }
}

fn clamp_add(a: int, b: int) -> int {
    let s = a + b
    if s > 100000000 {
        return 100000000
    }
    if s < -100000000 {
        return -100000000
    }
    s
}

/// `v` times ten to the `e`, stopping early once the answer is zero or
/// past any sleep a process could finish.
fn ten_to(v: f64, e: int) -> f64 {
    var r = v
    var k = e
    while k > 0 && r > 0.0 && r < duration_forever() {
        r = r * 10.0
        k -= 1
    }
    if k > 0 && r > 0.0 {
        return duration_forever()
    }
    while k < 0 && r > 0.0 {
        r = r / 10.0
        k += 1
    }
    r
}
