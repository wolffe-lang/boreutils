//! Backup names from GNU 9.11's Backup options documentation and oracle
//! outputs. No implementation source. Numbered names are discovered by
//! listing the destination's parent; a link's own name is backed up.

/// 0 none, 1 simple, 2 numbered, 3 numbered if any exist, otherwise simple.
pub fn backup_kind(word: str) -> int {
    let choices = ["none", "off", "simple", "never", "numbered", "t", "existing", "nil"]
    let meanings = [0, 0, 1, 1, 2, 2, 3, 3]
    argmatch(word, choices, meanings)
}

/// VERSION_CONTROL, defaulting to numbered-if-existing; negative for invalid.
pub fn backup_default() -> int {
    let control = env_get("VERSION_CONTROL") else "existing"
    if control.len == 0 { return 3 }
    backup_kind(control)
}

/// The requested simple suffix, defaulting to a tilde.
pub fn backup_suffix() -> str {
    let value = env_get("SIMPLE_BACKUP_SUFFIX") else "~"
    if value.len == 0 then "~" else value
}

/// Choose the next name without changing any entry.
pub fn backup_name(path: str, kind: int, suffix: str) -> str {
    if kind == 0 { return "" }
    let bare = without_slashes(path)
    let cut = bare.rfind("/") else -1
    let dir = if cut < 0 then "." else (if cut == 0 then "/" else bare[0..cut])
    let name = if cut < 0 then bare else bare[cut + 1..]
    var largest = ""
    if kind == 2 || kind == 3 {
        let entries = fs_read_dir(dir) else List[str]()
        let prefix = "{name}.~"
        for entry in entries {
            if !entry.starts_with(prefix) || !entry.ends_with("~") || entry.len <= prefix.len + 1 {
                continue
            }
            let digits = entry[prefix.len..entry.len - 1]
            // GNU's observed version grammar excludes zero/leading zeros.
            if digits.bytes()[0] as int < 49 || digits.bytes()[0] as int > 57 { continue }
            var valid = true
            for b in digits.bytes() { if b as int < 48 || b as int > 57 { valid = false; break } }
            if valid &&
                (digits.len > largest.len || digits.len == largest.len && digits > largest) {
                largest = digits
            }
        }
    }
    if kind == 2 || largest.len > 0 { return "{bare}.~{backup_increment(largest)}~" }
    "{bare}{suffix}"
}

/// Report an invalid/ambiguous final backup control in GNU's option order.
pub fn backup_error(prog: str, word: str) -> int {
    let what = if backup_kind(word) == -2 then "ambiguous" else "invalid"
    eprint(
        "{prog}: {what} argument {quote(word)} for 'backup type'\nValid arguments are:\n  - 'none', 'off'\n  - 'simple', 'never'\n  - 'existing', 'nil'\n  - 'numbered', 't'\nTry '{prog} --help' for more information.",
    )
    1
}

// Versions are decimal names, not machine integers. The path limit, not
// int overflow, bounds their length.
fn backup_increment(digits: str) -> str {
    var reverse = List[byte]()
    var carry = 1
    var k = digits.len
    while k > 0 {
        k -= 1
        let n = digits.bytes()[k] as int - 48 + carry
        carry = n / 10
        (mut reverse).push((48 + n % 10) as byte)
    }
    if carry > 0 { (mut reverse).push(49 as byte) }
    var result = List[byte]()
    k = reverse.len
    while k > 0 { k -= 1; (mut result).push(reverse[k]) }
    str_from_utf8(result) else "1"
}
