//! paths — a path made canonical: absolute, with no `.`, no `..` and no
//! symbolic link in it.
//!
//! This walk also supports realpath's lexical and missing modes beyond
//! fs_realpath (added in 0.2.34): `fs_lstat` says
//! what a component is and `fs_read_link` where a link leads (s218), so
//! the walk is written here, one component at a time, as POSIX
//! describes pathname resolution. `readlink -f`, `-e` and `-m` are its
//! three modes, and `stat`'s `%m` stands on it.
//!
//! Measured black-box against GNU `readlink` 9.11 (kasumi
//! `~/lanes/bu20/probe6.sh`):
//!
//! - `existing` (`-e`): every component must exist.
//! - `all_but_last` (`-f`): the LAST component may be missing (`nope`,
//!   and `nope/` too), no other; a file followed by a slash or by
//!   anything is `Not a directory`.
//! - `missing` (`-m`): nothing need exist. Missing or non-directory
//!   prefixes are taken lexically until `..` returns to an existing
//!   directory, where link resolution resumes (bu30 regression twins
//!   in readlink and realpath).
//! - An empty path is `No such file or directory` in every mode.
//! - Forty links is the limit (`Too many levels of symbolic links`).
//!
//! **What this cannot do, named:** a link whose target is not UTF-8
//! (wolf-lang#687: a path is a `str`) ends the walk as unreadable.
//!
//! References consulted: POSIX.1-2024 XBD 4.16 (pathname resolution) and
//! `realpath()`; GNU coreutils 9.11's manual (`readlink invocation`,
//! `realpath invocation`) and black-box runs. Never GNU or glibc source.

/// What a walk answered: the canonical path, or why there is none (the
/// host's words for the component that stopped it).
pub struct Resolved {
    ok: bool,
    path: str,
    why: str,
}

/// Every component must exist (`readlink -e`).
pub fn existing() -> int {
    0
}

/// Every component but the last must exist (`readlink -f`).
pub fn all_but_last() -> int {
    1
}

/// No component need exist (`readlink -m`).
pub fn missing() -> int {
    2
}

fn stopped(why: str) -> Resolved {
    Resolved { ok: false, path: "", why: why }
}

/// The components on `stack` as one absolute path.
fn joined(stack: List[str]) -> str {
    if stack.len == 0 {
        return "/"
    }
    var bytes = List[byte]()
    for c in stack {
        (mut bytes).push(47 as byte)
        for b in c.bytes() {
            (mut bytes).push(b)
        }
    }
    str_from_utf8(bytes) else "/"
}

/// Whether any real component is left in `rest` from `from` on.
fn more_after(rest: List[str], from: int) -> bool {
    var k = from
    while k < rest.len {
        if rest[k].len > 0 {
            return true
        }
        k += 1
    }
    false
}

/// `path` made canonical under `mode` (`existing`, `all_but_last` or
/// `missing`).
pub fn canonical(path: str, mode: int) -> Resolved {
    if path.len == 0 {
        return stopped("No such file or directory")
    }
    var stack = List[str]()
    if !path.starts_with("/") {
        let cwd = os_cwd() else |_| {
            return stopped("No such file or directory")
        }
        for c in cwd.split("/") {
            if c.len > 0 {
                (mut stack).push(c)
            }
        }
    }
    var rest = List[str]()
    for c in path.split("/") {
        (mut rest).push(c)
    }
    var trailing = path.ends_with("/")
    var links = 0
    var lexical = false
    var lexical_depth = 0
    var i = 0
    while i < rest.len {
        let c = rest[i]
        i += 1
        if c.len == 0 || c == "." {
            continue
        }
        if c == ".." {
            let _ = (mut stack).pop() else ""
            if lexical && stack.len < lexical_depth { lexical = false }
            continue
        }
        if lexical {
            (mut stack).push(c)
            continue
        }
        let here = joined(stack)
        let candidate = if here == "/" then "/{c}" else "{here}/{c}"
        let more = more_after(rest, i)
        var code = 0
        let rec = fs_lstat(candidate) else |_| {
            code = os_error()
            List[int]()
        }
        if rec.len != 20 {
            if mode == missing() {
                (mut stack).push(c)
                lexical = true
                lexical_depth = stack.len
                continue
            }
            // ENOENT, and nothing after it: the one component -f lets
            // be missing.
            if mode == all_but_last() && !more && code == 2 {
                (mut stack).push(c)
                continue
            }
            if code == 0 {
                return stopped("Input/output error")
            }
            return stopped(os_error_text(code))
        }
        if rec[0] == 3 {
            links += 1
            if links > 40 {
                if mode == missing() {
                    (mut stack).push(c)
                    lexical = true
                    lexical_depth = stack.len
                    continue
                }
                return stopped("Too many levels of symbolic links")
            }
            let bytes = fs_read_link(candidate) else |_| {
                return stopped(os_error_text(os_error()))
            }
            let target = str_from_utf8(bytes) else |_| {
                return stopped("Invalid or incomplete multibyte or wide character")
            }
            if target.ends_with("/") && !more_after(rest, i) {
                trailing = true
            }
            if target.starts_with("/") {
                stack = List[str]()
            }
            var next = List[str]()
            for t in target.split("/") {
                (mut next).push(t)
            }
            while i < rest.len {
                (mut next).push(rest[i])
                i += 1
            }
            rest = next
            i = 0
            continue
        }
        if rec[0] != 1 && (more || trailing) {
            if mode == missing() {
                (mut stack).push(c)
                lexical = true
                lexical_depth = stack.len
                continue
            }
            return stopped("Not a directory")
        }
        (mut stack).push(c)
    }
    Resolved { ok: true, path: joined(stack), why: "" }
}

/// The directory part of an absolute canonical path (`/` for `/x`).
pub fn parent_of(path: str) -> str {
    let cut = path.rfind("/") else 0
    if cut <= 0 {
        return "/"
    }
    path[0..cut]
}
