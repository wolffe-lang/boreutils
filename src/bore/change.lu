//! change — what the programs that change the file system share: the
//! refusals that keep `rm` from the root and from `.`, how a name is
//! joined to a directory, and the question a program asks before it
//! overwrites or removes.
//!
//! References consulted: POSIX.1-2024 `rm` (the `.` and `..` rule, the
//! prompt and its affirmative response) and XBD 4.16 (pathname
//! resolution: a trailing slash follows a link); GNU coreutils 9.11's
//! manual (`rm invocation`, "Treating / specially") and black-box runs
//! of its `rm`, `mv` and `cp` in scratch directories. Never GNU source.
//!
//! **The root rule is a function, tested as one — and run as a
//! program only where `/` is disposable.** No test in this repository
//! runs any `rm`, this one or GNU's, on a HOST's `/`: a test of a
//! refusal whose failure is the loss of the machine is not a test
//! anyone should run. `names_root` and `rm_verdict` are exercised by
//! `src/change_test.lu` on `/`, `//`, `/.` and `/dev/..`, which costs
//! one `lstat` each; and `tools/roottest` runs the built `rm` on `/`
//! itself, on both tiers, in a throwaway container with no mount and
//! no network, as a user and as root inside it, beside GNU's
//! (`tests/root/cases.toml`).

/// Whether two stat records describe one file: the same device and the
/// same inode (`[os.fs.stat]`, words 9 and 10).
pub fn same_file(a: List[int], b: List[int]) -> bool {
    a[9] == b[9] && a[10] == b[10]
}

/// Whether `path` names the root directory: its record, read WITHOUT
/// following a final link, is `/`'s. So `/`, `//`, `/.` and `/usr/..`
/// are the root; a link to `/` is a link, and is not — but the same
/// link with a trailing slash is, because the host resolves it
/// (measured: `fs_lstat("l/")` answers the target's record).
///
/// This is how GNU's `--preserve-root` decides (documented: "fail upon
/// any attempt to remove the root directory"), and it is the only
/// spelling-proof test there is. A path that cannot be described at
/// all is not the root.
pub fn names_root(path: str) -> bool {
    let root = fs_lstat("/") else |_| {
        // Unanswerable: say yes, so that nothing is removed on a guess.
        return true
    }
    let rec = fs_lstat(path) else |_| {
        return false
    }
    same_file(rec, root)
}

/// Whether `rec` is the root directory's own record. The second fence:
/// the recursive walk asks it of every directory it is about to enter.
pub fn record_is_root(rec: List[int]) -> bool {
    let root = fs_lstat("/") else |_| {
        return true
    }
    same_file(rec, root)
}

/// Whether the last component of `path` — trailing slashes aside — is
/// `.` or `..`. POSIX forbids `rm` either as an operand, and GNU skips
/// one with `refusing to remove '.' or '..' directory`.
pub fn dot_name(path: str) -> bool {
    var end = path.len
    while end > 0 && path[end - 1..end] == "/" {
        end -= 1
    }
    var start = end
    while start > 0 && path[start - 1..start] != "/" {
        start -= 1
    }
    let last = path[start..end]
    last == "." || last == ".."
}

/// What `rm` must do with one operand before it looks any further.
pub fn rm_go() -> int {
    0
}

/// The operand is `.` or `..`: skip it and say so.
pub fn rm_refuse_dot() -> int {
    1
}

/// The operand is the root directory: refuse it and say so.
pub fn rm_refuse_root() -> int {
    2
}

/// `rm`'s decision for one operand, before any record is read for
/// removal. Only a recursive `rm` is fenced: without `-r` the host
/// itself refuses a directory, and GNU says only what the host said.
/// The root is refused whenever `preserve` holds — and this `rm` never
/// lets it not hold.
pub fn rm_verdict(path: str, recursive: bool, preserve: bool) -> int {
    if !recursive {
        return rm_go()
    }
    if dot_name(path) {
        return rm_refuse_dot()
    }
    if preserve && names_root(path) {
        return rm_refuse_root()
    }
    rm_go()
}

/// `name` inside the directory `dir`, as GNU spells it in a message:
/// one slash between them unless `dir` already ends in one.
pub fn join_name(dir: str, name: str) -> str {
    if name == "/" && dir.ends_with("/") {
        // The root moved or copied into a directory named with a slash
        // is that directory (measured in a container: `mv / /` is `'/'
        // and '/' are the same file`).
        return dir
    }
    if dir.ends_with("/") {
        return "{dir}{name}"
    }
    "{dir}/{name}"
}

/// `path` without its trailing slashes; `/` (and `//`) stay `/`.
pub fn without_slashes(path: str) -> str {
    var end = path.len
    while end > 1 && path[end - 1..end] == "/" {
        end -= 1
    }
    path[0..end]
}

/// The last component of `path`, trailing slashes dropped: what `mv`
/// and `cp` call a source inside a directory it is moved or copied to.
/// `a/b/` is `b`; `/` is `/`; `.` is `.`.
pub fn last_name(path: str) -> str {
    let bare = without_slashes(path)
    var start = bare.len
    while start > 0 && bare[start - 1..start] != "/" {
        start -= 1
    }
    if start == bare.len {
        return bare
    }
    bare[start..]
}

/// Read one line of standard input and answer whether it is a yes: its
/// first byte is `y` or `Y` (POSIX's affirmative response in the POSIX
/// locale; measured against GNU 9.11: `yes` and `Y` are, ` y` and the
/// end of input are not). The whole line is consumed, a byte at a time,
/// so the next question reads the next line and nothing is taken from
/// whoever reads standard input after this program.
pub fn said_yes() -> bool {
    var first = -1
    var seen = 0
    loop {
        var b = -1
        region one {
            let chunk = fs_read_chunk(0, 1) else |_| {
                List[byte]()
            }
            if chunk.len == 1 {
                b = chunk[0] as int
            }
        }
        if b < 0 || b == 10 {
            break
        }
        if seen == 0 {
            first = b
        }
        seen += 1
    }
    first == 121 || first == 89
}

/// The indices of `keys` in ascending order of key, equal keys in
/// their first order: a merge sort, so a hundred thousand entries cost
/// a hundred thousand times seventeen comparisons and not their
/// square. `cp -r` copies a directory's entries in the order of their
/// inode numbers, as GNU's does (measured: on ext4 and APFS, where the
/// directory's own order is neither that nor the names').
pub fn order_by(keys: List[int]) -> List[int] {
    var idx = List[int]()
    var i = 0
    while i < keys.len {
        (mut idx).push(i)
        i += 1
    }
    var width = 1
    while width < idx.len {
        var next = List[int]()
        var lo = 0
        while lo < idx.len {
            // (Not the prelude's `min`: the native tiers refuse it at
            // 0.2.27, "a std/prelude stub without a signature".)
            var mid = lo + width
            if mid > idx.len {
                mid = idx.len
            }
            var hi = lo + 2 * width
            if hi > idx.len {
                hi = idx.len
            }
            var a = lo
            var b = mid
            while a < mid && b < hi {
                if keys[idx[b]] < keys[idx[a]] {
                    (mut next).push(idx[b])
                    b += 1
                } else {
                    (mut next).push(idx[a])
                    a += 1
                }
            }
            while a < mid {
                (mut next).push(idx[a])
                a += 1
            }
            while b < hi {
                (mut next).push(idx[b])
                b += 1
            }
            lo = hi
        }
        idx = next
        width = width * 2
    }
    idx
}
