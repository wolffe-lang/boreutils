//! clock — an instant as a civil date and time, in the zone `TZ` names.
//!
//! `ls -l` and `stat` print a file's times in local time. wolf has no
//! `localtime`, and needs none: the zone is a file, in the TZif format
//! (RFC 8536), and this module reads it. The rule, as the C library
//! applies it, measured black-box against GNU 9.11 on glibc:
//!
//! - `TZ` unset: `/etc/localtime`. `TZ` empty: UTC.
//! - `TZ=NAME` or `TZ=:NAME`: the file `NAME` under `/usr/share/zoneinfo`
//!   (on linux under `TZDIR` when that is set: it is glibc's variable),
//!   or `NAME` itself when it starts with `/`.
//! - no such file: `NAME` read as a POSIX rule (`UTC0`, `EST5EDT`,
//!   `<+0330>-3:30`, `CET-1CEST,M3.5.0,M10.5.0/3`); a rule that cannot
//!   be read is UTC.
//!
//! A TZif file lists the instants its offset changed, and since 2020
//! most stop at the last change of RULE and carry a POSIX rule in a
//! footer for everything after it, so the footer is read too.
//!
//! Leap-second corrections in right/ zones remain uninterpreted.
//! date rejects such tables explicitly; older callers retain their
//! documented limit. Zone abbreviations are retained for date %Z.
//!
//! References consulted: RFC 8536 (the TZif format); POSIX.1-2024 XBD
//! 8.3 (the `TZ` variable); the days-from-civil arithmetic is the
//! well-known proleptic-Gregorian one. Never GNU or glibc source.

/// An instant broken into a date and a time of day, with the offset
/// from UTC (seconds east) it was broken at.
pub struct Civil {
    year: int,
    month: int,
    day: int,
    hour: int,
    minute: int,
    second: int,
    offset: int,
}

/// One end of a daylight-saving rule: `form` 0 is `Mm.w.d`, 1 is `Jn`
/// (a day of the year that never counts February 29), 2 is `n` (a day
/// of the year from zero); `secs` is the local time of day it happens.
struct Edge {
    form: int,
    month: int,
    week: int,
    day: int,
    secs: int,
}

/// A POSIX `TZ` rule: the offsets are seconds EAST of UTC.
struct Rule {
    ok: bool,
    std: int,
    dst: int,
    has_dst: bool,
    standard_name: str,
    daylight_name: str,
    start: Edge,
    end: Edge,
}

/// A time zone: the instants its offset changed, the offset in force
/// from each, the offset before the first, and the rule after the last.
pub struct Zone {
    times: List[int],
    offsets: List[int],
    names: List[str],
    first_name: str,
    leap_table: bool,
    first: int,
    rule: Rule,
}

fn no_edge() -> Edge {
    Edge { form: 0, month: 0, week: 0, day: 0, secs: 0 }
}

fn no_rule() -> Rule {
    Rule {
        ok: false,
        std: 0,
        dst: 0,
        has_dst: false,
        standard_name: "UTC",
        daylight_name: "",
        start: no_edge(),
        end: no_edge(),
    }
}

/// UTC: no change, no offset.
pub fn utc() -> Zone {
    Zone {
        times: List[int](),
        offsets: List[int](),
        names: List[str](),
        first_name: "UTC",
        leap_table: false,
        first: 0,
        rule: no_rule(),
    }
}

/// Whether `TZ` is not in the environment at all.
fn tz_unset() -> bool {
    let _ = env_get("TZ") else |e| match e {
        missing => { return true },
        utf8 => { return false },
    }
    false
}

/// The zone the environment names (see the header).
pub fn zone() -> Zone {
    if tz_unset() {
        return zone_file("/etc/localtime", "")
    }
    var name = env_get("TZ") else ""
    if name.starts_with(":") {
        name = name[1..]
    }
    if name.len == 0 {
        return utc()
    }
    if name.starts_with("/") {
        return zone_file(name, name)
    }
    // `TZDIR` is the GNU C library's variable, so it is read where that
    // library is the host's.
    var dir = "/usr/share/zoneinfo"
    if built_for_linux() {
        dir = env_get("TZDIR") else "/usr/share/zoneinfo"
    }
    zone_file("{dir}/{name}", name)
}

/// The zone the TZif file at `path` describes; when there is no such
/// file, or it is not one, `rule` read as a POSIX rule, else UTC.
fn zone_file(path: str, rule: str) -> Zone {
    var z = utc()
    var read = false
    // A zone name is a path under the zone directory, so a directory
    // (`TZ=America`) is asked for too, and is not a file to read.
    if fs_is_file(path) {
        let bytes = fs_read_bytes(path) else |_| {
            List[byte]()
        }
        read = parse_tzif(mut z, bytes)
    }
    if !read {
        z = utc()
        z.rule = parse_rule(rule)
        if z.rule.ok {
            z.first = z.rule.std
            z.first_name = z.rule.standard_name
        }
    }
    z
}

/// A big-endian unsigned 32-bit word of `b` at `at`.
fn be32u(b: List[byte], at: int) -> int {
    b[at] as int * 16777216 + b[at + 1] as int * 65536 + b[at + 2] as int * 256 + b[at + 3] as int
}

/// A big-endian signed 32-bit word.
fn be32(b: List[byte], at: int) -> int {
    let v = be32u(b, at)
    if v >= 2147483648 {
        return v - 4294967296
    }
    v
}

/// A big-endian signed 64-bit word.
fn be64(b: List[byte], at: int) -> int {
    be32(b, at) * 4294967296 + be32u(b, at + 4)
}

fn magic(b: List[byte], at: int) -> bool {
    b.len >= at + 44 &&
        b[at] as int == 84 &&
        b[at + 1] as int == 90 &&
        b[at + 2] as int == 105 &&
        b[at + 3] as int == 102
}

/// Fill `z` from a TZif file's bytes. False when they are not one.
fn parse_tzif(mut z: Zone, b: List[byte]) -> bool {
    if !magic(b, 0) {
        return false
    }
    let version = b[4] as int
    var at = 0
    var wide = 4
    if version >= 50 {
        // The 64-bit block follows the whole 32-bit one.
        let body = be32u(b, 32) * 5 +
            be32u(b, 36) * 6 +
            be32u(b, 40) +
            be32u(b, 28) * 8 +
            be32u(b, 24) +
            be32u(b, 20)
        at = 44 + body
        wide = 8
        if !magic(b, at) {
            return false
        }
    }
    let isut = be32u(b, at + 20)
    let isstd = be32u(b, at + 24)
    let leaps = be32u(b, at + 28)
    let timecnt = be32u(b, at + 32)
    let typecnt = be32u(b, at + 36)
    let charcnt = be32u(b, at + 40)
    let times_at = at + 44
    let kinds_at = times_at + timecnt * wide
    let types_at = kinds_at + timecnt
    let tail = types_at + typecnt * 6 + charcnt + leaps * (wide + 4) + isstd + isut
    if typecnt == 0 || tail > b.len {
        return false
    }
    z.leap_table = leaps > 0
    var k = 0
    while k < timecnt {
        let kind = b[kinds_at + k] as int
        if kind >= typecnt {
            return false
        }
        if wide == 8 {
            (mut z.times).push(be64(b, times_at + k * 8))
        } else {
            (mut z.times).push(be32(b, times_at + k * 4))
        }
        (mut z.offsets).push(be32(b, types_at + kind * 6))
        (mut z.names).push(
            tzif_name(b, types_at + typecnt * 6, charcnt, b[types_at + kind * 6 + 5] as int),
        )
        k += 1
    }
    z.first = be32(b, types_at)
    z.first_name = tzif_name(b, types_at + typecnt * 6, charcnt, b[types_at + 5] as int)
    // The footer: a newline, a POSIX rule, a newline.
    if wide == 8 && tail < b.len && b[tail] as int == 10 {
        var end = tail + 1
        while end < b.len && b[end] as int != 10 {
            end += 1
        }
        let text = str_from_utf8(b[tail + 1..end]) else ""
        z.rule = parse_rule(text)
    }
    true
}

fn tzif_name(b: List[byte], at: int, count: int, index: int) -> str {
    if index >= count { return "" }
    var end = index
    while end < count && b[at + end] as int != 0 { end += 1 }
    str_from_utf8(b[at + index..at + end]) else ""
}

/// A cursor over a rule's bytes.
struct Scan {
    at: int,
    bad: bool,
}

fn peek(b: List[byte], s: Scan) -> int {
    if s.at < b.len {
        return b[s.at] as int
    }
    -1
}

/// Skip a zone name: `<...>`, or three or more letters.
fn skip_name(b: List[byte], mut s: Scan) {
    if peek(b, s) == 60 {
        while s.at < b.len && b[s.at] as int != 62 {
            s.at += 1
        }
        if s.at >= b.len {
            s.bad = true
            return
        }
        s.at += 1
        return
    }
    let from = s.at
    while s.at < b.len {
        let c = b[s.at] as int
        let letter = c >= 65 && c <= 90 || c >= 97 && c <= 122
        if !letter {
            break
        }
        s.at += 1
    }
    if s.at - from < 3 {
        s.bad = true
    }
}

/// A run of digits, or -1 when there is none.
fn number(b: List[byte], mut s: Scan) -> int {
    var n: int = 0
    var seen = 0
    while s.at < b.len {
        let d = b[s.at] as int - 48
        if d < 0 || d > 9 || seen > 6 {
            break
        }
        n = n * 10 + d
        seen += 1
        s.at += 1
    }
    if seen == 0 {
        s.bad = true
        return -1
    }
    n
}

/// `[+-]hh[:mm[:ss]]` as seconds, signed as written.
fn hms(b: List[byte], mut s: Scan) -> int {
    var sign = 1
    if peek(b, s) == 43 {
        s.at += 1
    } else if peek(b, s) == 45 {
        sign = -1
        s.at += 1
    }
    var total = number(b, mut s) * 3600
    if peek(b, s) == 58 {
        s.at += 1
        total += number(b, mut s) * 60
        if peek(b, s) == 58 {
            s.at += 1
            total += number(b, mut s)
        }
    }
    sign * total
}

/// One end of the daylight rule, with its optional `/time`.
fn edge(b: List[byte], mut s: Scan) -> Edge {
    var e = Edge { form: 2, month: 0, week: 0, day: 0, secs: 7200 }
    if peek(b, s) == 77 {
        s.at += 1
        e.form = 0
        e.month = number(b, mut s)
        if peek(b, s) != 46 {
            s.bad = true
            return e
        }
        s.at += 1
        e.week = number(b, mut s)
        if peek(b, s) != 46 {
            s.bad = true
            return e
        }
        s.at += 1
        e.day = number(b, mut s)
        if e.month < 1 || e.month > 12 || e.week < 1 || e.week > 5 || e.day > 6 {
            s.bad = true
        }
    } else if peek(b, s) == 74 {
        s.at += 1
        e.form = 1
        e.day = number(b, mut s)
    } else {
        e.day = number(b, mut s)
    }
    if peek(b, s) == 47 {
        s.at += 1
        e.secs = hms(b, mut s)
    }
    e
}

/// A POSIX `TZ` rule, `std offset [dst [offset] [,start[/time],end[/time]]]`.
/// The written offset is hours WEST, so it is negated here. A daylight
/// name with no dates takes the United States' (`M3.2.0,M11.1.0`), as
/// the C library does.
fn parse_rule(text: str) -> Rule {
    var r = no_rule()
    if text.len == 0 {
        return r
    }
    let b = text.bytes()
    var s = Scan { at: 0, bad: false }
    skip_name(b, mut s)
    r.standard_name = zone_label(text[0..s.at])
    if s.bad {
        return r
    }
    r.std = -hms(b, mut s)
    if s.bad {
        return r
    }
    if s.at >= b.len {
        r.ok = true
        return r
    }
    let name_start = s.at
    skip_name(b, mut s)
    r.daylight_name = zone_label(text[name_start..s.at])
    if s.bad {
        return r
    }
    r.has_dst = true
    r.dst = r.std + 3600
    if s.at < b.len && peek(b, s) != 44 {
        r.dst = -hms(b, mut s)
    }
    if s.at >= b.len {
        r.start = Edge { form: 0, month: 3, week: 2, day: 0, secs: 7200 }
        r.end = Edge { form: 0, month: 11, week: 1, day: 0, secs: 7200 }
        r.ok = !s.bad
        return r
    }
    if peek(b, s) != 44 {
        return r
    }
    s.at += 1
    r.start = edge(b, mut s)
    if peek(b, s) != 44 {
        return r
    }
    s.at += 1
    r.end = edge(b, mut s)
    r.ok = !s.bad && s.at == b.len
    r
}

/// `a / b` rounded toward minus infinity, for `b` > 0.
fn floor_div(a: int, b: int) -> int {
    let q = a / b
    if a % b < 0 {
        return q - 1
    }
    q
}

/// Days from 1970-01-01 to the civil date.
fn days_from_civil(year: int, month: int, day: int) -> int {
    let y = if month <= 2 then year - 1 else year
    let era = floor_div(y, 400)
    let yoe = y - era * 400
    let mp = if month > 2 then month - 3 else month + 9
    let doy = (153 * mp + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

fn leap(year: int) -> bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

fn month_days(year: int, month: int) -> int {
    if month == 2 {
        return if leap(year) then 29 else 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    31
}

/// The instant `e` happens in `year`, as seconds on a clock running at
/// offset zero (the caller subtracts the offset in force before it).
fn edge_secs(e: Edge, year: int) -> int {
    var days = 0
    if e.form == 0 {
        let first = days_from_civil(year, e.month, 1)
        // 1970-01-01 was a Thursday.
        let weekday = (first % 7 + 11) % 7
        var day = 1 + (e.day - weekday + 7) % 7 + (e.week - 1) * 7
        if day > month_days(year, e.month) {
            day -= 7
        }
        days = first + day - 1
    } else if e.form == 1 {
        days = days_from_civil(year, 1, 1) + e.day - 1
        if leap(year) && e.day >= 60 {
            days += 1
        }
    } else {
        days = days_from_civil(year, 1, 1) + e.day
    }
    days * 86400 + e.secs
}

/// The offset `r` puts in force at instant `t`.
///
/// One host difference, kept because the oracle is the host's: for a
/// rule given in `TZ` itself, macOS's C library applies daylight time
/// only from 1970 on and answers the standard offset for every instant
/// before the epoch, where the GNU C library applies the rule to every
/// year (measured: `TZ=AEST-10AEDT,M10.1.0,M4.1.0/3` in January 1902 is
/// `+1000` on macOS and `+1100` on linux; CI run 38115826824).
fn rule_offset(r: Rule, t: int) -> int {
    if !r.has_dst {
        return r.std
    }
    if t < 0 && !built_for_linux() {
        return r.std
    }
    let year = civil(t, r.std).year
    let start = edge_secs(r.start, year) - r.std
    let end = edge_secs(r.end, year) - r.dst
    if start < end {
        return if t >= start && t < end then r.dst else r.std
    }
    if t >= end && t < start then r.std else r.dst
}

/// Seconds east of UTC in `z` at instant `t` (seconds from the epoch).
pub fn zone_offset(z: Zone, t: int) -> int {
    let n = z.times.len
    if n == 0 {
        if z.rule.ok {
            return rule_offset(z.rule, t)
        }
        return z.first
    }
    if t < z.times[0] {
        return z.first
    }
    if t >= z.times[n - 1] && z.rule.ok {
        return rule_offset(z.rule, t)
    }
    // The last change at or before `t`.
    var lo = 0
    var hi = n - 1
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if z.times[mid] <= t {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    z.offsets[lo]
}

/// Instant `t` as a date and time on a clock `offset` seconds east of
/// UTC.
pub fn civil(t: int, offset: int) -> Civil {
    let local = t + offset
    let days = floor_div(local, 86400)
    let secs = local - days * 86400
    let z = days + 719468
    let era = floor_div(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    let month = if mp < 10 then mp + 3 else mp - 9
    var year = yoe + era * 400
    if month <= 2 {
        year += 1
    }
    Civil {
        year: year,
        month: month,
        day: day,
        hour: secs / 3600,
        minute: secs / 60 % 60,
        second: secs % 60,
        offset: offset,
    }
}

/// Instant `t` in zone `z`.
pub fn civil_in(z: Zone, t: int) -> Civil {
    civil(t, zone_offset(z, t))
}

/// A month's three-letter English name (the C locale's `%b`).
pub fn month_name(month: int) -> str {
    let names = "JanFebMarAprMayJunJulAugSepOctNovDec"
    if month < 1 || month > 12 {
        return "???"
    }
    names[month * 3 - 3..month * 3]
}

/// `n` in at least `width` digits, zero-filled.
pub fn zero_padded(n: int, width: int) -> str {
    var text = "{n}"
    while text.len < width {
        text = "0" + text
    }
    text
}

/// `n` in at least `width` columns, space-filled on the left.
pub fn space_padded(n: int, width: int) -> str {
    var text = "{n}"
    while text.len < width {
        text = " " + text
    }
    text
}

/// A year as `%Y` prints it: as many digits as it has, a minus before a
/// negative one.
pub fn year_text(year: int) -> str {
    "{year}"
}

/// The offset as `%z` prints it: `+0000`, `-0500`, `+0530`.
pub fn offset_text(offset: int) -> str {
    let sign = if offset < 0 then "-" else "+"
    let a = if offset < 0 then -offset else offset
    "{sign}{zero_padded(a / 3600, 2)}{zero_padded(a / 60 % 60, 2)}"
}

/// `2020-09-13`.
pub fn date_text(c: Civil) -> str {
    "{year_text(c.year)}-{zero_padded(c.month, 2)}-{zero_padded(c.day, 2)}"
}

/// `12:26:40`.
pub fn time_text(c: Civil) -> str {
    "{zero_padded(c.hour, 2)}:{zero_padded(c.minute, 2)}:{zero_padded(c.second, 2)}"
}

/// `2020-09-13 12:26:40.000000000 +0000`: GNU's full ISO stamp, what
/// `ls --full-time` and `stat`'s `%x %y %z %w` print.
pub fn full_stamp(c: Civil, nanos: int) -> str {
    "{date_text(c)} {time_text(c)}.{zero_padded(nanos, 9)} {offset_text(c.offset)}"
}

fn zone_label(text: str) -> str {
    if text.starts_with("<") && text.ends_with(">") { return text[1..text.len - 1] }
    text
}

/// C-locale zone abbreviation at an instant, from the same TZif or rule
/// as its offset. References: RFC 8536 abbreviation table; POSIX TZ.
pub fn zone_abbreviation(z: Zone, t: int) -> str {
    let n = z.times.len
    if z.rule.ok && (n == 0 || t >= z.times[n - 1]) {
        if z.rule.has_dst && rule_offset(z.rule, t) == z.rule.dst { return z.rule.daylight_name }
        return z.rule.standard_name
    }
    if n == 0 || t < z.times[0] { return z.first_name }
    var lo = 0
    var hi = n - 1
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if z.times[mid] <= t { lo = mid } else { hi = mid - 1 }
    }
    z.names[lo]
}

/// A date input's TZ="RULE" without changing the output zone.
pub fn zone_named(name: str) -> Zone {
    if name == "" { return utc() }
    if name.starts_with(":") { return zone_named(name[1..]) }
    if name.starts_with("/") { return zone_file(name, name) }
    var dir = "/usr/share/zoneinfo"
    if built_for_linux() { dir = env_get("TZDIR") else dir }
    zone_file("{dir}/{name}", name)
}
