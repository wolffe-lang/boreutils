//! predicate — POSIX test's argument-count grammar and GNU 9.11's
//! documented predicates, measured black-box. Never implementation source.
//! Integers compare normalized decimal strings: GNU 9.11 accepts values
//! larger than intmax_t, so converting to a machine integer is incorrect.
//! Access checks use effective ids and Unix mode bits; ACLs lack a surface.

struct PredicateScan { at: int, error: str }

fn predicate_integer(s: str) -> str ! {invalid} {
    var v = s.trim()
    var negative = false
    if v.starts_with("+") || v.starts_with("-") { negative = v.starts_with("-"); v = v[1..] }
    if v.len == 0 { return invalid }
    for b in v.bytes() { if b as int < 48 || b as int > 57 { return invalid } }
    while v.len > 1 && v.starts_with("0") { v = v[1..] }
    if negative && v != "0" { return "-" + v }
    v
}

fn predicate_compare(a: str, b: str) -> int {
    let an = a.starts_with("-"), bn = b.starts_with("-")
    if an != bn { return if an then -1 else 1 }
    let aa = if an then a[1..] else a
    let bb = if bn then b[1..] else b
    var cmp = 0
    if aa.len != bb.len { cmp = if aa.len < bb.len then -1 else 1 }
    else if aa != bb { cmp = if aa < bb then -1 else 1 }
    if an then -cmp else cmp
}

fn predicate_unary(op: str) -> bool {
    let words = ["-b", "-c", "-d", "-e", "-f", "-g", "-G", "-h", "-k", "-L", "-n", "-N", "-O", "-p", "-r", "-s", "-S", "-t", "-u", "-w", "-x", "-z"]
    for word in words { if word == op { return true } }
    false
}

fn predicate_binary(op: str) -> bool {
    let words = ["=", "==", "!=", "<", ">", "-eq", "-ne", "-gt", "-ge", "-lt", "-le", "-nt", "-ot", "-ef"]
    for word in words { if word == op { return true } }
    false
}

fn predicate_access(r: List[int], bit: int) -> bool {
    let mode = rec_mode(r)
    if os_euid() == 0 { return bit != 1 || mode % 2 == 1 || mode / 8 % 2 == 1 || mode / 64 % 2 == 1 }
    var shift = 1
    if os_euid() == rec_uid(r) { shift = 64 }
    else {
        var group = os_egid() == rec_gid(r)
        let groups = os_groups() else List[int]()
        for g in groups { if g == rec_gid(r) { group = true } }
        if group { shift = 8 }
    }
    mode / (shift * bit) % 2 == 1
}

fn predicate_one(op: str, word: str, mut scan: PredicateScan) -> bool {
    if op == "-n" { return word.len != 0 }
    if op == "-z" { return word.len == 0 }
    if op == "-t" {
        let integer = predicate_integer(word) else |_| { scan.error = "invalid integer {quote_always(word)}"; return false }
        let fd = integer.to_int() else |_| { return false }
        if fd < 0 || fd > 2147483647 { return false }
        return os_isatty(fd) else false
    }
    let r = if op == "-h" || op == "-L" then fs_lstat(word) else fs_stat(word)
    let stat = r else |_| { return false }
    let mode = rec_mode(stat)
    if op == "-e" { return true }
    if op == "-b" { return rec_kind(stat) == kind_block() }
    if op == "-c" { return rec_kind(stat) == kind_char() }
    if op == "-d" { return rec_kind(stat) == kind_dir() }
    if op == "-f" { return rec_kind(stat) == kind_file() }
    if op == "-h" || op == "-L" { return rec_kind(stat) == kind_link() }
    if op == "-p" { return rec_kind(stat) == kind_fifo() }
    if op == "-S" { return rec_kind(stat) == kind_socket() }
    if op == "-s" { return rec_size(stat) > 0 }
    if op == "-g" { return mode / 1024 % 2 == 1 }
    if op == "-u" { return mode / 2048 % 2 == 1 }
    if op == "-k" { return mode / 512 % 2 == 1 }
    if op == "-G" { return rec_gid(stat) == os_egid() }
    if op == "-O" { return rec_uid(stat) == os_euid() }
    if op == "-r" { return predicate_access(stat, 4) }
    if op == "-w" { return predicate_access(stat, 2) }
    if op == "-x" { return predicate_access(stat, 1) }
    if op == "-N" { return stat[14] > stat[12] || stat[14] == stat[12] && stat[15] > stat[13] }
    false
}

fn predicate_two(a: str, op: str, b: str, mut scan: PredicateScan) -> bool {
    if op == "=" || op == "==" { return a == b }
    if op == "!=" { return a != b }
    if op == "<" { return a < b }
    if op == ">" { return a > b }
    if op == "-ef" || op == "-nt" || op == "-ot" {
        let ar = fs_stat(a) else |_| { List[int]() }
        let br = fs_stat(b) else |_| { List[int]() }
        if op == "-ef" { return ar.len > 0 && br.len > 0 && ar[9] == br[9] && ar[10] == br[10] }
        if ar.len == 0 { return op == "-ot" && br.len > 0 }
        if br.len == 0 { return op == "-nt" }
        let cmp = if ar[14] != br[14] then (if ar[14] < br[14] then -1 else 1) else (if ar[15] == br[15] then 0 else (if ar[15] < br[15] then -1 else 1))
        return if op == "-nt" then cmp > 0 else cmp < 0
    }
    let av = predicate_integer(a) else |_| { scan.error = "invalid integer {quote_always(a)}"; return false }
    let bv = predicate_integer(b) else |_| { scan.error = "invalid integer {quote_always(b)}"; return false }
    let cmp = predicate_compare(av, bv)
    if op == "-eq" { return cmp == 0 }
    if op == "-ne" { return cmp != 0 }
    if op == "-gt" { return cmp > 0 }
    if op == "-ge" { return cmp >= 0 }
    if op == "-lt" { return cmp < 0 }
    cmp <= 0
}

fn predicate_missing(args: List[str], mut scan: PredicateScan) {
    let word = if args.len == 0 then "" else args[args.len - 1]
    scan.error = "missing argument after {quote_always(word)}"
}

fn predicate_atom(args: List[str], mut scan: PredicateScan) -> bool {
    if scan.at >= args.len { predicate_missing(args, mut scan); return false }
    let word = args[scan.at]
    scan.at += 1
    if word == "!" { return !predicate_atom(args, mut scan) }
    if word == "(" {
        let result = predicate_or(args, mut scan)
        if scan.error != "" { return false }
        if scan.at >= args.len { predicate_missing(args, mut scan); return false }
        if args[scan.at] != ")" { scan.error = "')' expected, found {quote_always(args[scan.at])}"; return false }
        scan.at += 1
        return result
    }
    if scan.at + 1 < args.len && predicate_binary(args[scan.at]) {
        let op = args[scan.at], rhs = args[scan.at + 1]
        scan.at += 2
        return predicate_two(word, op, rhs, mut scan)
    }
    if predicate_unary(word) {
        if scan.at >= args.len { predicate_missing(args, mut scan); return false }
        let value = args[scan.at]
        scan.at += 1
        return predicate_one(word, value, mut scan)
    }
    word.len > 0
}

fn predicate_and(args: List[str], mut scan: PredicateScan) -> bool {
    var result = predicate_atom(args, mut scan)
    while scan.error == "" && scan.at < args.len && args[scan.at] == "-a" {
        scan.at += 1
        let rhs = predicate_atom(args, mut scan)
        result = result && rhs
    }
    result
}

fn predicate_or(args: List[str], mut scan: PredicateScan) -> bool {
    var result = predicate_and(args, mut scan)
    while scan.error == "" && scan.at < args.len && args[scan.at] == "-o" {
        scan.at += 1
        let rhs = predicate_and(args, mut scan)
        result = result || rhs
    }
    result
}

fn predicate_eval(args: List[str], mut scan: PredicateScan) -> bool {
    let n = args.len
    if n == 0 { return false }
    if n == 1 { return args[0].len != 0 }
    if n == 2 {
        if args[0] == "!" { return args[1].len == 0 }
        if predicate_unary(args[0]) { return predicate_one(args[0], args[1], mut scan) }
        if args[0].starts_with("-") { scan.error = "{quote_always(args[0])}: unary operator expected" }
        else { predicate_missing(args, mut scan) }
        return false
    }
    if n == 3 {
        if predicate_binary(args[1]) { return predicate_two(args[0], args[1], args[2], mut scan) }
        if args[0] == "!" { return !predicate_eval(args[1..], mut scan) }
        if args[0] == "(" && args[2] == ")" { return args[1].len != 0 }
        if args[1] != "-a" && args[1] != "-o" { scan.error = "{quote_always(args[1])}: binary operator expected"; return false }
    }
    if n == 4 && args[0] == "!" { return !predicate_eval(args[1..], mut scan) }
    if n == 4 && args[0] == "(" && args[3] == ")" { return predicate_eval(args[1..3], mut scan) }
    scan.at = 0
    let result = predicate_or(args, mut scan)
    if scan.error == "" && scan.at < args.len { scan.error = "extra argument {quote_always(args[scan.at])}" }
    result
}

/// Entrypoint shared by test and [. Status is true/false/syntax = 0/1/2.
pub fn predicate_main(prog: str) -> int {
    var args = env_args()
    if prog == "[" {
        if args.len == 1 && (args[0] == "--help" || args[0] == "--version") {
            var out = stdout()
            put(mut out, if args[0] == "--version" then version_text("[") else "Usage: [ EXPRESSION ]\nTest a string, integer or file predicate. The final ] is required.\n") else |_| {}
            return finish(mut out, "[", 0)
        }
        if args.len == 0 || args[args.len - 1] != "]" { warn("[", "missing ']' ".trim_end()); return 2 }
        let _ = (mut args).pop() else ""
    }
    var scan = PredicateScan { at: 0, error: "" }
    let result = predicate_eval(args, mut scan)
    if scan.error != "" { warn(prog, scan.error); return 2 }
    if result then 0 else 1
}
