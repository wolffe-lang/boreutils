//! bore — what every boreutils program shares.
//!
//! Three things, and nothing that belongs to one utility:
//!
//! - **Options** in GNU's getopt_long shape: short clusters (`-za`), a
//!   short option's argument attached or separate (`-s.h`, `-s .h`),
//!   long options abbreviated to any unique prefix (`--mul`), their
//!   argument after `=` or as the next word, `--` ending the options,
//!   and operands permuted among options unless `POSIXLY_CORRECT` is set.
//! - **Diagnostics** in GNU's shape: `prog: message`, and for a usage
//!   error the `Try 'prog --help' for more information.` line after it.
//! - **Output** as bytes, buffered: descriptor 1 itself, written in
//!   64 KiB chunks with `fs_write_chunk`.
//!
//! References consulted: POSIX.1-2024 XBD 12.2 (Utility Syntax
//! Guidelines); GNU coreutils 9.11's `--help` output and black-box runs
//! of its binaries (macOS Homebrew and linux native, glibc). Never GNU
//! source.
//!
//! **Why descriptor 1 and not `print_raw`.** `print_raw` takes a `str`,
//! so it cannot write bytes that are not UTF-8; it makes one `write` per
//! call; and it discards write errors, so a full disk looks like success.
//! Since wolf 0.2.26 the byte calls serve descriptors 0, 1 and 2
//! themselves (`[os.fs.std]`, s200, wolf-lang#405), so standard output
//! is `fs_write_chunk(1, …)` and standard input `fs_read_chunk(0, …)`.
//! Before that this module REOPENED `/dev/stdout` and `/dev/stdin`, which
//! linux refused for a socket (and the module fell back to `print_raw`)
//! and which made standard input a fresh open file description with its
//! own offset (bu15). Both workarounds are gone.
//!
//! ## The exit convention, which every boreutils program honours
//!
//! Measured black-box against GNU coreutils 9.11 on both hosts, with
//! descriptor 1 closed (`prog >&-`) and with the reader of a pipe gone.
//! Six rules, and the first four are what a new utility must follow:
//!
//! 1. **Open standard output first**, with `stdout()`, before any input
//!    file: with descriptor 1 closed the first file opened takes it.
//! 2. **All output goes through `Out`**, never `print`/`print_raw`,
//!    which discard write errors (wolf-lang#408).
//! 3. **The last act is `finish(mut out, prog, status)`**, and so is
//!    every early return that has written anything. On the common path
//!    that is the whole convention.
//! 4. **A failed write is status 1 and one diagnostic**, whatever the
//!    program's own status would have been:
//!    `prog: write error: Bad file descriptor`. `finish` does both.
//! 5. **Writing nothing never fails.** `true >&-` is 0 and `false >&-`
//!    is 1, because neither writes; `true --version >&-` is 1. The
//!    failure belongs to the write, not to the descriptor, which is why
//!    `Out` tracks whether the program wrote at all.
//! 6. **A broken pipe is not this module's business.** SIGPIPE kills a
//!    native wolf program exactly as it kills GNU's, with status 141
//!    and nothing on stderr, and wolf cannot observe or ignore it: the
//!    signal surface is `RELOAD`/`TERMINATE`/`QUIT`/`UPGRADE` only, so
//!    no boreutils program can ever take the EPIPE path GNU takes under
//!    `trap '' PIPE` (`yes: standard output: Broken pipe`, status 1).
//!    Filed upstream as wolf-lang#423 with its witness; for `yes | head
//!    -1` the default disposition is the CORRECT behaviour and matches
//!    GNU, so nothing here works around it.
//!
//! A program that streams rather than buffers — `cat` and `yes` are the
//! two — adds one line, `output_ok`, and GNU's own wording follows from
//! it; see that function.

use std.env

/// The version every boreutils `--version` reports.
pub fn version() -> str {
    "0.1.0"
}

/// The bytes a buffer holds before it is written.
fn chunk() -> int {
    65536
}

// ---------------------------------------------------------------- options

/// One option a program accepts: a one-character short name, a long
/// name, or both (`""` for the one it lacks), and whether it takes an
/// argument: always (`arg`), only when attached (`optional`), or never.
pub struct Opt {
    short: str,
    long: str,
    arg: bool,
    optional: bool,
}

/// An option that takes no argument.
pub fn flag(short: str, long: str) -> Opt {
    Opt { short: short, long: long, arg: false, optional: false }
}

/// An option that takes an argument.
pub fn takes(short: str, long: str) -> Opt {
    Opt { short: short, long: long, arg: true, optional: false }
}

/// An option whose argument is OPTIONAL — getopt_long's third state
/// (boreutils#8). It takes a word only when the word is ATTACHED: after
/// `=` for the long name (`--follow=name`), or in the same word for the
/// short one (`-Cauto`). A bare `--follow` never eats the next word, so
/// `tail --follow FILE` follows FILE. `Parsed.given` says whether a
/// word was attached, which is how `--follow=` (an empty word, which
/// GNU's argmatch calls ambiguous) differs from `--follow`.
pub fn optional(short: str, long: str) -> Opt {
    Opt { short: short, long: long, arg: false, optional: true }
}

/// The result of `parse`: the options in the order they were given,
/// the operands in order, and the first error, if any.
///
/// `keys[i]` is the long name of the i-th option given (its short name
/// when it has no long name) and `values[i]` its argument, `""` when it
/// takes none; `given[i]` says whether an argument was supplied at all,
/// which only an `optional` option can leave false while taking one.
/// Parsing stops at the first error, so every option before it is
/// present: a program that acts on `--help` in order behaves as GNU's
/// does for `--help -x` (help) and `-x --help` (the error).
pub struct Parsed {
    keys: List[str],
    values: List[str],
    given: List[bool],
    operands: List[str],
    error: str,
}

/// Whether parsing succeeded.
pub fn ok(p: Parsed) -> bool {
    p.error.len == 0
}

/// Whether option operands permute: GNU permutes unless
/// `POSIXLY_CORRECT` is set, when the first operand ends the options.
pub fn permute() -> bool {
    !env.has("POSIXLY_CORRECT")
}

/// Parse `args` against `spec`.
///
/// Never traps and has no rows: a malformed command line is data, and
/// the message GNU's getopt would print (without the `prog: ` prefix) is
/// in `error`.
pub fn parse(spec: List[Opt], args: List[str], permute: bool) -> Parsed {
    var p = Parsed {
        keys: List[str](),
        values: List[str](),
        given: List[bool](),
        operands: List[str](),
        error: "",
    }
    var i = 0
    var rest_are_operands = false
    while i < args.len {
        let a = args[i]
        i += 1
        if rest_are_operands {
            (mut p.operands).push(a)
        } else if a == "--" {
            rest_are_operands = true
        } else if a.starts_with("--") {
            let body = a[2..]
            let eq = body.find("=") else -1
            var name = body
            var inline = ""
            if eq >= 0 {
                name = body[0..eq]
                inline = body[eq + 1..]
            }
            let k = find_long(spec, name)
            if k == -1 {
                p.error = "unrecognized option '{a}'"
                return p
            }
            if k == -2 {
                p.error = "option '{a}' is ambiguous; possibilities:{possible(spec, name)}"
                return p
            }
            let o = copy spec[k]
            var value = ""
            var given = false
            if o.arg {
                given = true
                if eq >= 0 {
                    value = inline
                } else if i < args.len {
                    value = args[i]
                    i += 1
                } else {
                    p.error = "option '--{o.long}' requires an argument"
                    return p
                }
            } else if o.optional {
                given = eq >= 0
                value = inline
            } else if eq >= 0 {
                p.error = "option '--{o.long}' doesn't allow an argument"
                return p
            }
            (mut p.keys).push(o.long)
            (mut p.values).push(value)
            (mut p.given).push(given)
        } else if a.starts_with("-") && a.len > 1 {
            var off = 1
            var done = false
            while !done && off < a.len {
                let c = next_char(a, off)
                off += c.len
                let k = find_short(spec, c)
                if k < 0 {
                    p.error = "invalid option -- '{c}'"
                    return p
                }
                let o = copy spec[k]
                var value = ""
                var given = false
                if o.arg {
                    given = true
                    if off < a.len {
                        value = a[off..]
                    } else if i < args.len {
                        value = args[i]
                        i += 1
                    } else {
                        p.error = "option requires an argument -- '{c}'"
                        return p
                    }
                    done = true
                } else if o.optional && off < a.len {
                    // Attached or nothing: the rest of the word is the
                    // argument, and the next word is never taken.
                    given = true
                    value = a[off..]
                    done = true
                }
                (mut p.keys).push(key_of(o))
                (mut p.values).push(value)
                (mut p.given).push(given)
            }
        } else {
            (mut p.operands).push(a)
            if !permute {
                rest_are_operands = true
            }
        }
    }
    p
}

fn key_of(o: Opt) -> str {
    if o.long.len > 0 {
        return o.long
    }
    o.short
}

/// The character of `s` starting at byte `off`, as a `str`.
fn next_char(s: str, off: int) -> str {
    for c in s[off..].chars() {
        return "{c}"
    }
    ""
}

fn find_short(spec: List[Opt], c: str) -> int {
    var k = 0
    for o in spec {
        if o.short.len > 0 && o.short == c {
            return k
        }
        k += 1
    }
    -1
}

/// The index of the long option `name` names: exactly, or as the one
/// option it is a prefix of. -1 when none matches, -2 when it is
/// ambiguous.
fn find_long(spec: List[Opt], name: str) -> int {
    var k = 0
    var found = -1
    var count = 0
    for o in spec {
        if o.long.len > 0 {
            if o.long == name {
                return k
            }
            if o.long.starts_with(name) {
                found = k
                count += 1
            }
        }
        k += 1
    }
    if count > 1 {
        return -2
    }
    found
}

fn possible(spec: List[Opt], name: str) -> str {
    var out = List[byte]()
    for o in spec {
        if o.long.len > 0 && o.long.starts_with(name) {
            for b in " '--{o.long}'".bytes() {
                (mut out).push(b)
            }
        }
    }
    str_from_utf8(out) else ""
}

/// Match `word` against an option's argument vocabulary the way GNU's
/// argmatch does: an exact match, or else a PREFIX of the choices that
/// all mean one thing. `meaning[i]` is what `choices[i]` means, so
/// synonyms (`quiet`, `silent`) share one. Answers the meaning, `-1`
/// for no match and `-2` for a prefix of choices that mean different
/// things — which the empty word always is when there are two meanings.
/// Measured against GNU 9.11: `tail --follow=na` is `name`,
/// `--follow=` is ambiguous, `--follow=Name` matches nothing.
pub fn argmatch(word: str, choices: List[str], meaning: List[int]) -> int {
    var found = -1
    var i = 0
    while i < choices.len {
        if choices[i] == word {
            return meaning[i]
        }
        if choices[i].starts_with(word) {
            if found == -1 {
                found = meaning[i]
            } else if found != meaning[i] {
                found = -2
            }
        }
        i += 1
    }
    found
}

/// Report an argument `argmatch` refused, in GNU's shape, and answer
/// the status (1 — measured for `tail --follow=bogus` and for `sort
/// --check=bogus` alike, though `sort`'s own usage status is 2):
///
///     prog: invalid argument 'bogus' for '--follow'
///     Valid arguments are:
///       - 'descriptor'
///       - 'name'
///     Try 'prog --help' for more information.
///
/// `ambiguous` (the -2 answer) says `ambiguous argument` instead.
/// Choices that share a meaning share a line: `  - 'quiet', 'silent'`.
pub fn argmatch_error(
    prog: str,
    word: str,
    long: str,
    choices: List[str],
    meaning: List[int],
    ambiguous: bool,
) -> int {
    let what = if ambiguous then "ambiguous" else "invalid"
    var text = "{prog}: {what} argument {quote(word)} for {quote("--" + long)}\nValid arguments are:"
    var i = 0
    while i < choices.len {
        if i > 0 && meaning[i] == meaning[i - 1] {
            text += ", {quote(choices[i])}"
        } else {
            text += "\n  - {quote(choices[i])}"
        }
        i += 1
    }
    eprint("{text}\nTry '{prog} --help' for more information.")
    1
}

// ------------------------------------------------------------ diagnostics

/// Write `prog: msg` to standard error.
pub fn warn(prog: str, msg: str) {
    eprint("{prog}: {msg}")
}

/// Report a usage error in GNU's shape and answer the status to exit
/// with (1, as GNU's basename, dirname and yes do).
pub fn usage_error(prog: str, msg: str) -> int {
    eprint("{prog}: {msg}\nTry '{prog} --help' for more information.")
    1
}

/// `s` quoted as GNU quotes an operand in a diagnostic under `LC_ALL=C`
/// (measured against coreutils 9.11: shell-escape style — always single
/// quotes, a backslash before a backslash or a single quote, C escapes
/// for the control characters that have one, and a three-digit octal
/// escape for every other byte outside printable ASCII, so `é` prints as
/// `'\303\251'`).
pub fn quote(s: str) -> str {
    var out = List[byte]()
    (mut out).push(39 as byte)
    for b in s.bytes() {
        let n = b as int
        if n == 92 || n == 39 {
            (mut out).push(92 as byte)
            (mut out).push(b)
        } else if n >= 32 && n < 127 {
            (mut out).push(b)
        } else {
            for e in escape(n).bytes() {
                (mut out).push(e)
            }
        }
    }
    (mut out).push(39 as byte)
    str_from_utf8(out) else "'?'"
}

/// The escape GNU prints for the byte `n`, backslash included.
fn escape(n: int) -> str {
    if n == 7 {
        return "\\a"
    }
    if n == 8 {
        return "\\b"
    }
    if n == 9 {
        return "\\t"
    }
    if n == 10 {
        return "\\n"
    }
    if n == 11 {
        return "\\v"
    }
    if n == 12 {
        return "\\f"
    }
    if n == 13 {
        return "\\r"
    }
    let digits = "01234567"
    let a = digits[n / 64..n / 64 + 1]
    let b = digits[n / 8 % 8..n / 8 % 8 + 1]
    let c = digits[n % 8..n % 8 + 1]
    "\\{a}{b}{c}"
}

/// `s` as GNU renders a FILE NAME in a diagnostic under `LC_ALL=C`:
/// shell-escape style, quoted only when it has to be. `quote` above is
/// the always-quote style GNU uses for an operand it names in a usage
/// error; this is the one it uses for a path it could not open, so
/// `cat missing` says `missing` bare while `cat ""` says `''`.
///
/// Measured against coreutils 9.11 over every printable byte, in both
/// the leading and an inner position. Three shapes:
///
/// - a name holding a byte outside printable ASCII splices
///   single-quoted runs with `$'…'` escapes: `a<TAB>b` is
///   `'a'$'\t''b'`, and `é` alone is `''$'\303\251'`;
/// - a name holding a single quote and nothing that rules out double
///   quotes takes double quotes: `a'b` is `"a'b"`;
/// - anything else that needs quoting takes single quotes, with each
///   `'` written `'\''`.
pub fn quote_name(s: str) -> str {
    if s.len == 0 {
        return "''"
    }
    var nonprint = false
    var needs = false
    var has_quote = false
    var no_dquote = false
    var i = 0
    for b in s.bytes() {
        let n = b as int
        if n < 32 || n >= 127 {
            nonprint = true
        }
        if needs_quoting(n, i == 0) {
            needs = true
        }
        if n == 39 {
            has_quote = true
        }
        if breaks_dquote(n) {
            no_dquote = true
        }
        i += 1
    }
    if nonprint {
        return spliced(s)
    }
    if !needs {
        return s
    }
    if has_quote && !no_dquote {
        return "\"{s}\""
    }
    single_quoted(s)
}

/// Whether the byte `n` makes a name need quoting at all. The measured
/// set is space ! " $ & ' ( ) * : ; < = > ? [ \ ^ ` | anywhere, and #
/// or ~ in the first position only.
fn needs_quoting(n: int, first: bool) -> bool {
    if first && (n == 35 || n == 126) {
        return true
    }
    if n == 32 || n == 33 || n == 34 || n == 36 || n == 38 || n == 39 {
        return true
    }
    if n == 40 || n == 41 || n == 42 || n == 58 || n == 59 || n == 60 {
        return true
    }
    if n == 61 || n == 62 || n == 63 || n == 91 || n == 92 || n == 94 {
        return true
    }
    n == 96 || n == 124
}

/// Whether the byte `n` rules out the double-quoted shape. The measured
/// set is ! " # $ & ( ) * ; < = > ? [ \ ^ ` { | } ~ — deliberately NOT
/// the set above: a space and a colon keep double quotes, while #, {, }
/// and ~ forbid them even though they need no quoting on their own.
fn breaks_dquote(n: int) -> bool {
    if n == 33 || n == 34 || n == 35 || n == 36 || n == 38 || n == 40 {
        return true
    }
    if n == 41 || n == 42 || n == 59 || n == 60 || n == 61 || n == 62 {
        return true
    }
    if n == 63 || n == 91 || n == 92 || n == 94 || n == 96 || n == 123 {
        return true
    }
    n == 124 || n == 125 || n == 126
}

fn single_quoted(s: str) -> str {
    var out = List[byte]()
    push_str(mut out, "'")
    for b in s.bytes() {
        if b as int == 39 {
            push_str(mut out, "'\\''")
        } else {
            (mut out).push(b)
        }
    }
    push_str(mut out, "'")
    str_from_utf8(out) else "'?'"
}

/// The spliced shape: single-quoted runs of printable bytes joined to
/// `$'…'` runs of escaped ones. The opening quote is always written, so
/// a name starting with a non-printable byte opens with an empty `''`.
fn spliced(s: str) -> str {
    var out = List[byte]()
    push_str(mut out, "'")
    var open = true
    var escaping = false
    for b in s.bytes() {
        let n = b as int
        if n >= 32 && n < 127 {
            if escaping {
                push_str(mut out, "''")
                escaping = false
                open = true
            }
            if n == 39 {
                push_str(mut out, "'\\''")
            } else {
                (mut out).push(b)
            }
        } else {
            if open {
                push_str(mut out, "'")
                open = false
            }
            if !escaping {
                push_str(mut out, "$'")
                escaping = true
            }
            push_str(mut out, escape(n))
        }
    }
    push_str(mut out, "'")
    str_from_utf8(out) else "'?'"
}

fn push_str(mut out: List[byte], s: str) {
    for b in s.bytes() {
        (mut out).push(b)
    }
}

/// Report `prog: NAME: why`, with NAME quoted as GNU quotes a path.
pub fn input_error(prog: str, name: str, why: str) {
    eprint("{prog}: {quote_name(name)}: {why}")
}

/// GNU's wording for a missing path.
pub fn no_such_file() -> str {
    "No such file or directory"
}

/// GNU's wording for a path the host refused.
pub fn permission_denied() -> str {
    "Permission denied"
}

/// GNU's wording for a directory offered where a file was wanted.
///
/// Named for what it produces, not `is_a_directory`, which W0311 reads
/// as a predicate that ought to answer `bool`.
pub fn directory_reason() -> str {
    "Is a directory"
}

/// The host's words for the most recent failed fs call: GNU's
/// `strerror(errno)`, so `Not a directory`, `Too many levels of symbolic
/// links`, `No space left on device`.
///
/// Since wolf 0.2.26 the host's error number travels beside the row
/// (`os_error`, `os_error_text`, `[os.fs.error]`, s200, wolf-lang#407):
/// the task's most recent fallible fs call sets it when the host
/// refused and CLEARS it when the call succeeded. So this must be asked
/// before any other fs call, a successful `fs_close` included; a caller
/// that reports later keeps `host_code()` and asks `reason_of` then.
/// 0 (the call failed before the host was asked) keeps the stand-in
/// this module used before 0.2.26, `Input/output error`.
pub fn io_error() -> str {
    reason_of(host_code())
}

/// The host's error number for the most recent fallible fs call, or 0.
pub fn host_code() -> int {
    os_error()
}

/// The host's words for `code`, or `Input/output error` for 0.
pub fn reason_of(code: int) -> str {
    if code == 0 {
        return "Input/output error"
    }
    os_error_text(code)
}

// ------------------------------------------------------------------ input

/// Why an input could not be opened. Named rather than spelled at each
/// signature: W0602 denies an anonymous multi-tag row on a `pub` item,
/// because the tag set is API the moment a caller matches on it.
pub error OpenFailed = {not_found, denied, is_dir, io}

/// Why a read stopped. `eof` is an outcome, not a failure.
pub error ReadFailed = {eof, io}

/// One input stream: a named file, or standard input for the operand
/// `-`.
///
/// Standard input is descriptor 0 itself (`[os.fs.std]`, wolf 0.2.26):
/// a read starts at the offset the process shares with whoever started
/// it and moves it, so `{ read h; tail; } < f` reads from where `read`
/// stopped and `{ head -n 1; cat; } < f` hands `cat` the rest, as GNU
/// does. Until 0.2.26 linux reached it by reopening `/dev/stdin`, a
/// fresh open file description at offset 0, and bu15 moved offsets by
/// hand to hide that; nothing needs moving now.
pub struct In {
    fd: int,
    name: str,
}

/// The name this stream was opened under, for a diagnostic.
pub fn name_of(i: In) -> str {
    i.name
}

/// Open `path` for reading, `-` meaning standard input.
///
/// Rows: `not_found`, `denied` and `io` as the builtin answers them,
/// and `is_dir` for a directory. Measured at 0.2.14: `fs_open` ACCEPTS
/// a directory and only the following `fs_read_chunk` fails, with the
/// same `io` row a real read failure raises, so the kind is read from
/// `fs_fstat` (0 regular, 1 directory, 2 device) while the two can
/// still be told apart.
pub fn open_input(path: str) -> In ! OpenFailed {
    if path == "-" {
        return In { fd: 0, name: "-" }
    }
    let fd = fs_open(path)?
    let st = fs_fstat(fd) else |_| {
        fs_close(fd) else |_| {}
        return io
    }
    if st[0] == 1 {
        fs_close(fd) else |_| {}
        return is_dir
    }
    In { fd: fd, name: path }
}

/// The next chunk of `i`, at most `n` bytes.
///
/// Rows: `eof` at the end of the stream, `io` on a read failure.
/// Measured at 0.2.14: the end of a file arrives as the `eof` ROW, not
/// as a zero-length answer — but a zero-length answer at a positive `n`
/// means the same thing, so a caller must end on both.
pub fn read_chunk(i: In, n: int) -> List[byte] ! ReadFailed {
    fs_read_chunk(i.fd, n)?
}

/// Close `i`. A close failure is not reportable and is dropped, as GNU
/// drops it for an input. Standard input stays open: a later `-` reads
/// it again, from wherever this read left descriptor 0.
pub fn close_input(i: In) {
    if i.fd < 3 {
        return
    }
    fs_close(i.fd) else |_| {}
}

/// Move `i`'s offset to `at`, counted from the start. A pipe has no
/// offset to move and is left alone.
pub fn seek_to(i: In, at: int) {
    let _ = fs_seek(i.fd, at, 0) else 0
}

/// Where the next read of `i` starts, or -1 when it has no offset (a
/// pipe, a terminal).
///
/// Named `offset_of` until wolf 0.2.23, whose prelude gained
/// `offset_of(T, field)` (kw08): a module fn of that name shadows it,
/// W0304, which `--deny-warnings` refuses.
pub fn position_of(i: In) -> int {
    fs_tell(i.fd) else -1
}

/// The end of `i` when it is a regular file whose size can be TRUSTED,
/// or -1 when it must be read forward to find out.
///
/// `fs_fstat`'s size is not always the length, and GNU does not trust
/// it either (measured on kasumi, bu15): a sysfs attribute reports 4096
/// and holds 23 bytes, and a `/proc` file reports 0 and holds 144, and
/// GNU's `wc -c`, `tail -c` and `head -c -K` still answer 23 and 144
/// from them. So the size is believed only when the byte before it
/// exists and nothing exists at it, which costs two positional reads.
/// A file that has grown since the `fstat` answers its new end; one
/// that reports 0 or more than it holds answers -1 and is read forward,
/// which is exactly what a pipe gets.
pub fn verified_end(i: In) -> int {
    let st = fs_fstat(i.fd) else |_| {
        return -1
    }
    if st[0] != 0 || st[1] <= 0 {
        return -1
    }
    var end = st[1]
    var held = false
    region probe {
        let last = fs_read_at(i.fd, end - 1, 1) else |_| {
            List[byte]()
        }
        held = last.len == 1
    }
    if !held {
        return -1
    }
    var more = true
    while more {
        region probe {
            let past = fs_read_at(i.fd, end, 65536) else |_| {
                List[byte]()
            }
            if past.len == 0 {
                more = false
            } else {
                end += past.len
            }
        }
    }
    end
}

/// The first line of `--version`, and the lines after it.
pub fn version_text(prog: str) -> str {
    "{prog} (boreutils) {version()}\nLicence GPL-3.0-or-later. There is no warranty.\n"
}

// ----------------------------------------------------------------- output

/// Buffered byte output to standard output.
///
/// `closed` says descriptor 1 was not open when the program started;
/// `wrote` says the program has tried to write at least one byte. Both
/// are needed to answer GNU's question, which is not "is the descriptor
/// good" but "did a write fail": `true >&-` writes nothing and exits 0,
/// where `true --version >&-` writes and exits 1.
pub struct Out {
    fd: int,
    closed: bool,
    wrote: bool,
    buf: List[byte],
}

/// Standard output, ready to buffer: descriptor 1 itself
/// (`[os.fs.std]`, wolf 0.2.26).
///
/// A closed descriptor 1 is `fs_fstat(1)` answering `io` (`EBADF`), on
/// every host: the runtime never hands out 0, 1 or 2 for a file it
/// opens, and a write to a closed 1 is `io`, never a write into a file
/// that took the number. Until 0.2.26 this module reopened
/// `/dev/stdout`, read "closed" from the row the reopen raised (linux
/// `not_found`, macOS `io`), and fell back to `print_raw` when linux
/// refused the reopen for a socket. Ask it first anyway: GNU checks
/// standard output before it looks at an operand.
pub fn stdout() -> Out {
    let _ = fs_fstat(1) else |_| {
        return shut()
    }
    Out { fd: 1, closed: false, wrote: false, buf: List[byte]() }
}

/// A stream whose descriptor 1 is closed: every write fails.
fn shut() -> Out {
    Out { fd: -1, closed: true, wrote: false, buf: List[byte]() }
}

/// Append `s` to the buffer, writing when it is full.
///
/// A stream whose descriptor is closed buffers NOTHING and fails here,
/// at the write the program asked for, because that is where GNU fails:
/// `wc FILE nope` with descriptor 1 closed reports the failed write and
/// never opens `nope`.
pub fn put(mut o: Out, s: str) -> () ! {io} {
    o.wrote = true
    if o.closed {
        return io
    }
    for b in s.bytes() {
        (mut o.buf).push(b)
    }
    if o.buf.len >= chunk() {
        flush(mut o)?
    }
}

/// Append one byte, writing when the buffer is full.
pub fn put_byte(mut o: Out, b: byte) -> () ! {io} {
    o.wrote = true
    if o.closed {
        return io
    }
    (mut o.buf).push(b)
    if o.buf.len >= chunk() {
        flush(mut o)?
    }
}

/// Write what is buffered, then `bytes`, without copying `bytes`.
pub fn write_all(mut o: Out, bytes: List[byte]) -> () ! {io} {
    o.wrote = true
    if o.closed {
        return io
    }
    flush(mut o)?
    emit(o, bytes)?
}

/// Write `bytes` straight out, unbuffered and uncopied.
///
/// Takes `o` by READ, and that is the whole point: a caller streaming
/// inside a `region` block cannot hand its region-local bytes to
/// `write_all`, because passing a region-allocated list to a call that
/// also holds a `mut` parameter is E1010 — the compiler must assume the
/// list could be stored in that parameter and outlive the block. With
/// `o` read-only there is nowhere for it to be stored.
///
/// The caller owns the ordering: this does NOT flush what `put` has
/// buffered, so a program must use one route or the other, not both.
///
/// Read-only also means it cannot MARK the stream as written to, so a
/// program that streams this way calls `output_ok` before it starts —
/// which is the shape GNU's `cat` has anyway.
pub fn write_direct(o: Out, bytes: List[byte]) -> () ! {io} {
    emit(o, bytes)?
}

/// Write what is buffered.
///
/// Rows: `io` when the write fails, or when descriptor 1 is closed and
/// the program has written to it.
pub fn flush(mut o: Out) -> () ! {io} {
    if o.closed && o.wrote {
        return io
    }
    if o.buf.len == 0 {
        return
    }
    emit(o, o.buf)?
    o.buf = List[byte]()
}

fn emit(o: Out, bytes: List[byte]) -> () ! {io} {
    if o.closed {
        return io
    }
    fs_write_chunk(o.fd, bytes) else |_| { return io }
}

/// GNU's wording for a descriptor that is not open.
pub fn bad_descriptor() -> str {
    "Bad file descriptor"
}

/// The reason to print after a failed write's message: `Bad file
/// descriptor` for a descriptor 1 that was closed (detected, never
/// written), otherwise the host's words for the failed write (`No space
/// left on device`), read at once.
fn write_reason(o: Out) -> str {
    if o.closed {
        return bad_descriptor()
    }
    io_error()
}

/// `write_error` with the host's number kept from the moment the write
/// failed, for a program that streams and reports after other fs calls
/// (closing an input clears the number).
pub fn write_error_code(o: Out, prog: str, message: str, code: int) {
    if o.closed {
        warn(prog, "{message}: {bad_descriptor()}")
        return
    }
    warn(prog, "{message}: {reason_of(code)}")
}

/// Report a failed write to standard output in GNU's shape,
/// `prog: MESSAGE: reason`.
///
/// Measured against coreutils 9.11 on both hosts with descriptor 1
/// closed, MESSAGE is `write error` for every utility — `echo`, `wc`,
/// `basename`, `dirname`, `head`, `tail`, `cut`, `tr`, `uniq`, `seq`,
/// `nl`, `tac`, `paste`, `fold`, `expand`, `od`, `printf`, `pwd`,
/// `sum`, `cksum` all say it — EXCEPT where a program checks standard
/// output before it starts streaming, where it is `standard output`:
/// that is `cat FILE` and `yes`, and it is `output_ok` below.
/// `cat --version` takes the ordinary route and says `write error`.
pub fn write_error(o: Out, prog: str, message: str) {
    warn(prog, "{message}: {write_reason(o)}")
}

/// Whether a program that is about to stream may start, reporting GNU's
/// `prog: standard output: …` on stderr when it may not.
///
/// This is `cat`'s and `yes`'s shape and nobody else's, and it is
/// observable: `cat nope` with descriptor 1 closed prints ONLY
/// `cat: standard output: Bad file descriptor` and never reports the
/// missing operand, so the check is before the operands, not among
/// them. A program that answers `false` here returns 1 at once.
pub fn output_ok(o: Out, prog: str) -> bool {
    if o.closed {
        warn(prog, "standard output: {bad_descriptor()}")
        return false
    }
    true
}

/// Flush `o` and answer `status`, or report the write error and answer 1.
///
/// This is the last act of every boreutils program, and on the common
/// path it is the WHOLE of the exit convention: a program that only
/// buffers with `put` needs nothing else.
pub fn finish(mut o: Out, prog: str, status: int) -> int {
    flush(mut o) else |_| {
        write_error(o, prog, "write error")
        return 1
    }
    status
}
