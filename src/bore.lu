/// The utilities bore carries, in byte order.
fn names() -> List[str] {
    var n = List[str]()
    (mut n).push("[")
    (mut n).push("arch")
    (mut n).push("b2sum")
    (mut n).push("base32")
    (mut n).push("base64")
    (mut n).push("basename")
    (mut n).push("basenc")
    (mut n).push("cat")
    (mut n).push("chcon")
    (mut n).push("chgrp")
    (mut n).push("chmod")
    (mut n).push("chown")
    (mut n).push("chroot")
    (mut n).push("cksum")
    (mut n).push("comm")
    (mut n).push("cp")
    (mut n).push("csplit")
    (mut n).push("cut")
    (mut n).push("date")
    (mut n).push("dir")
    (mut n).push("dircolors")
    (mut n).push("dirname")
    (mut n).push("du")
    (mut n).push("echo")
    (mut n).push("env")
    (mut n).push("expand")
    (mut n).push("expr")
    (mut n).push("factor")
    (mut n).push("false")
    (mut n).push("fmt")
    (mut n).push("fold")
    (mut n).push("groups")
    (mut n).push("head")
    (mut n).push("hostid")
    (mut n).push("hostname")
    (mut n).push("id")
    (mut n).push("install")
    (mut n).push("join")
    (mut n).push("kill")
    (mut n).push("link")
    (mut n).push("ln")
    (mut n).push("logname")
    (mut n).push("ls")
    (mut n).push("md5sum")
    (mut n).push("mkdir")
    (mut n).push("mkfifo")
    (mut n).push("mknod")
    (mut n).push("mktemp")
    (mut n).push("mv")
    (mut n).push("nice")
    (mut n).push("nl")
    (mut n).push("nohup")
    (mut n).push("nproc")
    (mut n).push("numfmt")
    (mut n).push("od")
    (mut n).push("paste")
    (mut n).push("pathchk")
    (mut n).push("pinky")
    (mut n).push("pr")
    (mut n).push("printenv")
    (mut n).push("printf")
    (mut n).push("ptx")
    (mut n).push("pwd")
    (mut n).push("readlink")
    (mut n).push("realpath")
    (mut n).push("rm")
