/// Whether LIST holds NAME.
fn holds(list: List[str], name: str) -> bool {
    for n in list {
        if n == name {
            return true
        }
    }
    false
}

/// Run NAME, one of names(), on ARGS: what its own program does with them.
fn run(name: str, args: List[str]) -> int {
    if name == "[" then return bore.predicate_main("[", args)
    if name == "arch" then return arch.main(args)
    if name == "b2sum" then return checksum.command("b2sum", 10, 512, args)
    if name == "base32" then return codec.run("base32", 5, args)
    if name == "base64" then return codec.run("base64", 6, args)
    if name == "basename" then return basename.main(args)
    if name == "basenc" then return basenc.main(args)
    if name == "cat" then return cat.main(args)
    if name == "chcon" then return chcon.main(args)
    if name == "chgrp" then return bore.owner_main(true, args)
    if name == "chmod" then return chmod.main(args)
    if name == "chown" then return bore.owner_main(false, args)
    if name == "chroot" then return chroot.main(args)
    if name == "cksum" then return checksum.command("cksum", 0, 32, args)
    if name == "comm" then return comm.main(args)
    if name == "cp" then return cp.main(args)
    if name == "csplit" then return csplit.main(args)
    if name == "cut" then return cut.main(args)
    if name == "date" then return date.main(args)
    if name == "dir" then return listing.command("dir", args)
    if name == "dircolors" then return dircolors.main(args)
    if name == "dirname" then return dirname.main(args)
    if name == "du" then return du.main(args)
    if name == "echo" then return echo.main(args)
    if name == "env" then return env.main(args)
    if name == "expand" then return expand.main(args)
    if name == "expr" then return expr.main(args)
    if name == "factor" then return factor.main(args)
    if name == "false" then return false_.main(args)
    if name == "fmt" then return fmt.main(args)
    if name == "fold" then return fold.main(args)
    if name == "groups" then return groups.main(args)
    if name == "head" then return head.main(args)
    if name == "hostid" then return hostid.main(args)
    if name == "hostname" then return hostname.main(args)
    if name == "id" then return id.main(args)
    if name == "install" then return install.main(args)
    if name == "join" then return join.main(args)
    if name == "kill" then return kill.main(args)
    if name == "link" then return link.main(args)
    if name == "ln" then return ln.main(args)
    if name == "logname" then return logname.main(args)
    if name == "ls" then return listing.command("ls", args)
    if name == "md5sum" then return checksum.command("md5sum", 4, 128, args)
    if name == "mkdir" then return mkdir.main(args)
    if name == "mkfifo" then return mkfifo.main(args)
    if name == "mknod" then return mknod.main(args)
    if name == "mktemp" then return mktemp.main(args)
    if name == "mv" then return mv.main(args)
    if name == "nice" then return nice.main(args)
    if name == "nl" then return nl.main(args)
    if name == "nohup" then return nohup.main(args)
    if name == "nproc" then return nproc.main(args)
    if name == "numfmt" then return numfmt.main(args)
    if name == "od" then return od.main(args)
    if name == "paste" then return paste.main(args)
    if name == "pathchk" then return pathchk.main(args)
    if name == "pinky" then return pinky.main(args)
    if name == "pr" then return pr.main(args)
    if name == "printenv" then return printenv.main(args)
    if name == "printf" then return printf.main(args)
    if name == "ptx" then return ptx.main(args)
    if name == "pwd" then return pwd.main(args)
    if name == "readlink" then return readlink.main(args)
    if name == "realpath" then return realpath.main(args)
    if name == "rm" then return rm.main(args)
    if name == "rmdir" then return rmdir.main(args)
    if name == "runcon" then return runcon.main(args)
    if name == "seq" then return seq.main(args)
    if name == "sha1sum" then return checksum.command("sha1sum", 5, 160, args)
    if name == "sha224sum" then return checksum.command("sha224sum", 6, 224, args)
    if name == "sha256sum" then return checksum.command("sha256sum", 7, 256, args)
    if name == "sha384sum" then return checksum.command("sha384sum", 8, 384, args)
    if name == "sha512sum" then return checksum.command("sha512sum", 9, 512, args)
    if name == "shuf" then return shuf.main(args)
    if name == "sort" then return sort.main(args)
    if name == "split" then return split.main(args)
    if name == "stat" then return stat.main(args)
    if name == "stdbuf" then return stdbuf.main(args)
    if name == "stty" then return stty.main(args)
    if name == "sum" then return checksum.command("sum", 3, 16, args)
    if name == "tac" then return tac.main(args)
    if name == "tee" then return tee.main(args)
    if name == "test" then return bore.predicate_main("test", args)
    if name == "touch" then return touch.main(args)
    if name == "tr" then return tr.main(args)
    if name == "true" then return true_.main(args)
    if name == "truncate" then return truncate.main(args)
    if name == "tsort" then return tsort.main(args)
    if name == "tty" then return tty.main(args)
    if name == "uname" then return uname.main(args)
    if name == "unexpand" then return unexpand.main(args)
    if name == "uniq" then return uniq.main(args)
    if name == "unlink" then return unlink.main(args)
    if name == "uptime" then return uptime.main(args)
    if name == "users" then return users.main(args)
    if name == "vdir" then return listing.command("vdir", args)
    if name == "wc" then return wc.main(args)
    if name == "who" then return who.main(args)
    if name == "whoami" then return whoami.main(args)
    if name == "yes" then return yes.main(args)
    127
}

/// The bytes of PATH after its last slash.
fn base_name(path: List[byte]) -> List[byte] {
    var start = path.len
    while start > 0 && path[start - 1] != 47 as byte {
        start -= 1
    }
    path[start..]
}

/// `bore: unknown WHAT: NAME` on standard error, NAME as its bytes are,
/// and the status 127.
fn refuse(what: str, name: List[byte]) -> int {
    var line = "bore: unknown {what}: ".bytes()
    for b in name {
        (mut line).push(b)
    }
    (mut line).push(10 as byte)
    fs_write_chunk(2, line) else |_| {}
    127
}

fn main() -> int {
    let argv = env_args_bytes()
    var raw = List[byte]()
    if argv.len > 0 {
        raw = base_name(argv[0])
    }
    let name = str_from_utf8(raw) else |_| {
        return refuse("program name", raw)
    }
    if name != "bore" {
        if holds(names(), name) {
            return run(name, env_args())
        }
        return refuse("program name", raw)
    }
    if argv.len < 2 {
        return refuse("utility", List[byte]())
    }
    let word = str_from_utf8(argv[1]) else |_| {
        return refuse("utility", argv[1])
    }
    let all = env_args()
    let rest = all[1..]
    if holds(names(), word) {
        return run(word, rest)
    }
    refuse("utility", argv[1])
}
