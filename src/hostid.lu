//! member: false
//! hostid — Linux's persisted identifier, or its hosts-file IPv4 address.
//! References: GNU coreutils 9.11 manual/black-box gethostid runs;
//! Linux gethostid(3) documentation. No libc or GNU source.
//! The address rotation below was measured in the container. If no
//! hosts-file address is available, refuse the missing resolver surface
//! instead of printing zero or substituting a hash of the hostname.
//! Which hosts lines give an address was measured against GNU 9.11 too
//! (boreutils#72): a strict dotted quad, and `::1` as 127.0.0.1; any
//! other line naming the host is passed over.

use bore

fn hex(n: int) -> str {
    let digits = "0123456789abcdef"
    var text = ""
    var value = n
    for _ in 0..8 {
        let d = value % 16
        text = digits[d..d + 1] + text
        value /= 16
    }
    text
}

/// One part of a dotted quad as GNU reads it: one to three ASCII digits,
/// no leading zero, at most 255; -1 for anything else.
fn octet(part: str) -> int {
    if part.len == 0 || part.len > 3 { return -1 }
    if part.len > 1 && part.starts_with("0") { return -1 }
    var n = 0
    for b in part.bytes() {
        let d = b as int - 48
        if d < 0 || d > 9 { return -1 }
        n = n * 10 + d
    }
    if n > 255 { return -1 }
    n
}

/// A hosts line's address as four octets, or an empty list for a line GNU
/// passes over. `::1` is the loopback address, read as 127.0.0.1.
fn address(text: str) -> List[int] {
    var nums = List[int]()
    if text == "::1" {
        (mut nums).push(127)
        (mut nums).push(0)
        (mut nums).push(0)
        (mut nums).push(1)
        return nums
    }
    let parts = text.split(".")
    if parts.len != 4 { return List[int]() }
    for part in parts {
        let n = octet(part)
        if n < 0 { return List[int]() }
        (mut nums).push(n)
    }
    nums
}

fn identifier() -> int ! {unsupported} {
    if !bore.built_for_linux() { return unsupported }
    let saved = fs_read_bytes("/etc/hostid") else List[byte]()
    if saved.len >= 4 {
        return saved[0] as int +
            saved[1] as int * 256 +
            saved[2] as int * 65536 +
            saved[3] as int * 16777216
    }
    let hostname = bore.machine_field("hostname") else |_| { return unsupported }
    let config = fs_read_bytes("/etc/nsswitch.conf") else List[byte]()
    let nss = str_from_utf8(config) else ""
    var files_first = false
    for line in nss.lines() {
        if line.trim_start().starts_with("hosts:") {
            let list = line.trim_start()[6..].words()
            if list.len > 0 && list[0] == "files" { files_first = true }
        }
    }
    if !files_first { return unsupported }
    let bytes = fs_read_bytes("/etc/hosts") else |_| { return unsupported }
    let text = str_from_utf8(bytes) else |_| { return unsupported }
    for line in text.lines() {
        let fields = line.split("#")[0].words()
        if fields.len < 2 { continue }
        var matches = false
        for i in 1..fields.len { if fields[i].lower() == hostname.lower() { matches = true } }
        if !matches { continue }
        let nums = address(fields[0])
        if nums.len != 4 { continue }
        return nums[1] * 16777216 + nums[0] * 65536 + nums[3] * 256 + nums[2]
    }
    unsupported
}

fn main() -> int {
    var opts = List[bore.Opt]()
    (mut opts).push(bore.flag("", "help"))
    (mut opts).push(bore.flag("", "version"))
    let p = bore.parse(opts, env_args(), bore.permute())
    var out = bore.stdout()
    for key in p.keys {
        if key == "help" {
            bore.put(
                mut out,
                "Usage: hostid\nPrint the host's eight-digit hexadecimal identifier. DNS-only hosts require a resolver surface not supplied by wolf.\n",
            ) else |_| {}
            return bore.finish(mut out, "hostid", 0)
        }
        if key == "version" {
            bore.put(mut out, bore.version_text("hostid")) else |_| {}
            return bore.finish(mut out, "hostid", 0)
        }
    }
    if !bore.ok(p) { return bore.usage_error("hostid", p.error) }
    if p.operands.len > 0 {
        return bore.usage_error("hostid", "extra operand {bore.quote_always(p.operands[0])}")
    }
    let value = identifier() else |_| {
        bore.warn("hostid", "host address unavailable: wolf has no host-address resolver")
        return 1
    }
    bore.put(mut out, hex(value) + "\n") else |_| {}
    bore.finish(mut out, "hostid", 0)
}
