//! member: false
//! hostid — Linux's persisted identifier, or its hosts-file IPv4 address.
//! References: GNU coreutils 9.11 manual/black-box gethostid runs;
//! Linux gethostid(3) documentation. No libc or GNU source.
//! The address rotation below was measured in the container. If no
//! hosts-file address is available, refuse the missing resolver surface
//! instead of printing zero or substituting a hash of the hostname.
use bore

fn hex(n: int) -> str {
    let digits = "0123456789abcdef"
    var text = ""
    var value = n
    for _ in 0..8 { let d = value % 16; text = digits[d..d + 1] + text; value /= 16 }
    text
}

fn identifier() -> int ! {unsupported} {
    if !bore.built_for_linux() { return unsupported }
    let saved = fs_read_bytes("/etc/hostid") else List[byte]()
    if saved.len >= 4 { return saved[0] as int + saved[1] as int * 256 + saved[2] as int * 65536 + saved[3] as int * 16777216 }
    let hostname = bore.machine_field("hostname") else |_| { return unsupported }
    let config = fs_read_bytes("/etc/nsswitch.conf") else List[byte]()
    let nss = str_from_utf8(config) else ""
    var files_first = false
    for line in nss.lines() {
        if line.trim_start().starts_with("hosts:") {
            let list = line.trim_start()[6..].words()
            if list.len > 0 && list[0] == "files" { files_first = true }
        }
    }
    if !files_first { return unsupported }
    let bytes = fs_read_bytes("/etc/hosts") else |_| { return unsupported }
    let text = str_from_utf8(bytes) else |_| { return unsupported }
    for line in text.lines() {
        let fields = line.split("#")[0].words()
        if fields.len < 2 { continue }
        var matches = false
        for i in 1..fields.len { if fields[i].lower() == hostname.lower() { matches = true } }
        if !matches { continue }
        let parts = fields[0].split(".")
        if parts.len != 4 { continue }
        var nums = List[int]()
        for part in parts {
            let n = part.to_int() else |_| { return unsupported }
            if n < 0 || n > 255 { return unsupported }
            (mut nums).push(n)
        }
        return nums[1] * 16777216 + nums[0] * 65536 + nums[3] * 256 + nums[2]
    }
    unsupported
}

fn main() -> int {
    var opts = List[bore.Opt]()
    (mut opts).push(bore.flag("", "help")); (mut opts).push(bore.flag("", "version"))
    let p = bore.parse(opts, env_args(), bore.permute())
    var out = bore.stdout()
    for key in p.keys {
        if key == "help" { bore.put(mut out, "Usage: hostid\nPrint the host's eight-digit hexadecimal identifier. DNS-only hosts require a resolver surface not supplied by wolf.\n") else |_| {}; return bore.finish(mut out, "hostid", 0) }
        if key == "version" { bore.put(mut out, bore.version_text("hostid")) else |_| {}; return bore.finish(mut out, "hostid", 0) }
    }
    if !bore.ok(p) { return bore.usage_error("hostid", p.error) }
    if p.operands.len > 0 { return bore.usage_error("hostid", "extra operand {bore.quote_always(p.operands[0])}") }
    let value = identifier() else |_| { bore.warn("hostid", "host address unavailable: wolf has no host-address resolver"); return 1 }
    bore.put(mut out, hex(value) + "\n") else |_| {}
    bore.finish(mut out, "hostid", 0)
}
