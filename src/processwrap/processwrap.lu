//! Thin exec edge shared by nohup, nice and stdbuf.
//! References: POSIX.1-2024 exec and GNU 9.11 black-box runs.
//! Uses the same no-shebang shell fallback as this tree's env.

use bore

fn located(command: str) -> str {
    if command.contains("/") { return command }
    let path = env_get("PATH") else "/usr/bin:/bin"
    for dir in path.split(":") {
        let name = if dir.len == 0 then command else "{dir}/{command}"
        if fs_is_file(name) { return name }
    }
    ""
}

fn script(path: str) -> bool {
    let fd = fs_open(path) else |_| { return false }
    defer fs_close(fd) else |_| {}
    let b = fs_read_chunk(fd, 4) else |_| { return true }
    !(b.len >= 2 && b[0] as int == 35 && b[1] as int == 33) &&
        !(
            b.len >= 4 &&
                b[0] as int == 127 &&
                b[1] as int == 69 &&
                b[2] as int == 76 &&
                b[3] as int == 70
        )
}

/// Replace this process, falling back to /bin/sh for readable scripts.
/// Returns only on exec failure: 125 wrapper failure, 126 denied, 127 missing.
/// args must contain its command at index zero; fds follows os_exec mapping.
pub fn run(prog: str, args: List[str], fds: List[int]) -> int {
    let command = args[0]
    let vars = env_vars()
    var code = 0
    os_exec(command, args, vars, fds) else |e| match e {
        not_found => { code = 127 },
        denied => { code = 126 },
        io => { code = 1 },
        invalid => { code = 125 },
        unsupported => { code = 125 },
    }
    if code == 1 {
        let path = located(command)
        if path.len > 0 && script(path) {
            var shell = List[str]()
            (mut shell).push("/bin/sh")
            (mut shell).push(path)
            var i = 1
            while i < args.len { (mut shell).push(args[i]); i += 1 }
            os_exec("/bin/sh", shell, vars, fds) else |_| {}
        }
        code = 126
    }
    let why = if code == 127 {
        "No such file or directory"
    } else if code == 126 {
        "Permission denied"
    } else {
        "unsupported exec operation"
    }
    if prog == "nice" {
        bore.warn(prog, "{bore.quote_always(command)}: {why}")
    } else {
        bore.warn(prog, "failed to run command {bore.quote_always(command)}: {why}")
    }
    code
}
