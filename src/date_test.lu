//! Date grammar with an injected clock: relative items cannot race a day.

use bore

fn stamp(s: str) -> str {
    let now = bore.Instant { secs: 1668466800, nanos: 123000000 }
    let t = bore.date_read(s, bore.utc(), now) else |_| { return "refused" }
    bore.date_format("%F %T.%N", t, bore.utc()) else "refused"
}

fn model(fmt: str, secs: int, nanos: int, darwin: bool) -> str {
    let t = bore.Instant { secs: secs, nanos: nanos }
    bore.date_format_model(fmt, t, bore.utc(), darwin) else "refused"
}

fn main() {
    assert(stamp("@0") == "1970-01-01 00:00:00.000000000", "epoch")
    assert(stamp("@-0.0000000001") == "1969-12-31 23:59:59.999999999", "negative floor")
    assert(stamp("2022-12-31 -1 month") == "2022-12-01 00:00:00.000000000", "fuzzy month")
    assert(stamp("2022-11-14 3 days ago") == "2022-11-11 00:00:00.000000000", "ago")
    assert(stamp("2022-11-14 (") == "2022-11-14 00:00:00.000000000", "R-bu35-3")
    assert(stamp("Mon, 14 Nov 2022 21:02:42 +0000") == "2022-11-14 21:02:42.000000000", "RFC")
    assert(stamp("2020-02-30") == "refused", "invalid calendar")
    let early = bore.epoch_of(1, 1, 2, 3, 4, 5)
    assert(model("%c", early, 1, false) == "Tue Jan  2 03:04:05 1", "Linux C composite year")
    assert(model("%c", early, 1, true) == "Tue Jan  2 03:04:05 0001", "Darwin C composite year")
    assert(model("%Ec", early, 1, true) == "Tue Jan  2 03:04:05 0001", "Darwin alternate C composite")
    assert(model("%-N", 0, 123456789, false) == "123456789", "Linux default precision")
    assert(model("%-N", 0, 123456789, true) == "123456", "Darwin default precision")
    assert(model("%-8N", 0, 123456789, true) == "12345678", "explicit precision unchanged")
    assert(model("%N", 0, 123456789, true) == "123456789", "padded precision unchanged")
    assert(model("%c", -62167219200, 0, true) == "Sat Jan  1 00:00:00 0000", "Darwin year zero")
}
