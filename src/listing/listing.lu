}

fn indicator_meanings() -> List[int] {
    var s = List[int]()
    (mut s).push(no_indicator())
    (mut s).push(slash())
    (mut s).push(file_type())
    (mut s).push(classify())
    s
}

fn help() -> str {
    """
    Usage: ls [OPTION]... [FILE]...
    List each FILE, and the contents of each directory FILE (the
    working directory when there is none), sorted by name.

    Which names:
      -a, --all                  every name, the ones starting with . too
      -A, --almost-all           every name but . and ..
      -d, --directory            the operands themselves, not what they hold
      -R, --recursive            every directory under each one as well

    How they are laid out:
      -1                         one name per line (the default here)
      -C                         in columns, filled top to bottom
      -x                         in columns, filled left to right
      -m                         on lines, separated by commas
      -l                         the long format: mode, links, owner, group,
                                 size, time, name
      -g                         -l without the owner
      -o                         -l without the group
      -n, --numeric-uid-gid      -l with owner and group as numbers
      -G, --no-group             no group column in a long listing
          --full-time            -l with the whole time, to the nanosecond
          --time-style=STYLE     full-iso, long-iso, iso or locale
          --format=WORD          long or verbose (-l), vertical (-C), across
                                 or horizontal (-x), commas (-m),
                                 single-column (-1)
      -w, --width=COLS           the line width for -C, -x and -m
                                 (0: no limit; else COLUMNS, else 80)
      -T, --tabsize=COLS         a tab stop every COLS columns (0: no tabs)

    In what order (by name, in byte order, unless):
      -S                         largest first
      -t                         newest first
      -X                         by the text after the last .
      -U                         the directory's own order
      -f                         -a and -U
          --sort=WORD            none (-U), name, size (-S), time (-t),
                                 extension (-X)
      -r, --reverse              the other way round
          --group-directories-first  directories before everything else

    Which time (to show in -l; to sort by with -t, or without -l):
      -u                         the last access
      -c                         the last change of status
          --time=WORD            atime, ctime, mtime or birth

    What is shown:
      -s, --size                 each entry's allocated blocks before it
      -i, --inode                each entry's inode number before it
      -h, --human-readable       sizes and blocks in K, M, G (powers of 1024)
          --si                   the same in powers of 1000
      -k, --kibibytes            blocks of 1024 bytes (the default, unless
                                 POSIXLY_CORRECT is set)
      -F, --classify             / after a directory, @ after a link, * after
                                 an executable, | after a pipe, = after a
                                 socket
          --file-type            the same, less the *
      -p                         / after a directory
          --indicator-style=WORD none, slash (-p), file-type, classify (-F)
      -q, --hide-control-chars   ? for every byte that is not printable
          --show-control-chars   names as they are (the default off a terminal)
      -N, --literal              no quoting (on a terminal names are quoted
                                 as a shell would read them)

    Links:
      -H, --dereference-command-line  follow a link given as an operand
      -L, --dereference          follow every link

          --help                 print this help and exit
          --version              print the version and exit

    Not here yet, and refused by name: -v, the quoting styles but -N,
    --author, --block-size, --time-style=+FORMAT, and the colour and
    filtering options. On a terminal the width is -w, COLUMNS or 80: the
    terminal's own width cannot be asked. Owners and groups are named
    from /etc/passwd and /etc/group only.

    Exit status: 0 when all went well, 1 for a minor problem (an entry
    or a subdirectory it could not read), 2 for a serious one (an
    operand it could not reach, a bad option).

    boreutils: https://github.com/wolffe-lang/boreutils
    """
}

/// GNU escape style in LC_ALL=C: printable bytes except space/backslash
/// are literal, named C controls have short escapes, other bytes octal.
fn escaped(name: str) -> str {
    var bytes = List[byte]()
    for b in name.bytes() {
        let n = b as int
        var piece = ""
        if n == 32 { piece = "\\ " }
        else if n == 92 { piece = "\\\\" }
        else if n == 7 { piece = "\\a" }
        else if n == 8 { piece = "\\b" }
        else if n == 9 { piece = "\\t" }
        else if n == 10 { piece = "\\n" }
        else if n == 11 { piece = "\\v" }
        else if n == 12 { piece = "\\f" }
        else if n == 13 { piece = "\\r" }
        else if n < 32 || n >= 127 { piece = "\\{n / 64}{n / 8 % 8}{n % 8}" }
        else { (mut bytes).push(b); continue }
        for octet in piece.bytes() { (mut bytes).push(octet) }
    }
    str_from_utf8(bytes) else name
}
