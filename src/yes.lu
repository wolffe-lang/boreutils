//! member: false
//!
//! yes — write a line over and over until it is killed or the write
//! fails.
//!
//! References consulted: GNU coreutils 9.11 `yes --help` and black-box
//! runs of the GNU binary (`yes` is not in POSIX). Never GNU source.
//!
//! GNU's rules, each measured against coreutils 9.11:
//!
//! - The operands joined with single spaces are the line; with none it
//!   is `y`. `yes -- --help` writes `--help` forever.
//! - Options permute with operands unless `POSIXLY_CORRECT` is set, and
//!   an unknown option is a usage error with status 1.
//!
//! This is the first honest test of output throughput and of SIGPIPE: a
//! native wolf program dies on SIGPIPE exactly as GNU's does, with
//! status 141 and nothing on stderr.

use bore

fn main() -> int {
    let spec = options()
    let p = bore.parse(spec, env_args(), bore.permute())
    var out = bore.stdout()
    var i = 0
    while i < p.keys.len {
        let k = p.keys[i]
        if k == "help" {
            bore.put(mut out, help()) else |_| {}
            return bore.finish(mut out, "yes", 0)
        }
        if k == "version" {
            bore.put(mut out, bore.version_text("yes")) else |_| {}
            return bore.finish(mut out, "yes", 0)
        }
        i += 1
    }
    if !bore.ok(p) {
        return bore.usage_error("yes", p.error)
    }
    var line = "y\n"
    if p.operands.len > 0 {
        line = join(p.operands)
    }
    // GNU checks standard output before it starts, and a program that
    // writes for ever must not loop for ever against a descriptor it
    // cannot write. Measured at 9.11 on both hosts: `yes >&-` prints
    // `yes: standard output: Bad file descriptor` at once and exits 1.
    if !bore.output_ok(out, "yes") {
        return 1
    }
    repeat(mut out, line) else |_| {
        bore.write_error(out, "yes", "standard output")
        return 1
    }
    0
}

fn options() -> List[bore.Opt] {
    var s = List[bore.Opt]()
    (mut s).push(bore.flag("", "help"))
    (mut s).push(bore.flag("", "version"))
    s
}

/// The operands, separated by single spaces, and a newline.
fn join(words: List[str]) -> str {
    var line = ""
    var first = true
    for w in words {
        if first {
            line = w
        } else {
            line = "{line} {w}"
        }
        first = false
    }
    "{line}\n"
}

/// Write `line` forever. One buffer of whole lines is filled once and
/// written over and over: the buffer is what makes this faster than one
/// `write(2)` per line.
fn repeat(mut out: bore.Out, line: str) -> () ! {io} {
    var buf = List[byte]()
    while buf.len < 65536 {
        for b in line.bytes() {
            (mut buf).push(b)
        }
    }
    loop {
        bore.write_all(mut out, buf)?
    }
}

fn help() -> str {
    """
    Usage: yes [STRING]...
      or:  yes --help | --version
    Write a line holding the STRINGs, separated by single spaces, over
    and over. With no STRING the line is `y`.

          --help     print this help and exit
          --version  print the version and exit

    boreutils: https://github.com/wolffe-lang/boreutils
    """
}
