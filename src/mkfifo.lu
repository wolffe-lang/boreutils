//! member: false
//! mkfifo — make named pipes.
//! References consulted: POSIX.1-2024 mkfifo; GNU coreutils 9.11's
//! documented invocation and black-box binary runs. No implementation source.
//! -Z/--context are refused by name: wolf has no SELinux surface.
use bore

fn main() -> int {
    var opts = List[bore.Opt]()
    (mut opts).push(bore.takes("m", "mode"))
    (mut opts).push(bore.flag("Z", ""))
    (mut opts).push(bore.optional("", "context"))
    (mut opts).push(bore.flag("", "help"))
    (mut opts).push(bore.flag("", "version"))
    let p = bore.parse(opts, env_args(), bore.permute())
    var out = bore.stdout()
    var mode = 438
    var explicit = false
    var i = 0
    while i < p.keys.len {
        let k = p.keys[i]
        if k == "help" {
            bore.put(mut out, "Usage: mkfifo [OPTION]... NAME...\nMake named pipes; -m MODE sets permissions.\n-Z/--context require an unavailable SELinux surface.\n") else |_| {}
            return bore.finish(mut out, "mkfifo", 0)
        }
        if k == "version" {
            bore.put(mut out, bore.version_text("mkfifo")) else |_| {}
            return bore.finish(mut out, "mkfifo", 0)
        }
        if k == "Z" || k == "context" { bore.warn("mkfifo", "unsupported option: SELinux (-Z/--context)")
            return 1 }
        if k == "mode" {
            let m = bore.parse_mode(p.values[i]) else |_| {
                bore.warn("mkfifo", "invalid mode")
                return 1
            }
            mode = bore.apply_mode(m, 438, false, bore.current_umask())
            if mode >= 512 {
                bore.warn("mkfifo", "mode must specify only file permission bits")
                return 1
            }
            explicit = true
        }
        i += 1
    }
    if !bore.ok(p) { return bore.usage_error("mkfifo", p.error) }
    if p.operands.len == 0 { return bore.usage_error("mkfifo", "missing operand") }
    var status = 0
    for name in p.operands {
        var mask = -1
        if explicit { mask = os_umask(0) else -1 }
        var code = 0
        fs_mkfifo(name, mode % 512) else |_| { code = bore.host_code() }
        if mask >= 0 { let _ = os_umask(mask) else 0 }
        if code != 0 {
            bore.warn("mkfifo", "cannot create fifo {bore.quote_always(name)}: {bore.reason_of(code)}")
            status = 1
        } else if explicit && mode >= 512 {
            fs_set_mode(name, mode) else |_| {
                bore.warn("mkfifo", "cannot set permissions of {bore.quote_always(name)}: {bore.io_error()}")
                status = 1
            }
        }
    }
    bore.finish(mut out, "mkfifo", status)
}
