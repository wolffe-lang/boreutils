//! member: false
//! truncate — set or adjust file lengths without rewriting their bytes.
//! References consulted: GNU coreutils 9.11's documented invocation and
//! black-box runs. No implementation source. All size arithmetic is checked
//! before it reaches wolf's trapping arithmetic. -o is refused by name:
//! st_blocks is allocated space, not the unavailable st_blksize (R-bu30-1).
//! Listed open-surface gaps (notes/bu30/probes/open-gap.lu): no writable
//! mode without O_CREAT, so -c's stat/open check races a concurrent unlink;
//! no non-blocking writable open, so FIFO operands are refused by name.
//! A path changed into a FIFO after its stat can still block: the same
//! missing open flags prevent closing that race, not another path check.

use bore

fn size_word(text: str, leading: bool, negative: bool) -> int ! {invalid, large} {
    var i = 0
    var n = 0
    while leading && i < text.len {
        let b = text.bytes()[i] as int
        if b != 32 && (b < 9 || b > 13) { break }
        i += 1
    }
    let start = i
    while i < text.len {
        let b = text.bytes()[i] as int
        if b < 48 || b > 57 { break }
        let d = b - 48
        if negative {
            if n < (-9223372036854775808 + d) / 10 { return large }
            n = n * 10 - d
        } else {
            if n > (9223372036854775807 - d) / 10 { return large }
            n = n * 10 + d
        }
        i += 1
    }
    if i == start { return invalid }
    let tail = text[i..text.len]
    if tail.len == 0 { return n }
    var power = 0
    let marks = "kMGTPEZYRQ"
    var j = 0
    while j < marks.len {
        let a = marks.bytes()[j]
        if tail.bytes()[0] == a || j == 0 && tail.bytes()[0] == 75 as byte { power = j + 1 }
        j += 1
    }
    if power == 0 { return invalid }
    var base = 1024
    if tail.len == 2 && tail[1..2] == "B" {
        base = 1000
    } else if tail.len == 3 && tail[1..3] == "iB" {} else if tail.len != 1 {
        return invalid
    }
    while power > 0 {
        if negative {
            if n < -9223372036854775808 / base { return large }
        } else if n > 9223372036854775807 / base {
            return large
        }
        n *= base
        power -= 1
    }
    n
}

fn adjusted(old: int, n: int, how: str) -> int ! {invalid} {
    if how == "+" {
        if old > 9223372036854775807 - n { return invalid }
        return old + n
    }
    if how == "-" { return if n < -old then 0 else old + n }
    if how == "<" { return if old < n then old else n }
    if how == ">" { return if old > n then old else n }
    if how == "/" { if n == 0 { return invalid }; return old - old % n }
    if how == "%" {
        if n == 0 { return invalid }
        let extra = if old % n == 0 then 0 else n - old % n
        if old > 9223372036854775807 - extra { return invalid }
        return old + extra
    }
    n
}

fn main() -> int {
    var opts = List[bore.Opt]()
    (mut opts).push(bore.takes("s", "size"))
    (mut opts).push(bore.takes("r", "reference"))
    (mut opts).push(bore.flag("c", "no-create"))
    (mut opts).push(bore.flag("o", "io-blocks"))
    (mut opts).push(bore.flag("", "help"))
    (mut opts).push(bore.flag("", "version"))
    let p = bore.parse(opts, env_args(), bore.permute())
    var out = bore.stdout()
    var text = ""
    var sized = false
    var reference = ""
    var referenced = false
    var nocreate = false
    var blocks = false
    var i = 0
    while i < p.keys.len {
        let k = p.keys[i]
        if k == "help" {
            bore.put(
                mut out,
                "Usage: truncate OPTION... FILE...\n-s SIZE sets a length; + - < > / % adjust it.\n-r FILE supplies a reference length; -c avoids creation.\n-o/--io-blocks needs an unavailable st_blksize surface.\n",
            ) else |_| {}
            return bore.finish(mut out, "truncate", 0)
        }
        if k == "version" {
            bore.put(mut out, bore.version_text("truncate")) else |_| {}
            return bore.finish(mut out, "truncate", 0)
        }
        if k == "size" { sized = true; text = p.values[i] }
        if k == "reference" { reference = p.values[i]; referenced = true }
        if k == "no-create" { nocreate = true }
        if k == "io-blocks" { blocks = true }
        i += 1
    }
    if !bore.ok(p) { return bore.usage_error("truncate", p.error) }
    if blocks {
        bore.warn(
            "truncate",
            "-o (--io-blocks) is not supported by this truncate (requires st_blksize)",
        )
        return 1
    }
    if !sized && !referenced {
        return bore.usage_error(
            "truncate",
            "you must specify either {bore.quote_always("--size")} or {bore.quote_always("--reference")}",
        )
    }
    var n = 0
    var how = ""
    if sized {
        var digits = text
        if text.len > 0 && text.bytes()[0] as int < 128 && "+-<>/%".contains(text[0..1]) {
            how = text[0..1]
            digits = text[1..text.len]
        }
        n = size_word(digits, how != "+" && how != "-", how == "-") else |e| {
            var detail = ""
            match e {
                invalid => {},
                large => {
                    let code = if bore.built_for_linux() then 75 else 84
                    detail = ": {os_error_text(code)}"
                },
            }
            bore.warn("truncate", "Invalid number: {bore.quote(text)}{detail}")
            return 1
        }
        if (how == "/" || how == "%") && n == 0 {
            bore.warn("truncate", "division by zero")
            return 1
        }
    }
    if referenced && sized && how.len == 0 {
        return bore.usage_error(
            "truncate",
            "you must specify a relative {bore.quote_always("--size")} with {bore.quote_always("--reference")}",
        )
    }
    var refsize = -1
    if referenced {
        let r = fs_stat(reference) else |_| {
            bore.warn("truncate", "cannot stat {bore.quote_always(reference)}: {bore.io_error()}")
            return 1
        }
        refsize = bore.rec_size(r)
        if !sized { n = refsize }
    }
    if p.operands.len == 0 { return bore.usage_error("truncate", "missing file operand") }
    var status = 0
    for name in p.operands {
        if nocreate {
            let _ = fs_stat(name) else |e| {
                match e {
                    not_found => { continue },
                    denied => {},
                    io => {},
                }
                bore.warn(
                    "truncate",
                    "cannot open {bore.quote_always(name)} for writing: {bore.io_error()}",
                )
                status = 1
                continue
            }
        }
        let kind = fs_stat(name) else |_| List[int]()
        if kind.len == 20 && bore.rec_kind(kind) == bore.kind_fifo() {
            bore.warn(
                "truncate",
                "a non-blocking writable open is not supported by this truncate: {bore.quote_always(name)}",
            )
            status = 1
            continue
        }
        let fd = fs_open_mode(name, 2) else |_| {
            bore.warn(
                "truncate",
                "cannot open {bore.quote_always(name)} for writing: {bore.io_error()}",
            )
            status = 1
            continue
        }
        var old = refsize
        if old < 0 {
            let r = fs_fstat_record(fd) else |_| {
                bore.warn("truncate", "cannot fstat {bore.quote_always(name)}: {bore.io_error()}")
                fs_close(fd) else |_| {}
                status = 1
                continue
            }
            old = bore.rec_size(r)
        }
        let length = adjusted(old, n, how) else |_| {
            bore.warn("truncate", "overflow extending size of file {bore.quote_always(name)}")
            fs_close(fd) else |_| {}
            status = 1
            continue
        }
        fs_truncate(fd, length) else |_| {
            bore.warn(
                "truncate",
                "failed to truncate {bore.quote_always(name)} at {length} bytes: {bore.io_error()}",
            )
            status = 1
        }
        fs_close(fd) else |_| {}
    }
    bore.finish(mut out, "truncate", status)
}
