//! member: false
//!
//! wc — count lines, words, characters, bytes and the longest line.
//!
//! References consulted: POSIX.1-2024 `wc`; GNU coreutils 9.11
//! `wc --help` and black-box runs of the GNU binary on macOS arm64
//! (Homebrew `gwc`) and linux x86-64 (native `wc`); uutils/coreutils
//! (MIT) and toybox (0BSD) as design references for the shape of a
//! counting loop. Never GNU source.
//!
//! GNU's rules, each measured against coreutils 9.11 on BOTH hosts,
//! which agreed on every case below:
//!
//! - The counts always print in ONE order whatever order the flags are
//!   given in: lines, words, chars (`-m`), bytes (`-c`), longest line
//!   (`-L`). With no selecting flag it is lines, words, bytes.
//! - A word is a non-empty run of non-whitespace. Under `LC_ALL=C` the
//!   whitespace BYTES are 9, 10, 11, 12, 13, 32 and — measured on both
//!   hosts — 160. Under a UTF-8 locale it is the code-point set in
//!   `wide_space`, which includes U+00A0 and U+2060 but not U+0085,
//!   U+200B or U+FEFF.
//! - `-l` counts newline BYTES, so a last line with no newline is not
//!   counted, but its words, bytes and length are.
//! - **Which GNU.** This is 9.11's behaviour, and 9.11 is not 9.4:
//!   ubuntu-latest still ships 9.4, where `-w` SKIPS a byte that is not
//!   printable — it neither joins a word nor breaks one — and where
//!   byte 160 is an ordinary character. 9.11 counts such a byte as part
//!   of a word and treats 160 as whitespace, which is what this program
//!   does. Eight differential cases carry `gnu_min = "9.11"` for it.
//! - `-L` is a display width, not a count: a tab advances to the next
//!   multiple of 8, `\r` and `\f` reset the width to zero, `\n` ends
//!   the line, and a byte that is not printable has width 0. The
//!   running maximum is taken after every character, so `abcd\rx` is 4.
//! - An operand that is a directory still prints a line of zeros, then
//!   the error. An operand that cannot be opened prints no line. Either
//!   way the remaining operands are still counted and the status is 1.
//! - Usage errors exit 1 (not 2), as bu00 measured for this family.
//!
//! **The column width**, the subtlest rule here, measured on both hosts:
//! every count is right-aligned in one shared width, and that width is
//!
//!   1                        when `--total=only` is in force, or when
//!                            exactly one count is selected AND there is
//!                            exactly one input, or when the file names
//!                            are read from a stream (`--files0-from=-`)
//!   digits(sum of sizes)     when every input that exists is a regular
//!                            file (a missing operand contributes
//!                            nothing and does not spoil it)
//!   7                        when any input that exists is not a
//!                            regular file — a pipe, a device, a
//!                            directory — so no size is knowable
//!
//! **Locales.** wolf 0.2.14 has no locale surface, so this program reads
//! `LC_ALL`, then `LC_CTYPE`, then `LANG` (GNU's precedence, measured)
//! and decides only one thing: whether the character set is UTF-8. In
//! the C locale a character is a byte, which makes `-m` identical to
//! `-c`. In UTF-8 mode `-m`, `-w` and `-L` decode UTF-8, an invalid byte
//! is consumed alone and counts as NO character while still belonging to
//! a word and having width 0 (measured against GNU on both hosts), and
//! `-L` uses the compact width table in `width_of`: the C0/C1 controls
//! and the main combining and format ranges are 0, the East Asian Wide
//! and Fullwidth ranges and emoji are 2, everything else is 1. That
//! table agrees with both hosts' `wcwidth` on every code point in the
//! differential corpus; outside it, a host whose Unicode version is
//! newer may differ. No other locale behaviour (collation, digits) is
//! imitated, because nothing in wolf exposes it.
//!
//! **`-c` is an fstat, not a read**, for a file operand: `fs_fstat`
//! answers the size and the handle is ours, so the offset is 0. It is
//! NOT taken for standard input, even when standard input is a regular
//! file and GNU does take it there: what `wc -c` must report on a
//! descriptor is size minus the CURRENT OFFSET, wolf 0.2.14 has no seek
//! or tell in the fs family, and guessing zero is wrong whenever the
//! shell already consumed part of the file. Filed on wolf-lang#405 with
//! the measured cost (1 GiB: GNU 0.005 s, a full read ~0.4 s).
//!
//! **`--debug` is accepted and ignored.** GNU prints which SIMD kernel
//! its line counter chose; we have none to report (wolf has no way to
//! express a vectorized byte scan today — see the report on this lane).

use bore

/// Which counts were selected, in print order.
struct Sel {
    lines: bool,
    words: bool,
    chars: bool,
    bytes: bool,
    maxline: bool,
}

/// The counts for one input, or for the total.
struct Counts {
    lines: int,
    words: int,
    chars: int,
    bytes: int,
    maxline: int,
}

fn zero() -> Counts {
    Counts { lines: 0, words: 0, chars: 0, bytes: 0, maxline: 0 }
}

/// One input to count: a path, or standard input.
struct Input {
    /// The path to open; unused when `stdin` is true.
    path: str,
    /// The name to print after the counts; empty prints no name.
    label: str,
    stdin: bool,
}

/// How many counts `sel` prints.
fn columns(sel: Sel) -> int {
    var n = 0
    if sel.lines {
        n += 1
    }
    if sel.words {
        n += 1
    }
    if sel.chars {
        n += 1
    }
    if sel.bytes {
        n += 1
    }
    if sel.maxline {
        n += 1
    }
    n
}

/// The bytes one read asks for. `fs_read_chunk` clamps to 1 MiB, and
/// 1 MiB measured faster than 64 KiB on both hosts: 256 MiB reads in
/// 0.06 s against 0.09 s (nomad-1, release tier).
fn chunk() -> int {
    1048576
}

// ------------------------------------------------------------ the locale

/// Whether the character set from the environment is UTF-8. GNU's
/// precedence, measured: LC_ALL, then LC_CTYPE, then LANG, taking the
/// first that is set and non-empty.
pub fn utf8_locale(all: str, ctype: str, lang: str) -> bool {
    var v = all
    if v.len == 0 {
        v = ctype
    }
    if v.len == 0 {
        v = lang
    }
    let dot = v.rfind(".") else -1
    var codeset = v
    if dot >= 0 {
        codeset = v[dot + 1..]
    }
    let l = codeset.lower()
    l == "utf-8" || l == "utf8"
}

fn locale_is_utf8() -> bool {
    let all = env_get("LC_ALL") else ""
    let ctype = env_get("LC_CTYPE") else ""
    let lang = env_get("LANG") else ""
    utf8_locale(all, ctype, lang)
}

/// Whether the single BYTE `n` separates words in the C locale.
/// Measured on both hosts: 9..13, 32, and 160.
pub fn byte_space(n: int) -> bool {
    n == 32 || n >= 9 && n <= 13 || n == 160
}

/// Whether the code point `n` separates words in a UTF-8 locale.
/// Measured against GNU on both hosts over every code point in the
/// corpus: U+00A0 and U+2060 separate, U+0085, U+200B and U+FEFF do not.
pub fn wide_space(n: int) -> bool {
    if n < 128 {
        return n == 32 || n >= 9 && n <= 13
    }
    if n == 160 || n == 5760 {
        return true
    }
    if n >= 8192 && n <= 8202 {
        return true
    }
    if n == 8232 || n == 8233 || n == 8239 || n == 8287 || n == 8288 {
        return true
    }
    n == 12288
}

/// The display width of the code point `n`, in the compact table this
/// program documents: 0 for the controls and the main combining and
/// format ranges, 2 for the East Asian Wide and Fullwidth ranges and
/// emoji, 1 otherwise.
pub fn width_of(n: int) -> int {
    if n < 32 || n >= 127 && n < 160 {
        return 0
    }
    if zero_width(n) {
        return 0
    }
    if wide(n) {
        return 2
    }
    1
}

fn zero_width(n: int) -> bool {
    if n < 768 {
        return false
    }
    if n <= 879 {
        return true
    }
    if n >= 1155 && n <= 1161 {
        return true
    }
    if n >= 1425 && n <= 1469 {
        return true
    }
    if n == 1471 || n >= 1473 && n <= 1474 || n >= 1476 && n <= 1477 {
        return true
    }
    if n == 1479 || n >= 1552 && n <= 1562 || n >= 1611 && n <= 1631 {
        return true
    }
    if n == 1648 || n >= 1750 && n <= 1756 || n >= 1759 && n <= 1764 {
        return true
    }
    if n >= 1767 && n <= 1768 {
        return true
    }
    if n >= 1770 && n <= 1773 {
        return true
    }
    if n >= 1840 && n <= 1866 {
        return true
    }
    if n >= 2027 && n <= 2035 {
        return true
    }
    if n >= 2260 && n <= 2306 {
        return true
    }
    if n >= 3633 && n <= 3642 {
        return true
    }
    if n >= 3655 && n <= 3662 {
        return true
    }
    if n >= 3761 && n <= 3772 {
        return true
    }
    if n >= 4448 && n <= 4607 {
        return true
    }
    if n >= 7616 && n <= 7679 {
        return true
    }
    if n >= 8203 && n <= 8207 {
        return true
    }
    if n >= 8234 && n <= 8238 {
        return true
    }
    if n >= 8288 && n <= 8303 {
        return true
    }
    if n >= 8400 && n <= 8432 {
        return true
    }
    if n >= 12330 && n <= 12335 {
        return true
    }
    if n >= 12441 && n <= 12442 {
        return true
    }
    if n == 64286 {
        return true
    }
    if n >= 65024 && n <= 65039 {
        return true
    }
    if n >= 65056 && n <= 65071 {
        return true
    }
    if n == 65279 || n >= 65529 && n <= 65531 {
        return true
    }
    n >= 917760 && n <= 917999
}

fn wide(n: int) -> bool {
    if n < 4352 {
        return false
    }
    if n <= 4447 {
        return true
    }
    if n >= 8986 && n <= 8987 {
        return true
    }
    if n >= 9193 && n <= 9196 {
        return true
    }
    if n >= 11904 && n <= 12287 {
        return true
    }
    if n >= 12288 && n <= 19903 {
        return true
    }
    if n >= 19968 && n <= 42191 {
        return true
    }
    if n >= 44032 && n <= 55203 {
        return true
    }
    if n >= 63744 && n <= 64255 {
        return true
    }
    if n >= 65040 && n <= 65049 {
        return true
    }
    if n >= 65072 && n <= 65131 {
        return true
    }
    if n >= 65281 && n <= 65376 {
        return true
    }
    if n >= 65504 && n <= 65510 {
        return true
    }
    if n >= 127744 && n <= 128764 {
        return true
    }
    if n >= 128992 && n <= 129003 {
        return true
    }
    if n >= 129292 && n <= 129750 {
        return true
    }
    if n >= 131072 && n <= 196605 {
        return true
    }
    n >= 196608 && n <= 262141
}

// ---------------------------------------------------------- the counting

/// Count `fd` to end of file.
///
/// Three loops, because the hot ones must stay tight: bytes only, lines
/// only, and the general one. Measured on 256 MiB (nomad-1, release):
/// reading alone is 0.06 s, lines 0.14 s, lines and words 0.42 s.
fn scan(fd: int, sel: Sel, utf8: bool) -> Counts ! {io} {
    let want_chars = sel.chars && utf8
    if !sel.lines && !sel.words && !sel.maxline && !want_chars {
        return scan_bytes(fd)?
    }
    if sel.lines && !sel.words && !sel.maxline && !want_chars {
        return scan_lines(fd)?
    }
    if !utf8 && !sel.maxline {
        return scan_c(fd)?
    }
    scan_general(fd, utf8)?
}

/// Bytes only: no byte is looked at.
fn scan_bytes(fd: int) -> Counts ! {io} {
    var c = zero()
    loop {
        let piece = fs_read_chunk(fd, chunk()) else |e| match e {
            eof => { break },
            io => { return io },
        }
        c.bytes += piece.len
    }
    c.chars = c.bytes
    c
}

/// Lines and bytes.
fn scan_lines(fd: int) -> Counts ! {io} {
    var lines: int = 0
    var bytes: int = 0
    loop {
        let piece = fs_read_chunk(fd, chunk()) else |e| match e {
            eof => { break },
            io => { return io },
        }
        bytes += piece.len
        for b in piece {
            if b as int == 10 {
                lines += 1
            }
        }
    }
    var c = zero()
    c.lines = lines
    c.bytes = bytes
    c.chars = bytes
    c
}

/// Lines, words and bytes in the C locale: the default invocation, and
/// the one loop worth keeping tight. A comparison chain beat a
/// 256-entry class table by 0.07 s per 256 MiB on nomad-1, so the
/// chain stays.
fn scan_c(fd: int) -> Counts ! {io} {
    var lines: int = 0
    var words: int = 0
    var bytes: int = 0
    var inword = false
    loop {
        let piece = fs_read_chunk(fd, chunk()) else |e| match e {
            eof => { break },
            io => { return io },
        }
        bytes += piece.len
        for b in piece {
            let n = b as int
            if n == 10 {
                lines += 1
            }
            if n == 32 || n >= 9 && n <= 13 || n == 160 {
                inword = false
            } else if !inword {
                inword = true
                words += 1
            }
        }
    }
    var c = zero()
    c.lines = lines
    c.words = words
    c.bytes = bytes
    c.chars = bytes
    c
}

/// Everything else: the longest line, or a UTF-8 locale, or both. The
/// UTF-8 decoder carries its state across chunk boundaries, because a
/// character may straddle one.
fn scan_general(fd: int, utf8: bool) -> Counts ! {io} {
    var lines: int = 0
    var words: int = 0
    var chars: int = 0
    var bytes: int = 0
    var maxline: int = 0
    var pos: int = 0
    var inword = false
    // the UTF-8 decoder's state
    var pending = 0
    var cp: int = 0
    loop {
        let piece = fs_read_chunk(fd, chunk()) else |e| match e {
            eof => { break },
            io => { return io },
        }
        bytes += piece.len
        for b in piece {
            let n = b as int
            if !utf8 {
                chars += 1
                if n == 10 {
                    if pos > maxline {
                        maxline = pos
                    }
                    lines += 1
                    pos = 0
                } else if n == 13 || n == 12 {
                    if pos > maxline {
                        maxline = pos
                    }
                    pos = 0
                } else if n == 9 {
                    pos = (pos / 8 + 1) * 8
                } else if n >= 32 && n < 127 {
                    pos += 1
                }
                if byte_space(n) {
                    inword = false
                } else if !inword {
                    inword = true
                    words += 1
                }
                continue
            }
            if pending == 0 && n < 128 {
                // The ASCII fast path: one byte, one character, and the
                // C-locale rules are the UTF-8 rules below 128.
                chars += 1
                if n == 10 {
                    if pos > maxline {
                        maxline = pos
                    }
                    lines += 1
                    pos = 0
                } else if n == 13 || n == 12 {
                    if pos > maxline {
                        maxline = pos
                    }
                    pos = 0
                } else if n == 9 {
                    pos = (pos / 8 + 1) * 8
                } else if n >= 32 && n < 127 {
                    pos += 1
                }
                if n == 32 || n >= 9 && n <= 13 {
                    inword = false
                } else if !inword {
                    inword = true
                    words += 1
                }
                continue
            }
            // UTF-8: finish a pending sequence, or start one.
            var point = -1
            var invalid = false
            if pending > 0 {
                if n >= 128 && n < 192 {
                    cp = cp * 64 + (n - 128)
                    pending -= 1
                    if pending == 0 {
                        point = cp
                    }
                } else {
                    // the pending sequence was truncated: it counted
                    // nothing, and this byte starts again.
                    pending = 0
                    if n < 128 {
                        point = n
                    } else if n >= 194 && n < 224 {
                        pending = 1
                        cp = n - 192
                    } else if n >= 224 && n < 240 {
                        pending = 2
                        cp = n - 224
                    } else if n >= 240 && n < 245 {
                        pending = 3
                        cp = n - 240
                    } else {
                        invalid = true
                    }
                }
            } else if n < 128 {
                point = n
            } else if n >= 194 && n < 224 {
                pending = 1
                cp = n - 192
            } else if n >= 224 && n < 240 {
                pending = 2
                cp = n - 224
            } else if n >= 240 && n < 245 {
                pending = 3
                cp = n - 240
            } else {
                invalid = true
            }
            if invalid {
                // An invalid byte is consumed alone: no character, but
                // it belongs to a word and has width 0 (measured).
                if !inword {
                    inword = true
                    words += 1
                }
            } else if point >= 0 {
                chars += 1
                if point == 10 {
                    if pos > maxline {
                        maxline = pos
                    }
                    lines += 1
                    pos = 0
                } else if point == 13 || point == 12 {
                    if pos > maxline {
                        maxline = pos
                    }
                    pos = 0
                } else if point == 9 {
                    pos = (pos / 8 + 1) * 8
                } else {
                    pos += width_of(point)
                }
                if wide_space(point) {
                    inword = false
                } else if !inword {
                    inword = true
                    words += 1
                }
            }
        }
    }
    if pos > maxline {
        maxline = pos
    }
    var c = zero()
    c.lines = lines
    c.words = words
    c.chars = chars
    c.bytes = bytes
    c.maxline = maxline
    if !utf8 {
        c.chars = bytes
    }
    c
}

// ------------------------------------------------------------ formatting

/// Up to twenty spaces, sliced rather than built.
fn spaces(n: int) -> str {
    let pad = "                    "
    if n <= 0 {
        return ""
    }
    if n >= pad.len {
        return pad
    }
    pad[0..n]
}

/// The count of decimal digits in `n`, which is never negative here.
pub fn digits(n: int) -> int {
    var d = 1
    var v = n
    while v >= 10 {
        v = v / 10
        d += 1
    }
    d
}

/// One count, right-aligned in `width`.
fn field(n: int, width: int) -> str {
    let s = "{n}"
    if s.len >= width {
        return s
    }
    "{spaces(width - s.len)}{s}"
}

/// Write one output line: the selected counts in their fixed order,
/// separated by single spaces, then the label when there is one.
fn emit(mut out: bore.Out, c: Counts, sel: Sel, width: int, label: str) -> () ! {io} {
    var first = true
    if sel.lines {
        bore.put(mut out, field(c.lines, width))?
        first = false
    }
    if sel.words {
        if !first {
            bore.put(mut out, " ")?
        }
        bore.put(mut out, field(c.words, width))?
        first = false
    }
    if sel.chars {
        if !first {
            bore.put(mut out, " ")?
        }
        bore.put(mut out, field(c.chars, width))?
        first = false
    }
    if sel.bytes {
        if !first {
            bore.put(mut out, " ")?
        }
        bore.put(mut out, field(c.bytes, width))?
        first = false
    }
    if sel.maxline {
        if !first {
            bore.put(mut out, " ")?
        }
        bore.put(mut out, field(c.maxline, width))?
    }
    if label.len > 0 {
        bore.put(mut out, " ")?
        bore.put(mut out, label)?
    }
    bore.put(mut out, "\n")?
}

// ----------------------------------------------------------------- input

/// What an input is, for the width rule: 0 a regular file, 1 something
/// else that exists, 2 nothing that can be sized.
fn shape_of(path: str) -> int {
    if fs_is_file(path) {
        return 0
    }
    let _ = fs_size(path) else |_| {
        return 2
    }
    1
}

/// The shared column width. See the header for the rule.
fn width_for(inputs: List[Input], stdin_fd: int, ncols: int, only: bool, from_stream: bool) -> int {
    if only || from_stream {
        return 1
    }
    if ncols == 1 && inputs.len == 1 {
        return 1
    }
    var total: int = 0
    for inp in inputs {
        if inp.stdin {
            if stdin_fd < 0 {
                return 7
            }
            let st = fs_fstat(stdin_fd) else |_| {
                return 7
            }
            if st[0] != 0 {
                return 7
            }
            total += st[1]
        } else {
            let shape = shape_of(inp.path)
            if shape == 1 {
                return 7
            }
            if shape == 0 {
                total += fs_size(inp.path) else 0
            }
        }
    }
    digits(total)
}

/// The GNU wording for a row that came from opening or reading a file.
/// There is no `strerror` behind a row at 0.2.14 (wolf-lang#407), so
/// each row maps to the message GNU prints for the errno it stands for.
fn reason(tag: str) -> str {
    if tag == "not_found" {
        return "No such file or directory"
    }
    if tag == "denied" {
        return "Permission denied"
    }
    if tag == "isdir" {
        return "Is a directory"
    }
    "Input/output error"
}

/// The options, in the order GNU's own table declares them: the order
/// decides how `option '--=x' is ambiguous; possibilities: …` reads, and
/// that message is compared byte for byte.
fn options() -> List[bore.Opt] {
    var s = List[bore.Opt]()
    (mut s).push(bore.flag("c", "bytes"))
    (mut s).push(bore.flag("m", "chars"))
    (mut s).push(bore.flag("l", "lines"))
    (mut s).push(bore.flag("w", "words"))
    (mut s).push(bore.flag("", "debug"))
    (mut s).push(bore.takes("", "files0-from"))
    (mut s).push(bore.flag("L", "max-line-length"))
    (mut s).push(bore.takes("", "total"))
    (mut s).push(bore.flag("", "help"))
    (mut s).push(bore.flag("", "version"))
    s
}

/// Whether GNU leaves the byte `n` unquoted in a per-file diagnostic.
/// Measured against coreutils 9.11 over every ASCII punctuation mark on
/// both hosts: alphanumerics and `. - _ + , % @ # ] { } ~ /` are bare,
/// everything else — a space, `= : ! $ & ( ) * ? [ | ; < > ^` and the
/// quotes, control bytes and non-ASCII — makes the whole name quoted.
fn plain_byte(n: int) -> bool {
    if n >= 48 && n <= 57 || n >= 65 && n <= 90 || n >= 97 && n <= 122 {
        return true
    }
    n == 46 ||
        n == 45 ||
        n == 95 ||
        n == 43 ||
        n == 44 ||
        n == 37 ||
        n == 64 ||
        n == 35 ||
        n == 93 ||
        n == 123 ||
        n == 125 ||
        n == 126 ||
        n == 47
}

/// A file name as a diagnostic shows it: bare when it needs no quoting,
/// and in `bore.quote`'s shell style when it does.
fn shown(name: str) -> str {
    for b in name.bytes() {
        if !plain_byte(b as int) {
            return bore.quote(name)
        }
    }
    name
}

/// `--total=WHEN`, matched as GNU matches it: exactly, or as the unique
/// prefix of one valid word. -1 is unknown, -2 ambiguous.
pub fn total_mode(v: str) -> int {
    var names = List[str]()
    (mut names).push("auto")
    (mut names).push("always")
    (mut names).push("only")
    (mut names).push("never")
    var found = -1
    var count = 0
    var k = 0
    for n in names {
        if n == v {
            return k
        }
        if n.starts_with(v) {
            found = k
            count += 1
        }
        k += 1
    }
    if count > 1 {
        return -2
    }
    if found < 0 {
        return -1
    }
    found
}

fn total_words() -> str {
    "Valid arguments are:\n  - 'auto'\n  - 'always'\n  - 'only'\n  - 'never'"
}

/// Split a NUL-separated name list. A trailing NUL is optional, and an
/// empty name is kept so the caller can report its ordinal.
pub fn split_names(bytes: List[byte]) -> List[str] {
    var out = List[str]()
    var cur = List[byte]()
    var any = false
    for b in bytes {
        any = true
        if b as int == 0 {
            (mut out).push(str_from_utf8(cur) else "")
            cur = List[byte]()
            any = false
        } else {
            (mut cur).push(b)
        }
    }
    if any {
        (mut out).push(str_from_utf8(cur) else "")
    }
    out
}

fn main() -> int {
    let spec = options()
    let p = bore.parse(spec, env_args(), bore.permute())
    // Standard output is opened before any input file: with descriptor
    // 1 closed, the first file opened takes it (wolf-lang#405).
    var out = bore.stdout()
    var sel = Sel { lines: false, words: false, chars: false, bytes: false, maxline: false }
    var from = ""
    var has_from = false
    var mode = 0
    var i = 0
    while i < p.keys.len {
        let k = p.keys[i]
        let v = p.values[i]
        if k == "help" {
            bore.put(mut out, help()) else |_| {}
            return bore.finish(mut out, "wc", 0)
        }
        if k == "version" {
            bore.put(mut out, bore.version_text("wc")) else |_| {}
            return bore.finish(mut out, "wc", 0)
        }
        if k == "lines" {
            sel.lines = true
        }
        if k == "words" {
            sel.words = true
        }
        if k == "chars" {
            sel.chars = true
        }
        if k == "bytes" {
            sel.bytes = true
        }
        if k == "max-line-length" {
            sel.maxline = true
        }
        if k == "files0-from" {
            from = v
            has_from = true
        }
        if k == "total" {
            let m = total_mode(v)
            if m == -2 {
                return bore.usage_error(
                    "wc",
                    "ambiguous argument {bore.quote(v)} for '--total'\n{total_words()}",
                )
            }
            if m == -1 {
                return bore.usage_error(
                    "wc",
                    "invalid argument {bore.quote(v)} for '--total'\n{total_words()}",
                )
            }
            mode = m
        }
        i += 1
    }
    if !bore.ok(p) {
        return bore.usage_error("wc", p.error)
    }
    if columns(sel) == 0 {
        sel.lines = true
        sel.words = true
        sel.bytes = true
    }
    let utf8 = locale_is_utf8()
    var status = 0

    // The inputs, and standard input's handle when one is needed.
    var inputs = List[Input]()
    var stdin_fd = -1
    var from_stream = false
    if has_from {
        if p.operands.len > 0 {
            return bore.usage_error(
                "wc",
                "extra operand {bore.quote(p.operands[0])}\nfile operands cannot be combined with --files0-from",
            )
        }
        var raw = List[byte]()
        if from == "-" {
            from_stream = true
            stdin_fd = fs_open("/dev/stdin") else |_| {
                bore.warn("wc", "-: {reason("io")}")
                return bore.finish(mut out, "wc", 1)
            }
            loop {
                let piece = fs_read_chunk(stdin_fd, chunk()) else |e| match e {
                    eof => { break },
                    io => { break },
                }
                for b in piece {
                    (mut raw).push(b)
                }
            }
        } else {
            raw = fs_read_bytes(from) else |e| match e {
                not_found => {
                    bore.warn(
                        "wc",
                        "cannot open {bore.quote(from)} for reading: {reason("not_found")}",
                    )
                    return bore.finish(mut out, "wc", 1)
                },
                denied => {
                    bore.warn(
                        "wc",
                        "cannot open {bore.quote(from)} for reading: {reason("denied")}",
                    )
                    return bore.finish(mut out, "wc", 1)
                },
                io => {
                    bore.warn("wc", "cannot open {bore.quote(from)} for reading: {reason("io")}")
                    return bore.finish(mut out, "wc", 1)
                },
            }
        }
        let names = split_names(raw)
        var ordinal = 0
        for n in names {
            ordinal += 1
            if n.len == 0 {
                bore.warn("wc", "{from}:{ordinal}: invalid zero-length file name")
                status = 1
            } else if n == "-" && from_stream {
                bore.warn(
                    "wc",
                    "when reading file names from standard input, no file name of '-' allowed",
                )
                return bore.finish(mut out, "wc", 1)
            } else {
                (mut inputs).push(Input { path: n, label: n, stdin: false })
            }
        }
    } else {
        for o in p.operands {
            if o == "-" {
                (mut inputs).push(Input { path: "-", label: "-", stdin: true })
            } else {
                (mut inputs).push(Input { path: o, label: o, stdin: false })
            }
        }
        if inputs.len == 0 {
            (mut inputs).push(Input { path: "-", label: "", stdin: true })
        }
    }
    // Standard input is opened once, however many `-` operands name it.
    var needs_stdin = false
    for inp in inputs {
        if inp.stdin {
            needs_stdin = true
        }
    }
    if needs_stdin && stdin_fd < 0 {
        stdin_fd = fs_open("/dev/stdin") else |_| {
            -1
        }
    }

    let only = mode == 2
    let width = width_for(inputs, stdin_fd, columns(sel), only, from_stream)
    var total = zero()
    var counted = 0
    for inp in inputs {
        let one = count_one(inp, stdin_fd, sel, utf8, mut out, width, only) else |_| {
            status = 1
            continue
        }
        total.lines += one.lines
        total.words += one.words
        total.chars += one.chars
        total.bytes += one.bytes
        if one.maxline > total.maxline {
            total.maxline = one.maxline
        }
        counted += 1
    }
    let show_total = mode == 1 || only || mode == 0 && inputs.len > 1
    if show_total {
        var label = "total"
        if only {
            label = ""
        }
        emit(mut out, total, sel, width, label) else |_| {
            bore.warn("wc", "write error")
            return 1
        }
    }
    bore.finish(mut out, "wc", status)
}

/// Count one input and print its line. The row says the line was not
/// printed and the status must become 1; the message is already out.
fn count_one(
    inp: Input,
    stdin_fd: int,
    sel: Sel,
    utf8: bool,
    mut out: bore.Out,
    width: int,
    only: bool,
) -> Counts ! {failed} {
    var label = inp.label
    if only {
        label = ""
    }
    var fd = stdin_fd
    if !inp.stdin {
        fd = fs_open(inp.path) else |e| match e {
            not_found => {
                bore.warn("wc", "{shown(inp.label)}: {reason("not_found")}")
                return failed
            },
            denied => {
                bore.warn("wc", "{shown(inp.label)}: {reason("denied")}")
                return failed
            },
            io => {
                bore.warn("wc", "{shown(inp.label)}: {reason("io")}")
                return failed
            },
        }
    }
    if fd < 0 {
        bore.warn("wc", "{shown(inp.label)}: {reason("io")}")
        return failed
    }
    // A directory opens but cannot be read: GNU prints a line of zeros
    // and then the error, and the zeros join the total.
    var kind = 0
    var size: int = -1
    let st = fs_fstat(fd) else |_| {
        var none = List[int]()
        none
    }
    if st.len >= 2 {
        kind = st[0]
        size = st[1]
    }
    if kind == 1 {
        if !inp.stdin {
            fs_close(fd) else |_| {}
        }
        if !only {
            emit(mut out, zero(), sel, width, label) else |_| {}
        }
        bore.warn("wc", "{shown(inp.label)}: {reason("isdir")}")
        return failed
    }
    // `-c` (and `-m` in the C locale) on a regular file we opened is an
    // fstat, not a read: the handle is ours, so its offset is 0. Never
    // for standard input, which may already have been read from.
    let bytes_only = !sel.lines && !sel.words && !sel.maxline && !(sel.chars && utf8)
    if bytes_only && !inp.stdin && kind == 0 && size >= 0 {
        fs_close(fd) else |_| {}
        var c = zero()
        c.bytes = size
        c.chars = size
        if !only {
            emit(mut out, c, sel, width, label) else |_| {
                bore.warn("wc", "write error")
                return failed
            }
        }
        return c
    }
    let c = scan(fd, sel, utf8) else |_| {
        if !inp.stdin {
            fs_close(fd) else |_| {}
        }
        bore.warn("wc", "{shown(inp.label)}: {reason("io")}")
        return failed
    }
    if !inp.stdin {
        fs_close(fd) else |_| {}
    }
    if !only {
        emit(mut out, c, sel, width, label) else |_| {
            bore.warn("wc", "write error")
            return failed
        }
    }
    c
}

fn help() -> str {
    """
    Usage: wc [OPTION]... [FILE]...
      or:  wc [OPTION]... --files0-from=F
    Count the lines, words and bytes in each FILE, and a total line when
    there is more than one. With no FILE, or when FILE is -, read
    standard input.

    The counts always print in this order: lines, words, characters,
    bytes, longest line.

      -c, --bytes            print the byte count
      -m, --chars            print the character count
      -l, --lines            print the newline count
      -L, --max-line-length  print the display width of the longest line
      -w, --words            print the word count
          --files0-from=F    read the file names from F, NUL-separated;
                             with - read them from standard input
          --total=WHEN       when to print the total line: auto, always,
                             only or never
          --debug            accepted and ignored
          --help             print this help and exit
          --version          print the version and exit

    boreutils: https://github.com/wolffe-lang/boreutils
    """
}
