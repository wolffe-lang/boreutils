//! member: false
//!
//! logname — print the name the user logged in as.
//!
//! References consulted: POSIX.1-2024 `logname`; GNU coreutils 9.11
//! `logname --help` and the info manual's `logname invocation` node; the
//! `getlogin(3)`, `getutent(3)` and `utmp(5)` manual pages; black-box
//! runs of GNU's binary under `strace` in throwaway containers, with and
//! without a terminal and a utmp record (kasumi
//! `~/lanes/bu24/probes/p2.sh`), under `LC_ALL=C`. Never GNU source, nor
//! the C library's.
//!
//! What GNU 9.11 does on linux, measured (it asks `getlogin`):
//!
//! 1. it reads `/proc/self/loginuid`: the user id the kernel recorded at
//!    login, or 4294967295 when none was;
//! 2. none recorded: when standard input is a terminal it reads the
//!    terminal's name (`/proc/self/fd/0`, less `/dev/`) and looks in
//!    `/var/run/utmp` for the first login record (`USER_PROCESS` or
//!    `LOGIN_PROCESS`) on that line, and prints the record's user AS
//!    WRITTEN, with no account lookup (a record naming `zed`, whom
//!    `/etc/passwd` does not know, prints `zed`);
//! 3. otherwise `logname: no login name`, status 1. An operand is
//!    `extra operand 'X'`.
//!
//! This one reads the same files with no builtin: wolf has no
//! `getlogin`. A utmp record is `utmp(5)`'s 384 bytes on linux (x86-64
//! and arm64 alike): `ut_type` a 16-bit number at 0, `ut_line` 32 bytes
//! at 8, `ut_user` 32 bytes at 44.
//!
//! **What this cannot do:**
//!
//! - **macOS**: there `getlogin` asks the kernel for the session's login
//!   name, and wolf has no call for it. Refused by name, status 1 (the
//!   wolf issue is in boreutils' bu24 note).
//! - A login uid that IS recorded (`pam_loginuid`) is printed as that
//!   id's name in `/etc/passwd`; none of the hosts this lane measured on
//!   had one recorded, so that branch is written from `getlogin(3)` and
//!   is not measured against GNU.

use bore

fn main() -> int {
    let p = bore.parse(options(), env_args(), bore.permute())
    var out = bore.stdout()
    for key in p.keys {
        if key == "help" {
            bore.put(mut out, help()) else |_| {}
            return bore.finish(mut out, "logname", 0)
        }
        if key == "version" {
            bore.put(mut out, bore.version_text("logname")) else |_| {}
            return bore.finish(mut out, "logname", 0)
        }
    }
    if !bore.ok(p) {
        return bore.usage_error("logname", p.error)
    }
    if p.operands.len > 0 {
        return bore.usage_error("logname", "extra operand {bore.quote(p.operands[0])}")
    }
    if !bore.built_for_linux() {
        bore.warn("logname", "wolf cannot ask this host for the login name")
        return bore.finish(mut out, "logname", 1)
    }
    let name = login_name()
    if name == "\n" {
        bore.warn("logname", "no login name")
        return bore.finish(mut out, "logname", 1)
    }
    bore.put(mut out, "{name}\n") else |_| {}
    bore.finish(mut out, "logname", 0)
}

/// The login name, or a newline when there is none: a record's user
/// may be EMPTY, and GNU then prints an empty line, status 0 (measured).
fn login_name() -> str {
    let raw = fs_read_bytes("/proc/self/loginuid") else |_| {
        List[byte]()
    }
    let text = str_from_utf8(raw) else ""
    let uid = bore.id_number(text.trim())
    if uid >= 0 && uid != 4294967295 {
        let known = bore.name_of_user(bore.read_accounts(), uid)
        if known.len == 0 {
            return "\n"
        }
        return known
    }
    let tty = os_isatty(0) else false
    if !tty {
        return "\n"
    }
    let raw_path = fs_read_link("/proc/self/fd/0") else |_| {
        return "\n"
    }
    let path = str_from_utf8(raw_path) else ""
    if !path.starts_with("/dev/") {
        return "\n"
    }
    let line = path[5..]
    let utmp = fs_read_bytes("/var/run/utmp") else |_| {
        return "\n"
    }
    var at = 0
    while at + 384 <= utmp.len {
        let kind = utmp[at] as int + 256 * utmp[at + 1] as int
        if (kind == 6 || kind == 7) && field(utmp, at + 8, 32) == line {
            return field(utmp, at + 44, 32)
        }
        at += 384
    }
    "\n"
}

/// The NUL-ended text of `n` bytes at `at`, or `""` if it is not UTF-8.
fn field(b: List[byte], at: int, n: int) -> str {
    var end = at
    while end < at + n && b[end] as int != 0 {
        end += 1
    }
    str_from_utf8(b[at..end]) else ""
}

fn options() -> List[bore.Opt] {
    var s = List[bore.Opt]()
    (mut s).push(bore.flag("", "help"))
    (mut s).push(bore.flag("", "version"))
    s
}

fn help() -> str {
    """
    Usage: logname [OPTION]
    Print the name the user logged in as.

          --help     print this help and exit
          --version  print the version and exit

    boreutils: https://github.com/wolffe-lang/boreutils
    """
}
