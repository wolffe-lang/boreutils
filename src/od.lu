//! member: false
//! od — byte-exact integer/character and IEEE floating dumps.
//! References consulted: GNU coreutils 9.11 help and black-box probes;
//! IEEE 754 binary layouts. No implementation source. Floating decimal
//! arithmetic reuses this repository's own printf through floattext.

use bore
use floattext
use std.fmt

struct Type { code: str, size: int, width: int, floating: int, ascii: bool }
struct Options { base: int, skip: int, count: int, width: int, all: bool, big: bool, strings: int, label: int }
fn quantity(s: str) -> int {
    var k = 0, radix = 10
    if s.starts_with("0x") || s.starts_with("0X") { k = 2; radix = 16 }
    let start = k
    while k < s.len { let c = s.bytes()[k] as int; if c >= 48 && c <= 57 || radix == 16 && (c >= 97 && c <= 102 || c >= 65 && c <= 70) { k += 1 } else { break } }
    if k == start { return -1 }
    var n = fmt.parse_int_base(s[start..k], radix) else -1
    if n < 0 { return -1 }
    let suffix = s[k..]
    if suffix.len == 0 { return n }
    if suffix == "b" { if n > 9223372036854775807 / 512 { return -1 }; return n * 512 }
    let letters = "KMGTPEZYRQ"
    var power = 0
    for j in 0..letters.len { if suffix.starts_with(letters[j..j + 1]) { power = j + 1 } }
    if power == 0 { return -1 }
    let rest = suffix[1..]
    if rest != "" && rest != "B" && rest != "iB" { return -1 }
    let base = if rest == "B" then 1000 else 1024
    for _ in 0..power { if n > 9223372036854775807 / base { return -1 }; n *= base }
    n
}
fn old_offset(s: str) -> int {
    var word = s
    if word.starts_with("+") { word = word[1..] }
    var scale = 1
    if word.ends_with("b") { word = word[0..word.len - 1]; scale = 512 }
    var base = 8
    if word.ends_with(".") { base = 10; word = word[0..word.len - 1] }
    if word.starts_with("0x") || word.starts_with("0X") { base = 16; word = word[2..] }
    let n = fmt.parse_int_base(word, base) else -1
    if n < 0 || n > 9223372036854775807 / scale { return -1 }; n * scale
}
fn types(mut result: List[Type], word: str) -> bool {
    var k = 0
    while k < word.len {
        let code = word[k..k + 1]; k += 1
        if code != "a" && code != "c" && code != "d" && code != "f" && code != "o" && code != "u" && code != "x" { bore.warn("od", "invalid character {bore.quote_always(code)} in type string {bore.quote_always(word)}"); return false }
        var size = if code == "a" || code == "c" then 1 else if code == "f" then 8 else 4, floating = 0
        if code != "a" && code != "c" && k < word.len {
            let c = word[k..k + 1]
            var n = 0
            if c == "C" { n = 1 }; if c == "S" || c == "H" || c == "B" { n = 2 }; if c == "I" || c == "F" { n = 4 }; if c == "D" || c == "L" { n = 8 }
            if code == "f" && c == "L" { n = if fs_is_dir("/proc/self/fd") then 16 else 8 }
            if n > 0 { size = n; if c == "B" { floating = 3 }; k += 1 } else if c.bytes()[0] >= 48 as byte && c.bytes()[0] <= 57 as byte {
                let start = k
                while k < word.len && word.bytes()[k] >= 48 as byte && word.bytes()[k] <= 57 as byte { k += 1 }
                size = word[start..k].to_int() else 0
            }
        }
        if size != 1 && size != 2 && size != 4 && size != 8 && !(code == "f" && size == 16) {
            bore.warn("od", "invalid type string ‘{word}’;\nthis system doesn't provide a {size}-byte {if code == "f" then "floating point" else "integral"} type"); return false
        }
        if code == "f" { if size == 1 { bore.warn("od", "invalid floating point size"); return false }; if floating == 0 { floating = size } }
        var width = 3
        if code == "x" { width = 2 * size }; if code == "o" { width = (size * 8 + 2) / 3 }
        if code == "u" { width = if size == 1 then 3 else if size == 2 then 5 else if size == 4 then 10 else 20 }
        if code == "d" { width = if size == 1 then 4 else if size == 2 then 6 else if size == 4 then 11 else 20 }
        if code == "f" { width = if size <= 4 then 15 else if size == 8 then 24 else 29 }
        var ascii = false
        if k < word.len && word.bytes()[k] == 122 as byte { ascii = true; k += 1 }
        (mut result).push(Type { code: code, size: size, width: width, floating: floating, ascii: ascii })
    }
    true
}
fn address(n: int, o: Options) -> str {
    if o.base == 0 { return "" }
    let width = if o.base == 16 then 6 else 7
    let value = fmt.pad_left_with(fmt.to_str_base(n, o.base) else "0", width, "0")
    if o.label < 0 { return value }
    let label = o.label + n - o.skip
    value + " (" + fmt.pad_left_with(fmt.to_str_base(label, o.base) else "0", width, "0") + ")"
}
fn raw(bs: List[byte], at: int, size: int, end: int, big: bool) -> List[byte] {
    var result = List[byte]()
    for k in 0..size { (mut result).push(if at + k < end then bs[at + k] else 0 as byte) }
    result
}
fn unsigned(bs: List[byte], big: bool) -> wrapping[u64] {
    var value: wrapping[u64] = 0
    for k in 0..bs.len { value |= (bs[k] as int as wrapping[u64]) << (8 * (if big then bs.len - 1 - k else k)) as wrapping[u64] }
    value
}
fn character(b: int, named: bool) -> str {
    if named {
        let names = ["nul", "soh", "stx", "etx", "eot", "enq", "ack", "bel", "bs", "ht", "nl", "vt", "ff", "cr", "so", "si", "dle", "dc1", "dc2", "dc3", "dc4", "nak", "syn", "etb", "can", "em", "sub", "esc", "fs", "gs", "rs", "us"]
        let c = b % 128
        if c < 32 { return names[c] }; if c == 32 { return "sp" }; if c == 127 { return "del" }
        return str_from_utf8([c as byte]) else "?"
    }
    let controls = [0, 7, 8, 9, 10, 11, 12, 13]
    let labels = ["\\0", "\\a", "\\b", "\\t", "\\n", "\\v", "\\f", "\\r"]
    for k in 0..controls.len { if b == controls[k] { return labels[k] } }
    if b >= 32 && b <= 126 { return str_from_utf8([b as byte]) else "?" }
    fmt.pad_left_with(fmt.to_str_base(b, 8) else "0", 3, "0")
}
fn value(bs: List[byte], t: Type, big: bool) -> str {
    if t.code == "a" || t.code == "c" { return character(bs[0] as int, t.code == "a") }
    if t.code == "f" { return floattext.shortest(bs, t.floating, big) }
    let n = unsigned(bs, big)
    if t.code == "u" { return bore.u64_text(n) }
    if t.code == "d" {
        let high = 1 as wrapping[u64] << (8 * t.size - 1) as wrapping[u64]
        if n & high == 0 { return bore.u64_text(n) }
        var magnitude = (0 as wrapping[u64]) - n
        if t.size < 8 { magnitude &= (1 as wrapping[u64] << (8 * t.size) as wrapping[u64]) - 1 }
        return "-" + bore.u64_text(magnitude)
    }
    fmt.pad_left_with(bore.u64_radix(n, if t.code == "x" then 4 else 3, false), t.width, "0")
}
fn gcd(a: int, b: int) -> int { var x = a, y = b; while y != 0 { let r = x % y; x = y; y = r }; x }
fn main() -> int {
    var spec = List[bore.Opt]()
    for pair in [["A", "address-radix"], ["j", "skip-bytes"], ["N", "read-bytes"], ["t", "format"], ["", "endian"]] { (mut spec).push(bore.takes(pair[0], pair[1])) }
    (mut spec).push(bore.optional("w", "width")); (mut spec).push(bore.optional("S", "strings"))
    (mut spec).push(bore.flag("v", "output-duplicates")); (mut spec).push(bore.flag("", "traditional"))
    for key in ["a", "b", "c", "d", "f", "i", "l", "o", "s", "x"] { (mut spec).push(bore.flag(key, "")) }
    (mut spec).push(bore.flag("", "help")); (mut spec).push(bore.flag("", "version"))
    let p = bore.parse(spec, env_args(), bore.permute())
    var out = bore.stdout(), formats = List[Type]()
    var o = Options { base: 8, skip: 0, count: 9223372036854775807, width: 16, all: false, big: false, strings: 0, label: -1 }
    var traditional = false, width_given = false, modern = false
    for k in 0..p.keys.len {
        let key = p.keys[k], v = p.values[k]
        if key == "format" || key == "address-radix" || key == "skip-bytes" || key == "read-bytes" || key == "strings" { modern = true }
        if key == "help" || key == "version" { bore.put(mut out, if key == "version" then bore.version_text("od") else "Usage: od [OPTION]... [FILE]...\nDump bytes in character and numeric formats.\n") else |_| {}; return bore.finish(mut out, "od", 0) }
        if key == "format" { if !types(mut formats, v) { return 1 } }
        if key.len == 1 {
            let aliases = ["a", "o1", "c", "u2", "f4", "d4", "d8", "o2", "d2", "x2"]
            let keys = ["a", "b", "c", "d", "f", "i", "l", "o", "s", "x"]
            for j in 0..keys.len { if key == keys[j] { if !types(mut formats, aliases[j]) { return 1 } } }
        }
        if key == "address-radix" { if v == "n" { o.base = 0 } else if v == "d" { o.base = 10 } else if v == "x" { o.base = 16 } else if v == "o" { o.base = 8 } else { bore.warn("od", "invalid radix for --address-radix: {bore.quote_always(v)}"); return 1 } }
        if key == "skip-bytes" || key == "read-bytes" || key == "width" || key == "strings" {
            var n = quantity(v)
            if !p.given[k] && key == "width" { n = 32 }; if !p.given[k] && key == "strings" { n = 3 }
            if n < 0 { bore.warn("od", "invalid {key} argument {bore.quote_always(v)}"); return 1 }
            if key == "skip-bytes" { o.skip = n }; if key == "read-bytes" { o.count = n }; if key == "width" { o.width = n; width_given = true }; if key == "strings" { o.strings = n }
        }
        if key == "output-duplicates" { o.all = true }; if key == "traditional" { traditional = true }
        if key == "endian" { if v == "big" { o.big = true } else if v == "little" { o.big = false } else { return bore.usage_error("od", "invalid endianness {bore.quote_always(v)}") } }
    }
    if !bore.ok(p) { return bore.usage_error("od", p.error) }
    var paths = copy p.operands
    if paths.len > 0 {
        let last = paths[paths.len - 1]
        var old = last.starts_with("+") || paths.len == 2 && last.len > 0 && last.bytes()[0] >= 48 as byte && last.bytes()[0] <= 57 as byte
        if traditional { old = old || old_offset(last) >= 0 }
        if old && (!modern || traditional) {
            let n = old_offset(last)
            if n < 0 { bore.warn("od", "invalid offset: {bore.quote_always(last)}"); return 1 }
            let _ = (mut paths).pop()
            if traditional && paths.len > 0 && old_offset(paths[paths.len - 1]) >= 0 { o.label = n; o.skip = old_offset(paths[paths.len - 1]); let _ = (mut paths).pop() } else { o.skip = n }
        }
    }
    if paths.len == 0 { (mut paths).push("-") }
    if formats.len == 0 { if !types(mut formats, "o2") { return 1 } }
    var multiple = 1
    for t in formats { multiple = multiple / gcd(multiple, t.size) * t.size }
    if o.width <= 0 || o.width % multiple != 0 { bore.warn("od", "warning: invalid width {o.width}; using {multiple} instead"); o.width = multiple }
    if !width_given && o.width < multiple { o.width = multiple }
    var data = List[byte](), skipped = 0, status = 0, done = false, opened = false
    for path in paths {
        if done { break }
        let src = bore.open_input(path) else |_| { bore.input_error("od", path, bore.reason_of(bore.host_code())); status = 1; continue }
        opened = true
        var eof = false
        while !eof && !done {
            let needed = if skipped < o.skip then o.skip - skipped else o.count - data.len
            if needed == 0 { done = true; break }
            let chunk = bore.read_chunk(src, if needed < 65536 then needed else 65536) else |e| match e { eof => { eof = true; List[byte]() }, io => { bore.warn("od", "read error: {bore.io_error()}"); status = 1; eof = true; List[byte]() } }
            if chunk.len == 0 { eof = true }
            if skipped < o.skip { skipped += chunk.len } else { for b in chunk { (mut data).push(b) } }
        }
        bore.close_input(src)
    }
    if !opened { return status }
    if skipped < o.skip { bore.warn("od", "cannot skip past end of combined input"); return 1 }
    if o.strings > 0 {
        var start = 0
        for k in 0..data.len {
            let c = data[k] as int
            if c == 0 {
                if k - start >= o.strings { let addr = address(o.skip + start, o); if addr.len > 0 { bore.put(mut out, addr + " ") else |_| { return bore.finish(mut out, "od", 1) } }; for j in start..k { bore.put_byte(mut out, data[j]) else |_| { return bore.finish(mut out, "od", 1) } }; bore.put(mut out, "\n") else |_| { return bore.finish(mut out, "od", 1) } }
                start = k + 1
            } else if c < 32 || c > 126 { start = k + 1 }
        }
        return bore.finish(mut out, "od", status)
    }
    var rowchars = 0
    for t in formats { let n = o.width / t.size * (t.width + 1); if n > rowchars { rowchars = n } }
    var at = 0, previous = -1, suppressed = false
    while at < data.len {
        let end = if data.len - at < o.width then data.len else at + o.width
        var equal = previous >= 0 && end - at == o.width
        if equal { for k in 0..o.width { if data[at + k] != data[previous + k] { equal = false } } }
        if equal && !o.all { if !suppressed { bore.put(mut out, "*\n") else |_| { return bore.finish(mut out, "od", 1) } }; suppressed = true; at = end; continue }
        suppressed = false
        let addr = address(o.skip + at, o)
        for t_index in 0..formats.len {
            let t = copy formats[t_index]
            bore.put(mut out, if t_index == 0 then addr else " ".repeat(addr.len)) else |_| { return bore.finish(mut out, "od", 1) }
            let cell = rowchars / (o.width / t.size)
            var pos = at, used = 0
            while pos < end {
                let text = value(raw(data, pos, t.size, end, o.big), t, o.big)
                bore.put(mut out, " " + fmt.pad_left(text, cell - 1)) else |_| { return bore.finish(mut out, "od", 1) }
                used += cell; pos += t.size
            }
            if t.ascii {
                bore.put(mut out, " ".repeat(rowchars - used) + "  >") else |_| { return bore.finish(mut out, "od", 1) }
                for k in at..end { let c = data[k] as int; bore.put_byte(mut out, if c >= 32 && c <= 126 then data[k] else 46 as byte) else |_| { return bore.finish(mut out, "od", 1) } }
                bore.put(mut out, "<") else |_| { return bore.finish(mut out, "od", 1) }
            }
            bore.put(mut out, "\n") else |_| { return bore.finish(mut out, "od", 1) }
        }
        previous = at; at = end
    }
    if o.base != 0 { bore.put(mut out, address(o.skip + data.len, o) + "\n") else |_| { return bore.finish(mut out, "od", 1) } }
    bore.finish(mut out, "od", status)
}
