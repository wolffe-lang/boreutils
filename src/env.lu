//! member: false
//!
//! env — run a program in a changed environment, or print the
//! environment.
//!
//! References consulted: POSIX.1-2024 `env`; GNU coreutils 9.11
//! `env --help`, the info manual's `env invocation` node, and black-box
//! runs of the GNU binary on linux x86-64 and macOS arm64 (Homebrew
//! `genv`), under `LC_ALL=C` (kasumi `~/lanes/bu20/probe6.sh`). Never
//! GNU source.
//!
//! `env` REPLACES itself with the program (`os_exec`, wolf 0.2.27, s225,
//! ruling #62): the process id stays, no child is started, and the
//! program's status is the status.
//!
//! GNU's rules, each measured against 9.11:
//!
//! - The command line is options, then `NAME=VALUE` words, then the
//!   COMMAND and its arguments. Options do not permute: the first word
//!   that is not one ends them (`env A=1 -u A` runs a program named
//!   `-u`). A lone `-` among the first words is `-i`.
//! - `-i` starts from an empty environment; `-u NAME` removes a
//!   variable (every `-u` before any `NAME=VALUE`, wherever they were
//!   written); each `NAME=VALUE` replaces the variable where it stands
//!   or is added as a new one — at the end on linux, at the front on
//!   macOS, as each host's C library has it. An empty or `=`-holding
//!   name to `-u` is `cannot unset`, status 125.
//! - With no COMMAND the environment is printed, one entry a line, or
//!   NUL-ended under `-0`; `-0` with a COMMAND is a usage error.
//! - `-C DIR` changes the working directory before the COMMAND, and
//!   needs one. `-a WORD` makes WORD the program's own name for itself
//!   (its `argv[0]`).
//! - The COMMAND is searched along the `PATH` of the NEW environment —
//!   the one the program is handed — else `/usr/bin:/bin` (ruling #62,
//!   and what GNU's does).
//! - Statuses: the COMMAND's own; 125 when `env` itself fails; 126 when
//!   the COMMAND is found and cannot be run (`Permission denied`); 127
//!   when it is not found.
//!
//! **What wolf cannot see, and what that costs** (each a stated skip in
//! `tests/cases/env.toml`, never an imitation):
//!
//! - **The environment's own order.** `env_vars()` answers it SORTED and
//!   leaves out an entry that is not UTF-8 (wolf-lang#535). So a bare
//!   `env`, and what a COMMAND inherits without `-i`, hold GNU's entries
//!   in a different order, less any that is not UTF-8. Under `-i` the
//!   order is exact.
//! - **Why a program could not be run.** `os_exec` answers a row, and
//!   the os family does not leave the host's number behind
//!   (`[os.fs.error]`; wolf-lang#682), so anything but "not found" and
//!   "permission denied" has no words of its own here. A file with no
//!   `#!` line is the one case `env` works out for itself, because GNU's
//!   `execvp` then runs it under `/bin/sh`: when the row is `io` and the
//!   file does not start with `#!` or an ELF header, so does this.
//! - **`=VALUE`**, an entry with an empty name: GNU hands it on;
//!   `os_exec` refuses the whole environment as `invalid`
//!   (`[os.proc.exec]`). It is printed by a bare `env`, and with a
//!   COMMAND is status 125, said so.
//! - `-S`/`--split-string`, `-v`/`--debug` and the signal options
//!   (`--block-signal`, `--default-signal`, `--ignore-signal`,
//!   `--list-signal-handling`) are not written yet, and are refused by
//!   name (status 125) rather than ignored.

use bore

fn main() -> int {
    let p = bore.parse(options(), env_args(), false)
    var out = bore.stdout()
    var ignore = false
    var zero = false
    var dir = ""
    var chdir = false
    var argv0 = ""
    var renamed = false
    var unset = List[str]()
    var refused = ""
    var i = 0
    while i < p.keys.len {
        let k = p.keys[i]
        let v = p.values[i]
        if k == "help" {
            bore.put(mut out, help()) else |_| {}
            return done(mut out, 0)
        }
        if k == "version" {
            bore.put(mut out, bore.version_text("env")) else |_| {}
            return done(mut out, 0)
        }
        if k == "ignore-environment" {
            ignore = true
        } else if k == "null" {
            zero = true
        } else if k == "unset" {
            (mut unset).push(v)
        } else if k == "chdir" {
            dir = v
            chdir = true
        } else if k == "argv0" {
            argv0 = v
            renamed = true
        } else if refused.len == 0 {
            refused = "option '--{k}' is not written yet"
        }
        i += 1
    }
    if !bore.ok(p) {
        eprint("env: {p.error}\nTry 'env --help' for more information.")
        return 125
    }
    if refused.len > 0 {
        bore.warn("env", refused)
        return 125
    }
    // A lone `-` before the assignments is -i; then the assignments;
    // what is left is the command.
    var at = 0
    if at < p.operands.len && p.operands[at] == "-" {
        ignore = true
        at += 1
    }
    var vars = List[str]()
    if !ignore {
        // Sorted, and less any entry that is not UTF-8 (wolf-lang#535).
        for kv in env_vars() {
            (mut vars).push(kv)
        }
    }
    for name in unset {
        if name.len == 0 || name.contains("=") {
            bore.warn("env", "cannot unset {bore.quote(name)}: Invalid argument")
            return 125
        }
        vars = without(vars, name)
    }
    var empty_name = false
    while at < p.operands.len && p.operands[at].contains("=") {
        let word = p.operands[at]
        if word.starts_with("=") {
            empty_name = true
        }
        set(mut vars, word)
        at += 1
    }
    if at >= p.operands.len {
        if chdir {
            eprint(
                "env: must specify command with --chdir (-C)\nTry 'env --help' for more information.",
            )
            return 125
        }
        for kv in vars {
            bore.put(mut out, kv) else |_| {}
            if zero {
                bore.put_byte(mut out, 0 as byte) else |_| {}
            } else {
                bore.put_byte(mut out, 10 as byte) else |_| {}
            }
        }
        return done(mut out, 0)
    }
    if zero {
        eprint(
            "env: cannot specify --null (-0) with command\nTry 'env --help' for more information.",
        )
        return 125
    }
    let command = p.operands[at]
    var argv = List[str]()
    (mut argv).push(if renamed then argv0 else command)
    var k = at + 1
    while k < p.operands.len {
        (mut argv).push(p.operands[k])
        k += 1
    }
    if chdir {
        let why = enter(dir)
        if why.len > 0 {
            bore.warn("env", "cannot change directory to {bore.quote(dir)}: {why}")
            return 125
        }
    }
    if empty_name {
        bore.warn(
            "env",
            "cannot run {bore.quote(command)}: an entry with an empty name ('=VALUE') cannot be handed to a program ([os.proc.exec])",
        )
        return 125
    }
    let map = List[int]()
    var row = 0
    os_exec(command, argv, vars, map) else |e| match e {
        not_found => {
            row = 1
        },
        denied => {
            row = 2
        },
        io => {
            row = 3
        },
        invalid => {
            row = 4
        },
        unsupported => {
            row = 5
        },
    }
    // Only a failed exec comes back.
    if row == 1 {
        bore.warn("env", "{bore.quote(command)}: No such file or directory")
        return 127
    }
    if row == 2 {
        bore.warn("env", "{bore.quote(command)}: Permission denied")
        return 126
    }
    if row == 3 {
        // A file the kernel will not run that has no `#!` line and is no
        // ELF image is a script for `/bin/sh`, as GNU's `execvp` has it.
        let found = located(command, vars)
        if found.len > 0 && is_script(found) {
            var shell = List[str]()
            (mut shell).push("/bin/sh")
            (mut shell).push(found)
            var j = at + 1
            while j < p.operands.len {
                (mut shell).push(p.operands[j])
                j += 1
            }
            os_exec("/bin/sh", shell, vars, map) else |_| {}
        }
        bore.warn(
            "env",
            "{bore.quote(command)}: cannot be run, and wolf does not say why (wolf-lang#682)",
        )
        return 126
    }
    if row == 4 {
        bore.warn(
            "env",
            "cannot run {bore.quote(command)}: os_exec refuses this command line or environment ([os.proc.exec]: a NUL, or an entry with no name)",
        )
        return 125
    }
    bore.warn("env", "cannot run {bore.quote(command)}: this host has no exec")
    125
}

/// `bore.finish`, with env's status for a failed write: 125.
fn done(mut out: bore.Out, status: int) -> int {
    bore.flush(mut out) else |_| {
        bore.write_error(out, "env", "write error")
        return 125
    }
    status
}

/// The name of a `NAME=VALUE` entry.
fn name_of(entry: str) -> str {
    let eq = entry.find("=") else entry.len
    entry[0..eq]
}

/// `vars` less every entry named `name`.
fn without(vars: List[str], name: str) -> List[str] {
    var kept = List[str]()
    for kv in vars {
        if name_of(kv) != name {
            (mut kept).push(kv)
        }
    }
    kept
}

/// Put the entry `word` (`NAME=VALUE`) into `vars`: over the entry of
/// that name where it stands, else as a NEW entry — at the end on
/// linux and at the FRONT on macOS. That is where each host's C library
/// puts a variable it did not have, and GNU's `env` shows it: `env -i
/// A=1 B=2` prints `A=1` first on linux and `B=2` first on macOS
/// (measured, CI run 38115337070, the macOS job).
fn set(mut vars: List[str], word: str) {
    let name = name_of(word)
    var k = 0
    while k < vars.len {
        if name_of(vars[k]) == name {
            vars[k] = word
            return
        }
        k += 1
    }
    if bore.built_for_linux() {
        (mut vars).push(word)
        return
    }
    var moved = List[str]()
    (mut moved).push(word)
    for kv in vars {
        (mut moved).push(kv)
    }
    vars = moved
}

/// Change the working directory to `dir`; `""`, or the reason it could
/// not be entered in the host's words. `os_chdir` answers a row and
/// leaves no number (`[os.fs.error]`), so a directory that is there and
/// is not one is told apart by asking.
fn enter(dir: str) -> str {
    var why = ""
    os_chdir(dir) else |e| match e {
        not_found => {
            why = "No such file or directory"
        },
        denied => {
            why = "Permission denied"
        },
        io => {
            why = if fs_exists(dir) && !fs_is_dir(dir) {
                "Not a directory"
            } else {
                "Input/output error"
            }
        },
    }
    why
}

/// Where `os_exec` found `command`: itself when it holds a `/`, else the
/// first file along the `PATH` of `vars` (or `/usr/bin:/bin`) that is a
/// regular file (ruling #62's rule, restated to find the script).
fn located(command: str, vars: List[str]) -> str {
    if command.contains("/") {
        return command
    }
    var path = "/usr/bin:/bin"
    for kv in vars {
        if kv.starts_with("PATH=") {
            path = kv[5..]
            break
        }
    }
    for part in path.split(":") {
        let candidate = if part.len == 0 then command else "{part}/{command}"
        if fs_is_file(candidate) {
            return candidate
        }
    }
    ""
}

/// Whether the file at `path` is one the kernel refuses for want of a
/// `#!` line: readable, and starting with neither `#!` nor an ELF
/// header.
fn is_script(path: str) -> bool {
    let fd = fs_open(path) else |_| {
        return false
    }
    let head = fs_read_chunk(fd, 4) else |_| {
        List[byte]()
    }
    fs_close(fd) else |_| {}
    if head.len >= 2 && head[0] as int == 35 && head[1] as int == 33 {
        return false
    }
    if head.len >= 4 &&
        head[0] as int == 127 &&
        head[1] as int == 69 &&
        head[2] as int == 76 &&
        head[3] as int == 70 {
        return false
    }
    true
}

fn options() -> List[bore.Opt] {
    var s = List[bore.Opt]()
    (mut s).push(bore.takes("a", "argv0"))
    (mut s).push(bore.flag("i", "ignore-environment"))
    (mut s).push(bore.flag("0", "null"))
    (mut s).push(bore.takes("u", "unset"))
    (mut s).push(bore.takes("C", "chdir"))
    (mut s).push(bore.takes("S", "split-string"))
    (mut s).push(bore.optional("", "block-signal"))
    (mut s).push(bore.optional("", "default-signal"))
    (mut s).push(bore.optional("", "ignore-signal"))
    (mut s).push(bore.flag("", "list-signal-handling"))
    (mut s).push(bore.flag("v", "debug"))
    (mut s).push(bore.flag("", "help"))
    (mut s).push(bore.flag("", "version"))
    s
}

fn help() -> str {
    """
    Usage: env [OPTION]... [-] [NAME=VALUE]... [COMMAND [ARG]...]
    Set each NAME to VALUE in the environment and run COMMAND; with no
    COMMAND, print the resulting environment.

      -a, --argv0=WORD          pass WORD as COMMAND's name for itself
      -i, --ignore-environment  start with an empty environment (so does -)
      -0, --null                end each printed entry with NUL, not newline
      -u, --unset=NAME          remove NAME from the environment
      -C, --chdir=DIR           change the working directory to DIR first
          --help                print this help and exit
          --version             print the version and exit

    COMMAND replaces env: its status is the status. Otherwise 125 when
    env itself fails, 126 when COMMAND is found and cannot be run, 127
    when it is not found.

    Not here yet, and refused by name: -S, -v and the signal options.
    Without -i the environment is in sorted order, not the order it was
    received in.

    boreutils: https://github.com/wolffe-lang/boreutils
    """
}
