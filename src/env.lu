//! member: false
//!
//! env — run a program in a changed environment, or print the
//! environment.
//!
//! References consulted: POSIX.1-2024 `env`; GNU coreutils 9.11
//! `env --help`, the info manual's `env invocation` node, and black-box
//! runs of the GNU binary on linux x86-64 and macOS arm64 (Homebrew
//! `genv`), under `LC_ALL=C` (kasumi `~/lanes/bu20/probe6.sh`). Never
//! GNU source.
//!
//! `env` REPLACES itself with the program (`os_exec`, wolf 0.2.27, s225,
//! ruling #62): the process id stays, no child is started, and the
//! program's status is the status.
//!
//! GNU's rules, each measured against 9.11:
//!
//! - The command line is options, then `NAME=VALUE` words, then the
//!   COMMAND and its arguments. Options do not permute: the first word
//!   that is not one ends them (`env A=1 -u A` runs a program named
//!   `-u`). A lone `-` among the first words is `-i`.
//! - `-i` starts from an empty environment; `-u NAME` removes a
//!   variable (every `-u` before any `NAME=VALUE`, wherever they were
//!   written); each `NAME=VALUE` replaces the variable where it stands
//!   or is added as a new one — at the end on linux, at the front on
//!   macOS, as each host's C library has it. An empty or `=`-holding
//!   name to `-u` is `cannot unset`, status 125.
//! - With no COMMAND the environment is printed, one entry a line, or
//!   NUL-ended under `-0`; `-0` with a COMMAND is a usage error.
//! - `-C DIR` changes the working directory before the COMMAND, and
//!   needs one. `-a WORD` makes WORD the program's own name for itself
//!   (its `argv[0]`).
//! - The COMMAND is searched along the `PATH` of the NEW environment —
//!   the one the program is handed — else `/usr/bin:/bin` (ruling #62,
//!   and what GNU's does).
//! - Statuses: the COMMAND's own; 125 when `env` itself fails; 126 when
//!   the COMMAND is found and cannot be run (`Permission denied`); 127
//!   when it is not found.
//!
//! **What wolf cannot see, and what that costs** (each a stated skip in
//! `tests/cases/env.toml`, never an imitation):
//!
//! - **The environment's own order.** `env_vars()` answers it SORTED and
//!   leaves out an entry that is not UTF-8 (wolf-lang#535). So a bare
//!   `env`, and what a COMMAND inherits without `-i`, hold GNU's entries
//!   in a different order, less any that is not UTF-8. Under `-i` the
//!   order is exact.
//! - **Why a program could not be run.** `os_exec` answers a row, and
//!   the os family does not leave the host's number behind
//!   (`[os.fs.error]`; wolf-lang#682), so anything but "not found" and
//!   "permission denied" has no words of its own here. A file with no
//!   `#!` line is the one case `env` works out for itself, because GNU's
//!   `execvp` then runs it under `/bin/sh`: when the row is `io` and the
//!   file does not start with `#!` or an ELF header, so does this.
//! - **`=VALUE`**, an entry with an empty name: GNU hands it on;
//!   `os_exec` refuses the whole environment as `invalid`
//!   (`[os.proc.exec]`). It is printed by a bare `env`, and with a
//!   COMMAND is status 125, said so.
//! - `-S` and `-v` follow the documented token and trace grammars.
//!   Ignore actions use native dispositions. Nonempty --block-signal
//!   remains refused: wolf has no mask setter. Default actions refuse
//!   blocked/unknown masks rather than leaving a signal silently blocked.
//!   Listing reads documented Linux /proc masks; other hosts refuse it.

use bore

fn main() -> int {
    let expanded = expand_arguments(env_args())
    if expanded.error.len > 0 { bore.warn("env", expanded.error); return 125 }
    let p = bore.parse(options(), expanded.words, false)
    var out = bore.stdout()
    let table = bore.signal_table()
    var actions = List[int]()
    var all_actions = List[bool]()
    var unblocks = List[bool]()
    for _ in table.numbers {
        (mut actions).push(0)
        (mut all_actions).push(false)
        (mut unblocks).push(false)
    }
    var list_signals = false
    var debug = false
    var ignore = false
    var zero = false
    var dir = ""
    var chdir = false
    var argv0 = ""
    var renamed = false
    var unset = List[str]()
    var refused = ""
    var i = 0
    while i < p.keys.len {
        let k = p.keys[i]
        let v = p.values[i]
        if k == "help" {
            bore.put(mut out, help()) else |_| {}
            return done(mut out, 0)
        }
        if k == "version" {
            bore.put(mut out, bore.version_text("env")) else |_| {}
            return done(mut out, 0)
        }
        if k == "ignore-environment" {
            ignore = true
        } else if k == "null" {
            zero = true
        } else if k == "unset" {
            (mut unset).push(v)
        } else if k == "chdir" {
            dir = v
            chdir = true
        } else if k == "argv0" {
            argv0 = v
            renamed = true
        } else if k == "debug" {
            debug = true
        } else if k == "list-signal-handling" {
            list_signals = true
        } else if k == "block-signal" || k == "default-signal" || k == "ignore-signal" {
            var entries = List[int]()
            if !p.given[i] {
                for index in 0..table.numbers.len {
                    if table.named[index] { (mut entries).push(index) }
                }
            } else if v.len > 0 {
                for word in v.split(",") {
                    let index = bore.signal_entry(table, word) else -1
                    if index < 0 {
                        bore.warn("env", "{bore.quote(word)}: invalid signal")
                        eprint("Try 'env --help' for more information.")
                        return 125
                    }
                    (mut entries).push(index)
                }
            }
            if k == "block-signal" && entries.len > 0 {
                refused = "--block-signal is not supported: wolf has no signal-mask setter"
            } else {
                for index in entries {
                    actions[index] = if k == "ignore-signal" then 1 else 2
                    all_actions[index] = !p.given[i]
                    if k == "default-signal" { unblocks[index] = true }
                }
            }
        } else if refused.len == 0 {
            refused = "option '--{k}' is not supported"
        }
        i += 1
    }
    if !bore.ok(p) {
        eprint("env: {p.error}\nTry 'env --help' for more information.")
        return 125
    }
    if refused.len > 0 {
        bore.warn("env", refused)
        return 125
    }
    // A lone `-` before the assignments is -i; then the assignments;
    // what is left is the command.
    var at = 0
    if at < p.operands.len && p.operands[at] == "-" {
        ignore = true
        at += 1
    }
    var vars = List[str]()
    if !ignore {
        // Sorted, and less any entry that is not UTF-8 (wolf-lang#535).
        for kv in env_vars() {
            (mut vars).push(kv)
        }
    }
    for name in unset {
        if name.len == 0 || name.contains("=") {
            bore.warn("env", "cannot unset {bore.quote(name)}: Invalid argument")
            return 125
        }
        vars = without(vars, name)
    }
    if debug {
        if ignore {
            eprint("cleaning environ")
        } else {
            for name in unset { eprint("unset:    {name}") }
        }
    }
    var empty_name = false
    while at < p.operands.len && p.operands[at].contains("=") {
        let word = p.operands[at]
        if debug { eprint("setenv:   {word}") }
        if word.starts_with("=") {
            empty_name = true
        }
        set(mut vars, word)
        at += 1
    }
    if !signal_actions(table, actions, all_actions, unblocks, debug, list_signals) { return 125 }
    if at >= p.operands.len {
        if chdir {
            eprint(
                "env: must specify command with --chdir (-C)\nTry 'env --help' for more information.",
            )
            return 125
        }
        for kv in vars {
            bore.put(mut out, kv) else |_| {}
            if zero {
                bore.put_byte(mut out, 0 as byte) else |_| {}
            } else {
                bore.put_byte(mut out, 10 as byte) else |_| {}
            }
        }
        return done(mut out, 0)
    }
    if zero {
        eprint(
            "env: cannot specify --null (-0) with command\nTry 'env --help' for more information.",
        )
        return 125
    }
    let command = p.operands[at]
    var argv = List[str]()
    (mut argv).push(if renamed then argv0 else command)
    var k = at + 1
    while k < p.operands.len {
        (mut argv).push(p.operands[k])
        k += 1
    }
    if chdir {
        if debug { eprint("chdir:    {bore.quote(dir)}") }
        let why = enter(dir)
        if why.len > 0 {
            bore.warn("env", "cannot change directory to {bore.quote(dir)}: {why}")
            return 125
        }
    }
    if empty_name {
        bore.warn(
            "env",
            "cannot run {bore.quote(command)}: an entry with an empty name ('=VALUE') cannot be handed to a program ([os.proc.exec])",
        )
        return 125
    }
    if debug {
        if renamed { eprint("argv0:     {bore.quote(argv0)}") }
        eprint("executing: {command}")
        for index in 0..argv.len { eprint("   arg[{index}]= {bore.quote(argv[index])}") }
    }
    let map = List[int]()
    var row = 0
    os_exec(command, argv, vars, map) else |e| match e {
        not_found => {
            row = 1
        },
        denied => {
            row = 2
        },
        io => {
            row = 3
        },
        invalid => {
            row = 4
        },
        unsupported => {
            row = 5
        },
    }
    // Only a failed exec comes back.
    if row == 1 {
        bore.warn("env", "{bore.quote(command)}: No such file or directory")
        return 127
    }
    if row == 2 {
        bore.warn("env", "{bore.quote(command)}: Permission denied")
        return 126
    }
    if row == 3 {
        // A file the kernel will not run that has no `#!` line and is no
        // ELF image is a script for `/bin/sh`, as GNU's `execvp` has it.
        let found = located(command, vars)
        if found.len > 0 && is_script(found) {
            var shell = List[str]()
            (mut shell).push("/bin/sh")
            (mut shell).push(found)
            var j = at + 1
            while j < p.operands.len {
                (mut shell).push(p.operands[j])
                j += 1
            }
            os_exec("/bin/sh", shell, vars, map) else |_| {}
        }
        bore.warn(
            "env",
            "{bore.quote(command)}: cannot be run, and wolf does not say why (wolf-lang#682)",
        )
        return 126
    }
    if row == 4 {
        bore.warn(
            "env",
            "cannot run {bore.quote(command)}: os_exec refuses this command line or environment ([os.proc.exec]: a NUL, or an entry with no name)",
        )
        return 125
    }
    bore.warn("env", "cannot run {bore.quote(command)}: this host has no exec")
    125
}

/// `bore.finish`, with env's status for a failed write: 125.
fn done(mut out: bore.Out, status: int) -> int {
    bore.flush(mut out) else |_| {
        bore.write_error(out, "env", "write error")
        return 125
    }
    status
}

/// The name of a `NAME=VALUE` entry.
fn name_of(entry: str) -> str {
    let eq = entry.find("=") else entry.len
    entry[0..eq]
}

/// `vars` less every entry named `name`.
fn without(vars: List[str], name: str) -> List[str] {
    var kept = List[str]()
    for kv in vars {
        if name_of(kv) != name {
            (mut kept).push(kv)
        }
    }
    kept
}

/// Put the entry `word` (`NAME=VALUE`) into `vars`: over the entry of
/// that name where it stands, else as a NEW entry — at the end on
/// linux and at the FRONT on macOS. That is where each host's C library
/// puts a variable it did not have, and GNU's `env` shows it: `env -i
/// A=1 B=2` prints `A=1` first on linux and `B=2` first on macOS
/// (measured, CI run 38115337070, the macOS job).
fn set(mut vars: List[str], word: str) {
    let name = name_of(word)
    var k = 0
    while k < vars.len {
        if name_of(vars[k]) == name {
            vars[k] = word
            return
        }
        k += 1
    }
    if bore.built_for_linux() {
        (mut vars).push(word)
        return
    }
    var moved = List[str]()
    (mut moved).push(word)
    for kv in vars {
        (mut moved).push(kv)
    }
    vars = moved
}

/// Change the working directory to `dir`; `""`, or the reason it could
/// not be entered in the host's words. `os_chdir` answers a row and
/// leaves no number (`[os.fs.error]`), so a directory that is there and
/// is not one is told apart by asking.
fn enter(dir: str) -> str {
    var why = ""
    os_chdir(dir) else |e| match e {
        not_found => {
            why = "No such file or directory"
        },
        denied => {
            why = "Permission denied"
        },
        io => {
            why = if fs_exists(dir) && !fs_is_dir(dir) {
                "Not a directory"
            } else {
                "Input/output error"
            }
        },
    }
    why
}

/// Where `os_exec` found `command`: itself when it holds a `/`, else the
/// first file along the `PATH` of `vars` (or `/usr/bin:/bin`) that is a
/// regular file (ruling #62's rule, restated to find the script).
fn located(command: str, vars: List[str]) -> str {
    if command.contains("/") {
        return command
    }
    var path = "/usr/bin:/bin"
    for kv in vars {
        if kv.starts_with("PATH=") {
            path = kv[5..]
            break
        }
    }
    for part in path.split(":") {
        let candidate = if part.len == 0 then command else "{part}/{command}"
        if fs_is_file(candidate) {
            return candidate
        }
    }
    ""
}

/// Whether the file at `path` is one the kernel refuses for want of a
/// `#!` line: readable, and starting with neither `#!` nor an ELF
/// header.
fn is_script(path: str) -> bool {
    let fd = fs_open(path) else |_| {
        return false
    }
    let head = fs_read_chunk(fd, 4) else |_| {
        List[byte]()
    }
    fs_close(fd) else |_| {}
    if head.len >= 2 && head[0] as int == 35 && head[1] as int == 33 {
        return false
    }
    if head.len >= 4 &&
        head[0] as int == 127 &&
        head[1] as int == 69 &&
        head[2] as int == 76 &&
        head[3] as int == 70 {
        return false
    }
    true
}

fn options() -> List[bore.Opt] {
    var s = List[bore.Opt]()
    (mut s).push(bore.takes("a", "argv0"))
    (mut s).push(bore.flag("i", "ignore-environment"))
    (mut s).push(bore.flag("0", "null"))
    (mut s).push(bore.takes("u", "unset"))
    (mut s).push(bore.takes("C", "chdir"))
    (mut s).push(bore.takes("S", "split-string"))
    (mut s).push(bore.optional("", "block-signal"))
    (mut s).push(bore.optional("", "default-signal"))
    (mut s).push(bore.optional("", "ignore-signal"))
    (mut s).push(bore.flag("", "list-signal-handling"))
    (mut s).push(bore.flag("v", "debug"))
    (mut s).push(bore.flag("", "help"))
    (mut s).push(bore.flag("", "version"))
    s
}

fn help() -> str {
    """
    Usage: env [OPTION]... [-] [NAME=VALUE]... [COMMAND [ARG]...]
    Set each NAME to VALUE in the environment and run COMMAND; with no
    COMMAND, print the resulting environment.

      -a, --argv0=WORD          pass WORD as COMMAND's name for itself
      -i, --ignore-environment  start with an empty environment (so does -)
      -0, --null                end each printed entry with NUL, not newline
      -u, --unset=NAME          remove NAME from the environment
      -C, --chdir=DIR           change the working directory to DIR first
          --help                print this help and exit
          --version             print the version and exit

    COMMAND replaces env: its status is the status. Otherwise 125 when
    env itself fails, 126 when COMMAND is found and cannot be run, 127
    when it is not found.

    -S splits documented quotes/escapes/variables; -v traces processing.
    Signal mask changes are refused (the toolchain has no mask setter).
    Without -i the environment is in sorted order, not the order it was
    received in.

    boreutils: https://github.com/wolffe-lang/boreutils
    """
}

struct SplitResult { words: List[str], error: str }

fn split_word(mut words: List[str], mut bytes: List[byte], mut active: bool) {
    if active { (mut words).push(str_from_utf8(bytes) else "") }
    bytes = List[byte]()
    active = false
}

// GNU documented -S grammar, independently tokenized. No shell execution.
fn split_string(text: str, debug: bool) -> SplitResult {
    var words = List[str]()
    var bytes = List[byte]()
    var active = false
    var quote = 0
    var k = 0
    var error = ""
    while k < text.len {
        let b = text.bytes()[k] as int
        if quote == 0 && (b == 32 || b >= 9 && b <= 13) {
            split_word(mut words, mut bytes, mut active)
            k += 1
            continue
        }
        if quote == 0 && b == 35 && !active { break }
        if b == 39 && quote != 34 || b == 34 && quote != 39 {
            quote = if quote == 0 then b else 0
            active = true
            k += 1
            continue
        }
        if b == 92 {
            if k + 1 >= text.len { error = "invalid backslash at end of string in -S"; break }
            let next = text.bytes()[k + 1] as int
            if quote == 39 && next != 39 && next != 92 {
                (mut bytes).push(b as byte)
                active = true
                k += 1
                continue
            }
            if next == 99 {
                if quote == 34 { error = "'\\c' must not appear in double-quoted -S string" }
                break
            }
            if next == 95 && quote == 0 {
                split_word(mut words, mut bytes, mut active)
                k += 2
                continue
            }
            let meanings = [12, 10, 13, 9, 11, 35, 36, 32, 34, 39, 92]
            let codes = "fnrtv#$_\"'\\"
            var translated = -1
            for i in 0..codes.len {
                if next == codes.bytes()[i] as int { translated = meanings[i] }
            }
            if translated < 0 { error = "invalid sequence '\\{text[k + 1..k + 2]}' in -S"; break }
            (mut bytes).push(translated as byte)
            active = true
            k += 2
            continue
        }
        if b == 36 && quote != 39 {
            var end = k + 2
            if k + 1 < text.len && text.bytes()[k + 1] as int == 123 {
                while end < text.len && text.bytes()[end] as int != 125 { end += 1 }
            }
            var valid = k + 1 < text.len &&
                text.bytes()[k + 1] as int == 123 &&
                end < text.len &&
                end > k + 2
            var index = k + 2
            while index < end && index < text.len {
                let c = text.bytes()[index] as int
                if !(
                    c == 95 ||
                        c >= 65 && c <= 90 ||
                        c >= 97 && c <= 122 ||
                        index > k + 2 && c >= 48 && c <= 57
                ) {
                    valid = false
                }
                index += 1
            }
            if !valid {
                error = "only ${{VARNAME}} expansion is supported, error at: {text[k..]}"
                break
            }
            let name = text[k + 2..end]
            let value = env_get(name) else ""
            if debug {
                if value.len == 0 {
                    eprint("replacing ${{{name}}} with null string")
                } else {
                    eprint("expanding ${{{name}}} into {bore.quote(value)}")
                }
            }
            for byte in value.bytes() { (mut bytes).push(byte) }
            if value.len > 0 { active = true }
            k = end + 1
            continue
        }
        (mut bytes).push(b as byte)
        active = true
        k += 1
    }
    if error.len == 0 && quote != 0 { error = "no terminating quote in -S string" }
    split_word(mut words, mut bytes, mut active)
    if debug && error.len == 0 {
        eprint("split -S:  {bore.quote(text)}")
        for i in 0..words.len {
            eprint("{if i == 0 then " into:   " else "     &   "} {bore.quote(words[i])}")
        }
    }
    SplitResult { words: words, error: error }
}

// Expand -S in the option prefix in place, including short clusters.
// Replacement words re-enter option parsing; command operands never do.
fn expand_arguments(args: List[str]) -> SplitResult {
    var words = copy args
    var k = 0
    var debug = false
    var expansions = 0
    while k < words.len {
        let word = words[k]
        if word == "--" || word == "-" || !word.starts_with("-") { break }
        var split = false
        var text = ""
        var consumed = 1
        var prefix = ""
        if word.starts_with("--") {
            let eq = word.find("=") else word.len
            let key = word[2..eq]
            if key.len > 0 && "split-string".starts_with(key) {
                split = true
                if eq < word.len {
                    text = word[eq + 1..]
                } else if k + 1 < words.len {
                    text = words[k + 1]
                    consumed = 2
                } else {
                    break
                }
            } else if key.len > 0 && "debug".starts_with(key) {
                debug = true
            } else if eq == word.len && (key == "unset" || key == "chdir" || key == "argv0") {
                consumed = 2
            }
        } else {
            var i = 1
            while i < word.len {
                let b = word.bytes()[i] as int
                if b == 118 { debug = true }
                if b == 83 {
                    split = true
                    if i > 1 { prefix = word[0..i] }
                    if i + 1 < word.len {
                        text = word[i + 1..]
                    } else if k + 1 < words.len {
                        text = words[k + 1]
                        consumed = 2
                    } else {
                        split = false
                    }
                    break
                }
                if b == 117 || b == 67 || b == 97 {
                    if i + 1 == word.len { consumed = 2 }
                    break
                }
                i += 1
            }
        }
        if !split { k += consumed; continue }
        expansions += 1
        if expansions > 100 {
            return SplitResult { words: List[str](), error: "-S expansion nesting exceeds 100" }
        }
        let result = split_string(text, debug)
        if result.error.len > 0 { return result }
        var replaced = List[str]()
        for i in 0..k { (mut replaced).push(words[i]) }
        if prefix.len > 0 { (mut replaced).push(prefix); k += 1 }
        for w in result.words { (mut replaced).push(w) }
        for i in k - (if prefix.len > 0 then 1 else 0) + consumed..words.len {
            (mut replaced).push(words[i])
        }
        words = replaced
    }
    SplitResult { words: words, error: "" }
}

// /proc's documented hexadecimal masks give all host signals, including
// the ones the portable ignored-meaning builtin cannot enumerate.
fn proc_mask(field: str) -> wrapping[u64] ! {unread} {
    let raw = fs_read_bytes("/proc/self/status") else |_| { return unread }
    let text = str_from_utf8(raw) else |_| { return unread }
    for line in text.lines() {
        if !line.starts_with(field + ":") { continue }
        var n: wrapping[u64] = 0
        for b in line[field.len + 1..].trim().bytes() {
            let c = b as int
            let d = if c >= 48 && c <= 57 {
                c - 48
            } else {
                (if c >= 97 && c <= 102 then c - 87 else -1)
            }
            if d < 0 { return unread }
            n = n * 16 + d as wrapping[u64]
        }
        return n
    }
    unread
}

fn mask_has(mask: wrapping[u64], number: int) -> bool {
    number > 0 && number <= 64 && mask >> (number - 1) as wrapping[u64] & 1 != 0
}

fn signal_actions(
    table: bore.SignalTable,
    actions: List[int],
    all: List[bool],
    unblocks: List[bool],
    debug: bool,
    list: bool,
) -> bool {
    var mask_known = true
    let blocked = proc_mask("SigBlk") else { mask_known = false; 0 as wrapping[u64] }
    for i in 0..actions.len {
        if !unblocks[i] { continue }
        if !bore.built_for_linux() || !mask_known || mask_has(blocked, table.numbers[i]) {
            bore.warn(
                "env",
                "--default-signal cannot unblock an inherited signal mask: wolf has no mask setter",
            )
            return false
        }
    }
    for i in 0..actions.len {
        if actions[i] == 0 { continue }
        let meaning = bore.signal_meaning(table, i)
        // Model the oracle's measured query boundary: wolf has no per-signal
        // action getter. The paired read-only native probes witness this
        // Darwin rejection; see bore/envsignals.lu. Never reach a setter
        // after that query is known to fail.
        if bore.env_signal_query_refused(meaning, os_name() == "macos") {
            if all[i] { continue }
            bore.warn("env", bore.env_signal_action_failure(true, table.numbers[i]))
            return false
        }
        var ok = true
        if actions[i] == 1 {
            os_signal_ignore_one(meaning) else |_| { ok = false }
        } else {
            os_signal_default_one(meaning) else |_| { ok = false }
        }
        if !ok {
            if all[i] { continue }
            bore.warn("env", bore.env_signal_action_failure(false, table.numbers[i]))
            return false
        }
        if debug {
            let how = if actions[i] == 1 then "IGNORE" else "DEFAULT"
            eprint("Reset signal {table.names[i]} ({table.numbers[i]}) to {how}")
            if unblocks[i] {
                eprint("signal {table.names[i]} ({table.numbers[i]}) mask set to UNBLOCK")
            }
        }
    }
    if list {
        if !bore.built_for_linux() {
            bore.warn(
                "env",
                "--list-signal-handling cannot read blocked signals on this host: wolf has no mask query",
            )
            return false
        }
        let ignored = proc_mask("SigIgn") else {
            bore.warn("env", "cannot read /proc/self/status signal masks")
            return false
        }
        for i in 0..table.numbers.len {
            let number = table.numbers[i]
            let ign = mask_has(ignored, number), block = mask_has(blocked, number)
            if !ign && !block { continue }
            let name = table.names[i]
            let gap = " ".repeat(if name.len < 10 then 10 - name.len else 0)
            let pad = if number < 10 then " " else ""
            let how = if ign && block then "BLOCK,IGNORE" else (if ign then "IGNORE" else "BLOCK")
            eprint("{name}{gap} ({pad}{number}): {how}")
        }
    }
    true
}
