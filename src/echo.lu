//! member: false
//!
//! echo — write the arguments, separated by single spaces, followed by
//! a newline.
//!
//! References consulted: POSIX.1-2024 `echo`; GNU coreutils 9.11
//! `echo --help` and black-box runs of the GNU binary. Never GNU
//! source.
//!
//! GNU's rules, each measured against coreutils 9.11:
//!
//! - Leading arguments made only of `-` followed by `n`, `e` and `E`
//!   are options, applied left to right, so `-neE` is all three and the
//!   last of `-e`/`-E` wins. The first argument that is not one ends the
//!   options: `-nx`, `--`, `-` and `--help x` are all written out.
//! - `--help` and `--version` are honoured only spelled in full and
//!   only as the sole argument. `--ver` is written out.
//! - With `POSIXLY_CORRECT` set, escapes are always interpreted, `-e`
//!   and `-E` are ordinary arguments, and only leading arguments equal
//!   to exactly `-n` are options.
//! - `\0NNN` takes up to three octal digits after the `0`, and a bare
//!   `\NNN` up to three in all, each taken modulo 256: `\400` is a NUL
//!   byte and `\1234` is `S4`. `\xHH` takes one or two hex digits, and
//!   a `\x` with none is written out. An unknown escape and a trailing
//!   backslash are written out. `\c` stops all output, newline included.

use bore

fn main() -> int {
    let args = env_args()
    var out = bore.stdout()
    let posix = !bore.permute()
    if !posix && args.len == 1 {
        if args[0] == "--help" {
            bore.put(mut out, help()) else |_| {}
            return bore.finish(mut out, "echo", 0)
        }
        if args[0] == "--version" {
            bore.put(mut out, bore.version_text("echo")) else |_| {}
            return bore.finish(mut out, "echo", 0)
        }
    }
    // wolf-lang#449: the --help / --version block above claims `out`,
    // so this call takes the writer last.
    write_args(args, posix, mut out) else |_| {
        bore.write_error(out, "echo", "write error")
        return 1
    }
    bore.finish(mut out, "echo", 0)
}

fn write_args(args: List[str], posix: bool, mut out: bore.Out) -> () ! {io} {
    var i = 0
    var newline = true
    var escapes = posix
    var scanning = true
    while scanning && i < args.len {
        let a = args[i]
        if posix {
            if a == "-n" {
                newline = false
                i += 1
            } else {
                scanning = false
            }
        } else if is_option(a) {
            for c in a[1..].bytes() {
                let n = c as int
                if n == 110 {
                    newline = false
                } else if n == 101 {
                    escapes = true
                } else {
                    escapes = false
                }
            }
            i += 1
        } else {
            scanning = false
        }
    }
    var first = true
    var stopped = false
    while !stopped && i < args.len {
        if !first {
            bore.put(mut out, " ")?
        }
        if escapes {
            stopped = write_escaped(mut out, args[i])?
        } else {
            bore.put(mut out, args[i])?
        }
        first = false
        i += 1
    }
    if newline && !stopped {
        bore.put(mut out, "\n")?
    }
}

/// Whether `a` is a `-n`/`-e`/`-E` cluster.
fn is_option(a: str) -> bool {
    if a.len < 2 || !a.starts_with("-") {
        return false
    }
    for c in a[1..].bytes() {
        let n = c as int
        if n != 110 && n != 101 && n != 69 {
            return false
        }
    }
    true
}

/// Write `s` with backslash escapes interpreted. Answers whether `\c`
/// stopped the output.
fn write_escaped(mut out: bore.Out, s: str) -> bool ! {io} {
    let b = s.bytes()
    var i = 0
    while i < b.len {
        let c = b[i] as int
        if c != 92 {
            bore.put_byte(mut out, b[i])?
            i += 1
        } else if i + 1 >= b.len {
            bore.put_byte(mut out, b[i])?
            i += 1
        } else {
            let n = b[i + 1] as int
            i += 2
            if n == 97 {
                bore.put_byte(mut out, 7 as byte)?
            } else if n == 98 {
                bore.put_byte(mut out, 8 as byte)?
            } else if n == 99 {
                return true
            } else if n == 101 {
                bore.put_byte(mut out, 27 as byte)?
            } else if n == 102 {
                bore.put_byte(mut out, 12 as byte)?
            } else if n == 110 {
                bore.put_byte(mut out, 10 as byte)?
            } else if n == 114 {
                bore.put_byte(mut out, 13 as byte)?
            } else if n == 116 {
                bore.put_byte(mut out, 9 as byte)?
            } else if n == 118 {
                bore.put_byte(mut out, 11 as byte)?
            } else if n == 92 {
                bore.put_byte(mut out, 92 as byte)?
            } else if n >= 48 && n <= 55 {
                // `\0NNN` takes three octal digits after the zero, a bare
                // `\NNN` three in all, and the value is taken modulo 256.
                var value = n - 48
                var digits = 2
                if n == 48 {
                    digits = 3
                }
                var taken = 0
                var more = true
                while more && taken < digits && i < b.len {
                    let d = b[i] as int
                    if d < 48 || d > 55 {
                        more = false
                    } else {
                        value = value * 8 + d - 48
                        i += 1
                        taken += 1
                    }
                }
                bore.put_byte(mut out, (value % 256) as byte)?
            } else if n == 120 {
                // `\xHH` takes one or two hex digits; with none, the `\x`
                // is written out as it was given.
                var value = 0
                var taken = 0
                var more = true
                while more && taken < 2 && i < b.len {
                    let d = hex(b[i] as int)
                    if d < 0 {
                        more = false
                    } else {
                        value = value * 16 + d
                        i += 1
                        taken += 1
                    }
                }
                if taken == 0 {
                    bore.put_byte(mut out, 92 as byte)?
                    bore.put_byte(mut out, 120 as byte)?
                } else {
                    bore.put_byte(mut out, value as byte)?
                }
            } else {
                bore.put_byte(mut out, 92 as byte)?
                bore.put_byte(mut out, b[i - 1])?
            }
        }
    }
    false
}

/// The value of one hex digit, or -1.
fn hex(c: int) -> int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    -1
}

fn help() -> str {
    """
    Usage: echo [-neE] [STRING]...
      or:  echo --help | --version
    Write the STRINGs, separated by single spaces, and a newline.

      -n  write no trailing newline
      -e  interpret backslash escapes in the STRINGs
      -E  do not interpret backslash escapes (the default)

    With POSIXLY_CORRECT set, escapes are always interpreted and only a
    leading -n is an option.

    Escapes: \\\\ \\a \\b \\c \\e \\f \\n \\r \\t \\v \\0NNN \\NNN \\xHH

    boreutils: https://github.com/wolffe-lang/boreutils
    """
}
