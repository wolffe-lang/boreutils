//! member: false
//! shred — overwrite existing regular files, optionally unlink them.
//! References consulted: GNU coreutils 9.11 manual's shred invocation and
//! sources-of-random-data nodes, and black-box runs. No implementation source.
//! This never promises physical erasure on CoW, flash, snapshots or backups.
//! -x is required: st_blksize is absent (wolf-lang#684). Name wiping is
//! refused: a non-replacing rename is absent (#706); --remove=unlink works.
//! More than three random passes need GNU's mixed-pattern scheduling, not
//! implemented here and refused by name. os_random supplies random passes.

use bore

fn overwrite(path: str, n: int, size: int, zero: bool, force: bool, remove: bool, verbose: bool, random: int) -> bool {
    var r = List[int]()
    if path == "-" { r = fs_fstat_record(1) else |_| { bore.warn("shred", "{path}: failed to open for writing: {bore.io_error()}"); return false } }
    else { r = fs_stat(path) else |_| { bore.warn("shred", "{path}: failed to open for writing: {bore.io_error()}"); return false } }
    if bore.rec_kind(r) != bore.kind_file() {
        bore.warn("shred", "{path}: unsupported file type; only regular files are overwritten")
        return false
    }
    var fd = 1
    if path != "-" {
        if force { fs_set_mode(path, bore.rec_mode(r) | 128) else |_| {} }
        fd = fs_open_mode(path, 3) else |_| { bore.warn("shred", "{path}: failed to open for writing: {bore.io_error()}"); return false }
    }
    defer { if fd != 1 { fs_close(fd) else |_| {} } }
    let opened = fs_fstat_record(fd) else |_| { return false }
    if !bore.same_file(r, opened) { bore.warn("shred", "{path}: operand changed during open; refusing to overwrite"); return false }
    let bytes = if size >= 0 then size else bore.rec_size(r)
    let passes = n + if zero then 1 else 0
    var pass = 0
    while pass < passes {
        let zeros = pass == n
        if verbose { bore.warn("shred", "{path}: pass {pass + 1}/{passes} ({if zeros then "000000" else "random"})...") }
        let _ = fs_seek(fd, 0, 0) else |_| { bore.warn("shred", "{path}: cannot seek: {bore.io_error()}"); return false }
        var left = bytes
        while left > 0 {
            region block {
                let amount = if left > 65536 then 65536 else left
                var data = List[byte]()
                if zeros {
                    var i = 0
                    while i < amount { (mut data).push(0 as byte); i += 1 }
                } else if random >= 0 {
                    while data.len < amount {
                        let part = fs_read_chunk(random, amount - data.len) else |_| { bore.warn("shred", "random source exhausted"); return false }
                        for b in part { (mut data).push(b) }
                    }
                } else {
                    for octet in os_random(amount) { (mut data).push(octet as byte) }
                }
                fs_write_chunk(fd, data) else |_| { bore.warn("shred", "{path}: error writing: {bore.io_error()}"); return false }
                left -= amount
            }
        }
        fs_sync(fd) else |_| { bore.warn("shred", "{path}: fsync failed: {bore.io_error()}"); return false }
        pass += 1
    }
    if remove && path != "-" {
        if verbose { bore.warn("shred", "{path}: removing") }
        fs_truncate(fd, 0) else |_| { bore.warn("shred", "{path}: cannot truncate: {bore.io_error()}"); return false }
        fs_remove(path) else |_| { bore.warn("shred", "{path}: cannot remove: {bore.io_error()}"); return false }
        if verbose { bore.warn("shred", "{path}: removed") }
    }
    true
}
fn main() -> int {
    var opts = List[bore.Opt]()
    for pair in ["f:force", "u:", "v:verbose", "x:exact", "z:zero", ":help", ":version"] {
        let at = pair.find(":") else 0
        (mut opts).push(bore.flag(pair[..at], pair[at + 1..]))
    }
    (mut opts).push(bore.takes("n", "iterations")); (mut opts).push(bore.takes("s", "size"))
    (mut opts).push(bore.takes("", "random-source")); (mut opts).push(bore.optional("", "remove"))
    let p = bore.parse(opts, env_args(), bore.permute())
    var out = bore.stdout()
    var n = 3, size: int = -1, random_name = "", how = ""
    var exact = false, zero = false, force = false, verbose = false
    var i = 0
    while i < p.keys.len {
        let k = p.keys[i], v = p.values[i]
        if k == "help" { bore.put(mut out, "Usage: shred -x [OPTION]... FILE...\nOverwrite regular files with random passes, optionally finishing with zeros.\nNo physical-erasure guarantee on CoW, flash, snapshots or backups.\nDefault block rounding and name wiping need unavailable surfaces.\n") else |_| {}; return bore.finish(mut out, "shred", 0) }
        if k == "version" { bore.put(mut out, bore.version_text("shred")) else |_| {}; return bore.finish(mut out, "shred", 0) }
        if k == "iterations" { n = v.to_int() else -1; if n < 0 { bore.warn("shred", "invalid number of passes: {bore.quote_always(v)}"); return 1 } }
        if k == "size" {
            let count = bore.parse_count(v) else |_| { bore.warn("shred", "invalid file size: {bore.quote_always(v)}"); return 1 }
            if bore.count_minus(count) { bore.warn("shred", "invalid file size: {bore.quote_always(v)}"); return 1 }
            size = bore.count_value(count)
        }
        if k == "exact" { exact = true }
        if k == "zero" { zero = true }
        if k == "force" { force = true }
        if k == "verbose" { verbose = true }
        if k == "random-source" { random_name = v }
        if k == "u" || k == "remove" { how = if v.len == 0 then "wipesync" else v }
        i += 1
    }
    if !bore.ok(p) { return bore.usage_error("shred", p.error) }
    if p.operands.len == 0 { return bore.usage_error("shred", "missing file operand") }
    if !exact { bore.warn("shred", "unsupported default block rounding: st_blksize absent (wolf-lang#684); use -x"); return 1 }
    if n > 3 { bore.warn("shred", "unsupported --iterations above 3: mixed-pattern scheduling not implemented"); return 1 }
    if how.len > 0 && how != "unlink" { bore.warn("shred", "unsupported --remove={how}: no non-replacing rename (wolf-lang#706)"); return 1 }
    var random = -1
    if random_name.len > 0 { random = fs_open(random_name) else |_| { bore.warn("shred", "{random_name}: {bore.io_error()}"); return 1 } }
    defer { if random >= 0 { fs_close(random) else |_| {} } }
    var status = 0
    for name in p.operands { if !overwrite(name, n, size, zero, force, how == "unlink", verbose, random) { status = 1 } }
    bore.finish(mut out, "shred", status)
}
