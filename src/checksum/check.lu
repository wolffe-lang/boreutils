//! GNU 9.11 checksum manifest grammar and diagnostics, black-box derived.
//! Digest algorithms and vectors are separately implemented from standards.
//! uutils (MIT), toybox (0BSD): design references only; never GNU source.

use bore

struct ManifestReader {
    src: bore.In,
    buf: List[byte],
    at: int,
    used: int,
    ended: bool,
}

fn manifest_reader(src: bore.In) -> ManifestReader {
    var b = List[byte]()
    var i = 0
    while i < 65536 { (mut b).push(0 as byte); i += 1 }
    ManifestReader { src: src, buf: b, at: 0, used: 0, ended: false }
}

fn manifest_line(mut r: ManifestReader) -> List[byte] ! {eof, io} {
    var line = List[byte]()
    loop {
        if r.at == r.used {
            if r.ended { if line.len > 0 { return line }; return eof }
            region refill {
                let b = bore.read_chunk(r.src, 65536) else |e| match e {
                    eof => { r.ended = true; continue },
                    io => { return io },
                }
                r.at = 0
                r.used = b.len
                if b.len == 0 { r.ended = true; continue }
                var i = 0
                while i < b.len { r.buf[i] = b[i]; i += 1 }
            }
        }
        let b = r.buf[r.at]
        r.at += 1
        if b as int == 10 { return line }
        (mut line).push(b)
    }
    line
}

struct Record {
    name: str,
    expected: str,
    kind: int,
    bits: int,
    base64: bool,
    style: int,
    name_start: int,
    name_end: int,
}

fn ascii_blank(b: byte) -> bool { b as int == 32 || b as int == 9 }

fn hex_digit(b: byte) -> bool {
    let x = b as int
    x >= 48 && x <= 57 || x >= 65 && x <= 70 || x >= 97 && x <= 102
}

fn lower_hex(s: str) -> str {
    var out = List[byte]()
    for b in s.bytes() {
        let n = b as int
        (mut out).push((if n >= 65 && n <= 70 then n + 32 else n) as byte)
    }
    str_from_utf8(out) else ""
}

fn unescape_filename(s: str) -> str ! {invalid} {
    var out = List[byte]()
    var i = 0
    while i < s.len {
        var b = s.bytes()[i]
        i += 1
        if b as int == 92 {
            if i == s.len { return invalid }
            let n = s.bytes()[i] as int
            i += 1
            if n == 92 {
                b = 92 as byte
            } else if n == 110 {
                b = 10 as byte
            } else if n == 114 {
                b = 13 as byte
            } else {
                return invalid
            }
        }
        (mut out).push(b)
    }
    str_from_utf8(out) else { return invalid }
}

fn parse_record(c: Settings, line: str, from_stdin: bool, reverse_style: int) -> Record ! {
    invalid,
} {
    var s = line
    if s.ends_with("\r") { s = s[..s.len - 1] }
    var pos = 0
    while pos < s.len && ascii_blank(s.bytes()[pos]) { pos += 1 }
    var base = pos
    s = s[pos..]
    var escaped = false
    if s.starts_with("\\") {
        escaped = true
        s = s[1..]
        base += 1
    }
    var kind = c.kind
    var bits = c.bits
    var name = ""
    var expected = ""
    var name_start = 0
    var name_end = 0
    var tagged = false
    var style = reverse_style
    let open = s.find("(") else -1
    let close = s.rfind(")") else -1
    var label = if open >= 0 then s[..open] else ""
    if label.ends_with(" ") { label = label[..label.len - 1] }
    let tagged_kind = label_kind(label) else -1
    if tagged_kind >= 0 && close > open {
        kind = tagged_kind
        bits = kind_bits(kind)
        if kind == 10 && label.starts_with("BLAKE2b-") {
            bits = length_number(label[8..]) else { return invalid }
            if bits < 8 || bits > 512 || bits % 8 != 0 { return invalid }
        }
        if (c.prog != "cksum" || c.explicit_kind) &&
            kind != c.kind &&
            !(c.kind == 11 && kind >= 6 && kind <= 9) {
            return invalid
        }
        name_start = open + 1
        name_end = close
        name = s[name_start..name_end]
        var tail = s[close + 1..]
        if tail.starts_with(" ") { tail = tail[1..] }
        if !tail.starts_with("=") { return invalid }
        tail = tail[1..]
        if tail.starts_with(" ") { tail = tail[1..] }
        expected = tail
        tagged = true
    } else {
        if c.prog == "cksum" && !c.explicit_kind { return invalid }
        pos = 0
        while pos < s.len && !ascii_blank(s.bytes()[pos]) { pos += 1 }
        if pos == s.len { return invalid }
        expected = s[..pos]
        pos += 1
        let marker = pos + 1 < s.len && (s.bytes()[pos] as int == 32 || s.bytes()[pos] as int == 42)
        if style == 0 { style = if marker then 1 else 2 }
        if style == 1 {
            if !marker { return invalid }
            pos += 1
        }
        if pos == s.len { return invalid }
        name_start = pos
        name_end = s.len
        name = s[pos..]
        if kind == 10 || kind == 11 {
            var all_hex = expected.len % 2 == 0
            for b in expected.bytes() { if !hex_digit(b) { all_hex = false } }
            if all_hex {
                bits = expected.len * 4
            } else if c.prog == "cksum" {
                if expected.len % 4 != 0 { return invalid }
                let pad = if expected.ends_with("==") {
                    2
                } else if expected.ends_with("=") {
                    1
                } else {
                    0
                }
                bits = (expected.len / 4 * 3 - pad) * 8
            } else {
                return invalid
            }
            if kind == 11 {
                kind = if bits == 224 {
                    6
                } else if bits == 256 {
                    7
                } else if bits == 384 {
                    8
                } else if bits == 512 {
                    9
                } else {
                    -1
                }
            }
        }
    }
    if escaped { name = unescape_filename(name)? }
    if name.len == 0 || name.contains("\0") || from_stdin && name == "-" { return invalid }
    var hex = expected.len == bits / 4
    for b in expected.bytes() { if !hex_digit(b) { hex = false } }
    // GNU cksum prefers base64 when the two encoded lengths coincide
    // (BLAKE2b-16 and -32); its own short hexadecimal records then fail
    // the base64 padding check. b2sum remains hex-only and accepts them.
    if c.prog == "cksum" && expected.len == (bits / 8 + 2) / 3 * 4 { hex = false }
    if hex {
        expected = lower_hex(expected)
    } else {
        if c.prog != "cksum" { return invalid }
        if expected.len != (bits / 8 + 2) / 3 * 4 { return invalid }
        // Canonical base64 is checked against the computed bytes below;
        // syntax and padding must be valid even for a mismatching digest.
        if !valid_base64(expected, bits / 8) { return invalid }
        expected = decode_base64_hex(expected, bits / 8)
    }
    if kind < 4 || kind > 10 || bits < 8 || bits > 512 || bits % 8 != 0 { return invalid }
    Record {
        name: name,
        expected: expected,
        kind: kind,
        bits: bits,
        base64: false,
        style: if tagged then 0 else style,
        name_start: base + name_start,
        name_end: base + name_end,
    }
}

fn label_kind(label: str) -> int ! {invalid} {
    if label == "MD5" { return 4 }
    if label == "SHA1" { return 5 }
    if label == "SHA224" { return 6 }
    if label == "SHA256" { return 7 }
    if label == "SHA384" { return 8 }
    if label == "SHA512" { return 9 }
    if label == "BLAKE2b" || label.starts_with("BLAKE2b-") { return 10 }
    invalid
}

fn valid_base64(s: str, bytes: int) -> bool {
    let pad = (3 - bytes % 3) % 3
    var i = 0
    while i < s.len {
        let b = s.bytes()[i] as int
        if i >= s.len - pad {
            if b != 61 { return false }
        } else if !(
            b >= 65 && b <= 90 || b >= 97 && b <= 122 || b >= 48 && b <= 57 || b == 43 || b == 47
        ) {
            return false
        }
        i += 1
    }
    true
}

fn base64_value(b: byte) -> int {
    let x = b as int
    if x >= 65 && x <= 90 { return x - 65 }
    if x >= 97 && x <= 122 { return x - 97 + 26 }
    if x >= 48 && x <= 57 { return x - 48 + 52 }
    if x == 43 then 62 else if x == 47 then 63 else 0
}

fn decode_base64_hex(s: str, count: int) -> str {
    var out = List[byte]()
    var i = 0
    while i < s.len {
        let a = base64_value(s.bytes()[i])
        let b = base64_value(s.bytes()[i + 1])
        let c = base64_value(s.bytes()[i + 2])
        let e = base64_value(s.bytes()[i + 3])
        if out.len < count { (mut out).push((a << 2 | b >> 4) as byte) }
        if out.len < count { (mut out).push((b << 4 | c >> 2) as byte) }
        if out.len < count { (mut out).push((c << 6 | e) as byte) }
        i += 4
    }
    hex_bytes(out)
}

struct CheckCounts {
    proper: int,
    malformed: int,
    unread: int,
    mismatch: int,
    matched: int,
    line: int,
    last_kind: int,
    last_bits: int,
    reverse_style: int,
}

fn check_file(mut seen: InputUse, c: Settings, path: str) -> int {
    if path == "-" { seen.stdin = true }
    let src = bore.open_input(path) else |e| {
        let why = match e {
            not_found => bore.no_such_file(),
            denied => bore.permission_denied(),
            is_dir => "read error",
            io => bore.io_error(),
        }
        bore.input_error(c.prog, path, why)
        return 1
    }
    var r = manifest_reader(src)
    var n = CheckCounts {
        proper: 0,
        malformed: 0,
        unread: 0,
        mismatch: 0,
        matched: 0,
        line: 0,
        last_kind: c.kind,
        last_bits: c.bits,
        reverse_style: 0,
    }
    var bad_read = false
    var bad_write = false
    var unsupported_path = false
    loop {
        region row {
            let bytes = manifest_line(mut r) else |e| match e {
                eof => { break },
                io => {
                    bore.warn(c.prog, "{manifest_name(path)}: read error")
                    bad_read = true
                    break
                },
            }
            n.line += 1
            if bytes.len > 0 && bytes[0] as int == 35 { continue }
            let line = str_from_utf8(bytes) else {
                if raw_name_record(c, bytes, n.reverse_style) {
                    bore.warn(
                        c.prog,
                        "non-UTF-8 file names in checksum lists are not supported: wolf 0.2.35 fs_open requires a UTF-8 path",
                    )
                    unsupported_path = true
                    break
                }
                malformed_line(c, path, mut n)
                continue
            }
            if line.len == 0 || line == "\r" || line.starts_with("#") { continue }
            let rec = parse_record(c, line, path == "-", n.reverse_style) else {
                malformed_line(c, path, mut n)
                continue
            }
            n.proper += 1
            if rec.style != 0 { n.reverse_style = rec.style }
            n.last_kind = rec.kind
            n.last_bits = rec.bits
            let a = compute(mut seen, c, rec.name, rec.kind, rec.bits) else |e| {
                let unread = match e {
                    failed => true,
                    missing => false,
                }
                if unread {
                    n.unread += 1
                    if !check_result(c, rec.name, "FAILED open or read") { bad_write = true; break }
                }
                continue
            }
            let actual = if rec.base64 then base64_bytes(a.bytes) else hex_bytes(a.bytes)
            if rec.expected == actual {
                n.matched += 1
                if !c.quiet && !check_result(c, rec.name, "OK") { bad_write = true; break }
            } else {
                n.mismatch += 1
                if !check_result(c, rec.name, "FAILED") { bad_write = true; break }
            }
        }
    }
    bore.close_input(src)
    if bad_write { return 2 }
    if unsupported_path { return 1 }
    if bad_read && n.proper == 0 { return 1 }
    if n.proper == 0 {
        bore.warn(c.prog, "{manifest_name(path)}: no properly formatted checksum lines found")
        return 1
    }
    if !c.status {
        if n.malformed > 0 {
            let suffix = if n.malformed == 1 then "line is" else "lines are"
            bore.warn(c.prog, "WARNING: {n.malformed} {suffix} improperly formatted")
        }
        if n.unread > 0 {
            let suffix = if n.unread == 1 then "file" else "files"
            bore.warn(c.prog, "WARNING: {n.unread} listed {suffix} could not be read")
        }
        if n.mismatch > 0 {
            let suffix = if n.mismatch == 1 then "checksum" else "checksums"
            bore.warn(c.prog, "WARNING: {n.mismatch} computed {suffix} did NOT match")
        }
        if c.ignore && n.matched == 0 {
            bore.warn(c.prog, "{manifest_name(path)}: no file was verified")
        }
    }
    if bad_read ||
        n.unread > 0 ||
        n.mismatch > 0 ||
        c.strict && n.malformed > 0 ||
        c.ignore && n.matched == 0 {
        return 1
    }
    0
}

fn manifest_name(path: str) -> str {
    bore.quote_name(if path == "-" then "standard input" else path)
}

fn malformed_line(c: Settings, path: str, mut n: CheckCounts) {
    n.malformed += 1
    if c.warn && !c.status {
        let label = if n.last_kind == 0 {
            "CRC"
        } else if n.last_kind == 10 {
            "BLAKE2b"
        } else if n.last_kind == 11 {
            "SHA2"
        } else {
            digest_label(n.last_kind, n.last_bits)
        }
        bore.warn(
            c.prog,
            "{manifest_name(path)}: {n.line}: improperly formatted {label} checksum line",
        )
    }
}

fn check_result(c: Settings, name: str, status: str) -> bool {
    if c.status { return true }
    var out = bore.stdout()
    let shown = bore.quote_name(name)
    bore.put(mut out, "{shown}: {status}\n") else |_| {}
    bore.finish(mut out, c.prog, 0) == 0
}

// Substitute only invalid UTF-8 bytes, preserving every separator,
// backslash escape and parenthesis. The ordinary parser decides the grammar
// and exposes the name span; invalid bytes anywhere else remain malformed.
fn raw_name_record(c: Settings, bytes: List[byte], style: int) -> bool {
    var clean = List[byte]()
    var i = 0
    while i < bytes.len {
        let width = utf8_span(bytes, i)
        if width == 0 {
            (mut clean).push(120 as byte)
            i += 1
        } else {
            var j = 0
            while j < width { (mut clean).push(bytes[i + j]); j += 1 }
            i += width
        }
    }
    let sanitized = str_from_utf8(clean) else { return false }
    let rec = parse_record(c, sanitized, false, style) else { return false }
    utf8_range_ok(bytes, 0, rec.name_start) &&
        utf8_range_ok(bytes, rec.name_end, bytes.len) &&
        !utf8_range_ok(bytes, rec.name_start, rec.name_end)
}

fn utf8_range_ok(bytes: List[byte], start: int, end: int) -> bool {
    var i = start
    while i < end {
        let width = utf8_span(bytes, i)
        if width == 0 || i + width > end { return false }
        i += width
    }
    true
}

// RFC 3629's byte ranges; no allocation or locale-dependent decoding.
fn utf8_span(bytes: List[byte], at: int) -> int {
    let b = bytes[at] as int
    if b < 128 { return 1 }
    let width = if b >= 194 && b <= 223 {
        2
    } else if b >= 224 && b <= 239 {
        3
    } else if b >= 240 && b <= 244 {
        4
    } else {
        0
    }
    if width == 0 || at + width > bytes.len { return 0 }
    var j = 1
    while j < width {
        let n = bytes[at + j] as int
        if n < 128 || n > 191 { return 0 }
        j += 1
    }
    let second = bytes[at + 1] as int
    if b == 224 && second < 160 ||
        b == 237 && second > 159 ||
        b == 240 && second < 144 ||
        b == 244 && second > 143 {
        return 0
    }
    width
}
