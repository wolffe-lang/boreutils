//! MD5 from RFC 1321 sections 3.1-3.5, not its C implementation.
//! Constants are floor(2^32*abs(sin(i))), i=1..64; round word indices
//! are the four permutations in section 3.4. RFC 1321 A.5's seven
//! published vectors, including empty and abc, are unit tested.
//! uutils (MIT) and toybox (0BSD): design references only; never GNU source.

fn md5_initial() -> List[wrapping[u64]] {
    [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476]
}

fn md5_block(mut d: Digest) {
    load_words(mut d, 4, true)
    var a = d.h[0]
    var b = d.h[1]
    var c = d.h[2]
    var e = d.h[3]
    var i = 0
    while i < 64 {
        var f: wrapping[u64] = 0
        var word = i
        if i < 16 {
            f = b & c | (b ^ 0xffffffff) & e
        } else if i < 32 {
            f = e & b | (e ^ 0xffffffff) & c
            word = (5 * i + 1) % 16
        } else if i < 48 {
            f = b ^ c ^ e
            word = (3 * i + 5) % 16
        } else {
            f = c ^ (b | e ^ 0xffffffff)
            word = 7 * i % 16
        }
        let add = a + f + d.k[i] + d.w[word] & 0xffffffff
        let next = b + rotr32(add, 32 - d.order[i / 16 * 4 + i % 4]) & 0xffffffff
        a = e
        e = c
        c = b
        b = next
        i += 1
    }
    d.h[0] = d.h[0] + a & 0xffffffff
    d.h[1] = d.h[1] + b & 0xffffffff
    d.h[2] = d.h[2] + c & 0xffffffff
    d.h[3] = d.h[3] + e & 0xffffffff
}

fn md5_rotations() -> List[int] {
    [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21]
}

