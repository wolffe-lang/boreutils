//! The option parser and the quoting, on the shapes GNU's getopt_long
//! answers (each expectation below was read off GNU coreutils 9.11).

use bore

fn spec() -> List[bore.Opt] {
    var s = List[bore.Opt]()
    (mut s).push(bore.flag("a", "multiple"))
    (mut s).push(bore.takes("s", "suffix"))
    (mut s).push(bore.flag("z", "zero"))
    (mut s).push(bore.flag("", "help"))
    (mut s).push(bore.flag("", "version"))
    s
}

fn words(a: str, b: str, c: str) -> List[str] {
    var xs = List[str]()
    if a.len > 0 || b.len > 0 || c.len > 0 {
        (mut xs).push(a)
    }
    if b.len > 0 || c.len > 0 {
        (mut xs).push(b)
    }
    if c.len > 0 {
        (mut xs).push(c)
    }
    xs
}

fn joined(xs: List[str]) -> str {
    var out = ""
    for x in xs {
        out += "[{x}]"
    }
    out
}

fn check(args: List[str], permute: bool, want: str) {
    let p = bore.parse(spec(), args, permute)
    let got = "k={joined(p.keys)} v={joined(p.values)} o={joined(p.operands)} e={p.error}"
    assert(got == want, "parse {joined(args)}: got {got}, want {want}")
}

/// A table with OPTIONAL-argument options (boreutils#8): `--follow`
/// long-only, `-C`/`--color` with both names, and `-f` a plain flag.
fn spec_optional() -> List[bore.Opt] {
    var s = List[bore.Opt]()
    (mut s).push(bore.optional("", "follow"))
    (mut s).push(bore.optional("C", "color"))
    (mut s).push(bore.flag("f", ""))
    (mut s).push(bore.takes("n", "lines"))
    s
}

fn flags(xs: List[bool]) -> str {
    var out = ""
    for x in xs {
        out += if x then "[1]" else "[0]"
    }
    out
}

fn check_optional(args: List[str], want: str) {
    let p = bore.parse(spec_optional(), args, true)
    let got = "k={joined(p.keys)} v={joined(p.values)} g={flags(p.given)} o={joined(p.operands)} e={p.error}"
    assert(got == want, "parse {joined(args)}: got {got}, want {want}")
}

fn main() {
    // getopt_long's optional_argument: a word only when attached.
    check_optional(words("--follow", "x", ""), "k=[follow] v=[] g=[0] o=[x] e=")
    check_optional(words("--follow=name", "x", ""), "k=[follow] v=[name] g=[1] o=[x] e=")
    check_optional(words("--follow=", "x", ""), "k=[follow] v=[] g=[1] o=[x] e=")
    check_optional(words("--fol=d", "", ""), "k=[follow] v=[d] g=[1] o= e=")
    check_optional(words("-C", "auto", ""), "k=[color] v=[] g=[0] o=[auto] e=")
    check_optional(words("-Cauto", "", ""), "k=[color] v=[auto] g=[1] o= e=")
    check_optional(words("-fC", "", ""), "k=[f][color] v=[][] g=[0][0] o= e=")
    check_optional(words("-fCx", "", ""), "k=[f][color] v=[][x] g=[0][1] o= e=")
    check_optional(words("-n", "3", ""), "k=[lines] v=[3] g=[1] o= e=")
    check_optional(words("--color", "--follow", ""), "k=[color][follow] v=[][] g=[0][0] o= e=")
    check_optional(words("--co", "", ""), "k=[color] v=[] g=[0] o= e=")
    check(words("a/b", "", ""), true, "k= v= o=[a/b] e=")
    check(words("-za", "x", ""), true, "k=[zero][multiple] v=[][] o=[x] e=")
    check(words("-s.h", "x", ""), true, "k=[suffix] v=[.h] o=[x] e=")
    check(words("-s", ".h", "x"), true, "k=[suffix] v=[.h] o=[x] e=")
    check(words("-as", ".c", "x"), true, "k=[multiple][suffix] v=[][.c] o=[x] e=")
    check(words("--suf=.h", "x", ""), true, "k=[suffix] v=[.h] o=[x] e=")
    check(words("--suffix", ".h", ""), true, "k=[suffix] v=[.h] o= e=")
    check(words("--mul", "x", ""), true, "k=[multiple] v=[] o=[x] e=")
    check(words("x", "-a", ""), true, "k=[multiple] v=[] o=[x] e=")
    check(words("x", "-a", ""), false, "k= v= o=[x][-a] e=")
    check(words("--", "-a", ""), true, "k= v= o=[-a] e=")
    check(words("-", "", ""), true, "k= v= o=[-] e=")
    check(words("-x", "--help", ""), true, "k= v= o= e=invalid option -- 'x'")
    check(words("--help", "-x", ""), true, "k=[help] v=[] o= e=invalid option -- 'x'")
    check(words("-s", "", ""), true, "k= v= o= e=option requires an argument -- 's'")
    check(words("--suf", "", ""), true, "k= v= o= e=option '--suffix' requires an argument")
    check(words("--ze=1", "", ""), true, "k= v= o= e=option '--zero' doesn't allow an argument")
    check(words("--foo=1", "", ""), true, "k= v= o= e=unrecognized option '--foo=1'")
    check(words("---", "", ""), true, "k= v= o= e=unrecognized option '---'")
    check(
        words("--=x", "", ""),
        true,
        "k= v= o= e=option '--=x' is ambiguous; possibilities: '--multiple' '--suffix' '--zero' '--help' '--version'",
    )
    assert(bore.quote("c") == "'c'", "quote plain")
    assert(bore.quote("c d") == "'c d'", "quote with a space")
    assert(bore.quote("c'd") == "'c\\'d'", "quote with a single quote")
    assert(bore.quote("c\\d") == "'c\\\\d'", "quote with a backslash")
    assert(bore.quote("c\td") == "'c\\td'", "quote with a tab")
    assert(bore.quote("cé") == "'c\\303\\251'", "quote with a non-ASCII byte")
    // quote_name is the OTHER style: the one GNU uses for a path it
    // could not open, quoted only when it has to be. Every expectation
    // below was read off `gcat NAME` under LC_ALL=C.
    assert(bore.quote_name("ab") == "ab", "name needing no quotes")
    assert(bore.quote_name("") == "''", "the empty name")
    assert(bore.quote_name("no,such+file%here") == "no,such+file%here", "name of safe punctuation")
    assert(bore.quote_name("a b") == "'a b'", "name with a space")
    assert(bore.quote_name("a:b") == "'a:b'", "name with a colon")
    assert(bore.quote_name("a\\b") == "'a\\b'", "name with a backslash")
    assert(bore.quote_name("a\"b") == "'a\"b'", "name with a double quote")
    // # and ~ need quoting only where a shell would read them.
    assert(bore.quote_name("a#b") == "a#b", "hash inside a name")
    assert(bore.quote_name("#ab") == "'#ab'", "hash starting a name")
    assert(bore.quote_name("a~b") == "a~b", "tilde inside a name")
    assert(bore.quote_name("~ab") == "'~ab'", "tilde starting a name")
    // A single quote takes double quotes, unless something else in the
    // name rules them out.
    assert(bore.quote_name("a'b") == "\"a'b\"", "name with a single quote")
    assert(bore.quote_name("a'b c") == "\"a'b c\"", "a single quote and a space")
    assert(bore.quote_name("a'b:c") == "\"a'b:c\"", "a single quote and a colon")
    assert(bore.quote_name("a'b$c") == "'a'\\''b$c'", "a single quote and a dollar")
    assert(bore.quote_name("a'b{{c}}") == "'a'\\''b{{c}}'", "a single quote and a brace")
    assert(bore.quote_name("a'b!c") == "'a'\\''b!c'", "a single quote and a bang")
    // A byte outside printable ASCII splices $'…' runs in.
    assert(bore.quote_name("a\tb") == "'a'$'\\t''b'", "a tab inside a name")
    assert(bore.quote_name("\t") == "''$'\\t'", "a name that is one tab")
    assert(bore.quote_name("ab\t") == "'ab'$'\\t'", "a tab ending a name")
    assert(bore.quote_name("\tab") == "''$'\\t''ab'", "a tab starting a name")
    assert(bore.quote_name("a\tb\tc") == "'a'$'\\t''b'$'\\t''c'", "two tabs")
    assert(bore.quote_name("\t\t") == "''$'\\t\\t'", "one run of two tabs")
    assert(bore.quote_name("é") == "''$'\\303\\251'", "a name that is one non-ASCII char")
    assert(bore.quote_name("a'b\tc") == "'a'\\''b'$'\\t''c'", "a single quote and a tab")
    assert(bore.quote_name("a\\b\tc") == "'a\\b'$'\\t''c'", "a backslash and a tab")
}
