//! member: false
//! comm — three-column merge under LC_ALL=C. References consulted:
//! POSIX comm, GNU coreutils 9.11 help/manual and binary probes;
//! uutils (MIT), toybox (0BSD) design references only. No GNU source.

use bore
use textio

fn main() -> int {
    var out = bore.stdout()
    var spec = List[bore.Opt]()
    (mut spec).push(bore.flag("1", ""))
    (mut spec).push(bore.flag("2", ""))
    (mut spec).push(bore.flag("3", ""))
    (mut spec).push(bore.flag("", "check-order"))
    (mut spec).push(bore.flag("", "nocheck-order"))
    (mut spec).push(bore.takes("", "output-delimiter"))
    (mut spec).push(bore.flag("z", "zero-terminated"))
    (mut spec).push(bore.flag("", "total"))
    (mut spec).push(bore.flag("", "help"))
    (mut spec).push(bore.flag("", "version"))
    let p = bore.parse(spec, env_args(), bore.permute())
    var show = [true, true, true]
    var order = 0, delim = 10, total = false, sep = "\t", sep_given = false
    for k in 0..p.keys.len {
        let key = p.keys[k]
        if key == "help" || key == "version" {
            bore.put(
                mut out,
                if key == "version" {
                    bore.version_text("comm")
                } else {
                    "Usage: comm [OPTION]... FILE1 FILE2\nCompare sorted byte records in three columns.\n"
                },
            ) else |_| {}
            return bore.finish(mut out, "comm", 0)
        }
        if key == "1" { show[0] = false }
        if key == "2" { show[1] = false }
        if key == "3" { show[2] = false }
        if key == "check-order" { order = 1 }
        if key == "nocheck-order" { order = -1 }
        if key == "zero-terminated" { delim = 0 }
        if key == "total" { total = true }
        if key == "output-delimiter" {
            let v = p.values[k]
            if sep_given && sep != v {
                bore.warn("comm", "multiple output delimiters specified")
                return 1
            }
            sep = v
            sep_given = true
        }
    }
    if !bore.ok(p) { return bore.usage_error("comm", p.error) }
    if p.operands.len < 2 {
        if p.operands.len == 0 { return bore.usage_error("comm", "missing operand") }
        return bore.usage_error("comm", "missing operand after {bore.quote(p.operands[0])}")
    }
    if p.operands.len > 2 {
        return bore.usage_error("comm", "extra operand {bore.quote(p.operands[2])}")
    }
    let shared_stdin = p.operands[0] == "-" && p.operands[1] == "-"
    var a = textio.Rows { items: List[textio.Rec](), failed: false }
    var b = textio.Rows { items: List[textio.Rec](), failed: false }
    var reader = SharedInput { chunk: List[byte](), pos: 0, exhausted: false, eof_given: false, why: "" }
    if shared_stdin {
        if !push_shared(mut reader, mut a.items, delim) || !push_shared(mut reader, mut b.items, delim) {
            bore.input_error("comm", "-", reader.why)
            return 1
        }
    } else {
        a = textio.load("comm", p.operands[0], delim)
        if a.failed { return 1 }
        b = textio.load("comm", p.operands[1], delim)
        if b.failed { return 1 }
    }
    var i = 0, j = 0, unpaired = false, bad1 = false, bad2 = false
    var counts = [0, 0, 0]
    while i < a.items.len || j < b.items.len {
        var c = 0
        if i >= a.items.len {
            c = 1
        } else if j < b.items.len {
            let cmp = textio.cmp(a.items[i].data, b.items[j].data, false)
            if cmp == 0 { c = 2 } else if cmp > 0 { c = 1 }
        }
        counts[c] += 1
        if show[c] {
            for col in 0..c {
                if show[col] {
                    if sep.len == 0 {
                        bore.put_byte(mut out, 0 as byte) else |_| {
                            return bore.finish(mut out, "comm", 1)
                        }
                    } else {
                        bore.put(mut out, sep) else |_| { return bore.finish(mut out, "comm", 1) }
                    }
                }
            }
            if c == 1 {
                textio.put(mut out, b.items[j].data, delim) else |_| {
                    return bore.finish(mut out, "comm", 1)
                }
            } else {
                textio.put(mut out, a.items[i].data, delim) else |_| {
                    return bore.finish(mut out, "comm", 1)
                }
            }
        }
        var shared_failed = false
        if c != 1 {
            i += 1
            if shared_stdin && !push_shared(mut reader, mut a.items, delim) {
                shared_failed = true
            }
        }
        if c != 0 {
            j += 1
            if shared_stdin && !push_shared(mut reader, mut b.items, delim) {
                shared_failed = true
            }
        }
        if c != 2 { unpaired = true }
        // At EOF GNU rechecks the last retained record; otherwise check
        // only the file advanced by this merge step. A previously paired
        // disorder can therefore be silent until that file ends.
        if order >= 0 && (order == 1 || unpaired) {
            var ai = i, bj = j
            if ai == a.items.len { ai -= 1 }
            if bj == b.items.len { bj -= 1 }
            if c != 1 &&
                ai > 0 &&
                !bad1 &&
                textio.cmp(a.items[ai - 1].data, a.items[ai].data, false) > 0 {
                bore.warn("comm", "file 1 is not in sorted order")
                bad1 = true
                if order == 1 { return bore.finish(mut out, "comm", 1) }
            }
            if c != 0 &&
                bj > 0 &&
                !bad2 &&
                textio.cmp(b.items[bj - 1].data, b.items[bj].data, false) > 0 {
                bore.warn("comm", "file 2 is not in sorted order")
                bad2 = true
                if order == 1 { return bore.finish(mut out, "comm", 1) }
            }
        }
        if shared_failed {
            bore.input_error("comm", "-", reader.why)
            return bore.finish(mut out, "comm", 1)
        }
    }
    if total {
        let s = if sep.len == 0 then "\0" else sep
        bore.put(mut out, "{counts[0]}{s}{counts[1]}{s}{counts[2]}{s}total") else |_| {
            return bore.finish(mut out, "comm", 1)
        }
        bore.put_byte(mut out, delim as byte) else |_| { return bore.finish(mut out, "comm", 1) }
    }
    var status = 0
    if bad1 || bad2 { bore.warn("comm", "input is not in sorted order"); status = 1 }
    bore.finish(mut out, "comm", status)
}

// A single cursor, shared by both merge sides. Only the consumed side
// receives the next record; an unpaired record therefore shifts ownership.
struct SharedInput { chunk: List[byte], pos: int, exhausted: bool, eof_given: bool, why: str }
fn push_shared(mut reader: SharedInput, mut rows: List[textio.Rec], delim: int) -> bool {
    let row = next_shared(mut reader, delim) else |e| match e {
        eof => { return true },
        io => { return false },
    }
    (mut rows).push(row)
    true
}
fn next_shared(mut reader: SharedInput, delim: int) -> textio.Rec ! {eof, io} {
    if reader.exhausted {
        if !reader.eof_given { reader.eof_given = true; return eof }
        // Measured GNU 9.11 closes its shared FILE at the first EOF;
        // the other side's next request reports EBADF rather than EOF.
        reader.why = bore.bad_descriptor()
        return io
    }
    var bytes = List[byte]()
    loop {
        if reader.pos >= reader.chunk.len {
            reader.chunk = fs_read_chunk(0, 65536) else |e| match e {
                eof => {
                    reader.exhausted = true
                    if bytes.len > 0 { return textio.Rec { data: bytes } }
                    reader.eof_given = true
                    return eof
                },
                io => { reader.why = bore.reason_of(bore.host_code()); return io },
            }
            reader.pos = 0
            if reader.chunk.len == 0 {
                reader.exhausted = true
                if bytes.len > 0 { return textio.Rec { data: bytes } }
                reader.eof_given = true
                return eof
            }
        }
        let b = reader.chunk[reader.pos]
        reader.pos += 1
        if b as int == delim { return textio.Rec { data: bytes } }
        (mut bytes).push(b)
    }
}
