//! member: false
//! uptime — Linux procfs uptime/load and utmp user/boot records.
//! References: GNU coreutils 9.11 manual and black-box boundary runs;
//! Linux proc(5), utmp(5). No implementation source. Non-Linux procfs
//! and utmp layouts are refused by name. Clock output is shape-tested.

use bore

fn proc_text(path: str) -> str {
    let b = fs_read_bytes(path) else List[byte]()
    str_from_utf8(b) else ""
}

// An existing utmp with no BOOT_TIME makes GNU 9.11 use init's
// start, not host uptime. Read its documented procfs start_ticks and
// AT_CLKTCK from auxv, never assume the host's tick frequency.
fn init_boot() -> int {
    let aux = fs_read_bytes("/proc/self/auxv") else List[byte]()
    var hz: int = 0
    var at = 0
    while at + 16 <= aux.len {
        var tag: int = 0, value: int = 0, power: int = 1
        for j in 0..7 {
            tag += aux[at + j] as int * power
            value += aux[at + 8 + j] as int * power
            power *= 256
        }
        if tag == 17 { hz = value; break }
        at += 16
    }
    if hz <= 0 { return -1 }
    var boot: int = -1
    for line in proc_text("/proc/stat").lines() {
        if line.starts_with("btime ") { boot = line[6..].trim().to_int() else -1 }
    }
    let record = proc_text("/proc/1/stat")
    let close = record.rfind(")") else -1
    if close < 0 || boot < 0 { return -1 }
    let fields = record[close + 1..].words()
    if fields.len < 20 { return -1 }
    let ticks = fields[19].to_int() else -1
    if ticks < 0 { return -1 }
    boot + ticks / hz
}

fn main() -> int {
    var opts = List[bore.Opt]()
    (mut opts).push(bore.flag("", "help"))
    (mut opts).push(bore.flag("", "version"))
    let p = bore.parse(opts, env_args(), bore.permute())
    var out = bore.stdout()
    for key in p.keys {
        if key == "help" {
            bore.put(
                mut out,
                "Usage: uptime [FILE]\nPrint the clock, uptime, login count and one-, five- and fifteen-minute loads. FILE supplies Linux utmp boot and login records.\n",
            ) else |_| {}
            return bore.finish(mut out, "uptime", 0)
        }
        if key == "version" {
            bore.put(mut out, bore.version_text("uptime")) else |_| {}
            return bore.finish(mut out, "uptime", 0)
        }
    }
    if !bore.ok(p) { return bore.usage_error("uptime", p.error) }
    if p.operands.len > 1 {
        return bore.usage_error("uptime", "extra operand {bore.quote_always(p.operands[1])}")
    }
    if !bore.login_abi(os_name(), os_arch()) {
        bore.warn("uptime", "procfs uptime/load and utmp layout unsupported on this host")
        return 1
    }
    let now = bore.Instant { secs: time_unix_ms() / 1000, nanos: 0 }
    let path = if p.operands.len == 0 then bore.login_path() else p.operands[0]
    var users = 0, boot: int = -1
    for r in bore.login_records(path) {
        if r.kind == 7 && !r.valid_text {
            bore.warn("uptime", "non-UTF-8 utmp text is unsupported (raw paths: wolf-lang#687)")
            return 1
        }
        if r.kind == 7 && r.user != "" && (p.operands.len > 0 || bore.login_live(r)) { users += 1 }
        if r.kind == 2 { boot = r.secs }
    }
    var up: int = -1
    if fs_exists(path) {
        if boot < 0 { boot = init_boot() }
        if boot >= 0 { up = now.secs - boot }
    } else if p.operands.len == 0 {
        up = proc_text("/proc/uptime").split(".")[0].to_int() else -1
    }
    var status = 0
    var duration = "???? days ??:??"
    if up >= 0 {
        let days = up / 86400
        let hours = up / 3600 % 24
        duration = bore.space_padded(hours, 3) + ":" + bore.zero_padded(up / 60 % 60, 2)
        if days > 0 {
            duration = "{days} " +
                (if days == 1 then "day" else "days") +
                " " +
                bore.space_padded(hours, 2) +
                ":" +
                bore.zero_padded(up / 60 % 60, 2)
        }
    } else {
        if !fs_exists(path) {
            bore.warn("uptime", "couldn't get boot time: No such file or directory")
        } else {
            bore.warn("uptime", "couldn't get boot time")
        }
        status = 1
    }
    let clock = bore.date_format("%H:%M:%S", now, bore.zone()) else "??:??:??"
    var text = " {clock}  up {duration},  {users} " + (if users == 1 then "user" else "users")
    let load = proc_text("/proc/loadavg").words()
    if load.len >= 3 { text += ",  load average: {load[0]}, {load[1]}, {load[2]}" }
    bore.put(mut out, text + "\n") else |_| {}
    bore.finish(mut out, "uptime", status)
}
