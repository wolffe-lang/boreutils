#!/bin/sh
# idtest-selftest — prove tools/idtest can see a difference (bu24).
#
# A gate nobody has watched fail is not a gate. This runs idtest over
# tests/ids/selftest.toml, whose plants make the sides differ on purpose
# (an owner, an account, the actor, the terminal), and passes only when
# idtest exits 1, every plant is a FAIL line of its own on the field it
# is about, and the control passes.
#
# usage: tools/idtest-selftest [idtest's options]
set -eu
BORE_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$BORE_ROOT"

out=$(tools/idtest "$@" --cases tests/ids/selftest.toml 2>&1) && status=0 || status=$?
if [ "$status" -ne 1 ]; then
    echo "idtest-selftest: REFUSED — idtest exited $status over the planted"
    echo "idtest-selftest: differences; it must exit 1. Output was:"
    echo "$out"
    exit 1
fi
for planted in "plant: an owner one side changes" \
               "plant: an account one side cannot see" \
               "plant: the actor took" \
               "plant: the terminal and its record reached ours"; do
    if ! echo "$out" | grep -qF "FAIL $planted"; then
        echo "idtest-selftest: REFUSED — the plant '$planted' did not fail:"
        echo "$out"
        exit 1
    fi
done
for said in "release tree:" "release exit: 1, gnu 0" "release stdout: '1001\\n', want '0\\n'" \
            "release stdout: 'alice\\n', want ''"; do
    if ! echo "$out" | grep -qF "$said"; then
        echo "idtest-selftest: REFUSED — no line says: $said"
        echo "$out"
        exit 1
    fi
done
if ! echo "$out" | grep -qF "ok   control: the actor's own id"; then
    echo "idtest-selftest: REFUSED — the control did not pass:"
    echo "$out"
    exit 1
fi
echo "$out" | grep -E '^(FAIL|ok  )'
echo "idtest-selftest: idtest saw every planted difference and passed the control"
