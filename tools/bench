#!/usr/bin/env python3
"""bench - hyperfine, boreutils against GNU coreutils, on named inputs.

Not a CI gate. CI runs one smoke bench (--scale 0.001) so the harness
stays alive; the numbers of record are taken by hand on a stated host.

Bench file (TOML), tests/bench/<util>.toml:

  [[bench]]
  name = "1 GiB of output into head -c"
  command = "{prog} | head -c {bytes:1073741824} > /dev/null"
  input = "big"          # optional: big | lines | noise

Placeholders: {prog} is the program under test (the boreutils binary or
GNU's), {input} the generated input file's path, {bytes:N} the integer
N times --scale (at least 1).

For the utilities that change the file system (bu21) a bench may also
carry

  prepare = "rm -rf {work}"   # run before EVERY timed run of both sides
                              #   (hyperfine --prepare): what the run
                              #   consumes or creates is put back first

and two more placeholders: {work}, a path that does not exist until a
bench makes it, inside a directory THIS TOOL made (`bore-bench-work.*`
under the scratch directory) and checks by prefix before every
hyperfine call — a program that removes is never pointed anywhere
else; and {path:N}, N times --scale components `d/d/d/…` (at least
one), for a path that deep. `--input NAME` runs only the benches whose
input is NAME (`none` for those with no input), since one --scale does
not suit a 1 GiB file and a 100,000-file tree alike.

Named inputs, generated deterministically (a fixed seed; the same bytes
on every host and every run) into a scratch directory, never committed,
and deleted when the run ends unless --keep:

  big    1 GiB of text: lowercase words, spaces, lines of about 64 bytes
  lines  64 MiB of very short lines: 0 to 7 letters each
  noise  256 MiB of uniformly random bytes
  tree   a DIRECTORY (bu18, for ls): flat/ holding 10,000 files and
         deep/ holding 100 directories of 100 files each, every name
         drawn from a fixed seed so that no order is already sorted, each
         file 0 to 999 bytes; --scale multiplies the counts

--scale multiplies every size, so --scale 0.001 is a smoke run.

Output: a markdown table per utility, headed by the host, the GNU
version and the build tier.

usage: tools/bench [--scale F] [--runs N] [--keep] [--dir D] [--bin DIR]
                   [--out FILE] [--input NAME] [util ...]
"""

import json
import os
import re
import platform
import random
import shutil
import subprocess
import sys
import tempfile
import tomllib

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BENCH = os.path.join(ROOT, "tests", "bench")
MIB = 1 << 20
SIZES = {"big": 1024 * MIB, "lines": 64 * MIB, "noise": 256 * MIB,
         "tree": 10000}
SEEDS = {"big": 0xB0BE, "lines": 0x11E5, "noise": 0x5EED, "tree": 0x7EE5}
BLOCK = 4 * MIB


def timings(doc, util):
    """{name: {"mean", "stddev"}} in seconds, from either export schema.
    hyperfine 1.x: each result's "command" is its `-n` name, with "mean"
    and "stddev" beside it. hyperfine 2.0.0 (schema_version 2; Homebrew,
    CI's macOS runner, 2026-10-15): the name is "name" and the times are
    under summary.time_wall_clock, unit stated."""
    out = {}
    for r in doc.get("results", []):
        if "summary" in r:
            t = r["summary"].get("time_wall_clock", {})
            if t.get("unit") != "second":
                die(f"{util}: hyperfine's wall-clock unit is {t.get('unit')!r}, not second")
            out[r.get("name")] = {"mean": t["mean"], "stddev": t["stddev"]}
        else:
            out[r.get("command")] = {"mean": r["mean"], "stddev": r["stddev"]}
    if set(out) != {"boreutils", "gnu"}:
        die(f"{util}: hyperfine's results name {sorted(map(str, out))}, not boreutils and gnu")
    return out


def shell_args():
    """hyperfine 2.0.0 (Homebrew, CI's macOS runner, 2026-10-15) runs a
    command WITHOUT a shell unless asked, and every bench here redirects;
    1.x always used one and has no `default` shell to name."""
    said = subprocess.run(["hyperfine", "--version"], capture_output=True, text=True).stdout
    m = re.search(r"hyperfine (\d+)\.", said)
    if m is None:
        die(f"cannot read hyperfine's version from {said!r}")
    return ["--shell", "default"] if int(m.group(1)) >= 2 else []


def die(msg):
    print(f"bench: {msg}", file=sys.stderr)
    sys.exit(2)


def text_table(newline_every):
    # 256 byte values onto letters, spaces and newlines, in fixed ratios
    t = bytearray()
    for i in range(256):
        if i % newline_every == 0:
            t.append(10)
        elif i % 6 == 0:
            t.append(32)
        else:
            t.append(97 + i % 26)
    return bytes(t)


def generate_tree(path, count):
    """`tree`: flat/ with `count` files, deep/ with sqrt(count)
    directories of sqrt(count) files; names and sizes from the seed."""
    rng = random.Random(SEEDS["tree"])
    side = max(1, int(round(count ** 0.5)))

    def fill(d, n):
        os.makedirs(d)
        for _ in range(n):
            name = "%08x" % rng.getrandbits(32)
            with open(os.path.join(d, name), "wb") as fh:
                fh.write(b"x" * rng.randrange(1000))

    fill(os.path.join(path, "flat"), count)
    os.makedirs(os.path.join(path, "deep"))
    for k in range(side):
        fill(os.path.join(path, "deep", "%08x" % rng.getrandbits(32)), side)


def generate(name, path, size):
    if name == "tree":
        generate_tree(path, size)
        return
    rng = random.Random(SEEDS[name])
    table = {"big": text_table(64), "lines": text_table(4)}.get(name)
    with open(path, "wb") as fh:
        left = size
        while left > 0:
            n = min(BLOCK, left)
            block = rng.randbytes(n)
            fh.write(block if table is None else block.translate(table))
            left -= n


def gnu_prefix():
    if "BORE_GNU_PREFIX" in os.environ:
        return os.environ["BORE_GNU_PREFIX"]
    return "g" if platform.system() == "Darwin" else ""


def expand(command, prog, inp, scale, work=""):
    out = command.replace("{prog}", prog).replace("{input}", inp or "")
    out = out.replace("{work}", work)
    while "{bytes:" in out:
        i = out.index("{bytes:")
        j = out.index("}", i)
        n = max(1, int(int(out[i + 7:j]) * scale))
        out = out[:i] + str(n) + out[j + 1:]
    while "{path:" in out:
        i = out.index("{path:")
        j = out.index("}", i)
        n = max(1, int(int(out[i + 6:j]) * scale))
        out = out[:i] + "/".join(["d"] * n) + out[j + 1:]
    return out


def work_path(scratch):
    """A path for a bench to create, remove and re-create: inside a
    directory made here, under `scratch`, and nowhere else."""
    holder = tempfile.mkdtemp(prefix="bore-bench-work.", dir=scratch)
    return holder, os.path.join(holder, "w")


def guard_work(work, scratch):
    """Refuse to hand a remover a path that is not this tool's own."""
    real = os.path.realpath(os.path.dirname(work))
    root = os.path.realpath(scratch)
    home = os.path.realpath(os.path.expanduser("~"))
    if (root in (os.sep, home) or os.path.islink(os.path.dirname(work))
            or not real.startswith(os.path.join(root, "bore-bench-work."))
            or os.path.basename(work) != "w"):
        die(f"refusing the work path {work!r}: not under {root!r}")


def main(argv):
    scale, runs, keep, scratch, out_path = 1.0, 10, False, None, None
    only_input = None
    bindir = os.path.join(ROOT, "target", "release")
    utils = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--scale", "--runs", "--dir", "--bin", "--out", "--input"):
            if i + 1 >= len(argv):
                die(f"{a} needs a value")
            v = argv[i + 1]
            i += 1
            if a == "--scale":
                scale = float(v)
            elif a == "--runs":
                runs = int(v)
            elif a == "--dir":
                scratch = v
            elif a == "--bin":
                bindir = os.path.abspath(v)
            elif a == "--input":
                only_input = v
            else:
                out_path = v
        elif a == "--keep":
            keep = True
        else:
            utils.append(a)
        i += 1
    if shutil.which("hyperfine") is None:
        die("hyperfine not found on PATH")
    utils = utils or sorted(f[:-5] for f in os.listdir(BENCH)
                            if f.endswith(".toml"))
    prefix = gnu_prefix()
    gnu_true = shutil.which(prefix + "true") or die("GNU coreutils not found")
    gnu_version = subprocess.run([gnu_true, "--version"], capture_output=True,
                                 text=True).stdout.splitlines()[0]
    wolf_line = "wolf ?"
    wolf = os.path.join(ROOT, ".wolf-bin", "wolf")
    if os.access(wolf, os.X_OK):
        wolf_line = subprocess.run([wolf, "--version"], capture_output=True,
                                   text=True).stdout.splitlines()[0]
    tier = os.path.basename(bindir)
    host = f"{platform.node().split('.')[0]} ({platform.system()} " \
           f"{platform.machine()}, {os.cpu_count()} cpus)"

    made = scratch is None
    scratch = scratch or tempfile.mkdtemp(prefix="bore-bench-")
    os.makedirs(scratch, exist_ok=True)
    report = []
    generated = {}
    holder, work = work_path(scratch)
    try:
        for util in utils:
            with open(os.path.join(BENCH, util + ".toml"), "rb") as fh:
                benches = tomllib.load(fh).get("bench", [])
            bore = os.path.join(bindir, util)
            gnu = shutil.which(prefix + util)
            if not os.access(bore, os.X_OK):
                die(f"no boreutils binary at {bore}")
            if gnu is None:
                die(f"GNU '{prefix}{util}' not found")
            report.append(f"## {util}\n")
            report.append(f"- host: {host}")
            report.append(f"- GNU: {gnu_version}")
            report.append(f"- boreutils: {tier} tier, {wolf_line}")
            report.append(f"- scale: {scale}, runs: {runs}\n")
            report.append("| bench | boreutils (ms) | GNU (ms) | GNU / boreutils |")
            report.append("|---|---:|---:|---:|")
            for b in benches:
                if only_input is not None and (b.get("input") or "none") != only_input:
                    continue
                inp = None
                if b.get("input"):
                    name = b["input"]
                    if name not in SIZES:
                        die(f"{util}: unknown input {name!r}")
                    inp = os.path.join(scratch, name)
                    if name not in generated:
                        generate(name, inp, max(1, int(SIZES[name] * scale)))
                        # On disk before it is timed: 20,000 fresh files
                        # still being written back made ls's rows swing
                        # ±40% on kasumi (bu18).
                        os.sync()
                        generated[name] = True
                export = os.path.join(scratch, "hyperfine.json")
                cmds = [expand(b["command"], p, inp, scale, work) for p in (bore, gnu)]
                extra = []
                if "prepare" in b:
                    extra = ["--prepare", expand(b["prepare"], "", inp, scale, work)]
                if "{work}" in b["command"] or "prepare" in b:
                    guard_work(work, scratch)
                subprocess.run(
                    ["hyperfine"] + shell_args() + ["--style", "none", "--warmup", "1",
                     "--runs", str(runs), "--export-json", export] + extra +
                    ["-n", "boreutils", cmds[0], "-n", "gnu", cmds[1]],
                    check=True, stdout=subprocess.DEVNULL)
                # What a bench left in the work path is not the next one's.
                if os.path.lexists(work):
                    guard_work(work, scratch)
                    if os.path.isdir(work) and not os.path.islink(work):
                        shutil.rmtree(work, ignore_errors=True)
                    else:
                        os.unlink(work)
                with open(export) as fh:
                    res = timings(json.load(fh), util)
                bm = res["boreutils"]["mean"] * 1000
                gm = res["gnu"]["mean"] * 1000
                bs = res["boreutils"]["stddev"] * 1000
                gs = res["gnu"]["stddev"] * 1000
                # At smoke scale both sides can round to zero, and a
                # ratio taken there would be noise dressed as a number.
                ratio = f"{gm / bm:.2f}" if bm >= 1.0 and gm >= 1.0 else "--"
                report.append(f"| {b['name']} | {bm:.1f} ± {bs:.1f} | "
                              f"{gm:.1f} ± {gs:.1f} | {ratio} |")
            report.append("")
    finally:
        shutil.rmtree(holder, ignore_errors=True)
        if made and not keep:
            shutil.rmtree(scratch, ignore_errors=True)
    text = "\n".join(report)
    print(text)
    if out_path:
        with open(out_path, "w") as fh:
            fh.write(text + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
