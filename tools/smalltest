#!/usr/bin/env python3
"""bu30: shape-guard plants and named surface refusals (no GNU source)."""
import copy
import contextlib
import io
import os
from pathlib import Path
import runpy
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
H = runpy.run_path(str(ROOT / "tools/difftest"))


class ShapeGate(unittest.TestCase):
    def test_control_and_plants(self):
        with tempfile.TemporaryDirectory(prefix="bore-small.") as top:
            path = Path(top) / "fixed.aZ0"
            path.write_bytes(b"")
            path.chmod(0o600)
            case = {"temp_shape": {"prefix": "fixed.", "xs": 3, "suffix": "", "directory": "", "kind": "file", "mode": 0o600}}
            good = {"exit": 0, "stdout": b"fixed.aZ0\n", "files": [("fixed.aZ0", "file", b"")]}
            answer = H["temp_result"](copy.deepcopy(good), case, top, top)
            self.assertEqual(answer["shape_error"], "")
            self.assertEqual(answer["files"][0][0], "<TEMP>")
            for output in [b"other.aZ0\n", b"fixed.aZ\n", b"fixed.aZ0x\n", b"fixed.a_0\n", b"fixed.aZ0.bad\n", b"fixed.aZ0\nextra\n"]:
                bad = dict(good, stdout=output)
                self.assertTrue(H["temp_result"](bad, case, top, top)["shape_error"], output)
            path.chmod(0o644)
            self.assertTrue(H["temp_result"](dict(good), case, top, top)["shape_error"])
            path.unlink()
            self.assertTrue(H["temp_result"](dict(good), case, top, top)["shape_error"])
            path.mkdir()
            self.assertTrue(H["temp_result"](dict(good), case, top, top)["shape_error"])
            case["temp_shape"]["kind"] = "none"
            self.assertTrue(H["temp_result"](dict(good), case, top, top)["shape_error"])

    def test_changer_guard(self):
        for util in ("mkfifo", "link", "unlink", "truncate", "sync", "mktemp"):
            self.assertIn(util, H["CHANGERS"])
        for path in ("/", "/etc/nope", "../outside", "a/../b", "~/x"):
            self.assertIsNotNone(H["unsafe"](path), path)
        self.assertEqual(list(H["changer_paths"]("truncate", ["-s", "/2", "f"])), ["f"])
        self.assertEqual(list(H["changer_paths"]("truncate", ["--size=/2", "f"])), ["f"])
        self.assertEqual(list(H["changer_paths"]("truncate", ["--", "-s", "/2"])), ["-s", "/2"])
        self.assertEqual(list(H["changer_paths"]("truncate", ["-r", "/outside", "f"])), ["-r", "/outside", "f"])


    def test_loader_refuses_outside_tmpdir(self):
        with tempfile.TemporaryDirectory(prefix="bore-loader.") as top:
            cases = Path(top) / "mktemp.toml"
            cases.write_text('[[case]]\nname="outside"\nargs=["-t","fXXX"]\nenv={ TMPDIR="/nonexistent-bore-refusal-root" }\n')
            with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit) as error:
                H["load"](str(cases), "mktemp")
            self.assertEqual(error.exception.code, 2)
            cases.write_text('[[case]]\nname="safe default"\nargs=[]\n')
            loaded = H["load"](str(cases), "mktemp")
            self.assertEqual(loaded[0]["env"]["TMPDIR"], "{scratch}")



class SurfaceRefusals(unittest.TestCase):
    def test_fifo_and_write_only_refusals(self):
        self.assertNotEqual(os.geteuid(), 0, "run the permission witness on the unprivileged leg")
        tier = os.environ.get("BORE_SMALL_TIER", "release")
        with tempfile.TemporaryDirectory(prefix="bore-special.") as top:
            file = Path(top) / "f"
            file.write_bytes(b"abcdef")
            file.chmod(0o200)
            os.mkfifo(Path(top) / "fifo")
            (Path(top) / "link").symlink_to("fifo")
            cases = [("sync", ["f"], b"non-creating writable open"),
                     ("sync", ["-d", "f"], b"non-creating writable open"),
                     ("truncate", ["-s", "0", "fifo"], b"non-blocking writable open"),
                     ("truncate", ["-c", "-s", "0", "fifo"], b"non-blocking writable open"),
                     ("truncate", ["-s", "0", "link"], b"non-blocking writable open")]
            for utility, args, reason in cases:
                with self.subTest(utility=utility, args=args):
                    done = subprocess.run([str(ROOT / "target" / tier / utility)] + args,
                                          cwd=top, capture_output=True, timeout=2)
                    self.assertEqual(done.returncode, 1, done.stderr)
                    self.assertEqual(done.stdout, b"")
                    self.assertIn(reason, done.stderr)
            file.chmod(0o600)
            self.assertEqual(file.read_bytes(), b"abcdef")

    def test_macos_link_follow_refusal(self):
        if sys.platform != "darwin":
            print("SKIP smalltest: macOS link-follow refusal (not Darwin)", flush=True)
            self.skipTest("macOS-only fs_link follow gap")
        tier = os.environ.get("BORE_SMALL_TIER", "release")
        with tempfile.TemporaryDirectory(prefix="bore-link-follow.") as top:
            p = Path(top)
            (p / "f").write_bytes(b"abcdef")
            (p / "live").symlink_to("f")
            (p / "dangling").symlink_to("missing")
            for source in ("live", "dangling"):
                done = subprocess.run([str(ROOT / "target" / tier / "link"), source, "h"],
                                      cwd=top, capture_output=True, timeout=2)
                self.assertEqual(done.returncode, 1, done.stderr)
                self.assertIn(b"following a source symbolic link", done.stderr)
                self.assertFalse(os.path.lexists(p / "h"))
            self.assertEqual((p / "f").read_bytes(), b"abcdef")

    def test_named_refusals(self):
        for tier in (os.environ.get("BORE_SMALL_TIER", "release"),):
            for utility, args, words in [
                ("truncate", ["-o", "-s", "1", "f"], b"-o (--io-blocks) is not supported by this truncate"),
                ("sync", [], b"sync(2)"),
                ("sync", ["-f", "f"], b"syncfs(2)"),
                ("mkfifo", ["-Z", "f"], b"-Z/--context"),
                ("mkfifo", ["--context=foo", "f"], b"-Z/--context"),
            ]:
                with self.subTest(tier=tier, utility=utility, args=args), tempfile.TemporaryDirectory(prefix="bore-refusal.") as top:
                    proc = subprocess.run([str(ROOT / "target" / tier / utility)] + args, cwd=top, capture_output=True, env={"LC_ALL": "C", "PATH": os.environ["PATH"]})
                    self.assertEqual(proc.returncode, 1, proc.stderr)
                    self.assertEqual(proc.stdout, b"")
                    self.assertIn(words, proc.stderr)
                    self.assertFalse(list(Path(top).iterdir()))


if __name__ == "__main__":
    unittest.main()
