#!/bin/sh
# difftest-selftest — prove the differential harness can see a difference.
#
# A gate nobody has watched fail is not a gate. This runs difftest over
# tests/selftest/, whose cases are deliberately wrong about GNU (they
# run the WRONG GNU utility against ours), and passes only when difftest
# exits 1 and every planted case is a FAIL line of its own.
set -eu
BORE_ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$BORE_ROOT"

out=$(BORE_SELFTEST=1 tools/difftest --cases tests/selftest 2>&1) && status=0 || status=$?
if [ "$status" -ne 1 ]; then
    echo "difftest-selftest: REFUSED — difftest exited $status over the planted"
    echo "difftest-selftest: mismatch; it must exit 1. Output was:"
    echo "$out"
    exit 1
fi
if ! echo "$out" | grep -q '^FAIL '; then
    echo "difftest-selftest: REFUSED — difftest exited 1 but printed no FAIL line:"
    echo "$out"
    exit 1
fi
# Every planted case must fail BY NAME: one FAIL line is not enough once
# there is more than one plant, because the others could be passing.
# The `files` plants (bu14) are the gate on the scratch directory, and
# the `offset` plant (bu15) the gate on a shared standard input, and the
# `tty` plant (bu19) the gate on reading a pseudo-terminal at all, and
# the `mask` plant (bu20) the gate on a mask hiding only its match, and
# the `gnu_keep` plant (bu23) the gate on a kept table still failing on
# a row one side lacks.
for planted in "true: true is not false" \
               "tee: a file one side writes" \
               "tee: a file whose bytes differ" \
               "head: an offset one side moves" \
               "echo: what a terminal received" \
               "echo: a mask hides only what it names" \
               "echo: a kept line the other side lacks" \
               "tee: two names of one file" \
               "tee: a time one side sets"; do
    if ! echo "$out" | grep -qF "FAIL $planted"; then
        echo "difftest-selftest: REFUSED — the plant '$planted' did not fail:"
        echo "$out"
        exit 1
    fi
done
# The controls (bu21): cases that must PASS for a plant beside them, or
# a key of the harness, to mean anything. The `tree` plant above fails
# on a link count; its twin compared on bytes alone must not fail. And
# the two `umask` controls pass only when the mask reached both sides.
# The `gnu_keep` control (bu23) passes only when the lines the case does
# not keep were really dropped.
for control in "tee: two names of one file, by bytes alone" \
               "echo: kept lines alike" \
               "tee: a mask reaches our side" \
               "tee: a mask reaches both sides or neither" \
               "tee: times both sides leave alike"; do
    if ! echo "$out" | grep -qxF "ok   $control"; then
        echo "difftest-selftest: REFUSED — the control '$control' did not pass:"
        echo "$out"
        exit 1
    fi
done
echo "$out" | grep -E '^(FAIL|difftest:)'
echo "difftest-selftest: the harness saw every planted difference"

# THE REFUSALS (bu21). A utility that changes the file system is never
# started on an operand that could reach outside its scratch directory:
# the harness refuses the whole run, status 2, before any case has run.
# One plant per rule under tests/refuse/, each a `mkdir` case (were a
# refusal ever broken, `mkdir /` fails and harms nothing — which is why
# no plant here names `rm`). And the scratch root itself is refused when
# it is `/` or a home directory.
#
# The `kill-*` plants (bu23) are the same gate for `kill`, which sends:
# a case of it that could signal a process refuses the run. Each names
# an id no host has (were the refusal ever broken, GNU's `kill` answers
# `No such process` and signals nothing).
#
# The `owner-*` plants (bu24) are the gate for `chown` and `chgrp`: a
# case of either that names a FILE refuses the run. Each names a user or
# group, and files, that no host has.
#
# The `timeout-*` plants (bu27) are the gate for `timeout`: a case of it
# that could start a command refuses the run. Each names a command that
# ends at once (`true`), so were the refusal ever broken nothing is
# signalled.
for plant in tests/refuse/*/; do
    name=$(basename "$plant")
    out=$(tools/difftest --cases "$plant" 2>&1) && status=0 || status=$?
    if [ "$status" -ne 2 ] || ! echo "$out" | grep -q 'difftest: .*refusing case'; then
        echo "difftest-selftest: REFUSED — the plant refuse/$name was not refused (status $status):"
        echo "$out"
        exit 1
    fi
    if echo "$out" | grep -qE '^(ok  |FAIL|SKIP) '; then
        echo "difftest-selftest: REFUSED — a case ran before refuse/$name was refused:"
        echo "$out"
        exit 1
    fi
    echo "$out" | grep 'refusing case'
done
for bad in / "$HOME"; do
    out=$(BORE_SCRATCH_ROOT="$bad" BORE_SELFTEST=1 tools/difftest --cases tests/selftest true 2>&1) && status=0 || status=$?
    if [ "$status" -ne 2 ] || ! echo "$out" | grep -q 'refusing the scratch root'; then
        echo "difftest-selftest: REFUSED — the scratch root $bad was accepted (status $status):"
        echo "$out"
        exit 1
    fi
    echo "$out" | grep 'refusing the scratch root'
done
echo "difftest-selftest: the harness refused every unsafe operand and root"
