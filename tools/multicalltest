#!/usr/bin/env python3
"""multicalltest - the rows that hold `bore`, the multicall program, to the
separate programs it replaces.

`bore` carries every utility but six, which stay separate programs (the
SEPARATE_ONLY tuple): `dd` and `timeout` name a signal-listening call, which
makes the runtime's signal hub (a thread and two pipes) before `main` on every
run, and those two with `sleep`, `tail`, `sync` and `shred` reach
`time_sleep_ms` or `fs_sync`, which link the runtime's thread path (about 78
pages that every utility in `bore` would carry). `bore NAME` for one of the six
runs the one installed beside `bore`.

Each step prints `ok   bore-STEP: ...` or `FAIL bore-STEP: ...` lines, a SKIP
only with its reason, and `END bore-STEP exit=N`; the tool exits 0 when every
step it ran is green, 1 when a step is red, and 2 when the harness itself
cannot run (a missing program, a malformed file).

  census        `bore --list` is, byte for byte, the sorted names of the
                `src/*.lu` entries less `bore` and the six, one a line, and
                the entries less `bore` are the binaries
                `.github/release.json` ships; both ways
  refusals      every case of the refusal file: argv[0] (text, or bytes as
                `argv0_hex`), the arguments (`args`, or `args_hex`), and the
                exact stdout, stderr (each text, or bytes as `stdout_hex`,
                `stderr_hex`) and status `bore` must answer
  dispositions  (linux: /proc/self/status) `cat /proc/self/status`, and the
                same through `env`, `nohup` and `timeout 5`: the SigBlk,
                SigIgn, SigCgt and Threads lines are the same for the
                separate programs, for links to `bore` named after them, and
                for `bore NAME` (`timeout` is the separate program in every
                form; the `cat` it starts is the form's)
  size          in loadable bytes, what an exec maps (an ELF's PT_LOAD
                filesz, a Mach-O's __TEXT and __DATA segments; the file size,
                mostly debug sections on linux, is printed and never judged):
                bore's are at most true's plus the excess over true of every
                utility it carries (no code carried twice), and at most the
                ceiling the size file records for this host
  pax-pages     (static ELF programs, PAX's shape) PAX copies every page of
                a program's PT_LOADs into fresh memory at each exec, so each
                utility run through `bore` holds all of bore's pages: bore's
                loadable pages (each PT_LOAD's memory in 4 KiB pages) less
                the separate `true`'s are at most 512 (2 MiB), printed with
                the headroom; a dynamic or Mach-O program is a SKIP with its
                reason
  startup       `true` and `cat SMALL`, separate against a link to `bore`:
                the least wall time over ten alternating hyperfine blocks of
                20 runs, and the peak resident size `/usr/bin/time` reports
                (the small parent: its own size is the floor, printed). On
                every host the wall time is within max(+10 %, +0.5 ms) of
                the separate program's, and the peak within +2 MiB.
                `--judge-startup HOST SEP_S MC_S SEP_RSS MC_RSS` prints the
                verdict on given figures (seconds, bytes) and exits 0 or 1
  no-hub        the six are not in `bore`: `bore --list` names none, and a
                link named after one is an unknown program name; and no file
                under src/ but the six entries and the tests names a call
                that makes the signal hub or the readiness set before `main`
                (HUB_CALLS, REACTOR_CALLS) or links the runtime's thread path
                (THREAD_CALLS, std `time.sleep`), so a later utility cannot
                bring either back quietly
  symbols       (linux: an ELF `bore`) its symbol table names none of
                OFFENDING (`pthread_create`, `pthread_getattr_np`, glibc's
                scanf); a FAIL names the utility whose code reaches the
                symbol first, by a backward search over the references
                `objdump -d` shows, or the symbol alone without objdump
  siblings      for each of the six, `bore NAME` with the separate program
                beside `bore` runs it (stdout, stderr and status equal to
                running it directly), and with none beside `bore` answers
                `bore: unknown utility: NAME`, status 127; PATH holds decoys
                of all six names, so a PATH search is red; `bore --help` says
                the six are separate programs

usage: tools/multicalltest [--bore PATH] [--bin DIR] [--cases FILE]
                           [--size FILE] [--src DIR] [STEP...]
  --bore PATH   the multicall program (default target/release/bore)
  --bin DIR     the separate programs (default target/release)
  --cases FILE  the refusal cases (default tests/multicall/cases.toml)
  --size FILE   the size ceilings (default tests/multicall/size.toml)
  --src DIR     the sources the census and no-hub read (default src)
"""

import collections
import json
import os
import platform
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import tomllib

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
STEPS = ("census", "refusals", "dispositions", "size", "pax-pages", "startup", "no-hub", "symbols",
         "siblings")
# The pages each running utility may hold over the separate `true` on PAX,
# which copies every loadable page at each exec: 2 MiB in 4 KiB pages.
PAX_PAGES = 512
# The utilities that stay separate programs, never in `bore`.
SEPARATE_ONLY = ("dd", "shred", "sleep", "sync", "tail", "timeout")
# The calls that make the signal hub before `main` (`[os.signal.hub]`), and
# those that make the readiness set before `main` (`[os.net.reactor]`).
HUB_CALLS = ("os_signal_listen", "os_signal_wait", "os_signal_wait_fd", "os_signal_wait_fds",
             "os_wait_ready", "os_ready_wait")
REACTOR_CALLS = ("net_accept", "net_read", "net_read_bytes", "net_write", "net_write_bytes",
                 "net_writev", "net_writev_head")
# The calls that link the runtime's thread path: a blocking wait starts a
# compensation worker through std::thread (pthread_create, and with its
# stack-overflow setup glibc's pthread_getattr_np and scanf).
THREAD_CALLS = ("time_sleep_ms", "fs_sync", "fs_sync_dir", "time.sleep")
BEFORE_MAIN = re.compile(r"\b(" + "|".join(re.escape(c) for c in HUB_CALLS + REACTOR_CALLS + THREAD_CALLS) + r")\b")
# What M8 refuses in bore's symbol table, and the code it blames.
OFFENDING = ("pthread_create", "pthread_getattr_np", "__isoc23_sscanf", "__vfscanf_internal")
UTILITY_CODE = re.compile(r"^_W(?:cmd\.|m_)([A-Za-z0-9_]+)\.")
WOLF_CODE = re.compile(r"^_W")
STRING = re.compile(r'"(?:\\.|[^"\\])*"')
SIG = re.compile(rb"^(SigBlk|SigIgn|SigCgt|Threads):.*$", re.M)
DISPOSITION_COMMANDS = (
    ["cat", "/proc/self/status"],
    ["env", "cat", "/proc/self/status"],
    ["nohup", "cat", "/proc/self/status"],
    ["timeout", "5", "cat", "/proc/self/status"],
)


class HarnessError(Exception):
    """The harness cannot run: status 2, never a verdict."""


def utilities(src):
    """The utilities, as tools/build finds them: every top-level src/*.lu
    that is not a test, less the multicall program itself, in byte order."""
    names = [f[:-3] for f in os.listdir(src)
             if f.endswith(".lu") and not f.endswith("_test.lu")]
    return sorted((n for n in names if n != "bore"), key=lambda n: n.encode())


def in_bore(src):
    """The utilities `bore` carries: all of them but SEPARATE_ONLY."""
    return [n for n in utilities(src) if n not in SEPARATE_ONLY]


def run(argv, executable=None, env=None, timeout=30):
    p = subprocess.run(argv, executable=executable, env=env, timeout=timeout,
                       stdin=subprocess.DEVNULL, capture_output=True)
    return p.returncode, p.stdout, p.stderr


def run_named(bore, argv):
    """Run `bore` with exactly `argv`. A name that can be a file name is
    given by a link of that name as well, so a program that learns its name
    from the path it was started by (a script) is asked the same question;
    any other argv[0] (bytes that are not text, a name holding `/`) is
    passed as argv[0] alone."""
    name = argv[0]
    plain = name and b"/" not in name and name not in (b".", b"..")
    try:
        name.decode("utf-8")
    except UnicodeDecodeError:
        plain = False
    if not plain:
        return run(argv, executable=bore)
    with tempfile.TemporaryDirectory(prefix="bore-named.") as top:
        link = os.path.join(os.fsencode(top), name)
        os.symlink(os.fsencode(bore), link)
        return run(argv, executable=link)


def links_to(bore, names, top):
    """A directory of symbolic links, one named after each utility, each to
    `bore`: the shape the image carries in /bin."""
    d = os.path.join(top, "links")
    os.mkdir(d)
    for n in names:
        os.symlink(bore, os.path.join(d, n))
    return d


def listed(o):
    """`bore --list`'s names, and whether it answered as it must (status 0,
    no stderr, every name ended by a newline); the reasons it did not are
    printed under `step`."""
    code, out, err = run(["bore", "--list"], executable=o["bore"])
    have = out.decode("utf-8", "replace").split("\n")
    problems = []
    if code != 0 or err:
        problems.append(f"`bore --list` exited {code} with stderr {err!r}")
    if have and have[-1] == "":
        have.pop()
    else:
        problems.append("`bore --list` does not end in a newline")
    return have, problems


def step_census(o):
    want = in_bore(o["src"])
    have, problems = listed(o)
    red = 0
    for p in problems:
        print(f"FAIL bore-census: {p}")
        red = 1
    for n in sorted(set(want) - set(have), key=str.encode):
        print(f"FAIL bore-census: missing {n}")
        red = 1
    for n in sorted(set(have) - set(want), key=str.encode):
        print(f"FAIL bore-census: extra {n}")
        red = 1
    if not red and have != want:
        print("FAIL bore-census: the names are not one a line in byte order")
        red = 1
    every = utilities(o["src"])
    with open(os.path.join(ROOT, ".github", "release.json"), "rb") as fh:
        shipped = sorted(json.load(fh)["binaries"], key=str.encode)
    for n in sorted(set(every) ^ set(shipped), key=str.encode):
        print(f"FAIL bore-census: {n} is {'in src/ but not' if n in every else 'shipped but not in src/,'} in .github/release.json")
        red = 1
    if not red:
        print(f"ok   bore-census: `bore --list` names the {len(want)} utilities it carries; "
              f"those and the six ({', '.join(SEPARATE_ONLY)}) are the {len(every)} .github/release.json ships")
    return red


def step_refusals(o):
    try:
        with open(o["cases"], "rb") as fh:
            cases = tomllib.load(fh).get("case", [])
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise HarnessError(f"{o['cases']}: {e}")
    if not cases:
        raise HarnessError(f"{o['cases']}: no cases")
    red = 0
    keys = {"name", "argv0", "argv0_hex", "args", "args_hex", "stdout", "stdout_hex", "stderr", "stderr_hex", "status"}

    def text_or_hex(c, key, default):
        if key in c and key + "_hex" in c:
            raise HarnessError(f"{o['cases']}: case {c['name']!r} gives both {key} and {key}_hex")
        if key + "_hex" in c:
            v = c[key + "_hex"]
            return [bytes.fromhex(x) for x in v] if isinstance(v, list) else bytes.fromhex(v)
        v = c.get(key, default)
        return [x.encode() for x in v] if isinstance(v, list) else v.encode()
    for c in cases:
        if set(c) - keys or "name" not in c or "status" not in c:
            raise HarnessError(f"{o['cases']}: malformed case {c.get('name', '?')!r}")
        try:
            argv = [text_or_hex(c, "argv0", "bore")] + text_or_hex(c, "args", [])
            want = (text_or_hex(c, "stdout", ""), text_or_hex(c, "stderr", ""), c["status"])
        except ValueError as e:
            raise HarnessError(f"{o['cases']}: case {c['name']!r}: {e}")
        code, out, err = run_named(o["bore"], argv)
        if (out, err, code) == want:
            print(f"ok   bore-refusals: {c['name']}")
        else:
            red = 1
            print(f"FAIL bore-refusals: {c['name']}  argv={argv!r}")
            print(f"    want: status {want[2]} stdout {want[0]!r} stderr {want[1]!r}")
            print(f"    have: status {code} stdout {out!r} stderr {err!r}")
    return red


def step_dispositions(o):
    if not os.path.exists("/proc/self/status"):
        print(f"SKIP bore-dispositions: this host ({platform.system()}) has no /proc/self/status to read them from")
        return 0
    red = 0
    carried = in_bore(o["src"])
    with tempfile.TemporaryDirectory(prefix="bore-dispositions.") as top:
        links = links_to(o["bore"], carried, top)
        for cmd in DISPOSITION_COMMANDS:
            label = " ".join(cmd)
            seen = {}
            bad = 0
            # A utility `bore` does not carry is its separate program in
            # the link form too; `bore NAME` runs the one beside `bore`.
            first = links if cmd[0] in carried else o["bin"]
            for form, path, exe, argv in (
                    ("separate", o["bin"], os.path.join(o["bin"], cmd[0]), [cmd[0]] + cmd[1:]),
                    ("link", links, os.path.join(first, cmd[0]), [cmd[0]] + cmd[1:]),
                    ("bore NAME", links, o["bore"], ["bore"] + cmd)):
                env = dict(os.environ, PATH=f"{path}:/usr/bin:/bin")
                code, out, err = run(argv, executable=exe, env=env)
                lines = b"\n".join(m.group(0) for m in SIG.finditer(out))
                if code != 0 or lines.count(b"\n") != 3:
                    print(f"FAIL bore-dispositions: {label} ({form}) exited {code}, stderr {err!r}, read {lines!r}")
                    bad = 1
                seen[form] = lines
            if len(set(seen.values())) != 1:
                bad = 1
                print(f"FAIL bore-dispositions: {label}")
                for form, lines in seen.items():
                    print(f"    {form}: {lines.decode('utf-8', 'replace').replace(chr(10), '  ')}")
            elif not bad:
                print(f"ok   bore-dispositions: {label}: {seen['separate'].decode().replace(chr(10), '  ')}")
            red |= bad
    return red


def loadable(path):
    """The bytes an exec maps from the program at `path`: an ELF's PT_LOAD
    filesz summed, a Mach-O's __TEXT, __DATA_CONST and __DATA filesize
    summed (its __LINKEDIT, the symbols, is left out as an ELF's sections
    are); None for a file that is neither."""
    with open(path, "rb") as fh:
        h = fh.read(64)
        if h[:4] == b"\x7fELF" and len(h) == 64 and h[4] == 2 and h[5] == 1:
            phoff, = struct.unpack_from("<Q", h, 0x20)
            phentsize, phnum = struct.unpack_from("<HH", h, 0x36)
            fh.seek(phoff)
            ph = fh.read(phentsize * phnum)
            total = 0
            for i in range(phnum):
                if len(ph) < (i + 1) * phentsize:
                    return None
                p_type, = struct.unpack_from("<I", ph, i * phentsize)
                if p_type == 1:
                    total += struct.unpack_from("<Q", ph, i * phentsize + 32)[0]
            return total
        if h[:4] == b"\xcf\xfa\xed\xfe" and len(h) >= 32:
            ncmds, sizeofcmds = struct.unpack_from("<II", h, 16)
            fh.seek(32)
            cmds = fh.read(sizeofcmds)
            total, at = 0, 0
            for _ in range(ncmds):
                if at + 8 > len(cmds):
                    return None
                cmd, size = struct.unpack_from("<II", cmds, at)
                if cmd == 0x19:  # LC_SEGMENT_64
                    seg = cmds[at + 8:at + 24].rstrip(b"\0")
                    if seg in (b"__TEXT", b"__DATA_CONST", b"__DATA"):
                        total += struct.unpack_from("<Q", cmds, at + 48)[0]
                at += size
            return total
    return None


def step_size(o):
    names = in_bore(o["src"])
    sizes = {}
    for n in names:
        p = os.path.join(o["bin"], n)
        if not os.path.isfile(p):
            raise HarnessError(f"no separate program {p}")
        sizes[n] = loadable(p)
        if sizes[n] is None:
            raise HarnessError(f"{p} is not an ELF or Mach-O program")
    bore = loadable(o["bore"])
    if bore is None:
        raise HarnessError(f"{o['bore']} is not an ELF or Mach-O program: no loadable bytes to weigh")
    true = sizes["true"]
    bound = true + sum(s - true for s in sizes.values())
    host = f"{platform.system()}-{platform.machine()}"
    print(f"bore-size: loadable bytes: bore {bore}; the {len(names)} separate programs it replaces "
          f"{sum(sizes.values())}; true {true}; the no-duplication bound {bound}; host {host}")
    print(f"bore-size: file size (information, never a verdict): bore {os.path.getsize(o['bore'])}, "
          f"true {os.path.getsize(os.path.join(o['bin'], 'true'))}")
    red = 0
    if bore <= bound:
        print("ok   bore-size: within the no-duplication bound")
    else:
        print(f"FAIL bore-size: the no-duplication bound: {bore} > {bound}")
        red = 1
    try:
        with open(o["size"], "rb") as fh:
            ceilings = tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError) as e:
        raise HarnessError(f"{o['size']}: {e}")
    entry = ceilings.get(host)
    if not isinstance(entry, dict) or type(entry.get("ceiling")) is not int:
        print(f"FAIL bore-size: ceiling: {o['size']} records none for {host} (bore has {bore} loadable bytes here)")
        return 1
    if bore <= entry["ceiling"]:
        print(f"ok   bore-size: within the ceiling {entry['ceiling']} for {host}")
    else:
        print(f"FAIL bore-size: ceiling: {bore} > {entry['ceiling']} for {host}")
        red = 1
    return red


def elf_pages(path):
    """A 64-bit ELF's loadable pages, each PT_LOAD's memory (memsz, so its
    zeroed tail too) rounded out to 4 KiB pages and summed, and whether it is
    static (no PT_INTERP): (pages, static); None for any other file."""
    with open(path, "rb") as fh:
        h = fh.read(64)
        if not (h[:4] == b"\x7fELF" and len(h) == 64 and h[4] == 2 and h[5] == 1):
            return None
        phoff, = struct.unpack_from("<Q", h, 0x20)
        phentsize, phnum = struct.unpack_from("<HH", h, 0x36)
        fh.seek(phoff)
        ph = fh.read(phentsize * phnum)
    pages, static = 0, True
    for i in range(phnum):
        if len(ph) < (i + 1) * phentsize:
            return None
        p_type, = struct.unpack_from("<I", ph, i * phentsize)
        if p_type == 3:  # PT_INTERP
            static = False
        elif p_type == 1:
            vaddr, = struct.unpack_from("<Q", ph, i * phentsize + 16)
            memsz, = struct.unpack_from("<Q", ph, i * phentsize + 40)
            pages += -(-(vaddr + memsz) // 4096) - vaddr // 4096
    return pages, static


def step_pax_pages(o):
    true = os.path.join(o["bin"], "true")
    if not os.path.isfile(true):
        raise HarnessError(f"no separate program {true}")
    for p in (o["bore"], true):
        if loadable(p) is None:
            raise HarnessError(f"{p} is not an ELF or Mach-O program")
    b, t = elf_pages(o["bore"]), elf_pages(true)
    if b is None or t is None:
        print(f"SKIP bore-pax-pages: not ELF programs ({platform.system()}); PAX runs static ELF programs")
        return 0
    if not (b[1] and t[1]):
        which = " and ".join(n for n, e in (("bore", b), ("true", t)) if not e[1])
        print(f"SKIP bore-pax-pages: {which} dynamic (PT_INTERP); PAX runs static programs, as cc -static builds them")
        return 0
    more = b[0] - t[0]
    line = (f"bore {b[0]} pages, true {t[0]}: +{more} pages for each running utility, "
            f"the bound {PAX_PAGES} (2 MiB), headroom {PAX_PAGES - more} pages")
    if more <= PAX_PAGES:
        print(f"ok   bore-pax-pages: {line}")
        return 0
    print(f"FAIL bore-pax-pages: {line}")
    return 1


def least_wall(commands, blocks=10, runs=20, warmup=5):
    """The least wall time of each named command over `blocks` hyperfine
    blocks, the order of the commands alternating from block to block."""
    hyperfine = shutil.which("hyperfine")
    if hyperfine is None:
        raise HarnessError("no hyperfine on PATH")
    best = {name: None for name, _ in commands}
    with tempfile.TemporaryDirectory(prefix="bore-startup.") as top:
        for b in range(blocks):
            order = commands if b % 2 == 0 else list(reversed(commands))
            out = os.path.join(top, f"block-{b}.json")
            argv = [hyperfine, "-N", "--style", "none", "--warmup", str(warmup), "--runs", str(runs),
                    "--output", "null", "--export-json", out]
            for name, cmd in order:
                argv += ["-n", name, cmd]
            p = subprocess.run(argv, capture_output=True, text=True, timeout=600)
            if p.returncode != 0:
                raise HarnessError(f"hyperfine exited {p.returncode}: {p.stderr.strip()}")
            with open(out) as fh:
                for r in json.load(fh)["results"]:
                    # hyperfine 1.x: the name in "command", times in "times";
                    # 2.x: "name", and one "measurements" entry a run.
                    name = r.get("name", r["command"])
                    times = (r["times"] if "times" in r else
                             [m["time_wall_clock"]["value"] for m in r["measurements"]])
                    least = min(times)
                    if best[name] is None or least < best[name]:
                        best[name] = least
    return best


def peak_rss(argv, runs=50):
    """The median peak resident size in bytes `/usr/bin/time` reports for
    `argv` (GNU time's %M is KiB; macOS's -l prints bytes)."""
    time = "/usr/bin/time"
    if not os.access(time, os.X_OK):
        raise HarnessError("no /usr/bin/time (on linux, the `time` package)")
    macos = platform.system() == "Darwin"
    values = []
    for _ in range(runs):
        cmd = [time, "-l"] + argv if macos else [time, "-f", "PEAK %M"] + argv
        p = subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.PIPE, text=True, timeout=60)
        if macos:
            m = re.search(r"(\d+)\s+maximum resident set size", p.stderr)
            v = int(m.group(1)) if m else None
        else:
            m = re.search(r"^PEAK (\d+)$", p.stderr, re.M)
            v = int(m.group(1)) * 1024 if m else None
        if v is None:
            raise HarnessError(f"/usr/bin/time printed no peak for {argv}: {p.stderr!r}")
        values.append(v)
    values.sort()
    return values[len(values) // 2]


def judge_startup(name, host, s, m, rs, rm):
    """The verdict on a separate program's and the multicall's least wall
    time (seconds) and peak resident size (bytes): (green, line). Whole
    nanoseconds, so a figure on a limit is on it. The limits are the same on
    every host; `host` names where the figures were taken."""
    s_ns, m_ns = int(round(s * 1e9)), int(round(m * 1e9))
    limit_ns = max(s_ns * 11 // 10, s_ns + 500_000)
    rss_limit = 2 * 1024 * 1024
    line = (f"{name}: least wall separate {s_ns / 1e6:.3f} ms, multicall {m_ns / 1e6:.3f} ms "
            f"(limit {limit_ns / 1e6:.3f}); peak separate {rs}, multicall {rm} bytes (limit +{rss_limit})")
    return m_ns <= limit_ns and rm - rs <= rss_limit, line


def step_startup(o):
    red = 0
    with tempfile.TemporaryDirectory(prefix="bore-startup-links.") as top:
        links = links_to(o["bore"], in_bore(o["src"]), top)
        small = os.path.join(top, "small.txt")
        with open(small, "w") as fh:
            fh.write("one line of text\nand a second\n")
        host_true = shutil.which("true") or "/usr/bin/true"
        floor = peak_rss([host_true])
        print(f"bore-startup: the floor, /usr/bin/time running {host_true}: peak {floor} bytes")
        for name, args in (("true", []), ("cat", [small])):
            sep = [os.path.join(o["bin"], name)] + args
            mc = [os.path.join(links, name)] + args
            best = least_wall([("separate", " ".join(sep)), ("multicall", " ".join(mc))])
            s, m = best["separate"], best["multicall"]
            rs, rm = peak_rss(sep), peak_rss(mc)
            green, line = judge_startup(name, platform.system(), s, m, rs, rm)
            if green:
                print(f"ok   bore-startup: {line}")
            else:
                print(f"FAIL bore-startup: {line}")
                red = 1
    return red


def before_main_calls(path):
    """(line number, name) for each call in the file at `path` that makes
    the signal hub or the readiness set; comments and string literals do
    not count."""
    found = []
    with open(path, encoding="utf-8", errors="replace") as fh:
        for i, line in enumerate(fh, 1):
            code = STRING.sub('""', line).split("//", 1)[0]
            found += [(i, m.group(1)) for m in BEFORE_MAIN.finditer(code)]
    return found


def step_no_hub(o):
    red = 0
    have, problems = listed(o)
    for p in problems:
        print(f"FAIL bore-no-hub: {p}")
        red = 1
    for n in SEPARATE_ONLY:
        if n in have:
            print(f"FAIL bore-no-hub: {n} is in the table (`bore --list` names it)")
            red = 1
        code, out, err = run_named(o["bore"], [n.encode(), b"--version"])
        want = (b"", f"bore: unknown program name: {n}\n".encode(), 127)
        if (out, err, code) != want:
            print(f"FAIL bore-no-hub: {n} by a link to bore: status {code} stdout {out[:80]!r} stderr {err[:80]!r}, "
                  f"not the unknown-program-name refusal")
            red = 1
    src = o["src"]
    files = []
    for top, dirs, names in os.walk(src):
        dirs[:] = sorted(d for d in dirs if not d.startswith("."))
        for f in sorted(names):
            rel = os.path.relpath(os.path.join(top, f), src)
            if (f.endswith(".lu") and not f.endswith("_test.lu")
                    and rel not in tuple(n + ".lu" for n in SEPARATE_ONLY)):
                files.append(rel)
    for rel in files:
        for line, name in before_main_calls(os.path.join(src, rel)):
            what = ("makes the signal hub before main" if name in HUB_CALLS else
                    "makes the readiness set before main" if name in REACTOR_CALLS else
                    "links the runtime's thread path")
            print(f"FAIL bore-no-hub: src/{rel}:{line} names {name}, which {what}")
            red = 1
    if not red:
        print(f"ok   bore-no-hub: none of the six separate programs is in the table "
              f"({', '.join(SEPARATE_ONLY)}), and none of the {len(files)} files under src/ (all but "
              f"their entries and the tests) names a call that makes the signal hub or the readiness "
              f"set or links the runtime's thread path")
    return red


def elf_tables(path):
    """An x86-64 ELF's functions by address (every name at each address),
    the canonical name of each (an imported function, a dynamic build's, is
    its own name), and a reader for the GOT and .data.rel.ro words; None
    when the file is not a 64-bit little-endian ELF."""
    with open(path, "rb") as fh:
        b = fh.read()
    if b[:4] != b"\x7fELF" or b[4] != 2 or b[5] != 1:
        return None
    shoff, = struct.unpack_from("<Q", b, 0x28)
    shentsize, shnum, shstrndx = struct.unpack_from("<HHH", b, 0x3A)
    secs = [struct.unpack_from("<IIQQQQIIQQ", b, shoff + i * shentsize) for i in range(shnum)]
    names_at = collections.defaultdict(set)
    imported = set()
    got_import = {}
    data = []
    shstr = secs[shstrndx]

    def symname(tab, sec, i):
        nm, = struct.unpack_from("<I", b, sec[4] + i * 24)
        o = tab[4] + nm
        return b[o:b.index(b"\0", o)].decode("utf-8", "replace")
    for sec in secs:
        if sec[1] in (2, 11):  # SHT_SYMTAB, SHT_DYNSYM: what the program imports
            st = secs[sec[6]]
            for i in range(sec[5] // 24):
                nm, info, other, shndx, value, size = struct.unpack_from("<IBBHQQ", b, sec[4] + i * 24)
                # A weak undefined reference links no code (a static build
                # leaves it 0), so only a strong one is an import.
                if shndx == 0 and nm and info >> 4 != 2:
                    imported.add(symname(st, sec, i).split("@")[0])
        if sec[1] == 4 and secs[sec[6]][1] == 11:  # SHT_RELA against .dynsym: GOT slots
            dyn = secs[sec[6]]
            dst = secs[dyn[6]]
            for i in range(sec[5] // 24):
                off, rinfo, addend = struct.unpack_from("<QQq", b, sec[4] + i * 24)
                if (rinfo & 0xffffffff) in (1, 6, 7) and rinfo >> 32:
                    got_import[off] = symname(dst, dyn, rinfo >> 32).split("@")[0]
    for sec in secs:
        o = shstr[4] + sec[0]
        secname = b[o:b.index(b"\0", o)].decode("utf-8", "replace")
        if secname in (".got", ".got.plt", ".data.rel.ro"):
            data.append((secname, sec[3], sec[3] + sec[5], sec[4]))
        if sec[1] != 2:  # SHT_SYMTAB
            continue
        st = secs[sec[6]]
        for i in range(sec[5] // 24):
            nm, info, other, shndx, value, size = struct.unpack_from("<IBBHQQ", b, sec[4] + i * 24)
            if (info & 0xf) == 2 and value:  # STT_FUNC
                o = st[4] + nm
                names_at[value].add(b[o:b.index(b"\0", o)].decode("utf-8", "replace"))
    canon = {n: n for n in imported}
    for addr, names in names_at.items():
        c = min(names, key=lambda n: (n.startswith("_"), len(n), n))
        for n in names:
            canon[n] = c
    first = {addr: canon[next(iter(names))] for addr, names in names_at.items()}

    def pointed(addr, lea):
        """The functions a rip-relative address leads to: a GOT slot's one
        pointer; a vtable's ([drop, size, align, method...]) when an
        instruction takes its address."""
        if addr in got_import:
            return [got_import[addr]]
        for secname, lo, hi, off in data:
            if not lo <= addr < hi:
                continue
            if secname != ".data.rel.ro":
                return [first[w] for w in [struct.unpack_from("<Q", b, off + addr - lo)[0]] if w in first] if addr + 8 <= hi else []
            if not lea:
                return []
            ws = [struct.unpack_from("<Q", b, off + addr - lo + 8 * i)[0] for i in range(40) if addr + 8 * i + 8 <= hi]
            shaped = lambda i: i + 2 < len(ws) and ws[i + 1] < 1 << 20 and ws[i + 2] in (1, 2, 4, 8, 16, 32, 64)
            if not (shaped(0) and (ws[0] in first or ws[0] == 0)):
                return [first[ws[0]]] if ws and ws[0] in first else []
            out = [first[ws[0]]] if ws[0] in first else []
            for i in range(3, len(ws)):
                if ws[i] not in first or shaped(i):
                    break
                out.append(first[ws[i]])
            return out
        return []
    return canon, pointed


LABEL = re.compile(r"^([0-9a-f]+) <(.+)>:$")
TARGET = re.compile(r"<([^>+]+)(?:\+0x[0-9a-f]+)?>")
COMMENT = re.compile(r"#\s*(?:0x)?([0-9a-f]+)")


def callers(path, canon, pointed, objdump):
    """Every function's callers and referrers, from `objdump -d`: direct
    calls and jumps, rip-relative addresses, GOT slots and vtables."""
    p = subprocess.run([objdump, "-d", "--no-show-raw-insn", path], capture_output=True, text=True,
                       errors="replace", timeout=600)
    if p.returncode != 0:
        raise HarnessError(f"objdump -d exited {p.returncode}: {p.stderr.strip()[:200]}")
    rev = collections.defaultdict(set)
    fn = None
    for line in p.stdout.splitlines():
        m = LABEL.match(line)
        if m:
            fn = canon.get(m.group(2), m.group(2))
            continue
        if fn is None or ":" not in line:
            continue
        targets = {canon.get(t.split("@")[0], t.split("@")[0]) for t in TARGET.findall(line)}
        c = COMMENT.search(line)
        if c and "(%rip)" in line:
            targets.update(pointed(int(c.group(1), 16), "lea" in line))
        for t in targets:
            if t != fn:
                rev[t].add(fn)
    return rev


def nearest(rev, start, match):
    """The functions nearest `start` in the callers' graph that `match`
    accepts, and one path from the first of them."""
    seen, prev, frontier = {start}, {}, [start]
    while frontier:
        hits = sorted(f for f in frontier if match(f))
        if hits:
            path = [hits[0]]
            while path[-1] != start:
                path.append(prev[path[-1]])
            return hits, path
        nxt = []
        for f in frontier:
            for c in sorted(rev.get(f, ())):
                if c not in seen:
                    seen.add(c)
                    prev[c] = f
                    nxt.append(c)
        frontier = nxt
    return [], []


def step_symbols(o):
    if platform.system() != "Linux":
        print(f"SKIP bore-symbols: this host ({platform.system()}) links glibc dynamically or not at all; "
              f"the symbols are checked on linux, where bore is static")
        return 0
    tables = elf_tables(o["bore"])
    if tables is None:
        print(f"SKIP bore-symbols: {o['bore']} is not a 64-bit ELF program, so it has no symbol table to read")
        return 0
    canon, pointed = tables
    present = [s for s in OFFENDING if s in canon]
    if not present:
        print(f"ok   bore-symbols: no pthread_create, pthread_getattr_np or scanf in bore's symbol table "
              f"({len(set(canon.values()))} functions)")
        return 0
    objdump = shutil.which("objdump")
    rev = callers(o["bore"], canon, pointed, objdump) if objdump else None
    for s in present:
        if rev is None:
            print(f"FAIL bore-symbols: {s} (no objdump on PATH to say which utility reaches it)")
            continue
        hits, path = nearest(rev, canon[s], lambda f: UTILITY_CODE.match(f))
        if hits:
            names = sorted({UTILITY_CODE.match(h).group(1) for h in hits})
            print(f"FAIL bore-symbols: {s}, reached first from {', '.join(names)}: "
                  f"{' -> '.join(f[:48] for f in path)}")
            continue
        hits, path = nearest(rev, canon[s], lambda f: WOLF_CODE.match(f))
        if hits:
            print(f"FAIL bore-symbols: {s}, reached first from wolf code {hits[0][:60]} (no utility's code "
                  f"by name): {' -> '.join(f[:48] for f in path)}")
        else:
            print(f"FAIL bore-symbols: {s} (no code was found to reach it)")
    return 1


def step_siblings(o):
    red = 0
    with tempfile.TemporaryDirectory(prefix="bore-siblings.") as top:
        decoys = os.path.join(top, "decoys")
        beside = os.path.join(top, "beside")
        alone = os.path.join(top, "alone")
        for d in (decoys, beside, alone):
            os.mkdir(d)
        for n in SEPARATE_ONLY:
            p = os.path.join(decoys, n)
            with open(p, "w") as fh:
                fh.write("#!/bin/sh\necho decoy\nexit 99\n")
            os.chmod(p, 0o755)
            src = os.path.join(o["bin"], n)
            if not os.path.isfile(src):
                raise HarnessError(f"no separate program {src}")
            shutil.copy2(src, os.path.join(beside, n))
        # Copies, not links: the directory `bore` runs from is the copy's.
        for d in (beside, alone):
            shutil.copy2(o["bore"], os.path.join(d, "bore"))
        small = os.path.join(top, "small.txt")
        with open(small, "w") as fh:
            fh.write("one line of text\nand a second\n")
        env = dict(os.environ, PATH=f"{decoys}:/usr/bin:/bin")
        calls = {"dd": ([f"if={small}", "bs=4", "status=none"], [f"if={top}/absent"], ["--version"]),
                 "timeout": (["5", os.path.join(o["bin"], "echo"), "beside"], [], ["--version"]),
                 "sleep": (["0"], ["--frob"], ["--version"]),
                 "tail": (["-n", "1", small], [f"{top}/absent"], ["--version"]),
                 "sync": ([small], ["--frob"], ["--version"]),
                 "shred": (["-x", f"{top}/absent"], ["--frob"], ["--version"])}
        for n in SEPARATE_ONLY:
            bad = []
            for args in calls[n]:
                direct = run([n] + args, executable=os.path.join(beside, n), env=env)
                through = run(["bore", n] + args, executable=os.path.join(beside, "bore"), env=env)
                if direct != through:
                    bad.append(f"`bore {n} {' '.join(args)}`: {through!r}, run directly {direct!r}")
            if bad:
                red = 1
                print(f"FAIL bore-siblings: {n} beside")
                for b in bad:
                    print(f"    {b}")
            else:
                print(f"ok   bore-siblings: {n} beside: `bore {n}` runs the {n} beside it ({len(calls[n])} calls)")
            have = run(["bore", n] + calls[n][0], executable=os.path.join(alone, "bore"), env=env)
            want = (127, b"", f"bore: unknown utility: {n}\n".encode())
            if have == want:
                print(f"ok   bore-siblings: {n} absent: the unknown-utility refusal")
            else:
                red = 1
                print(f"FAIL bore-siblings: {n} absent: {have!r}, not {want!r}")
        code, out, err = run(["bore", "--help"], executable=os.path.join(alone, "bore"), env=env)
        said = b" ".join(out.split())
        if code == 0 and b"dd, shred, sleep, sync, tail and timeout are separate programs" in said:
            print("ok   bore-siblings: --help says dd, shred, sleep, sync, tail and timeout are separate programs")
        else:
            red = 1
            print(f"FAIL bore-siblings: --help: status {code}, it does not say dd, shred, sleep, sync, tail "
                  f"and timeout are separate programs")
    return red


def main(argv):
    o = {"bore": os.path.join(ROOT, "target", "release", "bore"),
         "bin": os.path.join(ROOT, "target", "release"),
         "cases": os.path.join(ROOT, "tests", "multicall", "cases.toml"),
         "size": os.path.join(ROOT, "tests", "multicall", "size.toml"),
         "src": os.path.join(ROOT, "src")}
    if argv[:1] == ["--judge-startup"]:
        if len(argv) != 6:
            print("multicalltest: --judge-startup HOST SEP_S MC_S SEP_RSS MC_RSS", file=sys.stderr)
            return 2
        green, line = judge_startup("judged", argv[1], float(argv[2]), float(argv[3]), int(argv[4]), int(argv[5]))
        print(f"{'ok  ' if green else 'FAIL'} bore-startup: {line}")
        return 0 if green else 1
    while argv[:1] in (["--bore"], ["--bin"], ["--cases"], ["--size"], ["--src"]):
        if len(argv) < 2:
            print(f"multicalltest: {argv[0]} needs a path", file=sys.stderr)
            return 2
        o[argv[0][2:]] = os.path.abspath(argv[1])
        argv = argv[2:]
    steps = argv or list(STEPS)
    for s in steps:
        if s not in STEPS:
            print(f"multicalltest: no step {s!r} (steps: {' '.join(STEPS)})", file=sys.stderr)
            return 2
    if not os.access(o["bore"], os.X_OK):
        print(f"multicalltest: no multicall program at {o['bore']} (run tools/build)")
        for s in steps:
            print(f"END bore-{s} exit=1")
        return 1
    print(f"multicalltest: bore = {o['bore']}; separate programs = {o['bin']}; "
          f"{platform.system()} {platform.machine()}")
    worst = 0
    for s in steps:
        try:
            code = globals()["step_" + s.replace("-", "_")](o)
        except HarnessError as e:
            print(f"multicalltest: bore-{s}: the harness cannot run: {e}")
            code = 2
        except subprocess.TimeoutExpired as e:
            print(f"FAIL bore-{s}: timed out: {e}")
            code = 1
        print(f"END bore-{s} exit={code}")
        if code and not worst:
            worst = code
    return worst


if __name__ == "__main__":
    sys.stdout.reconfigure(line_buffering=True)
    sys.exit(main(sys.argv[1:]))
