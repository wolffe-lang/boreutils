#!/usr/bin/env python3
"""Correct-behavior witnesses for R-bu33-1, not GNU expectation overrides."""
import os
import select
import time
from pathlib import Path
import subprocess
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
TIER = os.environ.get("BORE_SPLITTER_TIER", os.environ.get("BORE_TEXT_TIER", "release"))
BIN = ROOT / "target" / TIER


class SplitDivergences(unittest.TestCase):
    def test_hex_start_preserves_every_record(self):
        with tempfile.TemporaryDirectory(prefix="bore-split.") as top:
            data = b"one\ntwo\nthree\nfour\nfive\n"
            run = subprocess.run([BIN / "split", "--hex-suffixes=f", "-l1"],
                                 input=data, cwd=top, capture_output=True, timeout=5)
            self.assertEqual((run.returncode, run.stdout, run.stderr), (0, b"", b""))
            names = sorted(Path(top).iterdir())
            self.assertEqual([p.name for p in names], ["x0f", "x10", "x11", "x12", "x13"])
            self.assertEqual(b"".join(p.read_bytes() for p in names), data)

    def test_line_partition_elides_empty_files_and_terminates(self):
        for count in (5, 10):
            with self.subTest(count=count), tempfile.TemporaryDirectory(prefix="bore-split.") as top:
                data = b"a\nb\n"
                run = subprocess.run([BIN / "split", "-e", "-n", f"l/{count}"],
                                     input=data, cwd=top, capture_output=True, timeout=5)
                self.assertEqual((run.returncode, run.stdout, run.stderr), (0, b"", b""))
                files = sorted(Path(top).iterdir())
                self.assertEqual([p.name for p in files], ["xaa", "xab"])
                self.assertTrue(all(p.stat().st_size > 0 for p in files))
                self.assertEqual(b"".join(p.read_bytes() for p in files), data)


class SplitStreaming(unittest.TestCase):
    def _partial_record(self, selected):
        for executable in [ROOT / '.gnu-bin/bin/split', BIN / 'split']:
            with self.subTest(executable=str(executable)), tempfile.TemporaryDirectory(prefix='bore-split-live.') as top:
                args = ['-u', '-n', 'r/1/2' if selected else 'r/2']
                child = subprocess.Popen([executable] + args, stdin=subprocess.PIPE,
                                         stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                         cwd=top, start_new_session=True)
                observed = False
                prefix = b''
                try:
                    child.stdin.write(b'alpha')
                    child.stdin.flush()
                    deadline = time.monotonic() + 2
                    while time.monotonic() < deadline:
                        if selected:
                            if select.select([child.stdout], [], [], .02)[0]:
                                prefix += os.read(child.stdout.fileno(), 64)
                                observed = prefix == b'alpha'
                        else:
                            file = Path(top) / 'xaa'
                            observed = file.exists() and file.read_bytes() == b'alpha'
                            if not observed:
                                time.sleep(.01)
                        if observed:
                            break
                finally:
                    child.stdin.close()
                    child.stdin = None
                    out, err = child.communicate(timeout=5)
                self.assertEqual((child.returncode, err), (0, b''))
                self.assertTrue(observed, 'unbuffered round-robin must not wait for EOF or a newline')
                if selected:
                    self.assertEqual(prefix + out, b'alpha')

    def test_round_robin_file_is_live_before_eof(self):
        self._partial_record(False)

    def test_selected_round_robin_stdout_is_live_before_eof(self):
        self._partial_record(True)


if __name__ == "__main__":
    unittest.main()
