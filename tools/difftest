#!/usr/bin/env python3
"""difftest - the differential harness: boreutils against GNU coreutils.

Every case in tests/cases/<util>.toml runs twice, once through the
boreutils binary and once through GNU's, and the two are compared on:

  stdout  byte for byte
  exit    the exit status (a signal death compares as 128+N, the shell's
          spelling, so SIGPIPE is 141 on both sides)
  stderr  byte for byte after the program name is normalized: each
          side's argv[0] becomes PROG, so "gbasename: missing operand"
          and "basename: missing operand" compare equal

A mismatch prints both sides. The exit status is 0 when every case
passes, 1 when any case fails, 2 when the harness itself cannot run (a
missing binary, a malformed case file), and 141 only when the reader of
this transcript went away — never because a CHILD's pipe broke, which is
an outcome cases are written to observe rather than a failure of the
harness (boreutils#10).

The report is written line by line as each case is decided, so a run
that is killed leaves every verdict it had already reached.
tools/difftest-evidence is the gate on both of those.

Case file (TOML, one file per utility, any number of [[case]] tables):

  [[case]]
  name = "suffix removed"        # required, unique in the file
  args = ["include/stdio.h", ".h"]
  stdin = "inline text"          # optional; or stdin_file = "name"
                                 #   (relative to tests/fixtures/)
  stdin_offset = 3               # optional, with stdin_file (bu15): move
                                 #   the file's OFFSET to this byte before
                                 #   the run, as `{ read h; prog; } < f`
                                 #   leaves it, and compare a fifth field,
                                 #   `offset`: where the run LEFT the
                                 #   offset of the open file description
                                 #   it shares with the harness. That is
                                 #   how `{ head -n 1; cat; } < f` is
                                 #   seen at all. A stdin_file may be an
                                 #   absolute path (`/proc/version`).
  requires = "/proc/version"     # optional: a path the case needs; the
                                 #   case is a SKIP on a host without it
                                 #   (macOS has no /proc and no /sys)
  stdin_repeat = 32768           # optional: send `stdin` this many times
                                 #   over. A case that has to be LARGER
                                 #   THAN THE PIPE BUFFER — the only way
                                 #   to reach a write that blocks and
                                 #   then fails — would otherwise carry a
                                 #   megabyte of one repeated line in the
                                 #   repository. Meaningless without
                                 #   `stdin`.
  env = { POSIXLY_CORRECT = "1" }  # optional
  compare = ["exit"]             # optional; default all three
  stdout_bytes = 64              # optional: read this many bytes of
                                 #   stdout, then close the pipe (for
                                 #   programs that never stop, like yes)
  stdout_file = "/dev/full"      # optional: send stdout to this PATH
                                 #   rather than to a pipe, which is how
                                 #   a write error on a LIVE descriptor
                                 #   is reached at all. The case is a
                                 #   SKIP where the path does not exist,
                                 #   so /dev/full is linux-only and says
                                 #   so by being absent on macOS. As with
                                 #   stdout_closed there is no stdout to
                                 #   compare.
  tty = 80                       # optional (bu19): standard output is a
                                 #   PSEUDO-TERMINAL this many columns wide
                                 #   (0: a terminal that reports no size),
                                 #   for what a program does when it asks
                                 #   `isatty`. Its stdout is what the
                                 #   terminal received, line discipline
                                 #   and all (`\n` arrives as `\r\n` on
                                 #   both sides). Exclusive with the other
                                 #   stdout keys.
  stdout_closed = true           # optional: run the program with
                                 #   DESCRIPTOR 1 CLOSED, the shape a
                                 #   shell writes `prog >&-`. There is no
                                 #   stdout to compare, so the default
                                 #   comparison is stderr and exit only,
                                 #   and naming "stdout" in `compare` is
                                 #   a malformed case.
  scratch = { "a" = "old\n" }   # optional: run in a SCRATCH directory
  scratch_dirs = ["d"]           #   (bu14). Naming any of these six
  scratch_links = { "l" = "d" }  #   keys gives the case a fresh, empty
  scratch_modes = { "a" = 0o444 }#   directory, populated from them:
  scratch_times = { "a" = 0 }    #   files with their bytes, directories,
  cwd = "d"                      #   symbolic links (name = target),
                                 #   modes, and modification times
                                 #   (bu18: seconds from the epoch, set
                                 #   on the entry itself, never through
                                 #   a link, after every entry exists so
                                 #   that adding one cannot move its
                                 #   directory's time afterwards: what
                                 #   `touch -h -d @N` sets; `ls -t` is
                                 #   the reader).
                                 #   Each side runs in it (or in
                                 #   `cwd` under it) ONE AFTER THE OTHER,
                                 #   at the SAME path, which is emptied
                                 #   and repopulated between them, so a
                                 #   path either side prints compares
                                 #   equal. `{scratch}` in `args` and in
                                 #   `env` values is that path. What the
                                 #   run leaves behind — every name,
                                 #   its kind, a file's bytes, a link's
                                 #   target — is a fourth field, `files`,
                                 #   compared by default. It is how a
                                 #   file a utility WRITES is seen at all
                                 #   (`tee FILE`), and the only way a
                                 #   case can stand in a directory whose
                                 #   path it knows (`pwd -L`).
  scratch_fifos = ["f"]          # optional (bu20): more kinds of entry
  scratch_sockets = ["s"]        #   for a scratch tree, each READ BACK
  scratch_hardlinks = { "h" = "a" }  # after it is made (a harness that
                                 #   silently made a plain file would
                                 #   show both sides the same wrong
                                 #   thing): named pipes, unix sockets
                                 #   (bound and closed, so the name
                                 #   stays), and hard links (name =
                                 #   an existing file of the tree).
  scratch_sizes = { "big" = 5000000000 }  # optional (bu20): a file of
                                 #   this many bytes that occupies none
                                 #   (a hole, made by truncating it up):
                                 #   how a size too large to write, or to
                                 #   spell in a case file, is listed.
  scratch_atimes = { "a" = 5 }   # optional (bu20): an entry's ACCESS
                                 #   time, where `scratch_times` alone
                                 #   sets both times to one value.
  scratch_time_all = 1600000000  # optional (bu20): the time of every
                                 #   entry of the tree, and of the tree's
                                 #   own top, that names none: a long
                                 #   listing prints every entry's time,
                                 #   and one left at "whenever the
                                 #   harness made it" differs between the
                                 #   two sides by the clock.
                                 #   A TIME (in these three keys) is
                                 #   seconds from the epoch, or the text
                                 #   "now-N" / "now+N": N seconds before
                                 #   or after ONE instant taken once per
                                 #   case and used for both sides, which
                                 #   is how the six-month rule of `ls -l`
                                 #   is met from both sides without a
                                 #   clock anyone can set.
  scratch_keep = true            # optional (bu20): lay the tree out ONCE
                                 #   and run both sides in it, rather
                                 #   than emptying and repopulating it
                                 #   between them. What a fresh tree
                                 #   cannot hold still — inode numbers,
                                 #   status-change and birth times, the
                                 #   directory's own order — is the same
                                 #   for both sides in a kept one. Only
                                 #   for a program that changes nothing:
                                 #   the harness refuses the case when
                                 #   the first side left the tree
                                 #   different.
  umask = 0o077                  # optional (bu21): the mask each side runs
                                 #   under. The harness itself runs at
                                 #   022, whatever its caller's was, so a
                                 #   mode a case sees is the same on
                                 #   every host; this is how what `mkdir`
                                 #   and `cp` do under another mask is
                                 #   seen.
  times = true                   # optional (bu22): a scratch case also
                                 #   compares a sixth field, `times`:
                                 #   every entry's access and
                                 #   modification time TO THE
                                 #   NANOSECOND, a link's own included,
                                 #   read without following anything. A
                                 #   time that falls inside the side's
                                 #   own case (from just before its
                                 #   tree is laid out to just after
                                 #   the program ended) is `now`, never
                                 #   a number,
                                 #   because the two sides run at two
                                 #   instants; any other time compares
                                 #   exactly. So a case that must see
                                 #   a time SET to now gives that entry
                                 #   a fixture time first. A time in the
                                 #   three scratch time keys may be
                                 #   "S.NNNNNNNNN" (seconds and nine
                                 #   digits) for a time with nanoseconds.
                                 #   tests/selftest/tee.toml is the
                                 #   gate on it.
  skip_on = { Darwin = "why" }   # optional (bu22): a SKIP, with the
                                 #   reason given, on the named host
                                 #   (`platform.system()`), and a run
                                 #   everywhere else: for a difference
                                 #   one host makes and the other does
                                 #   not, named where it is met.
  oracle_build_differs = { Darwin = "why" }
                                 # optional (bu24, ruling #83): a SKIP,
                                 #   with the reason given, on the named
                                 #   host ONLY when GNU's program there
                                 #   is the staged source build
                                 #   (.gnu-bin/, tools/fetch-oracle) — a
                                 #   build that answers otherwise than
                                 #   the oracle of record does (B73) —
                                 #   and a run against the host's own
                                 #   GNU everywhere else. boreutils#31:
                                 #   the macOS source build prints
                                 #   `\u0000` for printf '\u0000' where
                                 #   GNU 9.11 on linux and Homebrew's
                                 #   print a NUL.
  accounts = true                # optional (bu20): the case prints an
                                 #   owner's or a group's NAME. boreutils
                                 #   reads names from /etc/passwd and
                                 #   /etc/group and nowhere else, so on a
                                 #   host that keeps this user anywhere
                                 #   else (macOS's directory service) the
                                 #   case is a SKIP that says so, and its
                                 #   numeric twin (`-n`) is what runs.
  mask = ["IO Block: [0-9]+"]    # optional (bu20): regular expressions
                                 #   whose every match, in stdout and
                                 #   stderr of BOTH sides, is replaced by
                                 #   `<MASK>` before the comparison. For a
                                 #   field one side cannot know, named in
                                 #   a comment beside the case; everything
                                 #   outside the match is still compared
                                 #   byte for byte, and
                                 #   tests/selftest/echo.toml is the gate
                                 #   on that.
  gnu_keep = "^(EXIT|HUP)$"      # optional (bu23): a regular expression;
                                 #   only the lines of GNU's standard
                                 #   output that it matches (`re.search`,
                                 #   a line at a time) are compared, in
                                 #   their order. For a TABLE one side can
                                 #   print only part of: `kill -l` on GNU
                                 #   names every signal the host has, and
                                 #   this repository's the ones wolf has a
                                 #   meaning for. The rows both have are
                                 #   still compared, byte for byte and in
                                 #   order, and a row GNU lacks still
                                 #   fails. tests/selftest/echo.toml is
                                 #   the gate on it.
  tree = "basic"                 # optional (bu18): start from the file's
                                 #   [tree.basic] table, which holds any of
                                 #   the scratch keys above; the case's own
                                 #   keys are laid over it (a table entry
                                 #   by name, a list by appending), so one
                                 #   fixture tree serves a hundred cases
                                 #   without being written a hundred times
  skip = "reason"                # optional: reported, not run
  timeout = 10                   # optional, seconds
  gnu_min = "9.11"               # optional: run only when the GNU oracle
  gnu_max = "9.4"                #   is in this version range. GNU's
                                 #   behaviour differs across releases and
                                 #   the hosts do not agree: ubuntu-latest
                                 #   ships 9.4 where Homebrew and Arch ship
                                 #   9.11, and the two disagree about (for
                                 #   one) how `wc -w` treats a byte that is
                                 #   not printable. A case outside the
                                 #   range is reported as a SKIP.

THE SCRATCH ROOT, AND THE UTILITIES THAT CHANGE THE FILE SYSTEM (bu21).
Every scratch directory is made under ONE root, `$BORE_SCRATCH_ROOT` or
else the host's temporary directory, as `bore-scratch.XXXXXXXX/s`. The
root is refused when it is `/` or a home directory, and immediately
before EACH side of each case runs the harness checks again that the
directory it is about to stand a program in is a real directory, not a
link, whose resolved path is under that root with that prefix: a
program that removes and overwrites is never started anywhere else.

`mkdir`, `rmdir`, `rm`, `mv`, `cp` (and `touch`, `ln`, `chmod`, when
they exist) are CHANGERS. A changer's case always gets a scratch
directory, named or not, and the harness refuses the whole RUN (status
2, before any case of any utility has run) when one of its arguments —
an operand, an option's attached or `=` value — is `/`, begins with
`~`, has a `..` component, or is absolute and does not begin with
`{scratch}`. `rm -r ..` is refused here even though it would only reach
the scratch directory's own parent: the rule is the lane's, and the
refusal of `.` and `..` by the programs themselves is tested with `.`
and by unit tests. tests/refuse/ holds one plant per rule and
tools/difftest-selftest is the gate.

A scratch case compares a fifth field by default, `tree` (bu21): for
every entry the run left — the top included — its kind, its permission
bits, its link count (not a directory's, which is the file system's
business), a regular file's size, and its modification time WHEN THAT
IS OLDER THAN THE CASE (a time some side or the fixture set, since a
time of "just now" differs between the two sides by the clock). `files`
sees names and bytes; `tree` sees what `ls -l` would.

`kill` SENDS, AND THIS HARNESS RUNS ON HOSTS (bu23). A case of `kill`
is run here only when it cannot signal anything: its first argument is
`-l`, `-t`, `-L`, `--list`, `--table`, `--help` or `--version` (measured
against GNU 9.11: once one of those has been read, nothing later makes
it send), or else no argument of it is a number, signed or not, so that
no operand can name a process or a process group. Any other case
refuses the whole RUN, status 2, before anything has run — the changers'
rule. The cases that send are tests/kill/cases.toml and run from
tools/killtest: one fresh container a case, no network, every target a
process the case itself started. tests/refuse/kill-* holds the plants.

`timeout` RUNS A COMMAND AND SIGNALS A GROUP, AND THIS HARNESS RUNS ON
HOSTS (bu27). A case of it is run here only when it can start no
command: its first argument is `--help` or `--version`, or it has fewer
than two operands (a usage error), or its COMMAND is one no host can run
(`/`, `/etc/passwd`, or a path under `/nonexistent/`), so that timeout
answers 125, 126 or 127 before any child exists and no signal is ever
sent. Any other case refuses the whole RUN, status 2. The cases that
run a command are tests/timeout/cases.toml and run from
tools/timeouttest: one fresh container a case, no network.
tests/refuse/timeout-* holds the plants.

`chown` AND `chgrp` CHANGE OWNERS, AND THIS HARNESS RUNS ON HOSTS (bu24).
A case of either is run here only when it names no FILE: its first
argument is `--help` or `--version`, or it has at most one operand (the
OWNER or GROUP, so a usage error) and no `--reference` (which makes
every operand a file). Any other case refuses the whole RUN, status 2.
The cases that change an owner are tests/ids/cases.toml and run from
tools/idtest: one fresh container a case, no network, the accounts the
image's own. tests/refuse/owner-* holds the plants.

And for `kill` the oracle is asserted BY BINARY, not only by version:
most hosts ship a `kill` that is not GNU coreutils' (procps', or
util-linux's; a shell's builtin is neither), and coreutils installs its
own only when configured with `--enable-install-program=kill`, which
gnu-oracle.toml now does (`needs`). The program this harness is about
to call GNU's must say `kill (GNU coreutils) VERSION`, or the run is
refused; on the `field` leg, where the distro's own `kill` is the
finding, its cases are skipped by name instead. It is looked for on
PATH and then in .gnu-bin/bin, because a host may ship the oracle's
version without this one program (Homebrew): there the host's GNU
still answers for every other utility, and only `kill` is the build's.

The environment is built from scratch for every run: PATH, then
`[oracle.env]` from gnu-oracle.toml, then the case's env (which may
override either). Nothing else leaks in from the host, so a
POSIXLY_CORRECT in the caller's shell cannot change a verdict.

THE ENVIRONMENT IS PART OF THE PIN (B73). `LC_ALL=C` used to be written
here; it is in gnu-oracle.toml now, beside `_POSIX2_VERSION=200112`,
because both are the same kind of thing: a setting that decides what
GNU's answer IS, and that a differential suite must therefore state
rather than inherit. The second one is what makes two builds of one
coreutils release agree about the obsolete `+N` operand form, which
Homebrew's 9.11 and Arch's 9.11 otherwise do not. `[oracle.probe]`
asserts that the environment took, and this harness refuses a verdict
when it did not, exactly as it refuses one against the wrong version.

GNU's name per host: plain on linux, g-prefixed on macOS (Homebrew's
coreutils). $BORE_GNU_PREFIX overrides.

THE ORACLE OF RECORD. `gnu-oracle.toml` names the one GNU release whose
behaviour boreutils is drop-in for, and this harness refuses to return a
verdict against any other: a suite whose answer depends on which host
ran it is a matrix, not an oracle, and an oracle that drifts with a
package update makes a green mean nothing in particular (B44). Set
$BORE_ORACLE_ANY=1 to run against the host's own GNU anyway; the run
then says so on every line of its header and is INFORMATION, not a
verdict — which is what CI's non-blocking "field" leg is for.

  gnu_util = "false"             # self-test only ($BORE_SELFTEST): run
                                 #   THIS GNU utility as the oracle, so a
                                 #   case can plant a known difference

usage: tools/difftest [--bin DIR] [--cases DIR] [util ...]
"""

import os
import platform
import re
import shutil
import select
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
import tomllib

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CASES = os.path.join(ROOT, "tests", "cases")
FIXTURES = os.path.join(ROOT, "tests", "fixtures")
ALL = ("stdout", "stderr", "exit")
FIELDS = ALL + ("files", "offset", "tree", "times")
# The utilities that change the file system (bu21): see the docstring.
CHANGERS = ("mkdir", "rmdir", "rm", "mv", "cp", "touch", "ln", "chmod", "mkfifo", "link", "unlink", "truncate", "sync", "mktemp")
KEYS = {"name", "args", "stdin", "stdin_file", "stdin_offset", "requires",
        "stdin_repeat", "env",
        "compare", "stdout_bytes", "stdout_closed", "stdout_file", "skip",
        "timeout", "gnu_util", "gnu_min", "gnu_max", "scratch",
        "scratch_dirs", "scratch_links", "scratch_modes", "scratch_times",
        "cwd", "tree", "tty", "scratch_fifos", "scratch_sockets",
        "scratch_hardlinks", "scratch_atimes", "scratch_time_all",
        "scratch_keep", "mask", "scratch_sizes", "accounts", "umask",
        "times", "skip_on", "gnu_keep", "oracle_build_differs", "temp_shape", "tty_stdin"}
# Naming any of these gives a case a scratch directory and a `files` field.
SCRATCH = ("scratch", "scratch_dirs", "scratch_links", "scratch_modes",
           "scratch_times", "cwd", "scratch_fifos", "scratch_sockets",
           "scratch_hardlinks", "scratch_atimes", "scratch_time_all",
           "scratch_keep", "scratch_sizes")
# What a case compares when descriptor 1 is closed: there is no stdout.
CLOSED = ("stderr", "exit")


def gnu_version(line):
    """The version at the end of GNU's first --version line, as a tuple.

    GNU's behaviour differs across releases, so a case may name the range
    it describes with gnu_min / gnu_max. ubuntu-latest ships 9.4 where a
    current Homebrew or Arch ships 9.11, and they do not agree about, for
    one, how `wc -w` treats a byte that is not printable.
    """
    m = re.search(r"(\d+(?:\.\d+)*)\s*$", line.strip())
    if not m:
        return None
    return tuple(int(n) for n in m.group(1).split("."))


def version_tuple(text):
    return tuple(int(n) for n in str(text).split("."))


def die(msg):
    print(f"difftest: {msg}", file=sys.stderr)
    sys.exit(2)


def oracle_of_record():
    """The `[oracle]` table of gnu-oracle.toml, version asserted present."""
    path = os.path.join(ROOT, "gnu-oracle.toml")
    try:
        with open(path, "rb") as fh:
            doc = tomllib.load(fh)
        table = doc["oracle"]
        str(table["version"])
        return table
    except (OSError, KeyError, tomllib.TOMLDecodeError) as e:
        die(f"{path}: no oracle version here ({e})")


def oracle_env(table):
    """`[oracle.env]`: the environment every case runs under, both sides."""
    env = table.get("env", {})
    if not isinstance(env, dict):
        die("gnu-oracle.toml: [oracle.env] is not a table")
    return {str(k): str(v) for k, v in env.items()}


def assert_probe(table, prefix, env, loose):
    """`[oracle.probe]`: check the pinned environment actually took.

    A pinned environment nobody checks is the failure B44 named one
    level up: a green that has quietly changed what it measures. The
    probe is one observation whose answer is decided by how the oracle
    was BUILT and overridden by how it is RUN, so it fails loudly on a
    host where the override stopped working.
    """
    probe = table.get("probe")
    if probe is None:
        return
    for key in ("util", "args", "status"):
        if key not in probe:
            die(f"gnu-oracle.toml: [oracle.probe] has no {key}")
    exe = shutil.which(prefix + probe["util"])
    if exe is None:
        die(f"GNU '{prefix}{probe['util']}' not found on PATH for the probe")
    child = {"PATH": os.environ.get("PATH", "/usr/bin:/bin")}
    child.update(env)
    got = subprocess.run([exe] + [str(a) for a in probe["args"]], env=child,
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL).returncode
    want = int(probe["status"])
    what = " ".join([probe["util"]] + [str(a) for a in probe["args"]])
    if got == want:
        print(f"difftest: oracle profile OK — `{what}` exits {got} "
              f"({probe.get('why', '')})")
        return
    if loose:
        # The `field` leg. A build profile that differs is the finding
        # this leg exists to make — it is how B73 was found in the first
        # place — so it is REPORTED here and refuses nothing.
        print(f"difftest: ORACLE PROFILE DIFFERS: `{what}` exits {got} "
              f"where gnu-oracle.toml wants {want} "
              f"({probe.get('why', 'no reason given')})")
        return
    die(f"the pinned environment did not take: `{what}` exits {got} where "
        f"gnu-oracle.toml's [oracle.probe] wants {want} "
        f"({probe.get('why', 'no reason given')}). This build of GNU "
        f"coreutils answers differently from the oracle of record and no "
        f"verdict is possible against it. Set BORE_ORACLE_ANY=1 to run "
        f"against it for information.")


def own_program(prefix, util, want, loose):
    """GNU coreutils' own `util`, for a utility other packages ship too
    (`kill`: procps, util-linux): (path, None), or (None, why not).

    Looked for on PATH under the host's prefix first, then in the staged
    build, .gnu-bin/bin: a host whose GNU is the oracle's version but has
    no `kill` of its own (Homebrew) keeps its GNU for everything else,
    and `tools/fetch-oracle` stages the build for this program alone."""
    why = None
    for exe in (shutil.which(prefix + util),
                os.path.join(ROOT, ".gnu-bin", "bin", util)):
        if exe is None or not os.access(exe, os.X_OK):
            continue
        said = subprocess.run([exe, "--version"], capture_output=True,
                              text=True, errors="replace")
        first = (said.stdout.splitlines() or [""])[0]
        if re.fullmatch(r"\S+ \(GNU coreutils\) \S+", first) is None:
            why = why or (f"{exe} is not GNU coreutils' ({first!r}): another "
                          f"package's program of the same name is no oracle")
            continue
        if not loose and not first.endswith(" " + want):
            why = why or f"{exe} is {first!r}, and the oracle of record is {want}"
            continue
        return exe, None
    return None, why or (
        f"GNU's own '{util}' is not on PATH nor in .gnu-bin/bin: coreutils "
        f"installs it only when configured with --enable-install-program "
        f"(tools/fetch-oracle)")


def gnu_prefix():
    if "BORE_GNU_PREFIX" in os.environ:
        return os.environ["BORE_GNU_PREFIX"]
    return "g" if platform.system() == "Darwin" else ""


def status(code):
    return 128 - code if code < 0 else code


def feed(proc, data):
    """Hand the case its standard input, which the child may not want.

    A child started with descriptor 1 closed fails at its first write and
    exits — that is this repository's exit convention and GNU's — so it
    can be gone before it has read a byte. Writing to a pipe with no
    reader left is then EPIPE, and it is the CHILD's behaviour under
    test, never the harness's ability to finish a write. So a broken pipe
    here is an ordinary outcome and not an error.

    It was an error once. This harness used to set SIGPIPE to SIG_DFL for
    the whole process, so the write killed difftest instead of raising,
    and the report went with it (boreutils#10). Whether the write won the
    race against the child's exit decided whether a run was green, which
    is why the same commit could pass on one day and fail at exit 141 on
    another.
    """
    try:
        proc.stdin.write(data)
    except BrokenPipeError:
        pass
    try:
        proc.stdin.close()
    except BrokenPipeError:
        pass


def accounts_in_files():
    """Whether this user's and this user's group's NAMES are lines of
    /etc/passwd and /etc/group, the only place boreutils reads them."""
    def listed(path, want):
        try:
            with open(path, "rb") as fh:
                for line in fh:
                    parts = line.split(b":")
                    if len(parts) > 2 and parts[2].strip() == str(want).encode():
                        return True
        except OSError:
            pass
        return False
    return listed("/etc/passwd", os.getuid()) and listed("/etc/group", os.getgid())


def has_scratch(case):
    return bool(case.get("_changer")) or any(k in case for k in SCRATCH)


def scratch_root():
    """The one directory every scratch directory is made under, resolved,
    and refused when a mistake in it could reach anything that matters."""
    named = os.environ.get("BORE_SCRATCH_ROOT")
    root = os.path.realpath(named if named else tempfile.gettempdir())
    home = os.path.realpath(os.path.expanduser("~"))
    if root == os.sep or root == home or root == os.path.dirname(home):
        die(f"refusing the scratch root {root!r}: it is the file system's "
            f"root or a home directory")
    if not os.path.isdir(root):
        die(f"the scratch root {root!r} is not a directory")
    return root


def guard(top, root):
    """Refuse to start a program anywhere but a scratch directory this
    harness made: a real directory, no link, under the root by prefix.
    Called immediately before each side of each scratch case runs."""
    want = os.path.join(root, "bore-scratch.")
    real = os.path.realpath(top)
    holder = os.path.dirname(top)
    if (os.path.islink(top) or os.path.islink(holder)
            or not os.path.isdir(top)
            or real != top
            or not real.startswith(want)
            or os.path.basename(real) != "s"
            or os.path.dirname(holder) != root):
        die(f"refusing to run in {top!r}: it is not a scratch directory "
            f"under {root!r}")


def paths_named(arg):
    """What in one argument could be a path: the argument itself, or an
    option's `=` value, or the tail of a short option that holds a `/`,
    a `~` or a `..`. Conservative: a mode string or a date is checked as
    if it were a path, and passes because it stays inside."""
    if not arg.startswith("-") or arg == "-":
        return [arg]
    if arg.startswith("--"):
        return [arg.split("=", 1)[1]] if "=" in arg else []
    at = [i for i in (arg.find("/"), arg.find("~"), arg.find("..")) if i >= 0]
    return [arg[min(at):]] if at else []


def unsafe(arg):
    """Why a changer may not be handed `arg`, or None. Judged on the
    argument AS WRITTEN in the case file, `{scratch}` not yet replaced,
    so a whole run is refused before any of it starts."""
    for path in paths_named(arg):
        if path.startswith("~"):
            return f"{arg!r} begins with ~"
        if ".." in path.split("/"):
            return f"{arg!r} has a .. component"
        if path.startswith("/") or path.startswith("{scratch}"):
            inside = path.startswith("{scratch}/") or path == "{scratch}"
            if not inside:
                return f"{arg!r} is absolute and outside the scratch directory"
    return None


# What makes a `kill` case safe on a host (bu23): see the docstring.
KILL_LISTS = ("-l", "-t", "-L", "--list", "--table", "--help", "--version")


def could_signal(args):
    """Why this `kill` case could signal a process, or None."""
    if args and args[0] in KILL_LISTS:
        return None
    for a in args:
        if re.fullmatch(r"\s*[+-]?\d+\s*", a):
            return f"{a!r} is a number, and so could be a process id"
        if "{" in a:
            return f"{a!r} holds a placeholder"
    return None


# What makes a `timeout` case safe on a host (bu27): see the docstring.
TIMEOUT_TAKES = ("-k", "-s", "--kill-after", "--signal")
TIMEOUT_CANNOT_RUN = ("/", "/etc/passwd")


def could_run(args):
    """Why this `timeout` case could start a command, or None."""
    if args and args[0] in ("--help", "--version"):
        return None
    i = 0
    while i < len(args):
        a = args[i]
        if "{" in a:
            return f"{a!r} holds a placeholder"
        if a == "--":
            i += 1
            break
        if not a.startswith("-") or a == "-":
            break
        if a in TIMEOUT_TAKES or (re.fullmatch(r"-[fpv]*[ks]", a) is not None):
            i += 1
        i += 1
    operands = args[i:]
    if len(operands) < 2:
        return None
    cmd = operands[1]
    if cmd in TIMEOUT_CANNOT_RUN or cmd.startswith("/nonexistent/"):
        return None
    return f"{cmd!r} is a command it could run"


# What makes a `chown`/`chgrp` case safe on a host (bu24): see the docstring.
OWNER_SAFE = ("--help", "--version")


def could_own(args):
    """Why this `chown`/`chgrp` case could change an owner, or None."""
    if args and args[0] in OWNER_SAFE:
        return None
    operands = []
    ended = False
    for a in args:
        if "{" in a:
            return f"{a!r} holds a placeholder"
        if ended or a == "-" or not a.startswith("-"):
            operands.append(a)
        elif a == "--":
            ended = True
        elif a.startswith("--ref") or a.startswith("--reference"):
            return f"{a!r} makes every operand a FILE"
    if len(operands) >= 2:
        return f"{operands[1]!r} is a FILE operand"
    return None


def unlock(top):
    """Give back what a case's `scratch_modes` took away, so the tree can
    be emptied: a directory with mode 0 cannot be opened, so `rmtree`
    cannot reach in (bu18, `ls` of an unreadable directory). Never
    follows a link."""
    if not os.path.isdir(top) or os.path.islink(top):
        return
    os.chmod(top, 0o700)
    for entry in os.scandir(top):
        if entry.is_dir(follow_symlinks=False):
            unlock(entry.path)


def instant(value, now):
    """A case's TIME in nanoseconds: seconds from the epoch, or "now-N" /
    "now+N" against the one instant the case was given."""
    if isinstance(value, str):
        exact = re.fullmatch(r"(-?\d+)\.(\d{9})", value)
        if exact:
            sec, frac = int(exact.group(1)), int(exact.group(2))
            return sec * 1_000_000_000 + (frac if sec >= 0 else -frac)
        m = re.fullmatch(r"now([+-]\d+)?", value)
        if not m:
            die(f"a scratch time is seconds or 'now-N'/'now+N', not {value!r}")
        return (now + int(m.group(1) or 0)) * 1_000_000_000
    return int(value) * 1_000_000_000


def populate(case, top, now):
    """Empty `top` and lay the case's scratch tree out in it."""
    if os.path.lexists(top):
        unlock(top)
        shutil.rmtree(top)
    os.mkdir(top)
    for d in case.get("scratch_dirs", []):
        os.makedirs(os.path.join(top, d), exist_ok=True)
    for name, text in case.get("scratch", {}).items():
        path = os.path.join(top, name)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "wb") as fh:
            fh.write(text.encode())
    for name, size in case.get("scratch_sizes", {}).items():
        path = os.path.join(top, name)
        with open(path, "ab"):
            pass
        os.truncate(path, int(size))
        if os.lstat(path).st_size != int(size):
            die(f"scratch_sizes: {name} did not take {size} bytes")
    for name, target in case.get("scratch_links", {}).items():
        os.symlink(target, os.path.join(top, name))
    # The other kinds (bu20), each read back: a tree that silently held
    # a plain file where a case asked for a pipe would show both sides
    # the same wrong entry and pass.
    for name in case.get("scratch_fifos", []):
        path = os.path.join(top, name)
        os.mkfifo(path)
        if not stat.S_ISFIFO(os.lstat(path).st_mode):
            die(f"scratch_fifos: {name} is not a fifo")
    for name in case.get("scratch_sockets", []):
        # Bound by a RELATIVE name from inside its directory: a unix
        # socket's address is at most 108 bytes (104 on macOS), and a
        # scratch path under a long $TMPDIR is longer than that.
        path = os.path.join(top, name)
        here = os.open(".", os.O_RDONLY)
        try:
            os.chdir(os.path.dirname(path))
            sock = socket.socket(socket.AF_UNIX)
            sock.bind(os.path.basename(path))
            sock.close()
        finally:
            os.fchdir(here)
            os.close(here)
        if not stat.S_ISSOCK(os.lstat(path).st_mode):
            die(f"scratch_sockets: {name} is not a socket")
    for name, target in case.get("scratch_hardlinks", {}).items():
        path = os.path.join(top, name)
        os.link(os.path.join(top, target), path)
        if os.lstat(path).st_ino != os.lstat(os.path.join(top, target)).st_ino:
            die(f"scratch_hardlinks: {name} is not {target}")
    # Times after every entry exists, because creating an entry moves
    # its directory's mtime and a time set earlier would not survive;
    # before the modes, which move no mtime but can lock a directory
    # this loop must reach into. Each time is READ BACK, so a host that
    # silently ignores one (a link's, say) refuses the case rather than
    # letting both sides sort by whatever was there.
    times = {os.path.normpath(os.path.join(top, n)): instant(v, now)
             for n, v in case.get("scratch_times", {}).items()}
    atimes = {os.path.normpath(os.path.join(top, n)): instant(v, now)
              for n, v in case.get("scratch_atimes", {}).items()}
    if "scratch_time_all" in case:
        every = instant(case["scratch_time_all"], now)
        times.setdefault(top, every)
        for root, dirs, files in os.walk(top):
            for n in dirs + files:
                times.setdefault(os.path.join(root, n), every)
    for path in sorted(set(times) | set(atimes), key=len, reverse=True):
        if path not in times:
            die(f"scratch_atimes: {os.path.relpath(path, top)} has no "
                f"scratch_times beside it")
        ns = times[path]
        ans = atimes.get(path, ns)
        os.utime(path, ns=(ans, ns), follow_symlinks=False)
        seen = os.lstat(path)
        if seen.st_mtime_ns != ns or seen.st_atime_ns != ans:
            die(f"scratch_times: {os.path.relpath(path, top)} did not "
                f"take its time")
    for name, mode in case.get("scratch_modes", {}).items():
        os.chmod(os.path.join(top, name), mode)


def snapshot(top):
    """What a run left in the scratch tree, as a sorted, comparable list:
    every name under `top` with its kind, a file's bytes and a link's
    target. Never followed through a link, so a link out of the tree
    is its target text and nothing else."""
    seen = []
    for root, dirs, files in os.walk(top):
        for d in sorted(dirs):
            path = os.path.join(root, d)
            rel = os.path.relpath(path, top)
            if os.path.islink(path):
                seen.append((rel, "link", os.readlink(path).encode()))
            else:
                seen.append((rel, "dir", b""))
        for f in sorted(files):
            path = os.path.join(root, f)
            rel = os.path.relpath(path, top)
            if os.path.islink(path):
                seen.append((rel, "link", os.readlink(path).encode()))
            elif os.path.isfile(path):
                try:
                    # A hole of a hundred gigabytes (`scratch_sizes`) is
                    # compared by its length, never read into memory.
                    size = os.path.getsize(path)
                    if size > 1 << 20:
                        seen.append((rel, "file", b"<%d bytes>" % size))
                        continue
                    with open(path, "rb") as fh:
                        seen.append((rel, "file", fh.read()))
                except OSError as e:
                    seen.append((rel, "unreadable", str(e.errno).encode()))
            else:
                seen.append((rel, "other", b""))
    return sorted(seen)


def tree(top, now):
    """What `ls -l` would say of what a run left, the top included: kind,
    permission bits, link count (not a directory's), a file's size, and a
    modification time older than the case. Never follows a link."""
    def entry(path, rel):
        try:
            st = os.lstat(path)
        except OSError as e:
            # Listed by a directory that may be read and not searched.
            return (rel, "unseen", e.errno, None, None, None)
        kind = ("dir" if stat.S_ISDIR(st.st_mode) else
                "link" if stat.S_ISLNK(st.st_mode) else
                "file" if stat.S_ISREG(st.st_mode) else
                "fifo" if stat.S_ISFIFO(st.st_mode) else
                "socket" if stat.S_ISSOCK(st.st_mode) else "other")
        links = None if kind == "dir" else st.st_nlink
        size = st.st_size if kind == "file" else None
        # A link's own mode is the host's whim (0777 on linux, the
        # umask's on macOS) and nothing can set it.
        mode = None if kind == "link" else stat.S_IMODE(st.st_mode)
        old = st.st_mtime_ns if st.st_mtime < now - 600 else None
        return (rel, kind, mode, links, size, old)
    seen = [entry(top, ".")]
    for root, dirs, files in os.walk(top):
        for n in dirs + files:
            path = os.path.join(root, n)
            seen.append(entry(path, os.path.relpath(path, top)))
    return sorted(seen)


def stamps(top, start, end):
    """Every entry's access and modification time, to the nanosecond, a
    link's own (never followed), the top included; a time inside
    [start, end] (the side's own run) is "now". bu22."""
    def word(t):
        return "now" if start <= t <= end else t
    def entry(path, rel):
        try:
            st = os.lstat(path)
        except OSError as e:
            return (rel, "unseen", e.errno)
        return (rel, word(st.st_atime_ns), word(st.st_mtime_ns))
    seen = [entry(top, ".")]
    for root, dirs, files in os.walk(top):
        for n in dirs + files:
            path = os.path.join(root, n)
            seen.append(entry(path, os.path.relpath(path, top)))
    return sorted(seen, key=lambda e: e[0])


def substitute(value, top):
    return value if top is None else value.replace("{scratch}", top)


def run(exe, argv0, case, base_env, top=None, now=0, fresh=True):
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin")}
    env.update(base_env)
    env.update({k: substitute(v, top) for k, v in case.get("env", {}).items()})
    cwd = ROOT
    # The side's own window, for `times` (bu22): from a little before
    # its tree is laid out (a file system stamps with a coarser clock
    # than the one read here) to a little after the program has gone.
    # A time the fixture did not set is inside it, and so is "now".
    started = time.time_ns() - 20_000_000
    if top is not None:
        if fresh:
            populate(case, top, now)
        cwd = os.path.join(top, case.get("cwd", "."))
        # The last thing before a program is started (bu21).
        guard(top, case["_root"])
        if not os.path.realpath(cwd).startswith(top):
            die(f"refusing to run in {cwd!r}: it resolves outside {top!r}")
    mask = case.get("umask")
    closing = bool(case.get("stdout_closed"))

    def before():
        if mask is not None:
            os.umask(int(mask))
        if closing:
            os.close(1)
    stdin = subprocess.DEVNULL
    data = None
    if "stdin" in case:
        stdin = subprocess.PIPE
        data = case["stdin"].encode() * int(case.get("stdin_repeat", 1))
    elif "stdin_file" in case:
        stdin = open(os.path.join(FIXTURES, case["stdin_file"]), "rb")
        if "stdin_offset" in case:
            os.lseek(stdin.fileno(), int(case["stdin_offset"]), os.SEEK_SET)
    limit = case.get("stdout_bytes")
    closed = bool(case.get("stdout_closed"))
    sink = case.get("stdout_file")
    timeout = case.get("timeout", 10)
    tty = case.get("tty")
    if case.get("tty_stdin") and tty is None:
        tty = 80
    if tty is not None:
        return run_tty(exe, argv0, case, env, cwd, stdin, data, timeout, int(tty), top, now)
    if sink is not None:
        stdout = open(sink, "wb", buffering=0)
    elif closed:
        stdout = subprocess.DEVNULL
    else:
        stdout = subprocess.PIPE
    proc = subprocess.Popen(
        [argv0] + [substitute(a, top) for a in case.get("args", [])],
        executable=exe, env=env,
        stdin=stdin, stdout=stdout, stderr=subprocess.PIPE,
        # `prog >&-`: the child reaches main with descriptor 1 closed.
        # Nothing but a fork hook can produce that, because Popen's
        # stdout= can only REDIRECT a descriptor, never leave it shut.
        preexec_fn=before if (closed or mask is not None) else None,
        # Every case runs from the repository root, so a case naming a
        # file operand writes it as tests/fixtures/NAME and means the
        # same thing however difftest itself was invoked — unless it
        # names a scratch directory, which it then runs in.
        cwd=cwd,
        # the child gets the default SIGPIPE disposition, as a shell gives
        restore_signals=True)
    try:
        if closed or sink is not None:
            if data is not None:
                feed(proc, data)
            err = proc.stderr.read()
            proc.wait(timeout=timeout)
            out = b""
        elif limit is None:
            out, err = proc.communicate(data, timeout=timeout)
        else:
            if data is not None:
                feed(proc, data)
            out = b""
            while len(out) < limit:
                chunk = proc.stdout.read(limit - len(out))
                if not chunk:
                    break
                out += chunk
            proc.stdout.close()
            proc.wait(timeout=timeout)
            err = proc.stderr.read()
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
        return None
    else:
        # The child is gone, so the offset it shared with this open file
        # description is where it left it.
        if "stdin_offset" in case:
            offset = os.lseek(stdin.fileno(), 0, os.SEEK_CUR)
    finally:
        if hasattr(stdin, "close"):
            stdin.close()
        if hasattr(stdout, "close"):
            stdout.close()
    if case.get("_changer"):
        out = prog_lines(out, argv0, case.get("_util"))
    result = {"stdout": masked(out, case), "stderr": masked(normalize(err, argv0, case.get("_util")), case),
              "exit": status(proc.returncode)}
    if "stdin_offset" in case:
        result["offset"] = offset
    if top is not None:
        result["files"] = snapshot(top)
        result["tree"] = tree(top, now)
        result["times"] = stamps(top, started, time.time_ns() + 20_000_000)
    return temp_result(result, case, top, cwd)


def temp_result(result, case, top, cwd):
    """Validate the entire generated name and its object before normalizing it.

    Both sides must satisfy the stated shape and private mode independently;
    two equally broken results must never compare equal. Names in snapshots
    are replaced only after that check, not by an unbounded regex mask.
    """
    shape = case.get("temp_shape")
    if shape is None:
        return result
    result["shape_error"] = ""
    prefix = os.path.join(substitute(shape["directory"], top), shape["prefix"])
    pattern = (re.escape(prefix.encode()) + rb"[a-zA-Z0-9]{" +
               str(shape["xs"]).encode() + rb"}" +
               re.escape(shape.get("suffix", "").encode()) + rb"\n")
    if result["exit"] != 0 or re.fullmatch(pattern, result["stdout"]) is None:
        result["shape_error"] = "name, alphabet, X count, suffix, or exit differs from the declared shape"
        return result
    name = result["stdout"][:-1].decode()
    path = os.path.abspath(os.path.join(cwd, name))
    if top is None or os.path.commonpath([path, top]) != top:
        result["shape_error"] = "generated name escaped the scratch directory"
        return result
    expected = shape["kind"]
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        info = None
    if expected == "none":
        good = info is None
    else:
        good = info is not None and (stat.S_ISREG(info.st_mode) if expected == "file" else stat.S_ISDIR(info.st_mode))
        good = good and stat.S_IMODE(info.st_mode) == (shape["mode"] & ~case.get("umask", 0o022))
    if not good:
        result["shape_error"] = "created kind or private mode differs, or dry-run created an entry"
        return result
    relative = os.path.relpath(path, top)
    result["stdout"] = prefix.encode() + b"<RANDOM>" + shape.get("suffix", "").encode() + b"\n"
    for field in ("files", "tree", "times"):
        if field in result:
            result[field] = [("<TEMP>" if row[0] == relative else row[0],) + tuple(row[1:])
                             for row in result[field]]
    return result


def run_tty(exe, argv0, case, env, cwd, stdin, data, timeout, cols, top, now=0):
    """`run` with standard output on a pseudo-terminal `cols` wide.

    The pty is made here and its size set before the child starts, so a
    program that asks the terminal's width (GNU's `ls`, TIOCGWINSZ) and
    one that cannot (this repository's, which takes COLUMNS or 80) are
    measured against the same terminal. stderr is a pipe.

    THE TERMINAL END STAYS OPEN HERE UNTIL THE CHILD HAS GONE AND ITS
    OUTPUT HAS BEEN READ (boreutils#27). This harness used to close its
    copy at once and read the controller until EIO or end of file. On
    macOS the LAST close of a terminal end waits a while for what is
    buffered to be read (0.6 s, measured) and then discards it, and the
    controller answers end of file. When the child had already written
    and exited, that last close was this harness's own, made before its
    first read: it waited on a reader that was itself, and the bytes
    went (`tools/ttyprobe`, CI run 39026452370 on macos-latest: with the
    reader 5 ms late, 200 of 200 trials empty, every first read end of
    file with the child gone and every close 0.6 s; with no delay, 1 in
    200; on linux, 0 at any delay). So: read while the child runs, wait
    for it, read until the controller has been quiet a moment, and only
    then close the terminal end and read to the end — linux hands bytes
    over to the controller asynchronously and keeps them past the last
    close, so that final read is where linux's last bytes arrive."""
    import fcntl
    import pty
    import struct
    import termios
    master, slave = pty.openpty()
    fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 24, cols, 0, 0))
    proc = subprocess.Popen(
        [argv0] + [substitute(a, top) for a in case.get("args", [])],
        executable=exe, env=env, stdin=slave if case.get("tty_stdin") else stdin, stdout=slave,
        stderr=subprocess.PIPE, cwd=cwd, restore_signals=True)
    if data is not None:
        feed(proc, data)
    errfd = proc.stderr.fileno()
    out = bytearray()
    err = bytearray()
    deadline = time.monotonic() + timeout

    def take(fd, into):
        """One read of `fd` into `into`; False at its end (or EIO)."""
        try:
            chunk = os.read(fd, 65536)
        except OSError:
            return False
        if not chunk:
            return False
        into += chunk
        return True
    try:
        # While the child runs: both streams, as they come.
        reading = [master, errfd]
        while proc.poll() is None:
            if time.monotonic() > deadline:
                proc.kill()
                proc.wait()
                return None
            ready, _, _ = select.select(reading, [], [], 0.05)
            for fd in ready:
                if not take(fd, out if fd == master else err):
                    reading.remove(fd)
        # Gone. What it wrote is buffered behind the controller and this
        # harness still holds the terminal end, so it cannot be lost:
        # read until nothing has arrived for a while.
        while True:
            ready, _, _ = select.select([master], [], [], 0.05)
            if not ready or not take(master, out):
                break
        os.close(slave)
        slave = None
        while True:
            ready, _, _ = select.select([master], [], [], max(0.0, deadline - time.monotonic()))
            if not ready or not take(master, out):
                break
        while take(errfd, err):
            pass
    finally:
        if slave is not None:
            os.close(slave)
        os.close(master)
        if hasattr(stdin, "close"):
            stdin.close()
    out = bytes(out)
    err = bytes(err)
    if case.get("tty_stdin"):
        out = re.sub(rb"^/dev/(?:pts/[0-9]+|ttys[0-9]+)\r?\n$", b"<PTY>\n", out)
    result = {"stdout": masked(out, case), "stderr": masked(normalize(err, argv0, case.get("_util")), case),
              "exit": status(proc.returncode)}
    if top is not None:
        result["files"] = snapshot(top)
        result["tree"] = tree(top, now)
        # No window is taken on a terminal: every time is a number.
        result["times"] = stamps(top, 0, -1)
    return result


def masked(data, case):
    """`data` with every match of the case's `mask` expressions replaced."""
    for pattern in case.get("mask", []):
        data = re.sub(pattern.encode(), b"<MASK>", data)
    return data


def normalize(err, argv0, util=None):
    """`err` with the program's name as it was run made PROG — and, when
    GNU was run under a prefixed name (`gstat`), the bare utility name
    too: `stat: cannot stat 'x'` names itself twice on our side and
    `gstat: cannot stat 'x'` once on GNU's, and a harness that replaced
    only what each was RUN as read the same message as two (bu20, the
    macOS leg of run 38115826824)."""
    names = [argv0]
    if util is not None and util != argv0:
        names.append(util)
    for name in names:
        err = re.sub(rb"(?<![\w-])" + re.escape(name.encode()) + rb"(?![\w-])",
                     b"PROG", err)
    return err


def prog_lines(out, argv0, util=None):
    """Standard output with a LINE-LEADING `name: ` made `PROG: `, for
    the utilities that change the file system (bu21). `mkdir -v` and
    `rmdir -v` name themselves on standard output (`mkdir: created
    directory 'a'`), and GNU run as `gmkdir` says `gmkdir:` there: the
    macOS leg of run 38122354989 failed 36 cases on that prefix and on
    nothing else. Only the start of a line, and only for those
    utilities: any other program's standard output is data."""
    names = [argv0]
    if util is not None and util != argv0:
        names.append(util)
    for name in names:
        out = re.sub(rb"(?m)^" + re.escape(name.encode()) + rb": ", b"PROG: ", out)
    return out


def show(side, result, fields):
    if result is None:
        return f"    {side}: TIMED OUT"
    lines = []
    for f in fields:
        v = result[f]
        if f == "files":
            v = [(rel, kind, data[:80]) for rel, kind, data in v]
        if isinstance(v, bytes) and len(v) > 400:
            v = v[:400] + b"...(%d bytes)" % len(result[f])
        lines.append(f"    {side} {f}: {v!r}")
    return "\n".join(lines)


def planted(case, trees, path):
    """The case with its named tree laid under it (`tree = "NAME"`)."""
    name = case.get("tree")
    if name is None:
        return case
    if name not in trees:
        die(f"{path}: case {case.get('name', '?')!r} names tree {name!r}, "
            f"which the file does not define")
    base = trees[name]
    extra = set(base) - set(SCRATCH)
    if extra:
        die(f"{path}: tree {name!r} holds keys that are not scratch keys "
            f"({sorted(extra)})")
    out = {}
    for key in SCRATCH:
        if key in base and key in case:
            if isinstance(base[key], dict):
                merged = dict(base[key])
                merged.update(case[key])
                out[key] = merged
            elif isinstance(base[key], list):
                out[key] = list(base[key]) + list(case[key])
            else:
                out[key] = case[key]
        elif key in base:
            out[key] = base[key]
    merged = dict(case)
    merged.update(out)
    return merged


def load(path, util=None):
    try:
        with open(path, "rb") as fh:
            doc = tomllib.load(fh)
    except (OSError, tomllib.TOMLDecodeError) as e:
        die(f"{path}: {e}")
    trees = doc.get("tree", {})
    cases = [planted(c, trees, path) for c in doc.get("case", [])]
    seen = set()
    changer = util in CHANGERS
    for c in cases:
        if changer:
            c["_changer"] = True
            for a in list(c.get("args", [])) + [c.get("cwd", "")]:
                why = unsafe(str(a))
                if why is not None:
                    die(f"{path}: refusing case {c.get('name', '?')!r}: {why} "
                        f"({util} changes the file system)")
    if util == "kill":
        for c in cases:
            why = could_signal([str(a) for a in c.get("args", [])])
            if why is not None:
                die(f"{path}: refusing case {c.get('name', '?')!r}: {why} "
                    f"(kill sends: such a case belongs to tools/killtest, "
                    f"in a container)")
    if util == "timeout":
        for c in cases:
            why = could_run([str(a) for a in c.get("args", [])])
            if why is not None:
                die(f"{path}: refusing case {c.get('name', '?')!r}: {why} "
                    f"(timeout runs a command and signals its group: such a "
                    f"case belongs to tools/timeouttest, in a container)")
    if util in ("chown", "chgrp"):
        for c in cases:
            why = could_own([str(a) for a in c.get("args", [])])
            if why is not None:
                die(f"{path}: refusing case {c.get('name', '?')!r}: {why} "
                    f"({util} changes an owner: such a case belongs to "
                    f"tools/idtest, in a container)")
    for c in cases:
        extra = set(c) - KEYS - {"_changer"}
        if "name" not in c or extra:
            die(f"{path}: case {c.get('name', '?')!r} is malformed "
                f"(unknown keys {sorted(extra)})" if extra else
                f"{path}: a case has no name")
        if c["name"] in seen:
            die(f"{path}: duplicate case name {c['name']!r}")
        seen.add(c["name"])
        if "stdin_offset" in c and "stdin_file" not in c:
            die(f"{path}: case {c['name']!r} sets an offset on a standard "
                f"input that is not a file")
        if "stdin_repeat" in c and "stdin" not in c:
            die(f"{path}: case {c['name']!r} repeats a standard input "
                f"it does not have")
        if "stdout_file" in c:
            if c.get("stdout_closed") or "stdout_bytes" in c:
                die(f"{path}: case {c['name']!r} redirects standard "
                    f"output and also closes or reads it")
            if "stdout" in c.get("compare", CLOSED):
                die(f"{path}: case {c['name']!r} redirects standard "
                    f"output and still compares it")
        if "tty" in c and (c.get("stdout_closed") or "stdout_file" in c
                           or "stdout_bytes" in c):
            die(f"{path}: case {c['name']!r} puts standard output on a "
                f"terminal and also closes, redirects or reads it")
        if c.get("stdout_closed"):
            if "stdout_bytes" in c:
                die(f"{path}: case {c['name']!r} both closes standard "
                    f"output and reads bytes from it")
            if "stdout" in c.get("compare", CLOSED):
                die(f"{path}: case {c['name']!r} closes standard output "
                    f"and still compares it")
        for f in c.get("compare", ALL):
            if f not in FIELDS:
                die(f"{path}: case {c['name']!r} compares unknown {f!r}")
            if f == "offset" and "stdin_offset" not in c:
                die(f"{path}: case {c['name']!r} compares the offset and "
                    f"sets none")
            if f in ("files", "tree", "times") and not has_scratch(c):
                die(f"{path}: case {c['name']!r} compares {f} and has "
                    f"no scratch directory")
    return cases


def main(argv):
    # THE REPORT IS WRITTEN AS IT IS DECIDED (boreutils#10). Python block-
    # buffers a stdout that is not a terminal, which is exactly what CI
    # gives this harness, so a run that died took every verdict it had
    # already reached with it: three macOS gauntlets ended at exit 141
    # with NOTHING between `Run tools/difftest` and the error line. A
    # gate that loses its evidence when it fails cannot be used to
    # diagnose the thing that killed it. Line buffering costs one write
    # per case and makes the transcript survive any death, SIGKILL
    # included — see tools/difftest-evidence, which kills a run to check.
    sys.stdout.reconfigure(line_buffering=True)
    bindir = os.path.join(ROOT, "target", "release")
    cases = CASES
    while argv[:1] in (["--bin"], ["--cases"]):
        if len(argv) < 2:
            die(f"{argv[0]} needs a directory")
        if argv[0] == "--bin":
            bindir = os.path.abspath(argv[1])
        else:
            cases = os.path.abspath(argv[1])
        argv = argv[2:]
    utils = argv or sorted(f[:-5] for f in os.listdir(cases)
                           if f.endswith(".toml"))
    prefix = gnu_prefix()
    probe = shutil.which(prefix + "true")
    if probe is None:
        die(f"GNU coreutils not found as '{prefix}true' on PATH")
    version = subprocess.run([probe, "--version"], capture_output=True,
                             text=True).stdout.splitlines()[0]
    have = gnu_version(version)
    print(f"difftest: gnu = {version} (prefix {prefix!r}) on "
          f"{platform.system()} {platform.machine()}")
    print(f"difftest: bore = {bindir}")

    # The oracle of record, asserted. A drifting oracle is the failure
    # this check exists for: it is not that the wrong GNU gives wrong
    # answers, it is that nobody notices which GNU gave them.
    table = oracle_of_record()
    want = str(table["version"])
    base_env = oracle_env(table)
    if base_env:
        shown = " ".join(f"{k}={v}" for k, v in sorted(base_env.items()))
        print(f"difftest: oracle environment, {shown}")
    loose = bool(os.environ.get("BORE_ORACLE_ANY"))
    if have == version_tuple(want):
        print(f"difftest: oracle of record, GNU coreutils {want}")
    elif loose:
        print(f"difftest: NOT THE ORACLE OF RECORD: gnu-oracle.toml names "
              f"{want} and this host has {version}")
        print("difftest: BORE_ORACLE_ANY is set, so this run is "
              "INFORMATION, not a verdict")
    else:
        die(f"gnu-oracle.toml names GNU coreutils {want} as the oracle of "
            f"record and this host has {version}. Install the oracle "
            f"(tools/fetch-oracle), or set BORE_ORACLE_ANY=1 to run "
            f"against this one for information.")

    # The build profile, asserted — and on the `field` leg, reported.
    assert_probe(table, prefix, base_env, loose)

    # One mask for the harness and so for every tree it lays out and
    # every child that names none (bu21): a mode is the same on every
    # host, whatever the caller's shell had.
    os.umask(0o022)
    root = scratch_root()
    print(f"difftest: scratch root {root}")
    # Every case file is read, and every changer's argument judged,
    # BEFORE anything runs: a refused operand stops the run, not the case.
    loaded = {util: load(os.path.join(cases, util + ".toml"), util)
              for util in utils}

    passed = failed = skipped = 0
    for util in utils:
        entries = loaded[util]
        bore = os.path.join(bindir, util)
        if not os.access(bore, os.X_OK):
            die(f"no boreutils binary at {bore} (run tools/build)")
        foreign = own = None
        if util in str(table.get("needs", "")).split():
            own, foreign = own_program(prefix, util, want, loose)
            if foreign is not None and not loose:
                die(foreign)
            if own is not None:
                print(f"difftest: gnu {util} = {own}")
        for case in entries:
            if foreign is not None:
                skipped += 1
                print(f"SKIP {util}: {case['name']} ({foreign})")
                continue
            oracle = util
            if "gnu_util" in case:
                if not os.environ.get("BORE_SELFTEST"):
                    die(f"{util}: gnu_util is for the self-test only")
                oracle = case["gnu_util"]
            gnu = own if own is not None and oracle == util else shutil.which(prefix + oracle)
            if gnu is None:
                die(f"GNU '{prefix}{oracle}' not found on PATH")
            label = f"{util}: {case['name']}"
            if "skip" in case:
                skipped += 1
                print(f"SKIP {label} ({case['skip']})")
                continue
            bound = None
            if have is not None and "gnu_min" in case \
                    and have < version_tuple(case["gnu_min"]):
                bound = f"needs GNU >= {case['gnu_min']}, this is {version}"
            if have is not None and "gnu_max" in case \
                    and have > version_tuple(case["gnu_max"]):
                bound = f"needs GNU <= {case['gnu_max']}, this is {version}"
            if bound is not None:
                skipped += 1
                print(f"SKIP {label} ({bound})")
                continue
            host = platform.system()
            if host in case.get("skip_on", {}):
                skipped += 1
                print(f"SKIP {label} (on {host}: {case['skip_on'][host]})")
                continue
            built = os.path.realpath(os.path.join(ROOT, ".gnu-bin"))
            if host in case.get("oracle_build_differs", {}) and \
                    os.path.realpath(gnu).startswith(built + os.sep):
                skipped += 1
                print(f"SKIP {label} (on {host}, against the source-built oracle "
                      f"{gnu}: {case['oracle_build_differs'][host]})")
                continue
            need = case.get("requires")
            if need is not None and not os.path.exists(need):
                skipped += 1
                print(f"SKIP {label} (no {need} on this host)")
                continue
            if case.get("accounts") and not accounts_in_files():
                skipped += 1
                print(f"SKIP {label} (this account is not named in "
                      f"/etc/passwd and /etc/group, the only name service "
                      f"boreutils reads)")
                continue
            sink = case.get("stdout_file")
            if sink is not None and not os.path.exists(sink):
                skipped += 1
                print(f"SKIP {label} (no {sink} on this host)")
                continue
            fields = case.get("compare",
                              ALL if sink is None and not case.get("stdout_closed")
                              else CLOSED)
            if "stdin_offset" in case and "compare" not in case:
                fields = tuple(fields) + ("offset",)
            top = None
            if has_scratch(case):
                if "compare" not in case:
                    fields = tuple(fields) + ("files", "tree")
                    if case.get("times"):
                        fields = tuple(fields) + ("times",)
                # One path for both sides, emptied between them, so a
                # path either one prints is the same path.
                holder = tempfile.mkdtemp(prefix="bore-scratch.", dir=root)
                top = os.path.join(holder, "s")
            # One instant per case, for both sides ("now-N", bu20).
            now = int(time.time())
            keep = bool(case.get("scratch_keep"))
            # The bare name, for `normalize` (see there).
            case = dict(case)
            case["_util"] = oracle
            case["_root"] = root
            try:
                if keep:
                    populate(case, top, now)
                    laid = snapshot(top)
                b = run(bore, util, case, base_env, top, now, fresh=not keep)
                g = run(gnu, prefix + oracle, case, base_env, top, now,
                        fresh=not keep)
                # A kept tree is for a program that changes nothing.
                if keep and any(r is not None and r["files"] != laid
                                for r in (b, g)):
                    die(f"{label}: scratch_keep, and a side changed the tree")
            finally:
                if top is not None:
                    unlock(holder)
                    shutil.rmtree(holder, ignore_errors=True)
            if g is not None and "gnu_keep" in case:
                keep = re.compile(case["gnu_keep"].encode())
                g["stdout"] = b"".join(
                    line for line in g["stdout"].splitlines(keepends=True)
                    if keep.search(line.rstrip(b"\n")))
            ok = (b is not None and g is not None
                  and not b.get("shape_error") and not g.get("shape_error")
                  and all(b[f] == g[f] for f in fields))
            if ok:
                passed += 1
                print(f"ok   {label}")
            else:
                failed += 1
                print(f"FAIL {label}  args={case.get('args', [])!r}")
                if case.get("temp_shape"):
                    print(f"    shape errors: bore={None if b is None else b.get("shape_error")!r}, gnu={None if g is None else g.get("shape_error")!r}")
                print(show("bore", b, fields))
                print(show("gnu ", g, fields))
    print(f"difftest: {passed} passed, {failed} failed, {skipped} skipped")
    return 1 if failed else 0


if __name__ == "__main__":
    # THE HARNESS KEEPS PYTHON'S SIGPIPE, AND THE CHILDREN DO NOT
    # (boreutils#10). This used to read SIG_DFL, on the reasoning that a
    # case must meet the same SIGPIPE a shell would give it. The children
    # already do: Popen(restore_signals=True) — the default, and passed
    # explicitly in run() — puts every signal Python set to SIG_IGN back
    # to SIG_DFL in the child before exec, SIGPIPE among them, and the
    # cases that assert a child dies at 141 (`cat`'s and `tr`'s streams
    # cut short by their reader) are what keeps that honest. All SIG_DFL
    # here ever did was let a broken pipe of the HARNESS's own kill the
    # harness, unwritten report and all. Python's default is SIG_IGN, so
    # the write raises BrokenPipeError instead and feed() decides what it
    # means.
    #
    # Our own standard output is the one pipe we cannot answer for: if
    # whoever is reading this transcript goes away mid-report there is
    # nothing left to report to. Exit 141 then, deliberately and by the
    # shell's spelling, with the descriptor swapped for /dev/null so the
    # interpreter's own flush at exit cannot raise a second time.
    #
    # ANY OTHER DEATH OF THE HARNESS IS STATUS 2, NEVER 1 (bu20). Python
    # ends an uncaught exception with status 1, which is this tool's
    # word for "a case differs" — and on the `field` leg a difference is
    # an advisory, so a harness that died laying out a scratch tree (run
    # 38114708822: a file too large for ext4) was read as a divergence
    # and nobody was told that half the suite had not run. 2 is "the
    # harness itself cannot run", and `tools/field-verdict` reds on it.
    try:
        code = main(sys.argv[1:])
        sys.stdout.flush()
    except BrokenPipeError:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        code = 128 + signal.SIGPIPE
    except Exception:
        import traceback
        sys.stdout.flush()
        traceback.print_exc()
        print("difftest: the harness died; no verdict", file=sys.stderr)
        code = 2
    sys.exit(code)
