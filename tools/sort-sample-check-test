#!/usr/bin/env python3
"""Exercise actual sample-report spelling and empty-profile rejection."""
import importlib.machinery
import importlib.util
from pathlib import Path
import unittest

path = Path(__file__).with_name("sort-sample-check")
loader = importlib.machinery.SourceFileLoader("sort_sample_check", str(path))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)


class SampleContent(unittest.TestCase):
    def test_one_leading_underscore(self):
        self.assertTrue(module.has_active_sort(
            "Call graph:\n    17 Thread_1\n      12 _Wcmd.sort.compare$abc (in sort)\n"
            "Total number in stack:\n"))

    def test_two_leading_underscores(self):
        self.assertTrue(module.has_active_sort(
            "Call graph:\n    17 Thread_1\n      12 __Wcmd.sort.compare$abc (in sort)\n"
            "Total number in stack:\n"))

    def test_empty_call_graph(self):
        self.assertFalse(module.has_active_sort(
            "Call graph:\n\nTotal number in stack:\n"))

    def test_only_image_name_is_not_a_stack(self):
        self.assertFalse(module.has_active_sort(
            "Call graph:\n\nTotal number in stack:\n"
            "Binary Images: __Wcmd.sort.compare$abc\n"))

    def test_missing_call_graph(self):
        self.assertFalse(module.has_active_sort("sample process exited"))


if __name__ == "__main__":
    unittest.main()
