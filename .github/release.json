{
  "schema": 1,
  "name": "boreutils",
  "manifest": "src/wolf.pkg",
  "gate_workflow": ".github/workflows/release-gate.yml",
  "gate_profile": "full-every-suite",
  "build": [
    "tools/build"
  ],
  "binaries": {
    "[": "target/release/[",
    "arch": "target/release/arch",
    "b2sum": "target/release/b2sum",
    "base32": "target/release/base32",
    "base64": "target/release/base64",
    "basename": "target/release/basename",
    "basenc": "target/release/basenc",
    "cat": "target/release/cat",
    "chcon": "target/release/chcon",
    "chgrp": "target/release/chgrp",
    "chmod": "target/release/chmod",
    "chown": "target/release/chown",
    "chroot": "target/release/chroot",
    "cksum": "target/release/cksum",
    "comm": "target/release/comm",
    "cp": "target/release/cp",
    "csplit": "target/release/csplit",
    "cut": "target/release/cut",
    "date": "target/release/date",
    "dd": "target/release/dd",
    "dir": "target/release/dir",
    "dircolors": "target/release/dircolors",
    "dirname": "target/release/dirname",
    "du": "target/release/du",
    "echo": "target/release/echo",
    "env": "target/release/env",
    "expand": "target/release/expand",
    "expr": "target/release/expr",
    "factor": "target/release/factor",
    "false": "target/release/false",
    "fmt": "target/release/fmt",
    "fold": "target/release/fold",
    "groups": "target/release/groups",
    "head": "target/release/head",
    "hostid": "target/release/hostid",
    "hostname": "target/release/hostname",
    "id": "target/release/id",
    "install": "target/release/install",
    "join": "target/release/join",
    "kill": "target/release/kill",
    "link": "target/release/link",
    "ln": "target/release/ln",
    "logname": "target/release/logname",
    "ls": "target/release/ls",
    "md5sum": "target/release/md5sum",
    "mkdir": "target/release/mkdir",
    "mkfifo": "target/release/mkfifo",
    "mknod": "target/release/mknod",
    "mktemp": "target/release/mktemp",
    "mv": "target/release/mv",
    "nice": "target/release/nice",
    "nl": "target/release/nl",
    "nohup": "target/release/nohup",
    "nproc": "target/release/nproc",
    "numfmt": "target/release/numfmt",
    "od": "target/release/od",
    "paste": "target/release/paste",
    "pathchk": "target/release/pathchk",
    "pinky": "target/release/pinky",
    "pr": "target/release/pr",
    "printenv": "target/release/printenv",
    "printf": "target/release/printf",
    "ptx": "target/release/ptx",
    "pwd": "target/release/pwd",
    "readlink": "target/release/readlink",
    "realpath": "target/release/realpath",
    "rm": "target/release/rm",
    "rmdir": "target/release/rmdir",
    "runcon": "target/release/runcon",
    "seq": "target/release/seq",
    "sha1sum": "target/release/sha1sum",
    "sha224sum": "target/release/sha224sum",
    "sha256sum": "target/release/sha256sum",
    "sha384sum": "target/release/sha384sum",
    "sha512sum": "target/release/sha512sum",
    "shred": "target/release/shred",
    "shuf": "target/release/shuf",
    "sleep": "target/release/sleep",
    "sort": "target/release/sort",
    "split": "target/release/split",
    "stat": "target/release/stat",
    "stdbuf": "target/release/stdbuf",
    "stty": "target/release/stty",
    "sum": "target/release/sum",
    "sync": "target/release/sync",
    "tac": "target/release/tac",
    "tail": "target/release/tail",
    "tee": "target/release/tee",
    "test": "target/release/test",
    "timeout": "target/release/timeout",
    "touch": "target/release/touch",
    "tr": "target/release/tr",
    "true": "target/release/true",
    "truncate": "target/release/truncate",
    "tsort": "target/release/tsort",
    "tty": "target/release/tty",
    "uname": "target/release/uname",
    "unexpand": "target/release/unexpand",
    "uniq": "target/release/uniq",
    "unlink": "target/release/unlink",
    "uptime": "target/release/uptime",
    "users": "target/release/users",
    "vdir": "target/release/vdir",
    "wc": "target/release/wc",
    "who": "target/release/who",
    "whoami": "target/release/whoami",
    "yes": "target/release/yes"
  },
  "version_args": [
    "--version"
  ],
  "version_pattern": "^\\S+ \\(boreutils\\) (?P<version>[0-9]+\\.[0-9]+\\.[0-9]+)$",
  "smoke": [
    [
      "{bin}/cat",
      "--version"
    ],
    [
      "{bin}/printf",
      "%s\\n",
      "release-smoke"
    ],
    [
      "{bin}/test",
      "--version"
    ]
  ],
  "version_exemptions": {
    "test": "POSIX test treats --version as an operand; the shared family version is observed through the other utilities"
  }
}
